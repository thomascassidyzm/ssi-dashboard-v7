  },
  {
    "id": "f91434fb-83bf-4078-bc51-35bbd018cc71",
    "text": "どうもありがとうございます。さようなら。",
    "role": "known",
    "voice_id": "eve",
    "language": "jpn",
    "duration_ms": 2520,
    "verdict": "suspect",
