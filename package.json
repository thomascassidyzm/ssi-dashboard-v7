{
  "name": "ssi-dashboard-v7-clean",
  "private": true,
  "version": "14.0.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS=\"--max-old-space-size=8192\" vite",
    "build": "NODE_OPTIONS=\"--max-old-space-size=8192\" vite build",
    "build:local": "NODE_OPTIONS=\"--max-old-space-size=8192\" npm run generate-manifest && vite build",
    "generate-manifest": "NODE_OPTIONS=\"--max-old-space-size=8192\" node generate-course-manifest.js",
    "preview": "NODE_OPTIONS=\"--max-old-space-size=8192\" vite preview",
    "server": "NODE_OPTIONS=\"--max-old-space-size=8192\" node automation_server.cjs",
    "pipeline": "echo '⚠️  DEPRECATED: Use npm run automation instead' && exit 1",
    "automation": "NODE_OPTIONS=\"--max-old-space-size=8192\" node start-automation.js",
    "automation:legacy": "NODE_OPTIONS=\"--max-old-space-size=8192\" LEGACY_MODE=true node start-automation.js",
    "course-builder": "NODE_OPTIONS=\"--max-old-space-size=8192\" node services/course-builder-api.cjs",
    "check:syntax": "node tools/check-service-syntax.cjs",
    "pretest": "node tools/check-service-syntax.cjs",
    "pretest:run": "node tools/check-service-syntax.cjs",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:e2e:pod-recording": "playwright test --config=e2e/pod-recording/playwright.config.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.67.0",
    "@aws-sdk/client-s3": "^3.929.0",
    "@aws-sdk/lib-storage": "^3.1058.0",
    "@aws-sdk/s3-request-presigner": "^3.943.0",
    "@octokit/rest": "^22.0.1",
    "@ssi/core": "file:../ssi-learning-app/packages/core",
    "@supabase/supabase-js": "^2.87.1",
    "ajv": "^8.17.1",
    "aws-sdk": "^2.1692.0",
    "axios": "^1.7.9",
    "busboy": "^1.6.0",
    "d3": "^7.9.0",
    "dotenv": "^17.2.3",
    "elevenlabs": "^1.59.0",
    "http-proxy-middleware": "^3.0.5",
    "idb": "^8.0.3",
    "microsoft-cognitiveservices-speech-sdk": "^1.46.0",
    "pinia": "^3.0.4",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "syllable": "^5.0.1",
    "uuid": "^13.0.0",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vue-toastification": "^2.0.0-rc.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/ui": "^4.0.7",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.21",
    "body-parser": "^1.20.3",
    "chokidar": "^4.0.3",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fs-extra": "^11.3.2",
    "jsdom": "^30.0.1",
    "node-fetch": "^2.7.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "vite": "^7.1.7",
    "vitest": "^4.0.7"
  }
}
