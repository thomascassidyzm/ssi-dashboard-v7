# ===========================================
# SSi Dashboard v7 - .gitignore
# ===========================================
# Architecture:
#   - GitHub: Code, specs, prompts, scripts (SSoT)
#   - S3 (popty-bach): Working course data
#   - S3 (published): Final course manifests
#   - S3 (staging): Audio samples
# ===========================================

# --------------------------
# Node.js / Build
# --------------------------
node_modules/
dist/
dist-ssr/
*.local

# --------------------------
# Logs
# --------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server.log

# --------------------------
# Editor / OS
# --------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --------------------------
# Environment / Secrets
# --------------------------
.env
.env.*
!.env.example

# --------------------------
# Vercel
# --------------------------
.vercel/

# --------------------------
# Course Data (S3 is SSoT)
# --------------------------
# All course content lives in S3, not git
public/vfs/courses/
public/vfs/canonical/
public/vfs/courses-manifest.json

# --------------------------
# Audio Samples (S3 is SSoT)
# --------------------------
samples_database/

# --------------------------
# Temp / Working Files
# --------------------------
temp/
temp_*
test-*
test_*
archive/
!apml/archive/
recovered_*/
extracted-*/

# --------------------------
# Python
# --------------------------
__pycache__/
*.pyc

# --------------------------
# PM2 / Process Management
# --------------------------
.pm2/
ecosystem.config.js

# --------------------------
# Local Development
# --------------------------
# Orchestrator temp files
.orchestrator-*.md

# Claude recovery prompts
.claude/recovery_prompts/

# Session docs (ephemeral)
docs/sessions/

# Project management (local)
.project/

# --------------------------
# Tests (local only)
# --------------------------
tests/
public/vfs/courses_backup_*
**/backups/
**/*backup*

# --------------------------
# Scripts (agent workspace)
# --------------------------
# Agent-generated batch processors and experimental code
scripts/
