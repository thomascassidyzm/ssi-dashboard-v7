# ===========================================
# SSi Dashboard v7 - .gitignore
# ===========================================
# Architecture:
#   - GitHub: Code, specs, prompts, scripts (SSoT)
#   - S3 (popty-bach): Working course data
#   - S3 (published): Final course manifests
#   - S3 (staging): Audio samples
# ===========================================

# --------------------------
# Node.js / Build
# --------------------------
node_modules/
dist/
dist-ssr/
*.local

# --------------------------
# Logs
# --------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
server.log

# --------------------------
# Editor / OS
# --------------------------
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --------------------------
# Environment / Secrets
# --------------------------
.env
.env.*
!.env.example

# --------------------------
# Vercel
# --------------------------
.vercel/

# --------------------------
# Course Data (S3 is SSoT)
# --------------------------
# All course content lives in S3, not git
public/vfs/courses/
public/vfs/canonical/
public/vfs/courses-manifest.json

# --------------------------
# Audio Samples (S3 is SSoT)
# --------------------------
samples_database/

# --------------------------
# Temp / Working Files
# --------------------------
temp/
temp_*
test-*
test_*
# Root archive/ is scratch, EXCEPT the retired docs tree, which is tracked on
# purpose (Tom's ruling 2026-08-24). Anchored + negated because git cannot
# re-include a path whose parent directory is itself excluded.
/archive/*
!/archive/docs-retired-2026-08-24/
!apml/archive/
recovered_*/
extracted-*/
scripts/batch-temp/

# --------------------------
# Python
# --------------------------
__pycache__/
*.pyc

# --------------------------
# PM2 / Process Management
# --------------------------
.pm2/
ecosystem.config.js

# --------------------------
# Local Development
# --------------------------
# Orchestrator temp files
.orchestrator-*.md

# Claude recovery prompts
.claude/recovery_prompts/

# Session docs (ephemeral)
docs/sessions/

# Project management (local)
.project/

# --------------------------
# Tests (local only)
# --------------------------
tests/
public/vfs/courses_backup_*
**/backups/
**/*backup*

# --------------------------
# Bulk Audio Generation (side project)
# --------------------------
scripts/bulk-audio/data/
scripts/bulk-audio/generated/

# --------------------------
# Scripts directory (workspace, gitignored)
# --------------------------
scripts/

# --------------------------
# Root-level junk (temp scripts, reports, data)
# --------------------------
/*.cjs
!start-automation.cjs
/*.js
!vite.config.js
!tailwind.config.js
!postcss.config.js
/*.mjs
/*.md
!README.md
!SYSTEM.md
!CLAUDE.md
!ralph-methodology.md
!synonym-choice-architecture.md
!WORKLIST.md
/*.txt
/*.csv
/*.json
!package.json
!package-lock.json
!tsconfig.json
!tsconfig.*.json
!vercel.json
!automation.config.json
/*.db
seed*.json

# --------------------------
# Backup files
# --------------------------
*.bak

# --------------------------
# Supabase temp
# --------------------------
supabase/.temp/

# --------------------------
# Course-optimization working output — keep the planning .md,
# ignore the agent-generated JSON dumps (findings/fixes/regen/workflow
# results). Same ephemeral category as docs/sessions/ above.
# --------------------------
docs/course-optimization/**/*.json

# --------------------------
# Per-worker scratch worktrees and probe workspaces (2026-08-30).
# Created in-place by the A-108/A-134/A-74 sweep workers, the Claude
# worktree helper and the Hetzner throughput probe. They are working
# space belonging to one worker's run, never repo content, and they
# make `git status` in this checkout unreadable. Not deleted — ignored.
# --------------------------
.a-munster/
.a108-*/
.a134-*/
.a74-*/
.claude/worktrees/
.hetzner-probe/
.scan-gender/

# --------------------------
# Chat/transcript archives pulled down for analysis — other systems'
# records, kept locally for reading, not this repo's history.
# --------------------------
.kai-chat-archive/

# --------------------------
# Local database files and OS packages downloaded for headless-browser
# deps. Binary, machine-local, reproducible; never versioned here.
# (database/*.db also catches the literal `database/*.db` file a broken
# shell glob left behind on 2026-08-26.)
# --------------------------
database/*.db
*.deb
.vercel
.env*

# --------------------------
# Machine-generated evidence under docs/ and archive/ (2026-09-01, Tom's ruling
# "yes, move 290MB of machine logs out of the repo"). Sweep dryrun/applied/verify
# logs, queue tails, censuses, snapshots and screenshots are a WORKER'S output,
# not repo content: 278 MB of them were tracked, so every `git worktree add` wrote
# ~300 MB before anybody typed — ~30 a day, which was the estate's 10 GB/day disk
# churn (job #625). The files moved to ~/ssi-evidence/ssi-dashboard-v7/<same path>,
# with a MANIFEST.tsv; they also remain in git history at 7672f9b66.
# Tools may still WRITE here — the point is only that it never enters the tree.
# Where new evidence belongs: docs/EVIDENCE.md.
# --------------------------
docs/**/*.json
docs/**/*.jsonl
docs/**/*.gz
archive/**/*.json
archive/**/*.jsonl
archive/**/*.gz
docs/**/*.png
docs/**/*.jpg
docs/**/*.jpeg
docs/**/*.gif
docs/**/*.mp3
docs/**/*.wav
archive/**/*.png
archive/**/*.jpg
archive/**/*.jpeg
archive/**/*.gif
archive/**/*.mp3
archive/**/*.wav

# Kept in the tree deliberately: schemas, and the handful of evidence files that
# committed tools and tests read by path (verified by grep over tracked code,
# 2026-09-01). Anything added here must be small and must be READ by code.
!**/*.schema.json
!docs/pods/pod1-recast-regen-queue-by-language-2026-08-23.json
!docs/pods/chunk-audio-cut-candidates-2026-07-17.json
!docs/pods/pod0-welsh-drafts-applied-log.json
!docs/pods/ita_for_eng-pod-1-off-role-rerender-2026-08-24-applied-log.json
!docs/pods/pod-overlap-2026-08-14.json
!docs/pods/nld-inflight-session-repair-2026-08-24-applied-log.json
!docs/a108/a136-nld-noor-drop-sample.json
!docs/spa-bare-lego-repair-sample-2026-08-26.json

# NOT evidence: the frame layer's machine-readable SOURCE. Each docs/frame-layer/*.md
# is a human RENDER of its .json companion (see docs/frame-layer/README.md's table and
# tools/frame-layer/render-mapping.cjs, which writes the .md FROM the .json). No
# generator produces these — they are hand-authored analysis — so a checkout without
# them is a checkout with a missing input, not a checkout missing a log. The 2026-09-01
# sweep took them out with the logs and production-api crash-looped on the next restart:
# labs/basket-lab/server.cjs readFileSyncs pair-mapping-classes.json at REQUIRE time and
# production-api.cjs mounts it (services/production-api.cjs). Listed here are the three
# that committed code reads by path; the rest of the frame layer's JSON stays out.
!docs/frame-layer/pair-mapping-classes.json
!docs/frame-layer/english-pattern-inventory.json
!docs/frame-layer/dialogue-frame-inventory.json

# phrase declarations — the door records the QA spec per lego id here (operational data, never tracked)
data/phrase-declarations/
