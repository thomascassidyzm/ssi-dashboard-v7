[
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 2,
    "role": "target1",
    "seedId": "0104c5f8-47f4-4880-9bd8-ea3aba303fa6",
    "text": "Mä yritän oppia",
    "audioId": "561dd071-4ce3-449f-8d3a-7e4ed3f0e854",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 4,
    "role": "target1",
    "seedId": "be546b15-c5e3-4b72-aeff-c2cfcfd3faec",
    "text": "miten sanoa jotain suomeksi",
    "audioId": "d2ccfac7-cbee-4183-bd5f-482fdd9543e0",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 5,
    "role": "target1",
    "seedId": "9c4ce1a6-32ac-4517-95c7-cf8d306753fc",
    "text": "Mä aion harjoitella puhumista jonkun muun kanssa",
    "audioId": "e3efcdfa-c1c4-4f4b-98b4-4cdf35747213",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 29,
    "role": "target1",
    "seedId": "8f16e344-3d48-4482-ac47-856e0e83c21b",
    "text": "Mä odotan innolla sitä, että mä puhun paremmin, heti kun mä pystyn",
    "audioId": "30912549-57d8-4874-88ac-008324e5857e",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 62,
    "role": "target1",
    "seedId": "fc2142a8-7218-4d93-8eec-15091b800e07",
    "text": "Mä en oo varma voinko mä auttaa sua samaan aikaan",
    "audioId": "775de6c3-d031-4039-8870-190d29939d51",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 91,
    "role": "target1",
    "seedId": "30df0ccb-4e6d-480c-8213-c4aed5281e80",
    "text": "On vaikeaa miettiä tarpeeksi nopeesti, että ehtii vastata ajoissa",
    "audioId": "d9b4ac13-3aad-4984-967e-9d334c59409f",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 109,
    "role": "target1",
    "seedId": "10facbbc-5df1-4fdd-a007-b6fdd81e0eaa",
    "text": "Meidän pitää tehdä kovasti töitä, niin että me opitaan paljon uusia sanoja",
    "audioId": "9dc12b75-51d5-43c2-8872-529b206602fb",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 155,
    "role": "target1",
    "seedId": "c1670a81-9ebd-47a1-92ad-0c9c4199ec7e",
    "text": "Mua ei haittaa odottaa muutamaa minuuttia huomenna aamulla",
    "audioId": "85901dd4-5c66-4ae9-8443-d0ca6e4863dc",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 200,
    "role": "target1",
    "seedId": "bdc6f0db-8d3c-49eb-ac88-0359fbfdd715",
    "text": "Ne sanoo, että ne haluu varmistaa, että me lopetetaan kaiken ajoissa",
    "audioId": "0694e5fe-6672-47fc-a01d-ce264e3e95e3",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 235,
    "role": "target1",
    "seedId": "c0ee346c-3de2-4ca2-9713-30887e7372e8",
    "text": "Mä tapasin jonkun, joka sanoi, että se halusi kertoa sulle jotain",
    "audioId": "3c738c1a-3028-4b09-b3c8-62803e8a4d64",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 248,
    "role": "target1",
    "seedId": "5004c8dc-a34e-4fa3-9a95-3ffadb6f8f89",
    "text": "Mun mielestä elokuva oli täyttä roskaa, ja mä haluun mun rahat takaisin",
    "audioId": "d4e2bb8d-b4f2-48f3-a751-b60aae2598a8",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 262,
    "role": "target1",
    "seedId": "894f134a-337a-4454-bd8d-55a845be03a8",
    "text": "Kuka se mies oli, jolle sä puhuit eilen?",
    "audioId": "80854ec6-4c96-4656-b124-0d5c05df0707",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 304,
    "role": "target1",
    "seedId": "6157edbb-cf05-46f1-977c-d6bbc351e6e7",
    "text": "Mä luulen, että se ei haluu tehdä töitä kotoa",
    "audioId": "1f3c048d-9973-43f6-bc43-7e04cbe677bf",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 334,
    "role": "target1",
    "seedId": "cfe2e59d-d1a9-42e5-b478-dd5acb91a60c",
    "text": "Se sanoi, että se voi antaa sun pitää kissanpentua",
    "audioId": "cc6c9687-a2d0-426f-b918-cf59c91c4c70",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 497,
    "role": "target1",
    "seedId": "b884d4ca-a553-4507-9f7c-474e2597ea1c",
    "text": "Toi kuulostaa siltä, että sun pitäisi saada vähän unta",
    "audioId": "6bb3f83a-c975-4412-9718-07f6ff389487",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 502,
    "role": "target1",
    "seedId": "c705e0b1-b73f-4d5c-98ec-cb1ab7adf5e5",
    "text": "Se melkein eksyi, koska se kääntyi vasemmalle oikean sijaan",
    "audioId": "2403867f-2afc-4a0e-ac8f-ab5b54ccd64a",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 506,
    "role": "target1",
    "seedId": "f1c83adf-65b9-4370-838a-0eccac96dee9",
    "text": "Mä asuin täällä päin vuosia sitten ennen kuin me muutettiin",
    "audioId": "1aba5130-8edd-41d2-b609-13a336b6102a",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 508,
    "role": "target1",
    "seedId": "33840a51-4de1-4988-9a8a-e75ba35f52df",
    "text": "Ei oo mitään järkeä huolestua siitä, miten sä aiot maksaa",
    "audioId": "c6f293a3-5c87-48a0-b739-3b3ef7c6c6b5",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 518,
    "role": "target1",
    "seedId": "e39683dd-0c6f-46c2-8fd8-b8eb0d94fc7c",
    "text": "Mä en voinut kuvitella, että mulla olisi täsmälleen sama ongelma",
    "audioId": "45db085d-8076-466d-9394-335bed1f309f",
    "action": "linked",
    "from": null,
    "fromVoice": null
  },
  {
    "voiceId": "human_kai_fin",
    "language": "fin",
    "courseCode": "fin_for_eng",
    "seedNumber": 606,
    "role": "target1",
    "seedId": "c53c6f7f-b6f5-4bcc-9e1d-383a1649e3e7",
    "text": "Jos mä olisin tiennyt silloin, mitä mä tiedän nyt, mä olisin odottanut",
    "audioId": "c444a23b-e949-4a53-a467-c19830b87938",
    "action": "linked",
    "from": null,
    "fromVoice": null
  }
]