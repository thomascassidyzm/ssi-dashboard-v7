[Unit]
Description=Nightly voice-variety and count-reconciliation check at 05:55 Europe/London
Documentation=file:///home/tomcassidy/SSi/ssi-dashboard-v7-clean/tools/qa/voice-variety/README.md

[Timer]
# 05:55 London, stated in London so the twice-yearly DST shift needs no edit.
# Chosen to miss every neighbour already on this box: 03:00 SSi CI, 03:50
# landing sweep, 04:15 tmp sweep, 04:30 Vue template sentinel, 04:40, 05:10
# audio-gap, 05:40 events archive. audio-gap takes ~2 minutes and this takes
# ~3, so 05:55 clears both of its nearest neighbours with room to spare.
OnCalendar=*-*-* 05:55:00 Europe/London
RandomizedDelaySec=300
AccuracySec=1min
# A night missed because the box was down runs at the next boot rather than
# leaving a hole in the series.
Persistent=true
Unit=ssi-voice-variety.service

[Install]
WantedBy=timers.target
