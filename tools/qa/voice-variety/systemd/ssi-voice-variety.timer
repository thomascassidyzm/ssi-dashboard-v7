[Unit]
Description=Nightly voice-variety and count-reconciliation check
Documentation=file:///home/tomcassidy/SSi/ssi-dashboard-v7-clean/tools/qa/voice-variety/README.md

[Timer]
OnCalendar=*-*-* 05:05:00 UTC
RandomizedDelaySec=120
AccuracySec=1min
# A night missed because the box was down runs at the next boot rather than
# leaving a hole in the series.
Persistent=true
Unit=ssi-voice-variety.service

[Install]
WantedBy=timers.target
