[Unit]
Description=Nightly sibling-variant identity check at 06:10 Europe/London

[Timer]
# 06:10 London, stated in London so the twice-yearly DST shift needs no edit.
# Chosen to miss every neighbour already on this box: 03:00 SSi CI, 03:30 the
# nightly suite, 03:50 landing sweep, 04:15 tmp sweep, 04:30 Vue sentinel,
# 05:10 audio-gap, 05:40 events archive, 05:55 voice-variety. voice-variety
# takes ~3 minutes and this takes ~2, so 06:10 clears it with room to spare.
OnCalendar=*-*-* 06:10:00 Europe/London
RandomizedDelaySec=300
AccuracySec=1min
# A night missed because the box was down runs at the next boot rather than
# leaving a hole in the series.
Persistent=true
Unit=ssi-sibling-identity.service

[Install]
WantedBy=timers.target
