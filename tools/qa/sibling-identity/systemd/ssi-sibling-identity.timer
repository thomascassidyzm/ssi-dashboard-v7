[Unit]
Description=Nightly sibling-variant identity check

[Timer]
OnCalendar=*-*-* 04:20:00 UTC
RandomizedDelaySec=120
AccuracySec=1min
# A night missed because the box was down runs at the next boot rather than
# leaving a hole in the series.
Persistent=true
Unit=ssi-sibling-identity.service

[Install]
WantedBy=timers.target
