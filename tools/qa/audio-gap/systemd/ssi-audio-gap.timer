[Unit]
Description=Nightly text-ahead-of-audio count
Documentation=file:///home/tomcassidy/SSi/ssi-dashboard-v7-clean/tools/qa/audio-gap/README.md

[Timer]
# Job #683: every qa:* check runs inside the DB watchdog's 01:00-06:00Z off-peak window, ≥15 min apart, in UTC (no DST drift out of the window).
OnCalendar=*-*-* 04:00:00 UTC
RandomizedDelaySec=120
AccuracySec=1min
# A night missed because the box was down runs at the next boot rather than
# leaving a hole in the series.
Persistent=true
Unit=ssi-audio-gap.service

[Install]
WantedBy=timers.target
