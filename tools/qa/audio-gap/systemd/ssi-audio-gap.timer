[Unit]
Description=Nightly text-ahead-of-audio count at 05:10 Europe/London
Documentation=file:///home/tomcassidy/SSi/ssi-dashboard-v7-clean/tools/qa/audio-gap/README.md

[Timer]
# 05:10 London, stated in London so the twice-yearly DST shift needs no edit.
# Chosen to miss every neighbour already on this box: 03:00 SSi CI, 03:50 landing
# sweep, 04:15 tmp sweep, 04:40, 05:40 events archive.
OnCalendar=*-*-* 05:10:00 Europe/London
RandomizedDelaySec=300
AccuracySec=1min
# A night missed because the box was down runs at the next boot rather than
# leaving a hole in the series.
Persistent=true
Unit=ssi-audio-gap.service

[Install]
WantedBy=timers.target
