[Unit]
Description=Nightly voice-policy audit (job #53): every slot vs resolveVoice, report only, one notice to the Watson room

[Service]
Type=oneshot
# Runs the LANDED code: the shared detached nightly worktree is reset to origin/main first (the ssi-voice-variety pattern).
WorkingDirectory=/home/tomcassidy/SSi/popty-qa-nightly
ExecStartPre=/usr/bin/git -C /home/tomcassidy/SSi/popty-qa-nightly fetch --quiet origin main
ExecStartPre=/usr/bin/git -C /home/tomcassidy/SSi/popty-qa-nightly checkout --quiet --detach origin/main
ExecStart=/usr/bin/node /home/tomcassidy/SSi/popty-qa-nightly/tools/qa/voice-policy/nightly.cjs
# Read-only grouped queries over the course tables, mostly Postgres-side: back seat, hard cap.
Nice=15
IOSchedulingClass=idle
CPUWeight=20
TimeoutStartSec=2h
# Exit 2 = could not run; it has already said so in the room.
SuccessExitStatus=0 2
OOMScoreAdjust=500
StandardOutput=append:/home/tomcassidy/.local/log/ssi-voice-audit-unit.log
StandardError=append:/home/tomcassidy/.local/log/ssi-voice-audit-unit.log
