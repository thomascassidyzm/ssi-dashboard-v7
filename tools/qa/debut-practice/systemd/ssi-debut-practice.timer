[Unit]
Description=Daily debut-practice alarm

[Timer]
# Job #683: after sibling-identity (04:20Z), inside the watchdog's 01:00-06:00Z qa:* window.
OnCalendar=*-*-* 04:45:00 UTC
RandomizedDelaySec=120
AccuracySec=1min
Persistent=true
Unit=ssi-debut-practice.service

[Install]
WantedBy=timers.target
