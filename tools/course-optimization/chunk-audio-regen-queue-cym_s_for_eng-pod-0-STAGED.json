      },
      {
        "id": "cym_s_for_eng:pod-0:SC08-S016",
        "order": 58,
        "text": "Pedwar. Chwech. Wyth. Glas. Melyn.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC09-S001",
        "order": 59,
        "text": "Noswaith dda. Ma bwcin gyda ni i ddau, o dan yr enw Davies.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC09-S002",
        "order": 60,
        "text": "Croeso. Dewch gyda fi, os gwelwch yn dda. Dyma'r bwydlenni.",
