      },
      {
        "id": "cym_s_for_eng:pod-0:SC09-S010",
        "order": 68,
        "text": "A'r risotto i fi. Gyda salad gwyrdd bach i ddechrau.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC09-S011",
        "order": 69,
        "text": "Wrth gwrs. A beth licech chi i'w yfed?",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC09-S012",
        "order": 70,
        "text": "Allen ni weld y rhestr win?",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC09-S013",
        "order": 71,
        "text": "Byddai potel o win coch y tŷ yn hyfryd.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC09-S014",
        "order": 72,
        "text": "Dewis ardderchog. Do i ag e draw nawr.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC09-S015",
        "order": 73,
        "text": "Ydy popeth yn iawn? Oes lle gyda chi i bwdin?",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC09-S016",
        "order": 74,
        "text": "Dim ond dau goffi, os gwelwch yn dda. Coffi di-gaffein i fi.",
