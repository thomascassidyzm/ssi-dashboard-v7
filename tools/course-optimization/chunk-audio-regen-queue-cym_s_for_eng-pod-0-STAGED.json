      },
      {
        "id": "cym_s_for_eng:pod-0:SC06-S010",
        "order": 24,
        "text": "Galla, wrth gwrs. Nyrs dw i. Dw i'n gweithio yn yr ysbyty. Mae e'n agos 'ma. A beth dych chi'n neud?",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC06-S011",
        "order": 25,
        "text": "Dw i'n dysgu Saesneg, ond ddim mewn ysgol. Dw i'n gweithio gydag oedolion. Dw i ar wyliau 'ma gyda fy ngwraig a'r plant. Ry'n ni'n cael amser hyfryd.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC06-S012",
        "order": 26,
        "text": "Am ddiddorol. Wel, neis cwrdd â chi.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC06-S013",
        "order": 27,
        "text": "Un. Dau. Tri. Gwyn. Du.",
