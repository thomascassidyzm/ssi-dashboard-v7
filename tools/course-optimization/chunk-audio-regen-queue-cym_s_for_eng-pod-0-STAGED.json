      },
      {
        "id": "cym_s_for_eng:pod-0:SC04-S001",
        "order": 10,
        "text": "Helo, noswaith dda!",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC04-S002",
        "order": 11,
        "text": "Helo! Mae'n ddrwg 'da fi ond alla i ddim siarad ar hyn o bryd. Ma rhaid i fi fynd adre nawr. Allwn ni siarad fory?",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC04-S003",
        "order": 12,
        "text": "Na, mae'n ddrwg 'da fi, dw i'n brysur fory. Ond gad i ni siarad ddydd Sadwrn. Wela i di bryd hynny.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC05-S001",
        "order": 13,
        "text": "Noswaith dda, Sarah. Gest ti ddiwrnod hir?",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC05-S002",
        "order": 14,
        "text": "Do, hir iawn. Dw i wedi blino'n lân nawr. Nos da. Wela i di fory.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC06-S001",
        "order": 15,
        "text": "Esgusodwch fi. Helo. Beth yw eich enw chi?",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC06-S002",
        "order": 16,
        "text": "Anna yw fy enw i. A chi?",
