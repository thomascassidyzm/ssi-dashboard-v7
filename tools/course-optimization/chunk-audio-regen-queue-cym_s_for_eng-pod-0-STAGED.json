      },
      {
        "id": "cym_s_for_eng:pod-0:SC06-S006",
        "order": 20,
        "text": "Dw i'n dod o Ffrainc. Dw i 'di bod 'ma ers dwy flynedd.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC06-S007",
        "order": 21,
        "text": "Mae hon yn ddinas hyfryd. Beth dych chi'n neud?",
