      },
      {
        "id": "cym_s_for_eng:pod-0:SC10-S002",
        "order": 78,
        "text": "Oes, ma nhw lawr yr eil yna, ar y chwith.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC10-S003",
        "order": 79,
        "text": "Diolch. A oes gyda chi unrhyw dabledi lladd poen i blant?",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC10-S004",
        "order": 80,
        "text": "Dw i'n meddwl bod rhai 'da ni, ond bydd rhaid i chi edrych i fod yn siŵr.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC10-S005",
        "order": 81,
        "text": "Ma ishe i fi gael rhywfaint o eli haul a phast dannedd hefyd.",
        "reason": "no atom_map, no whole-turn audio"
      },
      {
        "id": "cym_s_for_eng:pod-0:SC10-S006",
        "order": 82,
        "text": "Ma'r eli haul lawr fan'na ar y dde, a gewch chi hyd i'r past dannedd jyst rownd y gornel.",
