-- TEMPLATE: weave-cym-sv2-sole-new-468.cjs sql fills the FLIPS and ROWS markers and writes weave-cym-sv2-sole-new-468.sql.
-- Job #468 (Aran 2026-10-13, reconciling jobs #459 and #460): three South LEGOs that #460 marked already taught
-- (is_new=false) are each the ONLY new LEGO in their seed, so with the flag off the seed has no new LEGO and never
-- plays. They go back to NEW (Aran is asked to confirm S1159; new is the default for sole-new cases):
--   S1159L1 'that isn’t what' = 'nid hynny'          (S1151L1 taught 'that wasn’t what' = 'nid hynny')
--   S1400L1 'do we want?' = 'ŷn ni’n moyn?'           (S1018L1/S1398L1 taught 'we want' = 'ŷn ni’n moyn')
--   S1409L2 'what we do' = 'beth ŷn ni’n gwneud'      (S1104L3 taught 'what we’re doing')
-- Each flip and its full practice basket land in ONE transaction: the deferred debut_keeps_practice trigger refuses a
-- new LEGO with no practice, and the v2 door refuses a not-new one. Basket generated by generateLegoPhrases (v3 door's
-- generator, real gates) and re-checked with the v2 door's own checks before this file was written; rows as the door builds them.
-- Only these LEGOs' is_new + last_edit_event_id change, and only these rows are added.
-- Fingerprints of live cym_n_for_eng / cym_s_for_eng (seeds, legos, phrases) and master canonical_seeds are asserted unchanged.
-- Dry run unless invoked with  -v finish=COMMIT . Undo: weave-cym-sv2-sole-new-468-undo.sql.
\set ON_ERROR_STOP on
\if :{?finish}
\else
  \set finish ROLLBACK
\endif
BEGIN;
SET LOCAL statement_timeout = '20min';
CREATE FUNCTION pg_temp.fp() RETURNS TABLE(t text, n bigint, h text) LANGUAGE sql AS $$
  SELECT 'canonical_seeds (master)', count(*), md5(string_agg(md5(x::text), '' ORDER BY x::text)) FROM canonical_seeds x
  UNION ALL SELECT 'live '||x.course_code||' seeds', count(*), md5(string_agg(md5(x::text), '' ORDER BY x.id)) FROM course_seeds x WHERE x.course_code IN ('cym_n_for_eng','cym_s_for_eng') GROUP BY x.course_code
  UNION ALL SELECT 'live '||x.course_code||' legos', count(*), md5(string_agg(md5(x::text), '' ORDER BY x.id)) FROM course_legos x WHERE x.course_code IN ('cym_n_for_eng','cym_s_for_eng') GROUP BY x.course_code
  UNION ALL SELECT 'live '||x.course_code||' phrases', count(*), md5(string_agg(md5(x::text), '' ORDER BY x.id)) FROM course_practice_phrases x WHERE x.course_code IN ('cym_n_for_eng','cym_s_for_eng') GROUP BY x.course_code
$$;
CREATE TEMP TABLE pre AS SELECT * FROM pg_temp.fp();
SELECT 'BEFORE' k, * FROM pre ORDER BY t;

CREATE TEMP TABLE flip (seed_number int, lego_index int, target_text text, PRIMARY KEY (seed_number, lego_index));
--@FLIPS@
CREATE TEMP TABLE add_rows (id text PRIMARY KEY, seed_number int, lego_index int, position int, known_text text, target_text text,
  word_count int, lego_count int, phrase_role text, introduce boolean, lego_position text, metadata jsonb);
--@ROWS@

DO $$ BEGIN
  IF to_regclass('backup_cym_sv2_sole_new_468') IS NOT NULL THEN RAISE EXCEPTION 'already applied'; END IF;
  IF (SELECT count(*) FROM flip f JOIN course_legos l ON l.course_code='cym_sv2_for_eng' AND l.seed_number=f.seed_number
        AND l.lego_index=f.lego_index AND l.target_text=f.target_text AND NOT l.is_new) <> 3 THEN
    RAISE EXCEPTION 'a listed LEGO is missing, has other text, or is already new'; END IF;
  -- The reason for the flip: no OTHER LEGO in the seed is new.
  IF EXISTS (SELECT 1 FROM course_legos l JOIN flip f ON l.course_code='cym_sv2_for_eng' AND l.seed_number=f.seed_number WHERE l.is_new) THEN
    RAISE EXCEPTION 'a seed has another new LEGO: it is not a sole-new case'; END IF;
  IF EXISTS (SELECT 1 FROM course_practice_phrases p JOIN flip f ON p.course_code='cym_sv2_for_eng' AND p.seed_number=f.seed_number AND p.lego_index=f.lego_index) THEN
    RAISE EXCEPTION 'a listed LEGO already has phrases'; END IF;
  IF EXISTS (SELECT 1 FROM add_rows a JOIN course_practice_phrases p ON p.id=a.id) THEN RAISE EXCEPTION 'a phrase id is taken'; END IF;
  IF EXISTS (SELECT 1 FROM add_rows a LEFT JOIN flip f USING (seed_number, lego_index) WHERE f.seed_number IS NULL) THEN RAISE EXCEPTION 'a row is not under a listed LEGO'; END IF;
END $$;

CREATE TABLE backup_cym_sv2_sole_new_468 AS
  SELECT l.id, l.course_code, l.seed_number, l.lego_index, l.is_new, l.last_edit_event_id
  FROM course_legos l JOIN flip f ON l.course_code='cym_sv2_for_eng' AND l.seed_number=f.seed_number AND l.lego_index=f.lego_index;
REVOKE ALL ON backup_cym_sv2_sole_new_468 FROM anon, authenticated;

INSERT INTO content_edit_events (course_code, surface, operation, actor_kind, actor_id, actor_label, actor_verified, actor_role, scope, detail)
VALUES ('cym_sv2_for_eng', 'sql:job-468 weave-cym-sv2-sole-new', 'weave-sole-new-back-to-new', 'agent', 'claude-job-468-sole-new',
        'agent (claude-job-468-sole-new)', false, 'creator',
        jsonb_build_object('lego_keys', (SELECT jsonb_agg(seed_number||':'||lego_index ORDER BY seed_number) FROM flip), 'phrase_ids', (SELECT jsonb_agg(id ORDER BY id) FROM add_rows)),
        jsonb_build_object('ruling', 'Job #468 reconciling #459/#460 (Aran 2026-10-13): a LEGO that is the only new LEGO in its seed stays NEW, or the seed never plays; S1159 is being confirmed with Aran, new is the default.',
                           'backup', 'backup_cym_sv2_sole_new_468'))
RETURNING id AS ev \gset

UPDATE course_legos l SET is_new = true, last_edit_event_id = :'ev'
FROM flip f WHERE l.course_code='cym_sv2_for_eng' AND l.seed_number=f.seed_number AND l.lego_index=f.lego_index;

INSERT INTO course_practice_phrases (id, course_code, seed_number, lego_index, position, known_text, target_text, word_count, lego_count,
  phrase_role, introduce, connected_lego_ids, lego_position, metadata, status, version, last_edit_event_id)
SELECT id, 'cym_sv2_for_eng', seed_number, lego_index, position, known_text, target_text, word_count, lego_count,
  phrase_role, introduce, '{}'::text[], lego_position, metadata, 'draft', 1, :'ev'
FROM add_rows;

CREATE TEMP TABLE post AS SELECT * FROM pg_temp.fp();
SELECT 'AFTER' k, * FROM post ORDER BY t;
DO $$ BEGIN
  IF EXISTS (SELECT * FROM pre EXCEPT SELECT * FROM post) OR EXISTS (SELECT * FROM post EXCEPT SELECT * FROM pre) THEN
    RAISE EXCEPTION 'CHECK FAILED: live Welsh or master canonical_seeds changed'; END IF;
  IF (SELECT count(*) FROM flip f JOIN course_legos l ON l.course_code='cym_sv2_for_eng' AND l.seed_number=f.seed_number AND l.lego_index=f.lego_index AND l.is_new) <> 3 THEN
    RAISE EXCEPTION 'CHECK FAILED: end state wrong'; END IF;
  IF (SELECT count(*) FROM course_practice_phrases p JOIN add_rows a USING (id)) <> (SELECT count(*) FROM add_rows) THEN RAISE EXCEPTION 'CHECK FAILED: rows missing'; END IF;
  RAISE NOTICE 'ALL CHECKS PASSED';
END $$;
SELECT a.id, a.known_text, a.target_text FROM add_rows a ORDER BY a.id;
SELECT 'finishing with' k, :'finish' v;
:finish;
SELECT :'finish' = 'COMMIT' AS do_refresh \gset
\if :do_refresh
REFRESH MATERIALIZED VIEW CONCURRENTLY course_round_index;
\endif
