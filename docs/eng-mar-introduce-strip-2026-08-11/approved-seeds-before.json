 },
 {
  "id": "5ddf2e27-1186-4a10-a86f-922cfe338d24",
  "course_code": "eng_for_mar",
  "seed_number": 580,
  "seed_id": "S0580",
  "known_text": "आम्हाला बऱ्याचदा मुलांना कुठेतरी थोड्या उबदार ठिकाणी न्यायचं होतं.",
  "target_text": "We've often wanted to take the children somewhere a little warmer.",
  "status": "released",
  "release_batch": null,
  "version": 446,
  "updated_at": "2026-08-02T20:37:44.649572+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "4fd73ce6-d49b-48e2-81c8-3e730d3bcd94",
  "target1_audio_id": "70b30ed6-20c4-4f8d-8704-0525f3bf2f41",
  "target2_audio_id": "179e97a0-7aa0-46d8-b56e-05c157335301",
  "decomposed_at": "2026-07-21T13:25:58.469+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "6c6cfa29-797a-499d-863c-00333d13dcaf",
  "course_code": "eng_for_mar",
  "seed_number": 581,
  "seed_id": "S0581",
  "known_text": "ते कसं आहे याबद्दल त्याला थोडं अजून जाणून घ्यायला आवडेल.",
  "target_text": "He'd like to know a little more about what it's like.",
  "status": "released",
  "release_batch": null,
  "version": 447,
  "updated_at": "2026-08-02T20:37:50.856783+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "cbe17bcf-0479-4d33-96b1-9468f7882ad4",
  "target1_audio_id": "6be0b55a-830b-40fa-80e3-38d688734320",
  "target2_audio_id": "50d6c37e-9f1a-4958-b11e-b083ad58e2fb",
  "decomposed_at": "2026-07-21T13:24:14.382+00:00",
  "approved_at": "2026-07-30T23:20:36.083+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "40ee90b6-2883-4d3f-9d1e-54457879dd76",
  "course_code": "eng_for_mar",
  "seed_number": 582,
  "seed_id": "S0582",
  "known_text": "इथे मोठं होणं कसं असतं?",
  "target_text": "What's it like to grow up here?",
  "status": "released",
  "release_batch": null,
  "version": 495,
  "updated_at": "2026-08-02T20:33:28.809848+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "dd27ff47-40f5-440f-abbe-3f611595d13c",
  "target1_audio_id": "0c868c8d-1271-4ef4-886b-cbe25e66f7de",
  "target2_audio_id": "fff12268-c6ba-4d44-b9ee-46fdbc452d1a",
  "decomposed_at": "2026-07-21T13:24:16.174+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "0507a8f2-1c7d-4f2e-ba8e-f83097c80d0a",
  "course_code": "eng_for_mar",
  "seed_number": 584,
  "seed_id": "S0584",
  "known_text": "दररोज सकाळी उठून डोंगर बघणं कसं असतं?",
  "target_text": "What's it like to wake up every morning and see the mountains?",
  "status": "released",
  "release_batch": null,
  "version": 495,
  "updated_at": "2026-08-02T20:33:28.809848+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "371ed2e5-74ed-408c-8101-10746a435dca",
  "target1_audio_id": "90fb3cb4-95a5-420c-a61f-854efa45847c",
  "target2_audio_id": "746ef14b-5d6d-415b-861c-a725108ba754",
  "decomposed_at": "2026-07-21T13:25:44.181+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "4b05e175-cfa0-4f58-ab0b-0c1d8ab470cf",
  "course_code": "eng_for_mar",
  "seed_number": 585,
  "seed_id": "S0585",
  "known_text": "मला माझ्या बेडरूमच्या खिडकीतून डोंगर दिसतात.",
  "target_text": "I can see the mountains out of my bedroom window.",
  "status": "released",
  "release_batch": null,
  "version": 381,
  "updated_at": "2026-08-02T19:41:17.375289+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "62900f3c-aa77-47eb-aa69-0b2613baf1ab",
  "target1_audio_id": "92251f3c-758a-4c61-8ecb-a9e70998ae24",
  "target2_audio_id": "3bafe14e-ac20-4ebf-9ae3-493a33277f0f",
  "decomposed_at": "2026-07-21T13:25:59.719+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "130079f1-e3ed-47d4-aedc-bcf9d2362ed3",
  "course_code": "eng_for_mar",
  "seed_number": 587,
  "seed_id": "S0587",
  "known_text": "ती आग्रह धरायची की आम्ही रात्रीच्या जेवणाला अंडी खावी.",
  "target_text": "She used to insist that we had eggs for supper.",
  "status": "released",
  "release_batch": null,
  "version": 381,
  "updated_at": "2026-08-02T19:41:17.163595+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "1b6eaaef-51df-49c9-8afd-e7e797c39ce9",
  "target1_audio_id": "ad33de75-9bf4-4a93-9bdf-6aa7a25142f7",
  "target2_audio_id": "c2e27cb9-b6ce-4e27-add2-1ea1a46869ff",
  "decomposed_at": "2026-07-21T13:31:06.151+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "e5f74de9-cbb1-4c74-9449-9bdc4cfd0a18",
  "course_code": "eng_for_mar",
  "seed_number": 588,
  "seed_id": "S0588",
  "known_text": "म्हणून मला मोठं होऊन घर सोडायचं होतं.",
  "target_text": "So I wanted to grow up and leave home.",
  "status": "released",
  "release_batch": null,
  "version": 447,
  "updated_at": "2026-08-02T20:37:50.856783+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "1ffec2cf-c51c-4f21-a436-7bdfd7352f18",
  "target1_audio_id": "bdfe232d-c0d4-41d3-aa55-a8aea4ec66b4",
  "target2_audio_id": "b5819284-b17d-4ca8-8f6a-40ed2c36617f",
  "decomposed_at": "2026-07-21T13:32:06.584+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "4e29eafc-3c07-42c2-ac6c-772de3d8273a",
  "course_code": "eng_for_mar",
  "seed_number": 589,
  "seed_id": "S0589",
  "known_text": "तिने मला सांगितलं की तिने आत्ताच शेवटची बस पाहिली.",
  "target_text": "She told me she'd just seen the last bus.",
  "status": "released",
  "release_batch": null,
  "version": 381,
  "updated_at": "2026-08-02T19:41:52.174833+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "89a5c26c-aa97-4c89-83ff-e31432334188",
  "target1_audio_id": "74767b19-a333-4c27-b555-9edabeff529c",
  "target2_audio_id": "26d67294-ff61-4f89-a1f2-6c2e71a769d2",
  "decomposed_at": "2026-07-21T13:31:09.011+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "935788f0-1b30-447b-9884-14ed07cd5096",
  "course_code": "eng_for_mar",
  "seed_number": 590,
  "seed_id": "S0590",
  "known_text": "मी शेवटची बस स्टेशनवरून निघताना पाहिली.",
  "target_text": "I saw the last bus leaving the station.",
  "status": "released",
  "release_batch": null,
  "version": 381,
  "updated_at": "2026-08-02T19:41:52.174833+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "f688b8c4-985a-4741-92a4-7963ca095853",
  "target1_audio_id": "42f41f99-da43-4845-92ce-f4634f7f9890",
  "target2_audio_id": "a1218102-5957-4693-992f-08ac48e23af2",
  "decomposed_at": "2026-07-21T13:31:11.084+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "63338edf-844e-453b-846a-f7c949133584",
  "course_code": "eng_for_mar",
  "seed_number": 591,
  "seed_id": "S0591",
  "known_text": "ती माझ्या मागे दुकानांपर्यंत आली.",
  "target_text": "She followed me down to the shops.",
  "status": "released",
  "release_batch": null,
  "version": 447,
  "updated_at": "2026-08-02T20:37:50.856783+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "7ca972c3-767f-42d1-9642-41d920d75191",
  "target1_audio_id": "555c004a-3fb1-44bf-a2ee-2f3083e12f5b",
  "target2_audio_id": "72bbe455-22c1-45e7-afbe-91d4ce18637c",
  "decomposed_at": "2026-07-21T13:31:12.441+00:00",
  "approved_at": "2026-07-30T23:21:04.608+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "2be316b5-218c-4153-bfac-b86d1323f997",
  "course_code": "eng_for_mar",
  "seed_number": 592,
  "seed_id": "S0592",
  "known_text": "आणि मुख्य रस्त्याने.",
  "target_text": "And along the main road.",
  "status": "released",
  "release_batch": null,
  "version": 446,
  "updated_at": "2026-08-02T20:37:44.649572+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "e14ad5c4-bb08-421b-be47-4f95a53b3b03",
  "target1_audio_id": "7971164c-dfc5-4742-8835-830160fe8764",
  "target2_audio_id": "d82e3c56-a759-42a9-895e-5072bffd5f24",
  "decomposed_at": "2026-07-21T13:32:07.94+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "12e0e9fb-fa04-4be4-9803-5dfa3c652d3e",
  "course_code": "eng_for_mar",
  "seed_number": 593,
  "seed_id": "S0593",
  "known_text": "मी कितीही वाद घातला तरी मला वाटून घ्यावंच लागलं.",
  "target_text": "However much I argued I still had to share.",
  "status": "released",
  "release_batch": null,
  "version": 381,
  "updated_at": "2026-08-02T19:41:52.174833+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "47ae8544-3ec7-4c31-850b-367e940562d8",
  "target1_audio_id": "0f9739c4-deca-495c-a7ed-cae44073dacb",
  "target2_audio_id": "6c47afd8-a5bd-4c18-be21-c2b94fec2f79",
  "decomposed_at": "2026-07-21T13:36:04.917+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "75477e7d-9b46-442a-a8c2-2455cdca34d7",
  "course_code": "eng_for_mar",
  "seed_number": 594,
  "seed_id": "S0594",
  "known_text": "मला माझी खेळणी माझ्या बहिणीबरोबर वाटून घ्यावी लागली.",
  "target_text": "I had to share my toys with my sister.",
  "status": "released",
  "release_batch": null,
  "version": 447,
  "updated_at": "2026-08-02T20:37:50.856783+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "acaa4d8a-58a9-4420-b035-163562be00f9",
  "target1_audio_id": "6e45f52e-b0c3-42f6-85d9-fc51711dd230",
  "target2_audio_id": "3cf07baf-ef2b-4ae4-92e1-1a69187284d3",
  "decomposed_at": "2026-07-21T13:36:06.552+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "1a248d26-2d43-41c7-96ae-0d30fdcfe2ec",
  "course_code": "eng_for_mar",
  "seed_number": 595,
  "seed_id": "S0595",
  "known_text": "मला बागेत आडवं व्हायची गरज आहे.",
  "target_text": "I need to lie down in the garden.",
  "status": "released",
  "release_batch": null,
  "version": 381,
  "updated_at": "2026-08-02T19:41:52.174833+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "6e0c2fde-2523-443f-bdd0-2ab3031e6139",
  "target1_audio_id": "b6cdd1f8-7d5b-4808-a0a8-8c74b436887a",
  "target2_audio_id": "4cae39ea-40b6-4548-bb14-135d05b5183e",
  "decomposed_at": "2026-07-21T13:35:05.877+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "77fb30dc-756f-4a20-a759-c9f07bda0d8c",
  "course_code": "eng_for_mar",
  "seed_number": 596,
  "seed_id": "S0596",
  "known_text": "आणि मला थोडा वेळ डोळे मिटायची गरज आहे.",
  "target_text": "And I need to close my eyes for a while.",
  "status": "released",
  "release_batch": null,
  "version": 446,
  "updated_at": "2026-08-02T20:37:44.649572+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "6e76be2b-28d1-4c72-8235-64e712ef99b4",
  "target1_audio_id": "1bba4b8c-126d-4651-b67a-60596c65fd62",
  "target2_audio_id": "79d97555-e257-4de0-a64d-cfabc7c28ca9",
  "decomposed_at": "2026-07-21T13:35:07.073+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "16a52664-b8f3-40fe-b24a-bb8c7584ffcc",
  "course_code": "eng_for_mar",
  "seed_number": 597,
  "seed_id": "S0597",
  "known_text": "मला शंका आहे की त्याने त्याबद्दल शंभर गोष्टी ऐकल्या असतील.",
  "target_text": "I suspect that he's heard a hundred stories about it.",
  "status": "released",
  "release_batch": null,
  "version": 381,
  "updated_at": "2026-08-02T19:41:52.174833+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
  "known_audio_id": "193c93e8-6d41-47f3-b4a1-dab7092ece26",
  "target1_audio_id": "b7688328-eb60-4675-a2a5-e941e400ae9f",
  "target2_audio_id": "6584108f-7b61-4384-932b-52468b66154d",
  "decomposed_at": "2026-07-21T13:36:08.139+00:00",
  "approved_at": "2026-07-30T19:01:37.943+00:00",
  "target_text_roman": null,
  "flagged_at": null
 },
 {
  "id": "f79676bd-450b-443e-91e8-25d80297cd05",
  "course_code": "eng_for_mar",
  "seed_number": 598,
  "seed_id": "S0598",
  "known_text": "ते काय करत होते याबद्दल त्याने हजार गोष्टी ऐकल्या आहेत.",
  "target_text": "He's heard a thousand stories about what they were doing.",
  "status": "released",
  "release_batch": null,
  "version": 447,
  "updated_at": "2026-08-02T20:37:50.856783+00:00",
  "created_at": "2026-06-30T11:13:59.259079+00:00",
