    },
    {
      "id": "isl_for_eng:pod-1:SC22-S003",
      "order": 223,
      "n": 3,
      "sentences": [
        "Takk, það er gott að vita.",
        "Ég þarf að læra fleiri orð, og ég þarf að æfa mig í að hlusta.",
        "Ég skil fólk ekki mjög vel þegar það talar ekki hægt."
      ],
      "ids": [
        "f3de1f8d-8980-442f-9308-0c2080d1a180",
        "36351da5-7a0e-431b-9b7c-b47b51146c3c",
