      "order": 222,
      "n": 3,
      "sentences": [
        "Auðvitað, ekkert mál.",
        "Þú virðist tala það mjög vel.",
        "Ég get skilið þig auðveldlega."
      ],
      "ids": [
        "d468d74b-2411-460e-b35c-036a45c9d294",
