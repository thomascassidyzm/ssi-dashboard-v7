    },
    {
      "id": "isl_for_eng:pod-1:SC22-S006",
      "order": 226,
      "n": 3,
      "sentences": [
        "Ég held að þú sért að gera þetta mjög vel.",
        "Ég er hrifinn.",
        "Ég held að þú sért tilbúinn að byrja að tala Íslensku við alla sem tala Íslensku."
      ],
      "ids": [
        "5c937e0c-aa31-4da8-b20d-04b7283152ae",
        "195212ca-ea13-4fa3-a3b4-086edbfbb05f",
