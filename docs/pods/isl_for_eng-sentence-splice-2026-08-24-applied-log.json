    },
    {
      "id": "isl_for_eng:pod-1:SC22-S005",
      "order": 225,
      "n": 4,
      "sentences": [
        "Já, takk.",
        "Það er auðveldara að tala við bara einn mann.",
        "Það er smá erfitt að hugsa um eitthvað að segja, þó.",
        "Ég er ekki viss um hvað ég á að segja, en mér líður eins og ég geti talað nógu vel til að byrja að eiga samræður."
      ],
      "ids": [
        "64c6b322-dd79-4af2-82dc-e787dc94cfd6",
        "35e474ad-5e7f-44b7-95a9-696e7b924333",
        "0ba82d35-b670-4a9e-9207-dee230c2ae9f",
        "00aafbba-c0d4-4f1f-bd17-f0e2303ed268"
      ],
      "margin": null,
