    },
    {
      "id": "isl_for_eng:pod-1:SC22-S007",
      "order": 227,
      "n": 2,
      "sentences": [
        "Það er bara svolítið pirrandi þegar ég get ekki hugsað nógu hratt til að tjá mig almennilega.",
        "En ég veit að ég þarf að halda áfram að æfa mig ef ég vil tala með meiri sjálfstrausti."
      ],
      "ids": [
        "b1873504-c8ef-4e14-b2a0-6f4ae9ebbe1c",
