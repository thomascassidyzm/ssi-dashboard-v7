 "ops": [
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC02-S003",
   "global_order": 7,
   "english": "How far is it into town?",
   "target_text": "到城里有多远？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC02-S004",
   "global_order": 8,
   "english": "Can you tell me how far it is into town?",
   "target_text": "你能告诉我到城里有多远吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC02-S005",
   "global_order": 9,
   "english": "It's not very far. Maybe three or four miles.",
   "target_text": "不太远。大概三四英里吧。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC03-S003",
   "global_order": 12,
   "english": "Do you have any food?",
   "target_text": "你们有吃的吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC03-S004",
   "global_order": 13,
   "english": "Do you have any snacks?",
   "target_text": "你们有零食吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC03-S005",
   "global_order": 14,
   "english": "Do you have crisps, or nuts, or anything?",
   "target_text": "你们有薯片、坚果什么的吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC03-S006",
   "global_order": 15,
   "english": "No, we've only got drinks.",
   "target_text": "没有，我们只有饮料。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC03-S007",
   "global_order": 16,
   "english": "Yes, would you like the menu?",
   "target_text": "有的，你需要看菜单吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC03-S008",
   "global_order": 17,
   "english": "Yes, please.",
   "target_text": "好的，谢谢。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC03-S009",
   "global_order": 18,
   "english": "Here's your coffee.",
   "target_text": "这是你的咖啡。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC05-S001",
   "global_order": 23,
   "english": "Good evening, Sarah. Did you have a long day?",
   "target_text": "晚上好，莎拉。你今天忙了一整天吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC07-S002",
   "global_order": 39,
   "english": "I'd like a black coffee, please.",
   "target_text": "我想要一杯黑咖啡，谢谢。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC07-S007",
   "global_order": 44,
   "english": "Could I have two white coffees and two black coffees and one of those, please?",
   "target_text": "我可以要两杯牛奶咖啡、两杯黑咖啡，还有一个那个吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC07-S009",
   "global_order": 46,
   "english": "Yes, can I have a glass of water as well, please.",
   "target_text": "好的，我还可以要一杯水吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC07-S010",
   "global_order": 47,
   "english": "That's eight pound forty altogether.",
   "target_text": "一共是八英镑四十便士。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC08-S002",
   "global_order": 54,
   "english": "I'd like a pint, please. What ales do you have on?",
   "target_text": "我想要一品脱，谢谢。你们有什么啤酒？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC11-S001",
   "global_order": 97,
   "english": "Good afternoon. I have a booking under the name Jones.",
   "target_text": "下午好。我用琼斯这个名字订了房。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC11-S002",
   "global_order": 98,
   "english": "Welcome. Yes, you have a double room for three nights. Could I see some ID, please?",
   "target_text": "欢迎。是的，你订了一间双人房，住三晚。我可以看一下你的证件吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC12-S010",
   "global_order": 119,
   "english": "19. 20. 21. Wednesday. Thursday.",
   "target_text": "19。20。21。星期三。星期四。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC14-S001",
   "global_order": 131,
   "english": "Hello. Can you take me to the train station, please?",
   "target_text": "你好。你能送我去火车站吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC14-S002",
   "global_order": 132,
   "english": "Yes, of course. It may take some time, there's a lot of traffic at the moment.",
   "target_text": "好的，当然可以。可能要花一点时间，现在路上很堵。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC14-S007",
   "global_order": 137,
   "english": "Here we are. That's twelve pound fifty.",
   "target_text": "到了。一共是十二英镑五十便士。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC15-S001",
   "global_order": 141,
   "english": "How much is that?",
   "target_text": "那个多少钱？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC15-S002",
   "global_order": 142,
   "english": "Can you tell me how much that is?",
   "target_text": "你能告诉我那个多少钱吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC15-S003",
   "global_order": 143,
   "english": "How much does it cost to get a taxi into town?",
   "target_text": "打车到城里要多少钱？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC15-S004",
   "global_order": 144,
   "english": "How much does it cost to get a bus into town?",
   "target_text": "坐公交车到城里要多少钱？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC15-S005",
   "global_order": 145,
   "english": "Where can we get a bus?",
   "target_text": "我们在哪里可以坐公交车？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC15-S006",
   "global_order": 146,
   "english": "Where can we get a taxi?",
   "target_text": "我们在哪里可以打车？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC15-S007",
   "global_order": 147,
   "english": "Four single tickets to town, please.",
   "target_text": "请给我四张去城里的单程票。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC15-S008",
   "global_order": 148,
   "english": "Two return tickets to town, please.",
   "target_text": "请给我两张去城里的往返票。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC15-S009",
   "global_order": 149,
   "english": "I prefer to try to speak your language, I think it's polite.",
   "target_text": "我更愿意试着说你的语言，我觉得这样比较礼貌。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC15-S010",
   "global_order": 150,
   "english": "I'm sorry I can't speak very quickly.",
   "target_text": "对不起，我说得不是很快。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC16-S001",
   "global_order": 152,
   "english": "But if you can speak slowly I think we'll be able to manage.",
   "target_text": "但如果你说得慢一点，我想我们应该能沟通。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC16-S002",
   "global_order": 153,
   "english": "You spoke a little too quickly, so I'm not sure if I understood.",
   "target_text": "你刚才说得有点太快了，所以我不确定我听懂了没有。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC16-S003",
   "global_order": 154,
   "english": "Can we try again?",
   "target_text": "我们能再试一次吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC16-S004",
   "global_order": 155,
   "english": "Can we see the menu?",
   "target_text": "我们能看一下菜单吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC16-S005",
   "global_order": 156,
   "english": "Can we see the dessert menu also?",
   "target_text": "我们也能看一下甜点菜单吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC16-S006",
   "global_order": 157,
   "english": "Do you have anything to eat?",
   "target_text": "你们有什么吃的吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC16-S007",
   "global_order": 158,
   "english": "Can we pay?",
   "target_text": "我们可以付款吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC16-S008",
   "global_order": 159,
   "english": "Can we pay by card?",
   "target_text": "我们可以刷卡付款吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC16-S009",
   "global_order": 160,
   "english": "No, we only take cash.",
   "target_text": "不行，我们只收现金。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC16-S010",
   "global_order": 161,
   "english": "I'm sorry, I don't have any cash.",
   "target_text": "对不起，我没有现金。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC16-S011",
   "global_order": 162,
   "english": "A million. 80. 90. 2 o'clock. 10 o'clock.",
   "target_text": "一百万。80。90。两点。十点。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC17-S001",
   "global_order": 163,
   "english": "Is there a cash machine near here?",
   "target_text": "这附近有取款机吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC17-S002",
   "global_order": 164,
   "english": "Do you want to pay by cash or card or put it on the room?",
   "target_text": "你想付现金、刷卡，还是记在房费里？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC17-S003",
   "global_order": 165,
   "english": "Can we put it on the room, please?",
   "target_text": "我们可以记在房费里吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC17-S004",
   "global_order": 166,
   "english": "Would you like to pay by cash or card or on the room?",
   "target_text": "你想付现金、刷卡，还是记在房费里？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC17-S005",
   "global_order": 167,
   "english": "Did you want to pay by cash or card?",
   "target_text": "你之前想付现金还是刷卡？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC17-S006",
   "global_order": 168,
   "english": "We'll pay by card again, please.",
   "target_text": "我们还是刷卡付款吧，谢谢。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC17-S007",
   "global_order": 169,
   "english": "It's hot today, again.",
   "target_text": "今天又很热。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC17-S008",
   "global_order": 170,
   "english": "Is the water warm?",
   "target_text": "水是温的吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC17-S009",
   "global_order": 171,
   "english": "No, it's a little cold today.",
   "target_text": "不是，今天有点冷。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC17-S010",
   "global_order": 172,
   "english": "It's not bad.",
   "target_text": "还不错。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC17-S011",
   "global_order": 173,
   "english": "3 o'clock. 9 o'clock. January. February.",
   "target_text": "三点。九点。一月。二月。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC18-S001",
   "global_order": 174,
   "english": "That's a bad idea.",
   "target_text": "这是个坏主意。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC18-S002",
   "global_order": 175,
   "english": "Do you have any orange juice?",
   "target_text": "你们有橙汁吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC18-S003",
   "global_order": 176,
   "english": "Do you have any apple juice?",
   "target_text": "你们有苹果汁吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC18-S004",
   "global_order": 177,
   "english": "Does the boat leave from here?",
   "target_text": "船是从这里出发的吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC18-S005",
   "global_order": 178,
   "english": "Does the bus leave from here?",
   "target_text": "公交车是从这里出发的吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC18-S006",
   "global_order": 179,
   "english": "Where does the bus leave from?",
   "target_text": "公交车从哪里出发？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC18-S007",
   "global_order": 180,
   "english": "Is that correct? Am I correct?",
   "target_text": "那是对的吗？我说得对吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC18-S008",
   "global_order": 181,
   "english": "Am I wrong about that?",
   "target_text": "我这样说错了吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC18-S009",
   "global_order": 182,
   "english": "I'm sorry, my son lost his ticket.",
   "target_text": "对不起，我儿子把票弄丢了。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC18-S010",
   "global_order": 183,
   "english": "We have paid, but my daughter has lost her ticket.",
   "target_text": "我们已经付过钱了，但我女儿把票弄丢了。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC18-S011",
   "global_order": 184,
   "english": "4 o'clock. 8 o'clock. March. April.",
   "target_text": "四点。八点。三月。四月。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC19-S001",
   "global_order": 185,
   "english": "That makes me happy.",
   "target_text": "这让我很开心。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC19-S002",
   "global_order": 186,
   "english": "That makes me feel a little worried.",
   "target_text": "这让我有点担心。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC19-S003",
   "global_order": 187,
   "english": "When you talk quickly, it makes me feel stupid.",
   "target_text": "你说话快的时候，会让我觉得自己很笨。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC19-S004",
   "global_order": 188,
   "english": "Is it okay if I sit here?",
   "target_text": "我可以坐这里吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC19-S005",
   "global_order": 189,
   "english": "Is it okay if we put this here?",
   "target_text": "我们可以把这个放在这里吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC19-S006",
   "global_order": 190,
   "english": "I don't want to be late.",
   "target_text": "我不想迟到。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC19-S007",
   "global_order": 191,
   "english": "Are we going to be late?",
   "target_text": "我们会迟到吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC19-S008",
   "global_order": 192,
   "english": "I promise I won't be late.",
   "target_text": "我保证我不会迟到。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC19-S009",
   "global_order": 193,
   "english": "I promise we won't be late.",
   "target_text": "我保证我们不会迟到。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC19-S010",
   "global_order": 194,
   "english": "I'd like two scoops of ice-cream, please.",
   "target_text": "我想要两球冰淇淋，谢谢。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC19-S011",
   "global_order": 195,
   "english": "5 o'clock. 7 o'clock. May. June.",
   "target_text": "五点。七点。五月。六月。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC20-S001",
   "global_order": 196,
   "english": "Can I have one scoop of chocolate and one of strawberry?",
   "target_text": "我可以要一球巧克力味和一球草莓味的吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC20-S002",
   "global_order": 197,
   "english": "And then another cone with one scoop of lemon and one of blueberry.",
   "target_text": "然后再要一个蛋筒，一球柠檬味和一球蓝莓味的。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC20-S003",
   "global_order": 198,
   "english": "Do you have any ice-cream?",
   "target_text": "你们有冰淇淋吗？",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC20-S004",
   "global_order": 199,
   "english": "Thank you for all your work.",
   "target_text": "谢谢你做的这一切。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC20-S005",
   "global_order": 200,
   "english": "I wish you good luck with everything.",
   "target_text": "祝你一切顺利。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC20-S006",
   "global_order": 201,
   "english": "Thank you for helping me.",
   "target_text": "谢谢你帮助我。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC20-S007",
   "global_order": 202,
   "english": "Good luck with that!",
   "target_text": "祝你好运！",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC20-S008",
   "global_order": 203,
   "english": "That's very kind of you.",
   "target_text": "你真是太好了。",
   "note": null
  },
  {
   "id": "zho_for_eng:pod-0-unrecorded:SC20-S009",
   "global_order": 204,
   "english": "You're very kind.",
   "target_text": "你人真好。",
   "note": null
  },
