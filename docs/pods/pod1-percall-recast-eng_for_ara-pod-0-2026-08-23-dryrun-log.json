  "nonExchangePairsDropped": [
    {
      "tag": "7:6->7:7",
      "a": "Cafe Customer 1",
      "b": "Cafe Customer 2",
      "aText": "أريد أخذها معي من فضلك.",
      "bText": "هل يمكنني الحصول على قهوتين بالحليب وقهوتين سوداوين وواحدة من تلك، من فضلك؟"
    },
    {
      "tag": "8:4->8:5",
      "a": "Bar Customer 1",
      "b": "Bar Customer 2",
      "aText": "أريد كوبًا كبيرًا من البيرة المُرّة من فضلك.",
      "bText": "هل يمكنني الحصول على نصف كوب من عصير التفاح المخمّر؟"
    },
    {
      "tag": "8:5->8:6",
      "a": "Bar Customer 2",
      "b": "Bar Customer 3",
      "aText": "هل يمكنني الحصول على نصف كوب من عصير التفاح المخمّر؟",
      "bText": "هل يمكنني رؤية قائمة النبيذ؟ أريد كأسًا من النبيذ."
    },
    {
      "tag": "8:8->8:9",
      "a": "Bar Customer 3",
      "b": "Bar Customer 1",
      "aText": "أريد كأسًا كبيرة من النبيذ الأبيض من فضلك.",
      "bText": "هل يمكنني الحصول على كأس صغيرة من النبيذ الأحمر؟"
    },
    {
      "tag": "8:9->8:10",
      "a": "Bar Customer 1",
      "b": "Bar Customer 2",
      "aText": "هل يمكنني الحصول على كأس صغيرة من النبيذ الأحمر؟",
      "bText": "أريد كأسين إضافيتين من البيرة."
    },
    {
      "tag": "8:14->8:15",
      "a": "Bar Customer 1",
      "b": "Bar Customer 2",
      "aText": "هل يمكننا الحصول على بعض الخبز؟ وطبق من البطاطس المقلية للطاولة.",
      "bText": "هل لديكم أي شطائر؟ أريد شطيرة جبن من فضلك."
    },
    {
      "tag": "9:4->9:5",
      "a": "Diner 2",
      "b": "Diner 1",
      "aText": "نريد زجاجة ماء فوّار وزجاجة ماء عادي من فضلك.",
      "bText": "عذرًا — هل لديكم أي شيء خالٍ من الغلوتين؟ أو للنباتيين؟"
    },
    {
      "tag": "9:9->9:10",
      "a": "Diner 1",
      "b": "Diner 2",
      "aText": "سآخذ لحم الخروف من فضلك. مع طبق جانبي من الخضار.",
      "bText": "والريزوتو لي. مع سلطة خضراء صغيرة في البداية."
    },
    {
      "tag": "9:12->9:13",
      "a": "Diner 1",
      "b": "Diner 2",
      "aText": "هل يمكننا رؤية قائمة النبيذ؟",
      "bText": "زجاجة من النبيذ الأحمر للبيت ستكون رائعة."
    },
    {
      "tag": "9:16->9:17",
      "a": "Diner 1",
      "b": "Diner 2",
      "aText": "قهوتان فقط من فضلك. قهوة منزوعة الكافيين لي.",
      "bText": "والفاتورة، عندما تكون جاهزًا. هل يمكننا تقسيمها؟"
    }
  ],
