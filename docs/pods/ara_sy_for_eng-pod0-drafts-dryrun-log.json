 },
 "ops": [
  {
   "id": "ara_sy_for_eng:pod-0:SC02-S002",
   "global_order": 6,
   "english": "No, it's free. Please, go ahead.",
   "target_text": "لا، فاضي. تفضل.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC02-S003",
   "global_order": 7,
   "english": "How far is it into town?",
   "target_text": "قديش بعيدة المدينة من هون؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC02-S004",
   "global_order": 8,
   "english": "Can you tell me how far it is into town?",
   "target_text": "فيك تقلي قديش بعيدة المدينة من هون؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC02-S005",
   "global_order": 9,
   "english": "It's not very far. Maybe three or four miles.",
   "target_text": "مو بعيدة كتير. يمكن تلات أو أربع أميال.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC03-S003",
   "global_order": 12,
   "english": "Do you have any food?",
   "target_text": "عندكن أكل؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC03-S004",
   "global_order": 13,
   "english": "Do you have any snacks?",
   "target_text": "عندكن شي سناكس؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC03-S005",
   "global_order": 14,
   "english": "Do you have crisps, or nuts, or anything?",
   "target_text": "عندكن تشيبس، أو مكسرات، أو شي هيك؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC03-S006",
   "global_order": 15,
   "english": "No, we've only got drinks.",
   "target_text": "لا، عندنا بس مشروبات.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC03-S007",
   "global_order": 16,
   "english": "Yes, would you like the menu?",
   "target_text": "إيه، بدك المينو؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC03-S008",
   "global_order": 17,
   "english": "Yes, please.",
   "target_text": "إيه، لو سمحت.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC03-S009",
   "global_order": 18,
   "english": "Here's your coffee.",
   "target_text": "تفضل قهوتك.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC07-S010",
   "global_order": 47,
   "english": "That's eight pound forty altogether.",
   "target_text": "المجموع تمن جنيه وأربعين.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC12-S010",
   "global_order": 119,
   "english": "19. 20. 21. Wednesday. Thursday.",
   "target_text": "19. 20. 21. الأربعاء. الخميس.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC14-S004",
   "global_order": 134,
   "english": "Perhaps about twenty minutes, if we're not unlucky with the traffic lights.",
   "target_text": "يمكن حوالي عشرين دقيقة، إلا إذا كان حظنا تعيس بالإشارات.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC14-S007",
   "global_order": 137,
   "english": "Here we are. That's twelve pound fifty.",
   "target_text": "توصلنا. الحساب اتنعش جنيه وخمسين.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC15-S001",
   "global_order": 141,
   "english": "How much is that?",
   "target_text": "قديش هاد؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC15-S002",
   "global_order": 142,
   "english": "Can you tell me how much that is?",
   "target_text": "فيك تقلي قديش هاد؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC15-S003",
   "global_order": 143,
   "english": "How much does it cost to get a taxi into town?",
   "target_text": "قديش بتكلف تكسي عالمدينة؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC15-S004",
   "global_order": 144,
   "english": "How much does it cost to get a bus into town?",
   "target_text": "قديش بتكلف الباص عالمدينة؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC15-S005",
   "global_order": 145,
   "english": "Where can we get a bus?",
   "target_text": "من وين فينا ناخد باص؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC15-S006",
   "global_order": 146,
   "english": "Where can we get a taxi?",
   "target_text": "من وين فينا ناخد تكسي؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC15-S007",
   "global_order": 147,
   "english": "Four single tickets to town, please.",
   "target_text": "أربع تذاكر رايح بس عالمدينة، لو سمحت.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC15-S008",
   "global_order": 148,
   "english": "Two return tickets to town, please.",
   "target_text": "تذكرتين رايح جاي عالمدينة، لو سمحت.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC15-S009",
   "global_order": 149,
   "english": "I prefer to try to speak your language, I think it's polite.",
   "target_text": "بفضل حاول احكي لغتك، برأيي هيك أحسن أدب.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC15-S010",
   "global_order": 150,
   "english": "I'm sorry I can't speak very quickly.",
   "target_text": "آسفة، ما فيني احكي كتير سريع.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC15-S011",
   "global_order": 151,
   "english": "100,000. 60. 70. 1 o'clock. 11 o'clock.",
   "target_text": "مية ألف. 60. 70. الساعة وحدة. الساعة إحدعش.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC16-S001",
   "global_order": 152,
   "english": "But if you can speak slowly I think we'll be able to manage.",
   "target_text": "بس إذا فيك تحكي شوي شوي، بظن رح نقدر نتفاهم.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC16-S002",
   "global_order": 153,
   "english": "You spoke a little too quickly, so I'm not sure if I understood.",
   "target_text": "حكيت شوي سريع، فما أنا متأكدة إذا فهمت.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC16-S003",
   "global_order": 154,
   "english": "Can we try again?",
   "target_text": "فينا نجرب مرة تانية؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC16-S004",
   "global_order": 155,
   "english": "Can we see the menu?",
   "target_text": "فينا نشوف المينو؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC16-S005",
   "global_order": 156,
   "english": "Can we see the dessert menu also?",
   "target_text": "فينا نشوف مينو الحلويات كمان؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC16-S006",
   "global_order": 157,
   "english": "Do you have anything to eat?",
   "target_text": "عندكن شي نأكله؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC16-S007",
   "global_order": 158,
   "english": "Can we pay?",
   "target_text": "فينا ندفع؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC16-S008",
   "global_order": 159,
   "english": "Can we pay by card?",
   "target_text": "فينا ندفع بالبطاقة؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC16-S009",
   "global_order": 160,
   "english": "No, we only take cash.",
   "target_text": "لا، منقبل بس كاش.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC16-S010",
   "global_order": 161,
   "english": "I'm sorry, I don't have any cash.",
   "target_text": "آسفة، ما معي كاش.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC16-S011",
   "global_order": 162,
   "english": "A million. 80. 90. 2 o'clock. 10 o'clock.",
   "target_text": "مليون. 80. 90. الساعة تنتين. الساعة عشرة.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC17-S001",
   "global_order": 163,
   "english": "Is there a cash machine near here?",
   "target_text": "في صراف آلي قريب من هون؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC17-S002",
   "global_order": 164,
   "english": "Do you want to pay by cash or card or put it on the room?",
   "target_text": "بدك تدفع كاش ولا بالبطاقة ولا تحطها عالغرفة؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC17-S003",
   "global_order": 165,
   "english": "Can we put it on the room, please?",
   "target_text": "فينا نحطها عالغرفة، لو سمحت؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC17-S004",
   "global_order": 166,
   "english": "Would you like to pay by cash or card or on the room?",
   "target_text": "بتحب تدفع كاش ولا بالبطاقة ولا عالغرفة؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC17-S005",
   "global_order": 167,
   "english": "Did you want to pay by cash or card?",
   "target_text": "كنت بدك تدفع كاش ولا بالبطاقة؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC17-S006",
   "global_order": 168,
   "english": "We'll pay by card again, please.",
   "target_text": "رح ندفع بالبطاقة كمان مرة، لو سمحت.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC17-S007",
   "global_order": 169,
   "english": "It's hot today, again.",
   "target_text": "الجو حر اليوم، كمان مرة.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC17-S008",
   "global_order": 170,
   "english": "Is the water warm?",
   "target_text": "المي دافية؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC17-S009",
   "global_order": 171,
   "english": "No, it's a little cold today.",
   "target_text": "لا، هي شوي بردة اليوم.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC17-S010",
   "global_order": 172,
   "english": "It's not bad.",
   "target_text": "مو سيئة.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC17-S011",
   "global_order": 173,
   "english": "3 o'clock. 9 o'clock. January. February.",
   "target_text": "الساعة تلاتة. الساعة تسعة. كانون الثاني. شباط.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC18-S001",
   "global_order": 174,
   "english": "That's a bad idea.",
   "target_text": "هاي فكرة مو منيحة.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC18-S002",
   "global_order": 175,
   "english": "Do you have any orange juice?",
   "target_text": "عندكن عصير برتقال؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC18-S003",
   "global_order": 176,
   "english": "Do you have any apple juice?",
   "target_text": "عندكن عصير تفاح؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC18-S004",
   "global_order": 177,
   "english": "Does the boat leave from here?",
   "target_text": "المركب بيطلع من هون؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC18-S005",
   "global_order": 178,
   "english": "Does the bus leave from here?",
   "target_text": "الباص بيطلع من هون؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC18-S006",
   "global_order": 179,
   "english": "Where does the bus leave from?",
   "target_text": "الباص بيطلع من وين؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC18-S007",
   "global_order": 180,
   "english": "Is that correct? Am I correct?",
   "target_text": "هاد صح؟ أنا محقة؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC18-S008",
   "global_order": 181,
   "english": "Am I wrong about that?",
   "target_text": "أنا غلطانة بهالموضوع؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC18-S009",
   "global_order": 182,
   "english": "I'm sorry, my son lost his ticket.",
   "target_text": "آسفة، ابني ضيع تذكرته.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC18-S010",
   "global_order": 183,
   "english": "We have paid, but my daughter has lost her ticket.",
   "target_text": "دفعنا، بس بنتي ضيعت تذكرتها.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC18-S011",
   "global_order": 184,
   "english": "4 o'clock. 8 o'clock. March. April.",
   "target_text": "الساعة أربعة. الساعة تمنية. آذار. نيسان.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC19-S001",
   "global_order": 185,
   "english": "That makes me happy.",
   "target_text": "هاد بيفرحني.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC19-S002",
   "global_order": 186,
   "english": "That makes me feel a little worried.",
   "target_text": "هاد بيخليني قلقانة شوي.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC19-S003",
   "global_order": 187,
   "english": "When you talk quickly, it makes me feel stupid.",
   "target_text": "لما تحكي سريع، بحس حالي غبية.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC19-S004",
   "global_order": 188,
   "english": "Is it okay if I sit here?",
   "target_text": "ماشي الحال إذا قعدت هون؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC19-S005",
   "global_order": 189,
   "english": "Is it okay if we put this here?",
   "target_text": "ماشي الحال إذا حطينا هاد هون؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC19-S006",
   "global_order": 190,
   "english": "I don't want to be late.",
   "target_text": "ما بدي تأخر.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC19-S007",
   "global_order": 191,
   "english": "Are we going to be late?",
   "target_text": "رح نتأخر؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC19-S008",
   "global_order": 192,
   "english": "I promise I won't be late.",
   "target_text": "بوعدك ما رح تأخر.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC19-S009",
   "global_order": 193,
   "english": "I promise we won't be late.",
   "target_text": "بوعدك ما رح نتأخر.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC19-S010",
   "global_order": 194,
   "english": "I'd like two scoops of ice-cream, please.",
   "target_text": "بدي مغرفتين بوظة، لو سمحت.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC19-S011",
   "global_order": 195,
   "english": "5 o'clock. 7 o'clock. May. June.",
   "target_text": "الساعة خمسة. الساعة سبعة. أيار. حزيران.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC20-S001",
   "global_order": 196,
   "english": "Can I have one scoop of chocolate and one of strawberry?",
   "target_text": "فيني آخد مغرفة شوكولا ومغرفة فريز؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC20-S002",
   "global_order": 197,
   "english": "And then another cone with one scoop of lemon and one of blueberry.",
   "target_text": "وبعدين كون تاني فيه مغرفة ليمون ومغرفة توت أزرق.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC20-S003",
   "global_order": 198,
   "english": "Do you have any ice-cream?",
   "target_text": "عندكن بوظة؟",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC20-S004",
   "global_order": 199,
   "english": "Thank you for all your work.",
   "target_text": "شكراً على كل تعبك.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC20-S005",
   "global_order": 200,
   "english": "I wish you good luck with everything.",
   "target_text": "بتمنى لك كل التوفيق بكل شي.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC20-S006",
   "global_order": 201,
   "english": "Thank you for helping me.",
   "target_text": "شكراً إنك ساعدتني.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC20-S007",
   "global_order": 202,
   "english": "Good luck with that!",
   "target_text": "بالتوفيق بهالشي!",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC20-S008",
   "global_order": 203,
   "english": "That's very kind of you.",
   "target_text": "هاد كتير لطيف منك.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC20-S009",
   "global_order": 204,
   "english": "You're very kind.",
   "target_text": "إنت كتير لطيف.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC20-S010",
   "global_order": 205,
   "english": "Thank you for being so friendly.",
   "target_text": "شكراً إنك كنت كتير ودود.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC20-S011",
   "global_order": 206,
   "english": "6 o'clock. July. August. September.",
   "target_text": "الساعة ستة. تموز. آب. أيلول.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC21-S001",
   "global_order": 207,
   "english": "It sounds as though we need to leave soon.",
   "target_text": "يبدو إنه لازم نطلع قريب.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC21-S002",
   "global_order": 208,
   "english": "It sounds as though you want us not to do that.",
   "target_text": "يبدو إنك ما بدك نعمل هيك.",
   "note": null
  },
  {
   "id": "ara_sy_for_eng:pod-0:SC21-S003",
   "global_order": 209,
   "english": "Is there a toilet here?",
   "target_text": "في حمام هون؟",
   "note": null
  },
  {
