      "course": "nld_for_eng",
      "text": "Dank u wel.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/3A493C74-3890-437F-808D-08EF379CBA77.mp3",
      "to_key": "mastered/98A5BBFA-8D88-43AB-B962-E4BD09E9A112.mp3",
      "to_duration_ms": 945,
      "to_size": 12140
    },
    {
      "id": "0b8af1f0-f4b6-4560-8960-a121b47638cd",
      "course": "kor_for_eng",
      "text": "카드로 계산해도 돼요?",
      "voice_id": "xai_bf9fe5b5f981",
      "from_key": "mastered/9DE651E7-EA91-44A7-990B-BE034FDAB25D.mp3",
      "to_key": "mastered/5ABD13F3-4348-4A71-9E80-6AB94C972D5B.mp3",
      "to_duration_ms": 1842,
      "to_size": 22796
    },
    {
      "id": "9e270de1-1038-46cb-8315-3ad818be426b",
      "course": "zho_for_eng",
      "text": "可以刷卡吗？",
      "voice_id": "xai_jpi39icg",
      "from_key": "mastered/E7CA0A5F-3B29-40C8-A443-F2ABADD9B42D.mp3",
      "to_key": "mastered/6DD5D69A-14A8-443C-B038-0109DC6CD5CD.mp3",
      "to_duration_ms": 1438,
      "to_size": 17900
    },
    {
      "id": "a394e763-96d0-490e-9ee8-cc1a43158649",
      "course": "nld_for_eng",
      "text": "Voor mij cafeïnevrij.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/31F5169C-07E2-4FD3-A5AF-D1537F1FB6DC.mp3",
      "to_key": "mastered/65CACD74-6F48-4274-9F2E-AB2A6A0EA034.mp3",
      "to_duration_ms": 1910,
      "to_size": 23660
    },
    {
      "id": "390503eb-3b51-4788-973e-ae501150fa4a",
      "course": "deu_at_for_eng",
      "text": "Kann i mit Karte zahlen?",
      "voice_id": "xai_e1fc5a89",
      "from_key": "mastered/325EA6DB-B852-45CA-B437-1E56F2021945.mp3",
      "to_key": "mastered/77F9371E-08DD-44D0-9DF6-E4F7C76F12E1.mp3",
      "to_duration_ms": 1740,
      "to_size": 21644
    },
    {
      "id": "406bb46b-69bb-4eeb-9728-5a56dc0bedfa",
      "course": "nld_for_eng",
      "text": "En heeft u ook pijnstillers voor kinderen?",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/2FA32706-3617-4B17-BEEB-345F12AA02BD.mp3",
      "to_key": "mastered/0AC0B3EA-0BB5-40A0-AAF9-CBE271713B91.mp3",
      "to_duration_ms": 2259,
      "to_size": 27980
    },
    {
      "id": "f99d1b72-5862-44e1-ac56-39952ebbc29a",
      "course": "nld_for_eng",
      "text": "Ja, natuurlijk.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/2976622E-2B2A-4941-8573-B02EAED30A87.mp3",
      "to_key": "mastered/57E3DCE5-9B55-46B7-BAF7-65E21D9F71AE.mp3",
      "to_duration_ms": 1537,
      "to_size": 19340
    },
    {
      "id": "9bcbc042-ff35-4353-8c4b-daac2e8cc447",
      "course": "nld_for_eng",
      "text": "Kan ik pinnen?",
      "voice_id": "xai_a13662ba951c",
      "from_key": "mastered/53972FFD-DDD6-4523-A505-8E11593FF53A.mp3",
      "to_key": "mastered/3B74C529-7F89-4197-A8BC-6BFDD070CAAD.mp3",
      "to_duration_ms": 1047,
      "to_size": 13292
    },
    {
      "id": "455153c1-e8a1-494d-b656-3340de52b029",
      "course": "nld_for_eng",
      "text": "Goedenavond.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/54842554-8C74-4D13-B1D3-1E0436C7EEFA.mp3",
      "to_key": "mastered/18E196D4-076A-41BE-B4C8-603F817BCE92.mp3",
      "to_duration_ms": 1579,
      "to_size": 19628
    },
    {
      "id": "a8565f40-506a-4b29-81d3-a67cfb5c0879",
      "course": "nld_for_eng",
      "text": "Met een bijgerecht van groenten.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/4C816884-9B32-4B30-9036-809E280154A1.mp3",
      "to_key": "mastered/BBDF78A0-BAF1-4C0D-AFA5-B3ACB94A1488.mp3",
      "to_duration_ms": 2076,
      "to_size": 25676
    },
    {
      "id": "f3ee2d23-74ff-42bb-8216-93fa9cabac89",
      "course": "deu_for_eng",
      "text": "Kann ich mit Karte bezahlen?",
      "voice_id": "xai_41321eb41295",
      "from_key": "mastered/AFF8F61F-8697-44F5-A85B-20CFBC6FDA2B.mp3",
      "to_key": "mastered/C17ECD30-A4FD-499A-8623-55DA89D8BE98.mp3",
      "to_duration_ms": 2200,
      "to_size": 27116
    },
    {
      "id": "e0522172-5a01-49b7-813a-b55ced914dbc",
      "course": "fra_for_eng",
      "text": "Je peux payer par carte ?",
      "voice_id": "xai_0p0rt7o1",
      "from_key": "mastered/FCE47EE0-91EC-4FDE-86B5-F2A1FDAFBDD9.mp3",
      "to_key": "mastered/080925E4-AAC2-4C22-9207-0EA5AA2E4B10.mp3",
      "to_duration_ms": 1717,
      "to_size": 21356
    },
    {
      "id": "392c255f-086e-40e4-aedd-9d832be42461",
      "course": "swe_for_eng",
      "text": "Det är väldigt snällt av dig!",
      "voice_id": "xai_3b312632",
      "from_key": "mastered/BB70CAC0-68FB-44EC-A3C7-9B1C23C6E732.mp3",
      "to_key": "mastered/6DCBA4D0-5C90-4DB9-80EA-CF3099AF5AEF.mp3",
      "to_duration_ms": 1931,
      "to_size": 23948
    },
    {
      "id": "135708dd-e0b9-4efe-ab8f-7b18c3f0a20e",
      "course": "swe_for_eng",
      "text": "Ja, tack.",
      "voice_id": "xai_3b312632",
      "from_key": "mastered/D762A1CD-401B-406E-8444-4F3AB4582270.mp3",
      "to_key": "mastered/2B592AB6-64F1-4BCA-9587-45D0D612193D.mp3",
      "to_duration_ms": 1403,
      "to_size": 17612
    },
    {
      "id": "ef5e559a-23ba-4f7b-b3a1-a106e404e2a5",
      "course": "nld_for_eng",
      "text": "Dank u wel.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/3A493C74-3890-437F-808D-08EF379CBA77.mp3",
      "to_key": "mastered/70CB0BD0-A681-46E3-BAC3-098E2CF19440.mp3",
      "to_duration_ms": 937,
      "to_size": 12140
    },
    {
      "id": "bed75600-910a-40a2-8953-70219677f6ea",
      "course": "nld_for_eng",
      "text": "Zou je het erg vinden als ik probeerde Nederlands met je te oefenen?",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/9FCF9C85-7D7B-4534-B7D3-6AD465520B26.mp3",
      "to_key": "mastered/8256C624-BEA5-44E8-85E2-C79A6D4F9FBD.mp3",
      "to_duration_ms": 3876,
      "to_size": 47276
    },
    {
      "id": "db6f24c8-b06c-419d-83a5-b0b22e7c3b37",
      "course": "nld_for_eng",
      "text": "Dank je, dat is goed om te weten.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/A833DB5C-26B0-4108-B12D-595C485AF755.mp3",
      "to_key": "mastered/AC2397E3-1181-4140-8DF6-92501997F5B5.mp3",
      "to_duration_ms": 2284,
      "to_size": 28268
    },
    {
      "id": "e6da799e-64d2-4eb3-a531-97e8db89e8ef",
      "course": "nld_for_eng",
      "text": "Ik moet meer woorden leren, en ik moet oefenen met luisteren.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/4D6F4F30-BD3F-4F47-AD4F-E75F653D181D.mp3",
      "to_key": "mastered/BFCBCD96-1759-4C6A-9BBB-4BF43838F09A.mp3",
      "to_duration_ms": 3951,
      "to_size": 48140
    },
    {
      "id": "2140fd94-a83a-4f51-997a-3b1108664b59",
      "course": "nld_for_eng",
      "text": "Het is alleen een beetje frustrerend als ik niet snel genoeg kan denken om mezelf goed uit te drukken.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/C06EDA07-8A13-42E3-8C52-A1E886591D4A.mp3",
      "to_key": "mastered/96CC2288-BB52-4529-B285-4CD91A41526E.mp3",
      "to_duration_ms": 5709,
      "to_size": 69164
    },
    {
      "id": "a2343902-aec8-4c16-ba05-be0c168ecb70",
      "course": "nld_for_eng",
      "text": "Ja, dank je.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/33C2FB5C-46B2-48EC-B923-198D25D628A4.mp3",
      "to_key": "mastered/31FE6BF2-5452-492E-8DF5-88EBADE4DD11.mp3",
      "to_duration_ms": 3970,
      "to_size": 48428
    },
    {
      "id": "a54386a0-7342-4d81-85c8-b8a6d2058882",
      "course": "nld_for_eng",
      "text": "Ik versta mensen niet goed als ze niet langzaam praten.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/234F34D9-9E9B-4E10-85ED-03DD083C384A.mp3",
      "to_key": "mastered/023B6DC8-80DE-4347-B404-552283CB5762.mp3",
      "to_duration_ms": 3613,
      "to_size": 44108
    },
    {
      "id": "555dbfcb-ee43-49f2-8bc1-d8f3bac82082",
      "course": "nld_for_eng",
      "text": "Maar ik weet dat ik moet blijven oefenen als ik zelfverzekerder wil spreken.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/37AA0AAE-17DD-4274-848A-04416ED0BC5A.mp3",
      "to_key": "mastered/8E3E4E56-B88F-4F0B-83AC-1354EB5A1DAE.mp3",
      "to_duration_ms": 4519,
      "to_size": 55052
    },
    {
      "id": "533f70fe-f9ef-4fba-8203-2329a1d7c3c3",
      "course": "nld_for_eng",
      "text": "Het is makkelijker om met maar één persoon te praten.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/B6464EBE-84A4-4BBC-9A89-1092657C8FDD.mp3",
      "to_key": "mastered/87EEF238-9982-461A-B196-633B8178EB78.mp3",
      "to_duration_ms": 4241,
      "to_size": 51596
    },
    {
      "id": "18bc6775-80ed-4fbd-81ce-0625880e712a",
      "course": "nld_for_eng",
      "text": "Het is een beetje moeilijk om aan iets te denken om te zeggen, eerlijk gezegd.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/46574FD1-4657-4F52-B598-E32800908951.mp3",
      "to_key": "mastered/1822525F-D177-4898-85FC-C49D1523523B.mp3",
      "to_duration_ms": 2155,
      "to_size": 26540
    },
    {
      "id": "dd4e9ffb-063b-4689-a93c-a2acdbe0c227",
      "course": "nld_for_eng",
      "text": "Ik weet niet goed wat ik moet zeggen, maar ik heb het gevoel dat ik genoeg kan spreken om gesprekken te beginnen.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/E7A1A811-ABEF-42BC-8DE2-937D2C4B89B6.mp3",
      "to_key": "mastered/F089366C-603F-4179-8902-91B54A422CB6.mp3",
      "to_duration_ms": 3662,
      "to_size": 44684
    },
    {
      "id": "29209253-13be-43fa-a1b4-25a196d6c42c",
      "course": "nld_for_eng",
      "text": "Dit is precies het soort oefening dat ik nodig heb.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/3950047C-0EF6-4CFE-AE1B-375DB277FC3D.mp3",
      "to_key": "mastered/62F444CA-DF54-4439-AB16-DF68D6842426.mp3",
      "to_duration_ms": 2805,
      "to_size": 34316
    },
    {
      "id": "68a2da48-c278-4d23-a621-ad390ca0c491",
      "course": "nld_for_eng",
      "text": "Ik denk dat ik kan voelen dat het mijn hersenen verandert terwijl we praten!",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/7D731418-F1FA-4D4F-A497-4F07A936D4DD.mp3",
      "to_key": "mastered/D98F2F82-C272-4D93-87AB-B7B47D02D844.mp3",
      "to_duration_ms": 4384,
      "to_size": 53324
    },
    {
      "id": "15af97a4-361b-4720-8fb4-4bde6aa65358",
      "course": "nld_for_eng",
      "text": "Ik waardeer je hulp echt heel erg.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/94E506B8-7F76-4E9E-ABE1-7B1E05963C46.mp3",
      "to_key": "mastered/B8DD935F-2FA9-48A9-976A-9E830D655BA6.mp3",
      "to_duration_ms": 2693,
      "to_size": 33164
    },
    {
      "id": "3fea3710-d265-49a4-818e-7321322b96d4",
      "course": "nld_for_eng",
      "text": "Maar het is verrassend hoe moe ik word als ik praat in een taal die ik niet zo goed spreek.",
      "voice_id": "xai_58d27475085e",
      "from_key": "mastered/5CC2F79D-F813-419C-9EEB-56FECBE1B2C6.mp3",
      "to_key": "mastered/0A2A3C62-2BC2-4D4C-AB44-43A2C3D665F4.mp3",
      "to_duration_ms": 4554,
      "to_size": 55340
    }
  ]
}