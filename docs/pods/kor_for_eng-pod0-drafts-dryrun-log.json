 },
 "ops": [
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC02-S003",
   "global_order": 7,
   "english": "How far is it into town?",
   "target_text": "시내까지 얼마나 멀어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC02-S004",
   "global_order": 8,
   "english": "Can you tell me how far it is into town?",
   "target_text": "시내까지 얼마나 먼지 말씀해 주시겠어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC02-S005",
   "global_order": 9,
   "english": "It's not very far. Maybe three or four miles.",
   "target_text": "그렇게 멀지 않아요. 아마 5-6킬로미터 정도요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC03-S003",
   "global_order": 12,
   "english": "Do you have any food?",
   "target_text": "음식 있어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC03-S004",
   "global_order": 13,
   "english": "Do you have any snacks?",
   "target_text": "간식 있어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC03-S005",
   "global_order": 14,
   "english": "Do you have crisps, or nuts, or anything?",
   "target_text": "과자나 견과류 같은 거 있어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC03-S006",
   "global_order": 15,
   "english": "No, we've only got drinks.",
   "target_text": "아니요, 음료만 있어요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC03-S007",
   "global_order": 16,
   "english": "Yes, would you like the menu?",
   "target_text": "네, 메뉴 보시겠어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC03-S008",
   "global_order": 17,
   "english": "Yes, please.",
   "target_text": "네, 부탁해요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC03-S009",
   "global_order": 18,
   "english": "Here's your coffee.",
   "target_text": "여기 커피 나왔어요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC05-S001",
   "global_order": 23,
   "english": "Good evening, Sarah. Did you have a long day?",
   "target_text": "안녕하세요, 사라 씨. 오늘 하루가 길었어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC05-S002",
   "global_order": 24,
   "english": "Yes, very. I'm very tired now. Good night. See you tomorrow.",
   "target_text": "네, 정말요. 지금 너무 피곤해요. 안녕히 주무세요. 내일 봐요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC06-S001",
   "global_order": 25,
   "english": "Excuse me. Hello. What's your name?",
   "target_text": "실례합니다. 안녕하세요. 이름이 어떻게 되세요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC06-S005",
   "global_order": 29,
   "english": "I'm from Manchester, but I live in London now. And you?",
   "target_text": "저는 맨체스터 출신인데, 지금은 런던에 살고 있어요. 당신은요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC07-S010",
   "global_order": 47,
   "english": "That's eight pound forty altogether.",
   "target_text": "다 해서 8파운드 40이에요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC08-S002",
   "global_order": 54,
   "english": "I'd like a pint, please. What ales do you have on?",
   "target_text": "파인트 한 잔 주세요. 어떤 에일 맥주가 있어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC11-S004",
   "global_order": 100,
   "english": "Lovely. The room is on the third floor, room 709.",
   "target_text": "좋아요. 방은 3층에 있고, 709호예요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC14-S001",
   "global_order": 131,
   "english": "Hello. Can you take me to the train station, please?",
   "target_text": "안녕하세요. 기차역까지 데려다 주시겠어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC14-S007",
   "global_order": 137,
   "english": "Here we are. That's twelve pound fifty.",
   "target_text": "다 왔어요. 12파운드 50이에요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC15-S001",
   "global_order": 141,
   "english": "How much is that?",
   "target_text": "그거 얼마예요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC15-S002",
   "global_order": 142,
   "english": "Can you tell me how much that is?",
   "target_text": "그게 얼마인지 말씀해 주시겠어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC15-S003",
   "global_order": 143,
   "english": "How much does it cost to get a taxi into town?",
   "target_text": "시내까지 택시 타면 얼마예요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC15-S004",
   "global_order": 144,
   "english": "How much does it cost to get a bus into town?",
   "target_text": "시내까지 버스 타면 얼마예요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC15-S005",
   "global_order": 145,
   "english": "Where can we get a bus?",
   "target_text": "버스는 어디서 탈 수 있어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC15-S006",
   "global_order": 146,
   "english": "Where can we get a taxi?",
   "target_text": "택시는 어디서 탈 수 있어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC15-S007",
   "global_order": 147,
   "english": "Four single tickets to town, please.",
   "target_text": "시내 가는 편도 표 네 장 주세요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC15-S008",
   "global_order": 148,
   "english": "Two return tickets to town, please.",
   "target_text": "시내 가는 왕복 표 두 장 주세요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC15-S009",
   "global_order": 149,
   "english": "I prefer to try to speak your language, I think it's polite.",
   "target_text": "저는 그 나라 언어로 말해보는 걸 더 좋아해요. 그게 예의라고 생각하거든요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC15-S010",
   "global_order": 150,
   "english": "I'm sorry I can't speak very quickly.",
   "target_text": "죄송하지만 저는 빨리 말을 잘 못해요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC16-S001",
   "global_order": 152,
   "english": "But if you can speak slowly I think we'll be able to manage.",
   "target_text": "하지만 천천히 말씀해 주시면 저희가 잘 해낼 수 있을 것 같아요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC16-S002",
   "global_order": 153,
   "english": "You spoke a little too quickly, so I'm not sure if I understood.",
   "target_text": "조금 너무 빨리 말씀하셔서, 제가 이해했는지 잘 모르겠어요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC16-S003",
   "global_order": 154,
   "english": "Can we try again?",
   "target_text": "다시 해볼 수 있을까요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC16-S004",
   "global_order": 155,
   "english": "Can we see the menu?",
   "target_text": "메뉴 좀 볼 수 있을까요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC16-S005",
   "global_order": 156,
   "english": "Can we see the dessert menu also?",
   "target_text": "디저트 메뉴도 볼 수 있을까요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC16-S006",
   "global_order": 157,
   "english": "Do you have anything to eat?",
   "target_text": "먹을 거 있어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC16-S007",
   "global_order": 158,
   "english": "Can we pay?",
   "target_text": "계산할 수 있을까요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC16-S008",
   "global_order": 159,
   "english": "Can we pay by card?",
   "target_text": "카드로 계산할 수 있을까요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC16-S009",
   "global_order": 160,
   "english": "No, we only take cash.",
   "target_text": "아니요, 현금만 받아요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC16-S010",
   "global_order": 161,
   "english": "I'm sorry, I don't have any cash.",
   "target_text": "죄송해요, 현금이 없어요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC16-S011",
   "global_order": 162,
   "english": "A million. 80. 90. 2 o'clock. 10 o'clock.",
   "target_text": "백만. 80. 90. 2시. 10시.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC17-S001",
   "global_order": 163,
   "english": "Is there a cash machine near here?",
   "target_text": "이 근처에 현금인출기가 있어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC17-S002",
   "global_order": 164,
   "english": "Do you want to pay by cash or card or put it on the room?",
   "target_text": "현금으로 계산하시겠어요, 카드로 하시겠어요, 아니면 방 앞으로 달아 놓을까요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC17-S003",
   "global_order": 165,
   "english": "Can we put it on the room, please?",
   "target_text": "방 앞으로 달아 놓을 수 있을까요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC17-S004",
   "global_order": 166,
   "english": "Would you like to pay by cash or card or on the room?",
   "target_text": "현금으로 하시겠어요, 카드로 하시겠어요, 아니면 방으로 달아 놓으시겠어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC17-S005",
   "global_order": 167,
   "english": "Did you want to pay by cash or card?",
   "target_text": "현금으로 하시려고 했어요, 아니면 카드로요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC17-S006",
   "global_order": 168,
   "english": "We'll pay by card again, please.",
   "target_text": "다시 카드로 계산할게요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC17-S007",
   "global_order": 169,
   "english": "It's hot today, again.",
   "target_text": "오늘도 또 더워요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC17-S008",
   "global_order": 170,
   "english": "Is the water warm?",
   "target_text": "물이 따뜻해요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC17-S009",
   "global_order": 171,
   "english": "No, it's a little cold today.",
   "target_text": "아니요, 오늘은 좀 추워요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC17-S010",
   "global_order": 172,
   "english": "It's not bad.",
   "target_text": "나쁘지 않아요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC17-S011",
   "global_order": 173,
   "english": "3 o'clock. 9 o'clock. January. February.",
   "target_text": "3시. 9시. 1월. 2월.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC18-S001",
   "global_order": 174,
   "english": "That's a bad idea.",
   "target_text": "그건 안 좋은 생각이에요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC18-S002",
   "global_order": 175,
   "english": "Do you have any orange juice?",
   "target_text": "오렌지 주스 있어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC18-S003",
   "global_order": 176,
   "english": "Do you have any apple juice?",
   "target_text": "사과 주스 있어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC18-S004",
   "global_order": 177,
   "english": "Does the boat leave from here?",
   "target_text": "배가 여기서 출발해요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC18-S005",
   "global_order": 178,
   "english": "Does the bus leave from here?",
   "target_text": "버스가 여기서 출발해요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC18-S006",
   "global_order": 179,
   "english": "Where does the bus leave from?",
   "target_text": "버스가 어디서 출발해요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC18-S007",
   "global_order": 180,
   "english": "Is that correct? Am I correct?",
   "target_text": "그게 맞아요? 제가 맞아요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC18-S008",
   "global_order": 181,
   "english": "Am I wrong about that?",
   "target_text": "제가 그거에 대해 틀렸어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC18-S009",
   "global_order": 182,
   "english": "I'm sorry, my son lost his ticket.",
   "target_text": "죄송해요, 제 아들이 표를 잃어버렸어요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC18-S010",
   "global_order": 183,
   "english": "We have paid, but my daughter has lost her ticket.",
   "target_text": "저희는 계산했는데, 제 딸이 표를 잃어버렸어요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC18-S011",
   "global_order": 184,
   "english": "4 o'clock. 8 o'clock. March. April.",
   "target_text": "4시. 8시. 3월. 4월.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC19-S001",
   "global_order": 185,
   "english": "That makes me happy.",
   "target_text": "그게 저를 행복하게 해요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC19-S002",
   "global_order": 186,
   "english": "That makes me feel a little worried.",
   "target_text": "그게 저를 조금 걱정되게 해요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC19-S003",
   "global_order": 187,
   "english": "When you talk quickly, it makes me feel stupid.",
   "target_text": "빨리 말씀하시면, 제가 바보 같다는 느낌이 들어요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC19-S004",
   "global_order": 188,
   "english": "Is it okay if I sit here?",
   "target_text": "여기 앉아도 될까요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC19-S005",
   "global_order": 189,
   "english": "Is it okay if we put this here?",
   "target_text": "이거 여기 놔도 될까요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC19-S006",
   "global_order": 190,
   "english": "I don't want to be late.",
   "target_text": "늦고 싶지 않아요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC19-S007",
   "global_order": 191,
   "english": "Are we going to be late?",
   "target_text": "우리 늦을 것 같아요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC19-S008",
   "global_order": 192,
   "english": "I promise I won't be late.",
   "target_text": "늦지 않겠다고 약속할게요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC19-S009",
   "global_order": 193,
   "english": "I promise we won't be late.",
   "target_text": "저희 늦지 않겠다고 약속할게요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC19-S010",
   "global_order": 194,
   "english": "I'd like two scoops of ice-cream, please.",
   "target_text": "아이스크림 두 스쿱 주세요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC19-S011",
   "global_order": 195,
   "english": "5 o'clock. 7 o'clock. May. June.",
   "target_text": "5시. 7시. 5월. 6월.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC20-S001",
   "global_order": 196,
   "english": "Can I have one scoop of chocolate and one of strawberry?",
   "target_text": "초콜릿 한 스쿱이랑 딸기 한 스쿱 주시겠어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC20-S002",
   "global_order": 197,
   "english": "And then another cone with one scoop of lemon and one of blueberry.",
   "target_text": "그리고 레몬 한 스쿱이랑 블루베리 한 스쿱으로 콘 하나 더 주세요.",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC20-S003",
   "global_order": 198,
   "english": "Do you have any ice-cream?",
   "target_text": "아이스크림 있어요?",
   "note": null
  },
  {
   "id": "kor_for_eng:pod-0-unrecorded:SC20-S004",
   "global_order": 199,
   "english": "Thank you for all your work.",
   "target_text": "열심히 해 주셔서 감사해요.",
   "note": null
  },
  {
