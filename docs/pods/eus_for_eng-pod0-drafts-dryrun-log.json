 },
 "ops": [
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC02-S002",
   "global_order": 6,
   "english": "No, it's free. Please, go ahead.",
   "target_text": "Ez, librea dago. Aurrera, mesedez.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC02-S003",
   "global_order": 7,
   "english": "How far is it into town?",
   "target_text": "Zenbat dago hiriraino?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC02-S004",
   "global_order": 8,
   "english": "Can you tell me how far it is into town?",
   "target_text": "Esan diezadakezu zenbat dagoen hiriraino?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC02-S005",
   "global_order": 9,
   "english": "It's not very far. Maybe three or four miles.",
   "target_text": "Ez dago oso urrun. Agian hiru edo lau milia.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC03-S001",
   "global_order": 10,
   "english": "Good afternoon. What can I get you?",
   "target_text": "Arratsalde on. Zer nahi duzu?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC03-S003",
   "global_order": 12,
   "english": "Do you have any food?",
   "target_text": "Baduzu janaririk?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC03-S004",
   "global_order": 13,
   "english": "Do you have any snacks?",
   "target_text": "Baduzu mokadurik?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC03-S005",
   "global_order": 14,
   "english": "Do you have crisps, or nuts, or anything?",
   "target_text": "Baduzu patata frijiturik, fruitu lehorrik, edo horrelako zerbait?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC03-S006",
   "global_order": 15,
   "english": "No, we've only got drinks.",
   "target_text": "Ez, edariak bakarrik ditugu.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC03-S007",
   "global_order": 16,
   "english": "Yes, would you like the menu?",
   "target_text": "Bai, menua nahi duzu?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC03-S008",
   "global_order": 17,
   "english": "Yes, please.",
   "target_text": "Bai, mesedez.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC03-S009",
   "global_order": 18,
   "english": "Here's your coffee.",
   "target_text": "Hemen duzu zure kafea.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC04-S003",
   "global_order": 22,
   "english": "No, I'm sorry, I'm busy tomorrow. But let's talk on Saturday. See you then.",
   "target_text": "Ez, barkatu, bihar lanpetuta nago. Baina hitz egin dezagun larunbatean. Orduan arte.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC06-S001",
   "global_order": 25,
   "english": "Excuse me. Hello. What's your name?",
   "target_text": "Barkatu. Kaixo. Nola duzu izena?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC06-S002",
   "global_order": 26,
   "english": "My name is Anna. And you?",
   "target_text": "Nire izena Anna da. Eta zuk?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC06-S004",
   "global_order": 28,
   "english": "Pleased to meet you too. Where are you from?",
   "target_text": "Ni ere pozten naiz zu ezagutzeaz. Nongoa zara?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC06-S012",
   "global_order": 36,
   "english": "How interesting. Well, lovely to meet you.",
   "target_text": "Bai interesgarria. Beno, pozten naiz zu ezagutzeaz.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC07-S001",
   "global_order": 38,
   "english": "Good morning. What can I get you?",
   "target_text": "Egun on. Zer nahi duzu?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC07-S010",
   "global_order": 47,
   "english": "That's eight pound forty altogether.",
   "target_text": "Guztira, zortzi libra eta berrogei zentimo dira.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC08-S001",
   "global_order": 53,
   "english": "Good evening. What can I get you?",
   "target_text": "Gabon. Zer nahi duzu?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC08-S002",
   "global_order": 54,
   "english": "I'd like a pint, please. What ales do you have on?",
   "target_text": "Pinta bat nahi dut, mesedez. Zer garagardo mota dituzue barrilean?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC08-S004",
   "global_order": 56,
   "english": "I'd like a pint of the bitter, please.",
   "target_text": "Garagardo garratzaren pinta bat nahi dut, mesedez.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC09-S001",
   "global_order": 69,
   "english": "Good evening. We have a booking for two, under the name Davies.",
   "target_text": "Gabon. Bi lagunentzako erreserba dugu, Davies izenean.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC11-S003",
   "global_order": 99,
   "english": "Of course. Here's my passport.",
   "target_text": "Noski. Hemen dut nire pasaportea.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC11-S012",
   "global_order": 108,
   "english": "It's on the welcome card in your room. Have a lovely stay.",
   "target_text": "Zure gelako ongietorri-txartelean dago. Egonaldi ona izan.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC12-S002",
   "global_order": 111,
   "english": "Of course. What are your symptoms?",
   "target_text": "Noski. Zer sintoma dituzu?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC12-S010",
   "global_order": 119,
   "english": "19. 20. 21. Wednesday. Thursday.",
   "target_text": "19. 20. 21. Asteazkena. Osteguna.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC14-S001",
   "global_order": 131,
   "english": "Hello. Can you take me to the train station, please?",
   "target_text": "Kaixo. Tren geltokira eraman nazakezu, mesedez?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC14-S007",
   "global_order": 137,
   "english": "Here we are. That's twelve pound fifty.",
   "target_text": "Hemen gaude. Hamabi libra eta berrogeita hamar zentimo dira.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC14-S010",
   "global_order": 140,
   "english": "100. 200. 1000. Sunday. 12 o'clock.",
   "target_text": "100. 200. 1000. Igandea. Hamabiak.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC15-S001",
   "global_order": 141,
   "english": "How much is that?",
   "target_text": "Zenbat da hori?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC15-S002",
   "global_order": 142,
   "english": "Can you tell me how much that is?",
   "target_text": "Esan diezadakezu zenbat den hori?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC15-S003",
   "global_order": 143,
   "english": "How much does it cost to get a taxi into town?",
   "target_text": "Zenbat balio du taxi batek hirira joateko?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC15-S004",
   "global_order": 144,
   "english": "How much does it cost to get a bus into town?",
   "target_text": "Zenbat balio du autobus batek hirira joateko?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC15-S005",
   "global_order": 145,
   "english": "Where can we get a bus?",
   "target_text": "Non har dezakegu autobusa?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC15-S006",
   "global_order": 146,
   "english": "Where can we get a taxi?",
   "target_text": "Non har dezakegu taxia?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC15-S007",
   "global_order": 147,
   "english": "Four single tickets to town, please.",
   "target_text": "Lau txartel joanekoa hirira, mesedez.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC15-S008",
   "global_order": 148,
   "english": "Two return tickets to town, please.",
   "target_text": "Bi txartel joan-etorrikoa hirira, mesedez.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC15-S009",
   "global_order": 149,
   "english": "I prefer to try to speak your language, I think it's polite.",
   "target_text": "Nahiago dut zure hizkuntza hitz egiten saiatu, uste dut edukazkoa dela.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC15-S010",
   "global_order": 150,
   "english": "I'm sorry I can't speak very quickly.",
   "target_text": "Sentitzen dut ezin dudala oso azkar hitz egin.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC15-S011",
   "global_order": 151,
   "english": "100,000. 60. 70. 1 o'clock. 11 o'clock.",
   "target_text": "100.000. 60. 70. Ordubata. Hamaikak.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC16-S001",
   "global_order": 152,
   "english": "But if you can speak slowly I think we'll be able to manage.",
   "target_text": "Baina poliki hitz egiten badezu, uste dut moldatuko garela.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC16-S002",
   "global_order": 153,
   "english": "You spoke a little too quickly, so I'm not sure if I understood.",
   "target_text": "Pixka bat azkarregi hitz egin duzu, beraz ez nago ziur ulertu dudan.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC16-S003",
   "global_order": 154,
   "english": "Can we try again?",
   "target_text": "Saia gaitezke berriro?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC16-S004",
   "global_order": 155,
   "english": "Can we see the menu?",
   "target_text": "Ikus dezakegu menua?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC16-S005",
   "global_order": 156,
   "english": "Can we see the dessert menu also?",
   "target_text": "Ikus dezakegu postre-menua ere?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC16-S006",
   "global_order": 157,
   "english": "Do you have anything to eat?",
   "target_text": "Baduzu zerbait jateko?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC16-S007",
   "global_order": 158,
   "english": "Can we pay?",
   "target_text": "Ordain dezakegu?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC16-S008",
   "global_order": 159,
   "english": "Can we pay by card?",
   "target_text": "Txartelarekin ordain dezakegu?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC16-S009",
   "global_order": 160,
   "english": "No, we only take cash.",
   "target_text": "Ez, eskudirua bakarrik onartzen dugu.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC16-S010",
   "global_order": 161,
   "english": "I'm sorry, I don't have any cash.",
   "target_text": "Sentitzen dut, ez dut eskudirurik.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC16-S011",
   "global_order": 162,
   "english": "A million. 80. 90. 2 o'clock. 10 o'clock.",
   "target_text": "Milioi bat. 80. 90. Ordubiak. Hamarrak.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC17-S001",
   "global_order": 163,
   "english": "Is there a cash machine near here?",
   "target_text": "Kutxazain automatikorik badago hemen inguruan?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC17-S002",
   "global_order": 164,
   "english": "Do you want to pay by cash or card or put it on the room?",
   "target_text": "Eskudiruz, txartelez, edo gelan kobratuta ordaindu nahi duzu?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC17-S003",
   "global_order": 165,
   "english": "Can we put it on the room, please?",
   "target_text": "Gelan kobra dezakezue, mesedez?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC17-S004",
   "global_order": 166,
   "english": "Would you like to pay by cash or card or on the room?",
   "target_text": "Eskudiruz, txartelez, edo gelan ordaindu nahi zenuke?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC17-S005",
   "global_order": 167,
   "english": "Did you want to pay by cash or card?",
   "target_text": "Eskudiruz edo txartelez ordaindu nahi zenuen?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC17-S006",
   "global_order": 168,
   "english": "We'll pay by card again, please.",
   "target_text": "Txartelez ordainduko dugu berriro, mesedez.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC17-S007",
   "global_order": 169,
   "english": "It's hot today, again.",
   "target_text": "Bero dago gaur, berriro ere.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC17-S008",
   "global_order": 170,
   "english": "Is the water warm?",
   "target_text": "Ura epela dago?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC17-S009",
   "global_order": 171,
   "english": "No, it's a little cold today.",
   "target_text": "Ez, hotz samar dago gaur.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC17-S010",
   "global_order": 172,
   "english": "It's not bad.",
   "target_text": "Ez dago gaizki.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC17-S011",
   "global_order": 173,
   "english": "3 o'clock. 9 o'clock. January. February.",
   "target_text": "Hiruak. Bederatziak. Urtarrila. Otsaila.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC18-S001",
   "global_order": 174,
   "english": "That's a bad idea.",
   "target_text": "Ideia txarra da hori.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC18-S002",
   "global_order": 175,
   "english": "Do you have any orange juice?",
   "target_text": "Baduzu laranja zukurik?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC18-S003",
   "global_order": 176,
   "english": "Do you have any apple juice?",
   "target_text": "Baduzu sagar zukurik?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC18-S004",
   "global_order": 177,
   "english": "Does the boat leave from here?",
   "target_text": "Ontzia hemendik ateratzen da?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC18-S005",
   "global_order": 178,
   "english": "Does the bus leave from here?",
   "target_text": "Autobusa hemendik ateratzen da?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC18-S006",
   "global_order": 179,
   "english": "Where does the bus leave from?",
   "target_text": "Nondik ateratzen da autobusa?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC18-S007",
   "global_order": 180,
   "english": "Is that correct? Am I correct?",
   "target_text": "Hori zuzena da? Ondo nago?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC18-S008",
   "global_order": 181,
   "english": "Am I wrong about that?",
   "target_text": "Oker nago horretan?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC18-S009",
   "global_order": 182,
   "english": "I'm sorry, my son lost his ticket.",
   "target_text": "Sentitzen dut, nire semeak bere txartela galdu du.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC18-S010",
   "global_order": 183,
   "english": "We have paid, but my daughter has lost her ticket.",
   "target_text": "Ordaindu dugu, baina nire alabak bere txartela galdu du.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC18-S011",
   "global_order": 184,
   "english": "4 o'clock. 8 o'clock. March. April.",
   "target_text": "Laurak. Zortziak. Martxoa. Apirila.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC19-S001",
   "global_order": 185,
   "english": "That makes me happy.",
   "target_text": "Horrek pozten nau.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC19-S002",
   "global_order": 186,
   "english": "That makes me feel a little worried.",
   "target_text": "Horrek pixka bat kezkatzen nau.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC19-S003",
   "global_order": 187,
   "english": "When you talk quickly, it makes me feel stupid.",
   "target_text": "Azkar hitz egiten duzunean, ergel sentiarazten nauzu.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC19-S004",
   "global_order": 188,
   "english": "Is it okay if I sit here?",
   "target_text": "Ondo dago hemen esertzen banaiz?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC19-S005",
   "global_order": 189,
   "english": "Is it okay if we put this here?",
   "target_text": "Ondo dago hau hemen jartzen badugu?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC19-S006",
   "global_order": 190,
   "english": "I don't want to be late.",
   "target_text": "Ez dut berandu iritsi nahi.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC19-S007",
   "global_order": 191,
   "english": "Are we going to be late?",
   "target_text": "Berandu iritsiko gara?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC19-S008",
   "global_order": 192,
   "english": "I promise I won't be late.",
   "target_text": "Agintzen dizut ez naizela berandu iritsiko.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC19-S009",
   "global_order": 193,
   "english": "I promise we won't be late.",
   "target_text": "Agintzen dizut ez garela berandu iritsiko.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC19-S010",
   "global_order": 194,
   "english": "I'd like two scoops of ice-cream, please.",
   "target_text": "Bi bola izozki nahi ditut, mesedez.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC19-S011",
   "global_order": 195,
   "english": "5 o'clock. 7 o'clock. May. June.",
   "target_text": "Bostak. Zazpiak. Maiatza. Ekaina.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC20-S001",
   "global_order": 196,
   "english": "Can I have one scoop of chocolate and one of strawberry?",
   "target_text": "Bola bat txokolatezkoa eta bat marrubizkoa eman diezadakezu?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC20-S002",
   "global_order": 197,
   "english": "And then another cone with one scoop of lemon and one of blueberry.",
   "target_text": "Eta gero beste kono bat, bola bat limoizkoa eta bat masustazkoa.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC20-S003",
   "global_order": 198,
   "english": "Do you have any ice-cream?",
   "target_text": "Baduzu izozkirik?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC20-S004",
   "global_order": 199,
   "english": "Thank you for all your work.",
   "target_text": "Eskerrik asko zure lan guztiagatik.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC20-S005",
   "global_order": 200,
   "english": "I wish you good luck with everything.",
   "target_text": "Zorte ona opa dizut guztiarekin.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC20-S006",
   "global_order": 201,
   "english": "Thank you for helping me.",
   "target_text": "Eskerrik asko laguntzeagatik.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC20-S007",
   "global_order": 202,
   "english": "Good luck with that!",
   "target_text": "Zorte on horrekin!",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC20-S008",
   "global_order": 203,
   "english": "That's very kind of you.",
   "target_text": "Oso atsegina zara horretan.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC20-S009",
   "global_order": 204,
   "english": "You're very kind.",
   "target_text": "Oso atsegina zara.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC20-S010",
   "global_order": 205,
   "english": "Thank you for being so friendly.",
   "target_text": "Eskerrik asko horren atsegina izateagatik.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC20-S011",
   "global_order": 206,
   "english": "6 o'clock. July. August. September.",
   "target_text": "Seiak. Uztaila. Abuztua. Iraila.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S001",
   "global_order": 207,
   "english": "It sounds as though we need to leave soon.",
   "target_text": "Badirudi laster alde egin behar dugula.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S002",
   "global_order": 208,
   "english": "It sounds as though you want us not to do that.",
   "target_text": "Badirudi nahi duzula hori ez egitea.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S003",
   "global_order": 209,
   "english": "Is there a toilet here?",
   "target_text": "Komunik badago hemen?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S004",
   "global_order": 210,
   "english": "Can you tell me where the toilet is?",
   "target_text": "Esan diezadakezu non dagoen komuna?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S005",
   "global_order": 211,
   "english": "It's down there on the left.",
   "target_text": "Han behean dago, ezkerretara.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S006",
   "global_order": 212,
   "english": "It's down there on the right.",
   "target_text": "Han behean dago, eskuinetara.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S007",
   "global_order": 213,
   "english": "Can you say that again?",
   "target_text": "Esan dezakezu hori berriro?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S008",
   "global_order": 214,
   "english": "Yes, I said it's over there.",
   "target_text": "Bai, esan dut han dagoela.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S009",
   "global_order": 215,
   "english": "What is that?",
   "target_text": "Zer da hori?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S010",
   "global_order": 216,
   "english": "What is that over there?",
   "target_text": "Zer da hori han?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S011",
   "global_order": 217,
   "english": "Would you like to order some drinks?",
   "target_text": "Edariren bat eskatu nahi zenuke?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S012",
   "global_order": 218,
   "english": "Do you want to order some drinks first?",
   "target_text": "Edariren bat eskatu nahi duzu lehenengo?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S013",
   "global_order": 219,
   "english": "Did you want something to drink first?",
   "target_text": "Zerbait edateko nahi zenuen lehenengo?",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC21-S014",
   "global_order": 220,
   "english": "October. November. December.",
   "target_text": "Urria. Azaroa. Abendua.",
   "note": null
  },
  {
   "id": "eus_for_eng:pod-0-unrecorded:SC22-S001",
   "global_order": 221,
   "english": "Would you mind if I tried to practise speaking Basque with you? I haven't been learning for very long, and I still feel a little nervous about speaking with other people.",
   "target_text": "Axola al zaizu zurekin euskaraz hitz egiten saiatzen banaiz? Ez naiz aspalditik ikasten ari, eta oraindik urduri samar sentitzen naiz beste jendearekin hitz egiterakoan.",
   "note": null
  }
 ],
 "rejected": [],
 "skipped": []
}