{"slot":"spa_for_eng:pod-1:SC06-S001","speaker":"James","text":"Excuse me. Hello. What's your name?","audio_id":"918c9792-1002-4d49-9565-dced622abc82","s3_key_before":"mastered/E9654893-BC3D-40A9-A0C0-DB4F184864C6.mp3","duration_ms_before":2664,"at":"2026-08-28T00:01:13.898Z","model":"sonic-3.6","bytes_before":32544,"before":{"lufs":-16.5,"lra":0,"peak_dbfs":-1.8},"status":"measured"}
{"slot":"spa_for_eng:pod-1:SC06-S003","speaker":"James","text":"I'm James. Pleased to meet you.","audio_id":"60fa092f-284c-45ee-b7b2-56a279390b30","s3_key_before":"mastered/9C0D38B6-0395-423D-9C15-DB10504D9E7B.mp3","duration_ms_before":2112,"at":"2026-08-28T00:01:14.064Z","model":"sonic-3.6","bytes_before":25920,"before":{"lufs":-16.3,"lra":0,"peak_dbfs":-1.9},"status":"measured"}
{"slot":"spa_for_eng:pod-1:SC06-S005","speaker":"James","text":"I'm from Manchester, but I live in London now. And you?","audio_id":"6a3cca5b-dfe1-4f20-9bec-2f2693966ecb","s3_key_before":"mastered/423481D5-C462-458E-A9F4-2450FEEA6B9F.mp3","duration_ms_before":3600,"at":"2026-08-28T00:01:14.202Z","model":"sonic-3.6","bytes_before":43776,"before":{"lufs":-16.4,"lra":0.7,"peak_dbfs":-1.7},"status":"measured"}
{"slot":"spa_for_eng:pod-1:SC06-S007","speaker":"James","text":"This is a lovely city. What do you do?","audio_id":"6d3d8f81-7027-4007-9304-858ce531a4f5","s3_key_before":"mastered/15AAF232-08E5-4885-9EC5-2507733069B7.mp3","duration_ms_before":2472,"at":"2026-08-28T00:01:14.398Z","model":"sonic-3.6","bytes_before":30240,"before":{"lufs":-16.3,"lra":0,"peak_dbfs":-1.9},"status":"measured"}
{"slot":"spa_for_eng:pod-1:SC06-S009","speaker":"James","text":"I'm sorry, I didn't understand you. I'm learning Spanish. Could you say that again more slowly?","audio_id":"02b7aac0-e33f-47f2-8fd0-0ec1baa7c197","s3_key_before":"mastered/38140967-67A9-4530-AF71-9247DB9AEBC5.mp3","duration_ms_before":5736,"at":"2026-08-28T00:01:14.579Z","model":"sonic-3.6","bytes_before":69408,"before":{"lufs":-16.5,"lra":2.6,"peak_dbfs":-1.8},"status":"measured"}
{"slot":"spa_for_eng:pod-1:SC06-S011","speaker":"James","text":"I teach English, but not in a school. I work with adults. I'm on holiday here with my wife and children. We're having a lovely time.","audio_id":"52949982-18f8-4e30-b28b-aab63d992192","s3_key_before":"mastered/425AD6EA-2B19-453A-9822-B154065E2AC1.mp3","duration_ms_before":7776,"at":"2026-08-28T00:01:14.786Z","model":"sonic-3.6","bytes_before":93888,"before":{"lufs":-16.5,"lra":2.6,"peak_dbfs":-1.7},"status":"measured"}
