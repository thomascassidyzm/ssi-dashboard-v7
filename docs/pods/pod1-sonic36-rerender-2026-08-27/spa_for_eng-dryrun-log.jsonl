{"slot":"spa_for_eng:pod-1:SC12-S004","speaker":"Pharmacist","text":"Try paracetamol for the headache, and these lozenges for the throat.","audio_id":"1c00b9dc-ab1b-42af-8ac9-54e081a93959","s3_key_before":"mastered/2A4616F6-4212-428E-882D-8316F2FA9ADF.mp3","duration_ms_before":3960,"at":"2026-08-28T00:01:21.283Z","model":"sonic-3.6","bytes_before":48096,"before":{"lufs":-16.5,"lra":2.5,"peak_dbfs":-1.7},"status":"measured"}
