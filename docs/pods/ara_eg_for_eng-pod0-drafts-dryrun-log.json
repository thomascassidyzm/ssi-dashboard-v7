 },
 "ops": [
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC02-S002",
   "global_order": 6,
   "english": "No, it's free. Please, go ahead.",
   "target_text": "لا، فاضي. اتفضل.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC02-S003",
   "global_order": 7,
   "english": "How far is it into town?",
   "target_text": "الوسط بعيد قد ايه من هنا؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC02-S004",
   "global_order": 8,
   "english": "Can you tell me how far it is into town?",
   "target_text": "ممكن تقولّي الوسط بعيد قد ايه من هنا؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC02-S005",
   "global_order": 9,
   "english": "It's not very far. Maybe three or four miles.",
   "target_text": "مش بعيد قوي. يمكن تلات او اربع أميال.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC03-S003",
   "global_order": 12,
   "english": "Do you have any food?",
   "target_text": "عندكو أكل؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC03-S004",
   "global_order": 13,
   "english": "Do you have any snacks?",
   "target_text": "عندكو حاجة خفيفة تتاكل؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC03-S005",
   "global_order": 14,
   "english": "Do you have crisps, or nuts, or anything?",
   "target_text": "عندكو شيبسي، ولا مكسرات، ولا حاجة؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC03-S006",
   "global_order": 15,
   "english": "No, we've only got drinks.",
   "target_text": "لا، عندنا مشروبات بس.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC03-S007",
   "global_order": 16,
   "english": "Yes, would you like the menu?",
   "target_text": "أيوه، تحب تشوف المنيو؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC03-S008",
   "global_order": 17,
   "english": "Yes, please.",
   "target_text": "أيوه، لو سمحت.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC03-S009",
   "global_order": 18,
   "english": "Here's your coffee.",
   "target_text": "اتفضل قهوتك.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC07-S010",
   "global_order": 47,
   "english": "That's eight pound forty altogether.",
   "target_text": "الحساب كله تمنية جنيه واربعين قرش.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC12-S010",
   "global_order": 119,
   "english": "19. 20. 21. Wednesday. Thursday.",
   "target_text": "19. 20. 21. الأربعاء. الخميس.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC14-S004",
   "global_order": 134,
   "english": "Perhaps about twenty minutes, if we're not unlucky with the traffic lights.",
   "target_text": "يمكن حوالي عشرين دقيقة، لو الإشارات ماكانتش وحشة معانا.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC14-S007",
   "global_order": 137,
   "english": "Here we are. That's twelve pound fifty.",
   "target_text": "وصلنا. الحساب اتناشر جنيه ونص.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC15-S001",
   "global_order": 141,
   "english": "How much is that?",
   "target_text": "ده بكام؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC15-S002",
   "global_order": 142,
   "english": "Can you tell me how much that is?",
   "target_text": "ممكن تقولّي ده بكام؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC15-S003",
   "global_order": 143,
   "english": "How much does it cost to get a taxi into town?",
   "target_text": "التاكسي للوسط بكام؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC15-S004",
   "global_order": 144,
   "english": "How much does it cost to get a bus into town?",
   "target_text": "الأتوبيس للوسط بكام؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC15-S005",
   "global_order": 145,
   "english": "Where can we get a bus?",
   "target_text": "نلاقي الأتوبيس فين؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC15-S006",
   "global_order": 146,
   "english": "Where can we get a taxi?",
   "target_text": "نلاقي التاكسي فين؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC15-S007",
   "global_order": 147,
   "english": "Four single tickets to town, please.",
   "target_text": "أربع تذاكر رايح بس للوسط، لو سمحت.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC15-S008",
   "global_order": 148,
   "english": "Two return tickets to town, please.",
   "target_text": "تذكرتين رايح جاي للوسط، لو سمحت.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC15-S009",
   "global_order": 149,
   "english": "I prefer to try to speak your language, I think it's polite.",
   "target_text": "أنا بفضل أحاول أتكلم لغتك، حاسس إن ده أدب.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC15-S010",
   "global_order": 150,
   "english": "I'm sorry I can't speak very quickly.",
   "target_text": "آسف، مش قادر أتكلم بسرعة قوي.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC15-S011",
   "global_order": 151,
   "english": "100,000. 60. 70. 1 o'clock. 11 o'clock.",
   "target_text": "100,000. 60. 70. الساعة واحدة. الساعة حداشر.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC16-S001",
   "global_order": 152,
   "english": "But if you can speak slowly I think we'll be able to manage.",
   "target_text": "بس لو تتكلم ببطء، حاسس إننا هنعرف نتفاهم.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC16-S002",
   "global_order": 153,
   "english": "You spoke a little too quickly, so I'm not sure if I understood.",
   "target_text": "انت اتكلمت بسرعة شوية، فمش متأكد إني كنت فاهم.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC16-S003",
   "global_order": 154,
   "english": "Can we try again?",
   "target_text": "ممكن نحاول تاني؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC16-S004",
   "global_order": 155,
   "english": "Can we see the menu?",
   "target_text": "ممكن نشوف المنيو؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC16-S005",
   "global_order": 156,
   "english": "Can we see the dessert menu also?",
   "target_text": "ممكن نشوف منيو الحلويات كمان؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC16-S006",
   "global_order": 157,
   "english": "Do you have anything to eat?",
   "target_text": "عندكو حاجة تتاكل؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC16-S007",
   "global_order": 158,
   "english": "Can we pay?",
   "target_text": "ممكن ندفع؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC16-S008",
   "global_order": 159,
   "english": "Can we pay by card?",
   "target_text": "ممكن ندفع بالكارت؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC16-S009",
   "global_order": 160,
   "english": "No, we only take cash.",
   "target_text": "لا، إحنا بناخد كاش بس.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC16-S010",
   "global_order": 161,
   "english": "I'm sorry, I don't have any cash.",
   "target_text": "آسف، معايا مفيش كاش.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC16-S011",
   "global_order": 162,
   "english": "A million. 80. 90. 2 o'clock. 10 o'clock.",
   "target_text": "مليون. 80. 90. الساعة اتنين. الساعة عشرة.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC17-S001",
   "global_order": 163,
   "english": "Is there a cash machine near here?",
   "target_text": "فيه ماكينة صراف آلي جنب هنا؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC17-S002",
   "global_order": 164,
   "english": "Do you want to pay by cash or card or put it on the room?",
   "target_text": "تحب تدفع كاش ولا كارت ولا تحطها على الأوضة؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC17-S003",
   "global_order": 165,
   "english": "Can we put it on the room, please?",
   "target_text": "ممكن نحطها على الأوضة، لو سمحت؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC17-S004",
   "global_order": 166,
   "english": "Would you like to pay by cash or card or on the room?",
   "target_text": "تحب تدفع كاش ولا كارت ولا على الأوضة؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC17-S005",
   "global_order": 167,
   "english": "Did you want to pay by cash or card?",
   "target_text": "كنت عايز تدفع كاش ولا كارت؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC17-S006",
   "global_order": 168,
   "english": "We'll pay by card again, please.",
   "target_text": "هندفع بالكارت تاني، لو سمحت.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC17-S007",
   "global_order": 169,
   "english": "It's hot today, again.",
   "target_text": "الجو حر النهارده، تاني.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC17-S008",
   "global_order": 170,
   "english": "Is the water warm?",
   "target_text": "المية سخنة؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC17-S009",
   "global_order": 171,
   "english": "No, it's a little cold today.",
   "target_text": "لا، هي شوية بارده النهارده.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC17-S010",
   "global_order": 172,
   "english": "It's not bad.",
   "target_text": "مش وحش.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC17-S011",
   "global_order": 173,
   "english": "3 o'clock. 9 o'clock. January. February.",
   "target_text": "الساعة تلاتة. الساعة تسعة. يناير. فبراير.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC18-S001",
   "global_order": 174,
   "english": "That's a bad idea.",
   "target_text": "ده فكرة وحشة.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC18-S002",
   "global_order": 175,
   "english": "Do you have any orange juice?",
   "target_text": "عندكو عصير برتقال؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC18-S003",
   "global_order": 176,
   "english": "Do you have any apple juice?",
   "target_text": "عندكو عصير تفاح؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC18-S004",
   "global_order": 177,
   "english": "Does the boat leave from here?",
   "target_text": "المركب بيمشي من هنا؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC18-S005",
   "global_order": 178,
   "english": "Does the bus leave from here?",
   "target_text": "الأتوبيس بيمشي من هنا؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC18-S006",
   "global_order": 179,
   "english": "Where does the bus leave from?",
   "target_text": "الأتوبيس بيمشي منين؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC18-S007",
   "global_order": 180,
   "english": "Is that correct? Am I correct?",
   "target_text": "ده صح؟ أنا صح؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC18-S008",
   "global_order": 181,
   "english": "Am I wrong about that?",
   "target_text": "أنا غلطان في الموضوع ده؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC18-S009",
   "global_order": 182,
   "english": "I'm sorry, my son lost his ticket.",
   "target_text": "آسف، ابني ضيع تذكرته.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC18-S010",
   "global_order": 183,
   "english": "We have paid, but my daughter has lost her ticket.",
   "target_text": "إحنا دفعنا، بس بنتي ضيعت تذكرتها.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC18-S011",
   "global_order": 184,
   "english": "4 o'clock. 8 o'clock. March. April.",
   "target_text": "الساعة اربعة. الساعة تمانية. مارس. ابريل.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC19-S001",
   "global_order": 185,
   "english": "That makes me happy.",
   "target_text": "ده بيسعدني.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC19-S002",
   "global_order": 186,
   "english": "That makes me feel a little worried.",
   "target_text": "ده بيخليني أحس بقلق شوية.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC19-S003",
   "global_order": 187,
   "english": "When you talk quickly, it makes me feel stupid.",
   "target_text": "لما تتكلم بسرعة، بيخليني أحس إني غبي.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC19-S004",
   "global_order": 188,
   "english": "Is it okay if I sit here?",
   "target_text": "تمام لو قعدت هنا؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC19-S005",
   "global_order": 189,
   "english": "Is it okay if we put this here?",
   "target_text": "تمام لو حطينا ده هنا؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC19-S006",
   "global_order": 190,
   "english": "I don't want to be late.",
   "target_text": "مش عايز أتأخر.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC19-S007",
   "global_order": 191,
   "english": "Are we going to be late?",
   "target_text": "هنتأخر؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC19-S008",
   "global_order": 192,
   "english": "I promise I won't be late.",
   "target_text": "أنا واعدك إني مش هتأخر.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC19-S009",
   "global_order": 193,
   "english": "I promise we won't be late.",
   "target_text": "أنا واعدك إننا مش هنتأخر.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC19-S010",
   "global_order": 194,
   "english": "I'd like two scoops of ice-cream, please.",
   "target_text": "عايز كورتين آيس كريم، لو سمحت.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC19-S011",
   "global_order": 195,
   "english": "5 o'clock. 7 o'clock. May. June.",
   "target_text": "الساعة خمسة. الساعة سبعة. مايو. يونيو.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC20-S001",
   "global_order": 196,
   "english": "Can I have one scoop of chocolate and one of strawberry?",
   "target_text": "ممكن كورة شوكولاتة وكورة فراولة؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC20-S002",
   "global_order": 197,
   "english": "And then another cone with one scoop of lemon and one of blueberry.",
   "target_text": "وبعدين قمع تاني فيه كورة ليمون وكورة توت أزرق.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC20-S003",
   "global_order": 198,
   "english": "Do you have any ice-cream?",
   "target_text": "عندكو آيس كريم؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC20-S004",
   "global_order": 199,
   "english": "Thank you for all your work.",
   "target_text": "شكرا على كل تعبك.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC20-S005",
   "global_order": 200,
   "english": "I wish you good luck with everything.",
   "target_text": "أتمنالك التوفيق في كل حاجة.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC20-S006",
   "global_order": 201,
   "english": "Thank you for helping me.",
   "target_text": "شكرا إنك ساعدتني.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC20-S007",
   "global_order": 202,
   "english": "Good luck with that!",
   "target_text": "بالتوفيق في كده!",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC20-S008",
   "global_order": 203,
   "english": "That's very kind of you.",
   "target_text": "ده لطف كبير منك.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC20-S009",
   "global_order": 204,
   "english": "You're very kind.",
   "target_text": "انت شخص لطيف قوي.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC20-S010",
   "global_order": 205,
   "english": "Thank you for being so friendly.",
   "target_text": "شكرا إنك كنت ودود كده.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC20-S011",
   "global_order": 206,
   "english": "6 o'clock. July. August. September.",
   "target_text": "الساعة ستة. يوليو. أغسطس. سبتمبر.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S001",
   "global_order": 207,
   "english": "It sounds as though we need to leave soon.",
   "target_text": "شكله إحنا محتاجين نمشي قريب.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S002",
   "global_order": 208,
   "english": "It sounds as though you want us not to do that.",
   "target_text": "شكله انت عايزنا منعملش كده.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S003",
   "global_order": 209,
   "english": "Is there a toilet here?",
   "target_text": "فيه حمام هنا؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S004",
   "global_order": 210,
   "english": "Can you tell me where the toilet is?",
   "target_text": "ممكن تقولّي الحمام فين؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S005",
   "global_order": 211,
   "english": "It's down there on the left.",
   "target_text": "هناك على الشمال.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S006",
   "global_order": 212,
   "english": "It's down there on the right.",
   "target_text": "هناك على اليمين.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S007",
   "global_order": 213,
   "english": "Can you say that again?",
   "target_text": "ممكن تقول ده تاني؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S008",
   "global_order": 214,
   "english": "Yes, I said it's over there.",
   "target_text": "أيوه، أنا قلت إنه هناك.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S009",
   "global_order": 215,
   "english": "What is that?",
   "target_text": "ده ايه؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S010",
   "global_order": 216,
   "english": "What is that over there?",
   "target_text": "ايه ده اللي هناك؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S011",
   "global_order": 217,
   "english": "Would you like to order some drinks?",
   "target_text": "تحب تطلب مشروبات؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S012",
   "global_order": 218,
   "english": "Do you want to order some drinks first?",
   "target_text": "عايز تطلب المشروبات الأول؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S013",
   "global_order": 219,
   "english": "Did you want something to drink first?",
   "target_text": "كنت عايز حاجة تشربها الأول؟",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC21-S014",
   "global_order": 220,
   "english": "October. November. December.",
   "target_text": "أكتوبر. نوفمبر. ديسمبر.",
   "note": null
  },
  {
   "id": "ara_eg_for_eng:pod-0-unrecorded:SC22-S001",
   "global_order": 221,
   "english": "Would you mind if I tried to practise speaking Egyptian Arabic with you? I haven't been learning for very long, and I still feel a little nervous about speaking with other people.",
   "target_text": "هل يضايقك لو حاولت أتمرن أتكلم عربي مصري معاك؟ أنا لسه بتعلم من مدة قصيرة، وبحس بشوية توتر لما أتكلم مع ناس تانية.",
