  },
  {
    "id": "96541b04-9c0c-4357-9494-5fa2ff442e4e",
    "text": "Affedersiniz, Topkapı Sarayı'na nasıl gidilir?",
    "role": "target1",
    "voice_id": "f331ee80",
    "language": "tur",
    "duration_ms": 2616,
    "verdict": "suspect",
    "reason": "rate",
