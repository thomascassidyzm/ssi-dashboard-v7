          "s3_key": "mastered/107E173F-FCC9-4EAE-A657-235803B38481.mp3",
          "duration_ms": 864,
          "axis": "short"
        },
        {
          "id": "73884d3a-86fa-41d9-8d32-aa9b2a0e3e10",
          "text": "Je ne voulais pas vous demander quelque chose de si important",
          "language": "fra",
          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/C14DB532-8F38-4B20-8166-A3051E3A1576.mp3",
          "duration_ms": 2736,
          "axis": "long"
        },
        {
          "id": "c1af13c1-1d61-44ed-b156-e5b43d02cf49",
          "text": "Je connais une vieille femme qui voulait parler français très bien",
          "language": "fra",
          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/C020D5EE-689F-40FE-9BC5-5603E15B5F4B.mp3",
          "duration_ms": 3216,
          "axis": "long"
        },
        {
          "id": "53fe21b2-8c7b-445b-aa85-5dac9a79e0d6",
          "text": "j'essaie mais je ne peux pas me souvenir de comment dire ce que je voulais dire",
          "language": "fra",
          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/29AD787E-A28A-4FD1-BC59-04BBABB7A52F.mp3",
          "duration_ms": 3696,
          "axis": "long"
        },
        {
          "id": "b0950506-2861-4a17-9587-747661008c85",
          "text": "elle a dit que depuis que nous avons essayé, rien ne fonctionne plus",
          "language": "fra",
          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/6A4F2496-ADF9-4CE8-A612-604B2D5F5D59.mp3",
          "duration_ms": 3744,
          "axis": "long"
        },
        {
          "id": "87004493-beee-49cc-b4fc-2ae7adfd1891",
          "text": "cet homme va me dire quelque chose de nouveau s'il a le temps",
          "language": "fra",
          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/D14B4955-754D-4F45-B792-F3F14C185A4E.mp3",
          "duration_ms": 3168,
          "axis": "long"
        },
        {
          "id": "e91059f4-0237-4c4e-95c7-057c0c8fdb0c",
          "text": "Je ne peux pas me souvenir de comment dire ce que je voulais dire hier",
          "language": "fra",
          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/8A3BE381-5E4D-41AB-9B58-234A20E32E7C.mp3",
          "duration_ms": 3552,
          "axis": "long"
        },
        {
          "id": "6fc44475-4348-468b-ba6e-8ebe7cb5be3a",
          "text": "ton frère connaît quelqu'un qui a dit qu'il voulait aider le vieil homme",
          "language": "fra",
          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/076BEEAA-B193-417E-9F59-3A29E6D51C80.mp3",
          "duration_ms": 3408,
          "axis": "long"
        },
        {
          "id": "afb50992-529f-420b-8cea-200c8473a396",
          "text": "Je pense que ma sœur peut t'aider à apprendre le français demain",
          "language": "fra",
          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/0BF1B27E-6728-4CD6-B74B-E92C3018A7BD.mp3",
          "duration_ms": 2880,
          "axis": "long"
        },
        {
          "id": "f8baf922-8437-453d-8767-17ab888ed1d8",
          "text": "j'aime avoir l'impression d'être presque prêt à partir bientôt",
          "language": "fra",
          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/28F11CE9-99D7-4A95-8E9F-B4A8B3AF38C2.mp3",
          "duration_ms": 3120,
          "axis": "long"
        },
        {
          "id": "76b95ac8-a2b8-43e6-af33-da68a33c8427",
          "text": "j'ai rencontré quelqu'un hier qui a dit qu'il voulait te dire quelque chose de très important",
          "language": "fra",
          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/E65B39BC-39FF-446B-81FF-B25E0407305A.mp3",
          "duration_ms": 4176,
          "axis": "long"
        },
        {
          "id": "af435888-3099-4972-89dc-9b4260d09a98",
          "text": "je pense que je connais un jeune homme qui veut travailler avec vous",
