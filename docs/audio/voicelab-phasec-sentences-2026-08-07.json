          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/09A211BA-AFFA-4CE7-A3D9-633104325DD0.mp3",
          "duration_ms": 3168,
          "axis": "long"
        },
        {
          "id": "6fd99e38-355e-41b2-bd74-a3e6288f22b6",
          "text": "Je pense que je comprends ce que j'essayais de dire maintenant",
