          "duration_ms": 2088,
          "axis": "awkward"
        },
        {
          "id": "81a8ae42-d0e9-4677-8d40-2eba213d9821",
          "text": "j'aimerais parler français très bien",
          "language": "fra",
          "role": "target1",
          "voice_id": "eve",
          "s3_key": "mastered/B025765E-8FE6-4546-A081-0BECDFBA35AA.mp3",
