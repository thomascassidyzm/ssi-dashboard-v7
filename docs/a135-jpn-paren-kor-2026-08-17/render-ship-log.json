  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0300L01U02",
  "course": "eng_for_kor",
  "text": "저는 그가 불친절하다고 생각했어요",
  "skipped": "already owned: 69742c38-291d-4dc6-b3ee-62595c809f87",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0300L01U04",
  "course": "eng_for_kor",
