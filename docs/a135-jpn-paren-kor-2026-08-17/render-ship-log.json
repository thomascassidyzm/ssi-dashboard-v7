[
 {
  "id": "eng_for_kor:S0040L01U04",
  "course": "eng_for_kor",
  "text": "영어로 말하는 것에 대해 기분이 어때요?",
  "skipped": "already owned: c6b79e1b-78f5-4141-b03f-e326f30a7694",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0040L01U05",
  "course": "eng_for_kor",
  "text": "영어를 배우는 것에 대해 기분이 어때요?",
  "skipped": "already owned: ebc64c35-acab-4d24-8e32-6bc40ee6b41e",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0280L03U04",
  "course": "eng_for_kor",
  "text": "저는 가기 전에 그 일만 했어요",
  "skipped": "already owned: 1c948c53-a616-4673-82c0-9a52a7321ace",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0280L03U05",
  "course": "eng_for_kor",
  "text": "그녀는 일만 했어요, 하지만 있고 싶어하지 않았어요",
  "skipped": "already owned: be44316e-9b3b-4072-b91b-6bd1a4ef7cb0",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0280L03U06",
  "course": "eng_for_kor",
  "text": "우리는 함께 일만 했어요, 그리고 저는 갈 준비가 됐어요",
  "skipped": "already owned: aa7f248e-7aca-47b1-807e-f73174009d59",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0282L01U03",
  "course": "eng_for_kor",
  "text": "더 많은 시간이 필요하면 아니요, 문제없어요",
  "skipped": "already owned: 179a240e-105a-4c37-bd83-c4aa9ef00bfc",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0282L01U04",
  "course": "eng_for_kor",
  "text": "우리가 함께 일할 때 아니요, 문제없어요",
  "skipped": "already owned: 771fd28f-f24b-469b-b997-271b102080e4",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0284L01U06",
  "course": "eng_for_kor",
  "text": "저는 당신이 제 여동생 친구를 만났으면 좋겠어요",
  "skipped": "already owned: 99cbadaf-b940-4312-88f2-58b9b4f0196a",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0288L01U01",
  "course": "eng_for_kor",
  "text": "저는 피곤할 때 텔레비전 보는 것을 좋아해요",
  "skipped": "already owned: 691abc27-3768-45a9-b330-433b4c5b825d",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0288L01U02",
  "course": "eng_for_kor",
  "text": "저는 저녁에 텔레비전 보는 것을 좋아해요",
  "skipped": "already owned: 9d6f3937-69d0-4c3d-a847-8fd143b61b6b",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0288L01U03",
  "course": "eng_for_kor",
  "text": "다른 사람과 텔레비전 보는 것을 좋아해요?",
  "skipped": "already owned: 8a42efc3-4157-4e54-99a4-db54620b9fd6",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0288L01U04",
  "course": "eng_for_kor",
  "text": "저는 쉬고 싶을 때 텔레비전 보는 것을 좋아해요",
  "skipped": "already owned: 167dff99-a0ea-43fb-9484-55ac6977858e",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0288L02U05",
  "course": "eng_for_kor",
  "text": "제가 아는 대부분의 사람들은 영어로 말하는 것이 괜찮아요",
  "skipped": "already owned: 51137f7e-eaf6-4a5f-8c66-4236a888dec6",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0292L01U01",
  "course": "eng_for_kor",
  "text": "저는 당신과 파티에 가고 싶어요",
  "skipped": "already owned: 57549d96-1510-4de7-a870-7856df6b270e",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0292L01U02",
  "course": "eng_for_kor",
  "text": "오늘 밤 파티에 오고 싶어요?",
  "skipped": "already owned: 08df6814-55fa-4d11-9401-0ed6859a8378",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0292L01U03",
  "course": "eng_for_kor",
  "text": "저는 파티에 갈 수 있을지 모르겠어요",
  "skipped": "already owned: a01657a4-5854-482b-96c2-49210b5bf4ba",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0292L01U04",
  "course": "eng_for_kor",
  "text": "저는 친구들과 파티에 가고 싶어요",
  "skipped": "already owned: 75a6e02b-39e1-4ed2-8361-ad2c02e4d757",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0294L01U06",
  "course": "eng_for_kor",
  "text": "죄송하지만 오늘 당신에게 전화할 시간이 충분하지 않아요",
  "skipped": "already owned: e564bb7c-9f22-45a1-89cd-9512d0d528bb",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0294L01U07",
  "course": "eng_for_kor",
  "text": "저는 어젯밤에 당신에게 전화할 시간이 충분하지 않았어요",
  "skipped": "already owned: 77e3fe19-7a02-4796-b57e-9e29df88bca4",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0294L01U08",
  "course": "eng_for_kor",
  "text": "그는 오늘 저녁에 당신에게 전화할 시간이 충분하지 않아요",
  "skipped": "already owned: 56317fd0-a6ae-4d38-9d53-a759122d8a07",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0296L01U01",
  "course": "eng_for_kor",
  "text": "저는 영어로 더 자주 말해야 한다고 말했어요",
  "skipped": "already owned: 081265fe-556e-4cd5-9e9e-d5748bcfb3ec",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0296L01U02",
  "course": "eng_for_kor",
  "text": "저는 연습할 시간이 더 필요하다고 말했어요",
  "skipped": "already owned: 5b1ad1e2-a985-4070-a363-9ce2bfafb01a",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0296L01U03",
  "course": "eng_for_kor",
  "text": "저는 답을 찾아야 한다고 말했어요",
  "skipped": "already owned: b5d2acc9-a1ef-4cd8-8256-dd42fa0339a8",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0296L01U04",
  "course": "eng_for_kor",
  "text": "저는 어제 당신과 이야기해야 한다고 말했어요",
  "skipped": "already owned: 666722c1-8547-44c6-96c3-7dd084a172af",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0298L01U01",
  "course": "eng_for_kor",
  "text": "저는 그것에 대해 할 말이 없다고 생각해요",
  "skipped": "already owned: 655fb999-8c3d-4172-8ea1-cf7d34bc22b2",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0298L01U02",
  "course": "eng_for_kor",
  "text": "그녀는 저에게 할 말이 없다고 말했어요",
  "skipped": "already owned: f7ff0140-7889-4cef-8f13-d9ad6e231efc",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0298L01U03",
  "course": "eng_for_kor",
  "text": "죄송하지만 저는 할 말이 없어요",
  "skipped": "already owned: d57ed210-0787-4946-bb06-a55d6ee330dc",
  "shipped": null,
  "spares": []
 },
 {
  "id": "eng_for_kor:S0300L01U01",
  "course": "eng_for_kor",
  "text": "저는 불친절하게 보이고 싶지 않아요",
