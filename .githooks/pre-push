#!/bin/sh
# Popty's own pre-push, run by the estate's global hook (~/.git-identity-hooks/pre-push chains to
# <repo>/.githooks/pre-push when it is executable). Refuses a push whose commit puts a speech
# recogniser back into audio split/cut/seam/align code — Tom r-2026-11-03: "Audio splits/alignment
# never use Whisper (or any transcription) for timings". The rule and its scope live in
# tools/check-no-transcribe-in-splits.cjs; this only runs it against each commit being pushed.
z=0000000000000000000000000000000000000000
root=$(git rev-parse --show-toplevel) || exit 0
check="$root/tools/check-no-transcribe-in-splits.cjs"
[ -f "$check" ] || exit 0
status=0
while read -r _lref lsha _rref _rsha; do
  [ -z "$lsha" ] && continue
  [ "$lsha" = "$z" ] && continue          # a branch deletion pushes no code
  git cat-file -e "$lsha:tools/check-no-transcribe-in-splits.cjs" 2>/dev/null || continue   # a commit from before the rule
  node "$check" --rev "$lsha" || status=1
done
exit $status
