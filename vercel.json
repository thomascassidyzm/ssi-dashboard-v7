{
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/((?!assets).*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/vfs/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/production/:path*",
      "destination": "https://mirthlessly-nonanesthetized-marilyn.ngrok-free.dev/api/production/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://mirthlessly-nonanesthetized-marilyn.ngrok-free.dev/api/:path*"
    },
    {
      "source": "/((?!vfs|api).*)",
      "destination": "/index.html"
    }
  ]
}
