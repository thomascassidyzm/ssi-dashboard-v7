[Unit]
Description=VOICELAB playground — type a sentence, pick a voice, hear it, read the six-gate verdict (tailnet only, port 4790)
After=network-online.target

[Service]
# r-2026-10-13: direct TTS routes paused; manual start only.
Type=simple
WorkingDirectory=/home/tomcassidy/SSi/voicelab-wt
Environment=PATH=/home/tomcassidy/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=NODE_ENV=production
ExecStart=/usr/bin/node services/voicelab-playground/server.cjs
Restart=no
