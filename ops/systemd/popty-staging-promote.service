[Unit]
Description=Promote Popty staging (deploy/staging) to main when the booth check is green and no journey file changed

[Service]
Type=oneshot
# Runs out of the PROD checkout, which ssi-auto-deploy keeps on main (see ssi-auto-deploy.service), so
# the script is present from the moment it lands on main — the staging tree only gets it after the
# next nightly fast-forwards it. The script only fetches and pushes refs; --repo says where.
WorkingDirectory=/home/tomcassidy/SSi/ssi-dashboard-v7-clean-prod
ExecStart=/usr/bin/node tools/promote-staging.cjs --repo /home/tomcassidy/wt-staging
TimeoutStartSec=2min
StandardOutput=append:/home/tomcassidy/.local/log/popty-staging-promote.log
StandardError=append:/home/tomcassidy/.local/log/popty-staging-promote.log
