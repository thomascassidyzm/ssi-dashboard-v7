# cs #537 (Tom 26 Nov: "popty will have to build locally too - perhaps on a schedule, to not choke the machines").
# popty.app is built HERE and uploaded prebuilt; Vercel builds nothing. Tick: at most one ship an hour, only when a file
# popty.app ships changed; a [hotfix]/[release] commit ships on the next tick. Ship now: popty-prod-ship-now.service.
# Install: cp ops/systemd/popty-prod-{deploy.service,deploy.timer,ship-now.service} ops/systemd/popty-build.slice \
#   ~/.config/systemd/user/ && systemctl --user daemon-reload && systemctl --user enable --now popty-prod-deploy.timer
[Unit]
Description=Popty production: build main on watson-1 and upload prebuilt, hourly, only when deployable code changed (cs #537)

[Service]
Type=oneshot
ExecStartPre=/bin/sh -c '[ -d %h/.cs-builds/popty-prod-prebuilt/.git ] || git clone -q --branch main https://github.com/thomascassidyzm/ssi-dashboard-v7.git %h/.cs-builds/popty-prod-prebuilt'
Slice=popty-build.slice
Nice=19
IOSchedulingClass=idle
CPUWeight=10
MemoryHigh=6G
MemoryMax=7G
TimeoutStartSec=45min
ExecStart=/usr/bin/flock %h/.local/state/watson-builds/popty-prod.lock /usr/bin/env node %h/.cs-builds/popty-prod-prebuilt/tools/release/prod-deploy.cjs
