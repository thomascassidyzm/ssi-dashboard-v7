[Unit]
Description=Precompute read-only per-voice clip and complete-round coverage
After=network-online.target

[Service]
Type=oneshot
User=popty
Group=tomcassidy
UMask=0002
Environment=HOME=/home/tomcassidy
WorkingDirectory=/home/tomcassidy/SSi/ssi-dashboard-v7-clean-prod
Environment=NODE_OPTIONS=--max-old-space-size=2048
ExecStart=/usr/bin/node tools/voice-coverage/refresh.cjs
Nice=15
IOSchedulingClass=idle
CPUWeight=20
TimeoutStartSec=60min
StandardOutput=append:/home/tomcassidy/.local/log/ssi-voice-coverage.log
StandardError=append:/home/tomcassidy/.local/log/ssi-voice-coverage.log
