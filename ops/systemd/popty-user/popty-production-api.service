# System unit (job #391). Was a tomcassidy user unit: ops/systemd/popty-production-api.service holds its history.
[Unit]
Description=Popty Production API (watson-1, user popty)
After=network-online.target tailscaled.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=20

[Service]
Type=simple
# RUNS AS ITS OWN UNIX USER (job #391, Tom 2026-10-14): popty, so a worker running as
# tomcassidy cannot read the Supabase service key, the provider keys or the DB owner login.
# Those live in /etc/popty (popty:popty, 0700/0600). Primary group tomcassidy + UMask 0002 so
# what Popty writes in the shared places (prod checkout data/ logs/, ~/.local/state, VFS_ROOT,
# ~/ssi-evidence) stays writable by the tomcassidy tools that share them. HOME stays Tom's:
# whisper, lame, the claude binary, the spend ledger and the model catalog are found from it.
User=popty
Group=tomcassidy
UMask=0002
Environment=HOME=/home/tomcassidy
EnvironmentFile=/etc/popty/popty.env
Environment=PGAPPNAME=popty-api
Environment=ROUND_INDEX_ENV_PSQL=/etc/popty/owner.env
# The course builder's claude CLI: its own config dir, the account-3 token symlinked in.
Environment=SSI_CLAUDE_CONFIG_DIR=/var/lib/popty/claude
Environment="PATH=/home/tomcassidy/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/snap/bin"
WorkingDirectory=/home/tomcassidy/SSi/ssi-dashboard-v7-clean-prod
Environment=NODE_OPTIONS=--max-old-space-size=4096
OOMScoreAdjust=500
ExecStartPre=/usr/bin/node tools/check-service-syntax.cjs services/production-api.cjs
ExecStart=/usr/bin/node services/production-api.cjs
Environment=PRODUCTION_API_PORT=3470
Environment=AUDIT_ARCHIVE_CRON=off
Environment=TAIL_REPAIR_MODE=flag
Restart=always
RestartSec=5
KillMode=process
StandardOutput=append:/home/tomcassidy/.local/log/popty-production-api.log
StandardError=append:/home/tomcassidy/.local/log/popty-production-api.log

[Install]
WantedBy=multi-user.target
