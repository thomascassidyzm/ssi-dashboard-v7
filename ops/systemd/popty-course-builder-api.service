[Unit]
Description=Popty Course Builder API (watson-1)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
# 2026-08-05: repointed from the developer's working checkout
# (…/ssi-dashboard-v7-clean) to the clean deployed one, matching
# popty-production-api and popty-phase8-audio. Until now this service alone
# served whatever a developer happened to have checked out and uncommitted —
# so it could never be judged or updated by the staleness watchdog, which
# skips units loaded from another clone.
# Cutover was byte-verified: of the 59 files in this service's require graph,
# 57 were identical between the two trees and 1 (course-builder-api.cjs)
# differed only by the /health build-identity hunk from c051a509. The two
# dirty files in the graph (services/shared/claude-{cli,config}.cjs) held the
# watson-1 homedir/OAuth auth fix, which had already landed on main — so the
# clean tree carries it too and the cutover loses no behaviour.
WorkingDirectory=/home/tomcassidy/SSi/ssi-dashboard-v7-clean-prod
Environment=NODE_OPTIONS=--max-old-space-size=4096
Environment=COURSE_BUILDER_PORT=3471
# watson-1 is LINUX. Every agent-spawn route defaults to
# `ctx.SPAWN_MODE === 'headless' ? 'headless' : terminal` with terminal
# defaulting to 'iTerm2' (services/course-builder/lib/agent-spawner.cjs:30),
# which shells out to `osascript` — a macOS binary that does not exist here.
# Without this, EVERY dashboard-triggered agent dies instantly with
# "spawn osascript ENOENT" and the Terminal.app fallback fails the same way.
# That is what actually stopped the 2026-08-04 nld_for_eng component backfill.
Environment=SPAWN_MODE=headless
# PRE-START SYNTAX GUARD (2026-08-08). Same guard production-api already
# carries: refuse to start a file node cannot parse, and say which file and
# which SyntaxError, instead of crash-looping every 5 seconds behind
# Restart=always. Last line of defence — by the time this fires the old
# process is already gone. The one that saves the service is in
# ops/watchdog/popty-staleness-watchdog.sh, which checks BEFORE restarting.
ExecStartPre=/usr/bin/node tools/check-service-syntax.cjs services/course-builder-api.cjs
ExecStart=/usr/bin/node services/course-builder-api.cjs
Restart=always
RestartSec=5
# See the note in popty-production-api.service — prefer killing a restartable
# service over the user manager that supervises it.
OOMScoreAdjust=500
# THIS is the service that spawns production/backfill agents
# (services/course-builder/lib/agent-spawner.cjs:40, services/course-builder/routes/v2.cjs).
# Those spawns already use detached:true + unref(), which gives them their own
# PROCESS GROUP — but that does NOT get them out of this unit's CGROUP, and
# systemd's default KillMode=control-group kills the whole cgroup on stop or
# restart. Result: restarting this unit murders every in-flight agent, which is
# exactly what happened to the nld_for_eng backfill on 2026-08-04.
# KillMode=process kills only the main node process and leaves agents running.
KillMode=process
StandardOutput=append:/home/tomcassidy/.local/log/popty-course-builder-api.log
StandardError=append:/home/tomcassidy/.local/log/popty-course-builder-api.log

[Install]
WantedBy=default.target
