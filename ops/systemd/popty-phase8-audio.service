[Unit]
Description=Popty Phase 8 Audio Generator (watson-1)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/tomcassidy/SSi/ssi-dashboard-v7-clean
Environment=NODE_OPTIONS=--max-old-space-size=4096
Environment=PHASE8_PORT=3465
# Tail-repair gate: detect-and-flag, never mutate the audio. services/audio-processor.cjs
# defaults to 'repair', the branch measured to amputate final words (final-word
# retention 0.52 vs 0.93, p=0.00001 — docs/audio-tail-gate-decision-memo-2026-08-04.md).
# The installed unit on watson-1 has carried this since 2026-08-04; the repo copy had
# drifted without it, so any machine provisioned from git would silently render damaged.
# PRE-START SYNTAX GUARD (2026-08-08). Same guard production-api already
# carries: refuse to start a file node cannot parse, and say which file and
# which SyntaxError, instead of crash-looping every 5 seconds behind
# Restart=always. Last line of defence — by the time this fires the old
# process is already gone. The one that saves the service is in
# ops/watchdog/popty-staleness-watchdog.sh, which checks BEFORE restarting.
ExecStartPre=/usr/bin/node tools/check-service-syntax.cjs services/phases/phase8-audio-v13.cjs
ExecStart=/usr/bin/node services/phases/phase8-audio-v13.cjs
Restart=always
RestartSec=5
# See popty-production-api.service — prefer killing a restartable service over
# the user manager that supervises it.
OOMScoreAdjust=500
# Phase 8 shells out to long-running TTS/generation work. Do not let a restart
# of this unit kill in-flight children.
KillMode=process
StandardOutput=append:/home/tomcassidy/.local/log/popty-phase8-audio.log
StandardError=append:/home/tomcassidy/.local/log/popty-phase8-audio.log

[Install]
WantedBy=default.target
