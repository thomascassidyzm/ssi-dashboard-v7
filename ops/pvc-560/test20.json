[{"aid": "e35fb6aa-c2c5-4b24-b97a-36b74110d444", "text": "the boy is the youngest", "role": "use", "wc": 4, "seed": 153, "lego": "S0153L01"}, {"aid": "1ef22c56-c155-44f8-9ceb-3bba00c1cf11", "text": "it was interesting", "role": "use", "wc": 3, "seed": 106, "lego": "S0106L03"}, {"aid": "a3fb37e6-a7b9-4647-a7ad-131f2e6777fa", "text": "the youngest is ten", "role": "use", "wc": 4, "seed": 188, "lego": "S0188L01"}, {"aid": "eaa6f242-3b83-48fe-82a2-b72abaa62ec0", "text": "do you like to read?", "role": "use", "wc": 4, "seed": 165, "lego": "S0165L01"}, {"aid": "75197704-5872-4ca0-81df-f5e5671007de", "text": "are you going to watch that film tomorrow?", "role": "use", "wc": 8, "seed": 113, "lego": "S0113L01"}, {"aid": "539494a6-b267-4cc2-bb06-20cba9f20503", "text": "how are you feeling about the football?", "role": "use", "wc": 7, "seed": 197, "lego": "S0197L01"}, {"aid": "646e3ab5-412a-44ac-b83c-2789ee831d17", "text": "do you feel like going out tonight?", "role": "use", "wc": 7, "seed": 257, "lego": "S0257L02"}, {"aid": "5a238103-ad12-4ffd-81bd-fc57b4f665da", "text": "do you think I should take a risk?", "role": "use", "wc": 8, "seed": 230, "lego": "S0230L01"}, {"aid": "8157d74f-4f2d-40e0-b522-4e10e3990f08", "text": "yes, the boy is fifteen and the girl is ten", "role": "use", "wc": 10, "seed": 149, "lego": "S0149L01"}, {"aid": "40d0c20b-c3a8-4b00-9591-8db41d6ae573", "text": "I went out on Saturday night and I had a glass or two of water", "role": "use", "wc": 13, "seed": 112, "lego": "S0112L02"}, {"aid": "80c9970b-e258-49cf-be78-ad29336efe56", "text": "yes, we\u2019ve got one boy and the girl there", "role": "use", "wc": 9, "seed": 149, "lego": "S0149L01"}, {"aid": "dd6a4804-431f-44d6-8cbc-62b192087399", "text": "I\u2019d rather watch the football tomorrow morning but my mother doesn\u2019t like it", "role": "use", "wc": 15, "seed": 115, "lego": "S0115L01"}, {"aid": "aa1f5db6-55c0-4928-b43f-927ed8caca6e", "text": "I met someone last night who told me that he wants to learn Welsh", "role": "use", "wc": 13, "seed": 114, "lego": "S0114L03"}, {"aid": "2246881c-701a-46f6-ae1a-e060673ffca9", "text": "we want them to make sure if you wanted milk with your coffee", "role": "use", "wc": 15, "seed": 257, "lego": "S0257L02"}, {"aid": "f4a75749-f923-4d93-b0ea-b61bc5072b34", "text": "have you heard that we want them to spend more time at home?", "role": "use", "wc": 14, "seed": 209, "lego": "S0209L01"}, {"aid": "2c6313ac-7734-4803-ab10-c72c18918f01", "text": "it was fairly good, they say", "role": "use", "wc": 6, "seed": 242, "lego": "S0242L01"}, {"aid": "f1825b06-d1ca-45f8-bb7f-8fa5cd70e6f1", "text": "we\u2019ve got two girls and one boy", "role": "use", "wc": 8, "seed": 156, "lego": "S0156L01"}, {"aid": "a53c0f44-2d30-4a05-9f84-e4e46ae697d8", "text": "she wants to relax for a while tomorrow morning", "role": "use", "wc": 8, "seed": 114, "lego": "S0114L02"}, {"aid": "91754af0-2007-4416-b182-894fa6e01731", "text": "I\u2019ve still got a lot to learn", "role": "use", "wc": 7, "seed": 135, "lego": "S0135L01"}, {"aid": "0a2a29b3-a1f1-4077-878d-054285a3de19", "text": "to speak with you in the restaurant", "role": "use", "wc": 7, "seed": 79, "lego": "S0079L02"}]