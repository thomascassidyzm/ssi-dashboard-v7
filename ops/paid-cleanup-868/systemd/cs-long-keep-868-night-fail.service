[Unit]
Description=cs #868 night runner backstop: wake the job if the night unit fails or cannot start

[Service]
Type=oneshot
ExecStart=/bin/bash -lc 'node %h/command-surface/tools/cs-wake-send.cjs 1a7af9ed-9077-4f45-9354-1a5218876914 "$(cat %h/.cs-long/868/.tok)" "[868 night] UNIT FAILED at $(date -u +%%FT%%TZ): $(systemctl --user show cs-long-keep-868-night -p Result -p ExecMainStatus --value | tr "\\n" " ") (journalctl --user -u cs-long-keep-868-night)"'
