<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ssi.popty-watchdog</string>

    <!-- A separate launchd job from the two it watches, on purpose. See the
         header of holmes-popty-watchdog.sh. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>__CHECKOUT__/ops/launchd/holmes-popty-watchdog.sh</string>
    </array>

    <key>StartInterval</key>
    <integer>120</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>__CHECKOUT__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>__HOME__</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__LOGDIR__/popty-watchdog.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__LOGDIR__/popty-watchdog.launchd.err.log</string>
</dict>
</plist>
