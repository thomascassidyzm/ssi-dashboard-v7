  "eng_for_hin:pod-1:SC10-S07": [
   ["Thank you, you've been very helpful.","धन्यवाद, आपने बहुत मदद की।","73098d09-784b-4315-9ee0-5a72f5eb7497","09bc1e73-feef-4fea-958d-166ba90afa67"],
   ["I'm very grateful.","मैं बहुत आभारी हूँ।","183c9aab-6cc8-4ef7-a550-78a8a5054418","7fb38a46-29f1-46c4-b8ca-27228910a5fc"]
  ],
  "eng_for_hin:pod-1:SC10-S08": [
   ["You're welcome.","आपका स्वागत है।","5d55041c-5685-48c7-9859-fde2677a459f","069d5274-0d3b-4578-aa8f-0f84e6344ccb"],
   ["Are you here on holiday?","क्या आप यहाँ छुट्टियों पर हैं?","909170cd-510c-4d58-8f30-89233fe84c43","21619258-44d0-45c2-b921-655dc4cbd94f"],
   ["You speak very good English.","आप बहुत अच्छी अंग्रेज़ी बोलते हैं।","d930f751-8149-409f-995b-67eb885cda2c","ff184a8c-9908-4fae-9b6e-411537bb7578"]
  ],
  "eng_for_hin:pod-1:SC10-S09": [
   ["That's very kind of you!","यह आपकी बहुत बड़ी मेहरबानी है!","c2c7822d-85f6-4eea-9869-edd3f40db30f","3417cbbd-2df5-4a76-8a65-a21735c1b4ca"],
