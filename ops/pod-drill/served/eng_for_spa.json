   ["The lamb is excellent.","El cordero está excelente.","47f95686-b1e2-4b48-83ae-5fb7e353f2ac","f40ca4c1-4084-4839-b574-7e470ed2e3b9"],
   ["It's been slow-cooked, with rosemary.","Está cocinado a fuego lento, con romero.","4c7ee99d-d373-449b-af3b-8753c5c96d53","4de55d70-39a8-4f5a-bc0c-fad6fcc6fcae"]
  ],
  "eng_for_spa:pod-1:SC09-S09": [
   ["I'll have the lamb, please.","Tomaré el cordero, por favor.","dc38313c-b001-41cb-95ef-67bdaa49b7c9","eba6f85e-7c3e-4f58-a974-082eaa16d1ce"],
   ["With a side of greens.","Con una guarnición de verduras.","bd3ce971-b135-4254-bf65-c876b6672b0b","e3b47e7a-da31-4002-8506-0eb08be6a65b"]
  ],
  "eng_for_spa:pod-1:SC09-S10": [
   ["And the risotto for me.","Y para mí el risotto.","0ab13c8c-60dc-46a1-a2e0-05939a8a206e","e30a6c9c-cea6-4cfc-946f-9942aed0d0aa"],
   ["With a small green salad to start.","Con una ensalada verde pequeña para empezar.","70fb684a-eed0-4494-ae67-5e3693ac68d1","493fd703-d43b-400c-b612-3f5cc407e4fd"]
  ],
  "eng_for_spa:pod-1:SC09-S11": [
   ["Of course.","Por supuesto.","73e1ade0-040c-4d28-a285-138a727f1253","f580d165-4dde-45a9-a788-e70cf74fc3df"],
   ["And what would you like to drink?","¿Y qué desean para beber?","fda6d28c-2fff-436f-8ff7-2216faa48f38","f2b2571e-0043-4fb8-add9-36c075714a84"]
  ],
  "eng_for_spa:pod-1:SC09-S14": [
   ["Excellent choice.","Excelente elección.","56d7746a-237a-49bc-be1e-f6452fbbb0e7","aff23af1-a8d8-4b16-beb6-b72504bbc1a4"],
   ["I'll bring it right over.","Se la traigo enseguida.","9bc615d5-cc29-4f18-9644-108ef9da1f8d","55ac017f-e47b-4a7c-8786-b11c3fa9789b"]
  ],
  "eng_for_spa:pod-1:SC09-S15": [
   ["Is everything alright?","¿Está todo bien?","23266310-e53f-4e74-bb89-2a6e5edda66b","3b2101d5-6013-4efd-ad6d-4525dba3bda2"],
   ["Do you have any room for dessert?","¿Les apetece algún postre?","df370956-ad47-4c90-90e2-96f3720ad1b3","82115528-60ae-4e31-8dce-3dba66ad4829"]
  ],
  "eng_for_spa:pod-1:SC09-S16": [
   ["Just two coffees, please.","Solo dos cafés, por favor.","1b4795de-9cab-44ac-bf10-bdf2871e639c","a6d99b92-cd26-495e-8f1d-e8e8661b9be0"],
   ["Decaf for me.","El mío descafeinado.","c1dc2e72-fda3-49bd-8ea0-a1cf6d02e0ee","f9a6200f-0d30-4db9-b5c3-4119db42ba8d"]
  ],
  "eng_for_spa:pod-1:SC09-S17": [
   ["And the bill, when you're ready.","Y la cuenta, cuando puedan.","2e348068-1608-4110-be5b-fc7b194533dc","f0b8e61f-b758-49f4-abe8-ebef9276d6d3"],
   ["Could we split it?","¿Podríamos pagar a medias?","7876bf13-7cb4-4435-a8c2-195200bded48","45a09670-2488-40c7-a83e-00bd6b83f74e"]
  ],
  "eng_for_spa:pod-1:SC10-S01": [
   ["Excuse me.","Disculpe.","4d35ce53-4b8e-465f-b7a9-b95426abe3f8","a89e5d4c-9878-4f16-8c28-3d952bbb0e86"],
   ["Do you have any painkillers?","¿Tienen analgésicos?","ef9a5855-5c1c-410b-bdcf-ab14fb36c925","cbe15eda-83a3-43df-bd4d-3714c473dca2"]
  ],
  "eng_for_spa:pod-1:SC10-S03": [
   ["Thank you.","Gracias.","e8c75798-5ad0-47f4-926d-48a88505f3d8","31a7f04d-7b64-4a1d-bab4-5580f9a129f4"],
   ["And do you have any painkillers for children?","¿Y tienen analgésicos para niños?","92a7c00c-c8e9-447d-b822-048ead6c3a43","9573c131-2003-4c03-b2a6-6431673e8fba"]
  ],
  "eng_for_spa:pod-1:SC10-S04": [
   ["I think so,","Creo que sí,","083c1b13-324a-46db-9451-ad584921519f","ef9a1020-8557-4e30-90c4-fa96397f0bbc"],
   ["but you'll have to look to make sure.","pero tendrá que mirar para asegurarse.","82613111-5337-40a3-ab31-a9c5c8584196","9a33b826-417f-4877-9b05-74c7c8af2df6"]
  ],
  "eng_for_spa:pod-1:SC10-S05": [
   ["I also need to get","También necesito comprar","645d7a51-1d92-4954-96a4-6d0d23a37e58","5e630721-de19-4169-9244-ea5d3fbbc8ed"],
   ["some sunscreen","protector solar","5e81547f-c90c-4e15-9072-7365fd047989","dbb5cc6b-6796-4afe-bf92-a5b037439ebd"],
   ["and some toothpaste.","y pasta de dientes.","aee53ccf-1f3f-49d4-989c-96606684c866","ec9c4a8b-a885-46d9-b763-4c26a8e2b0b8"]
  ],
  "eng_for_spa:pod-1:SC10-S06": [
   ["Sunscreen is down there on your right,","El protector solar está allí, a su derecha,","f3d54e12-858b-4a6a-86ea-2911127e1cb1","53f6e3e3-81fe-4f2a-928b-08a72b50397d"],
   ["and you'll find toothpaste just round the corner.","y la pasta de dientes la encontrará justo a la vuelta de la esquina.","e6b8c96d-d7c9-48e1-8e08-d816b98d60e2","101e9b77-f4c0-4cf9-9029-4338217f6918"]
  ],
  "eng_for_spa:pod-1:SC10-S07": [
   ["Thank you, you've been very helpful.","Gracias, ha sido de mucha ayuda.","73098d09-784b-4315-9ee0-5a72f5eb7497","eb52f570-fb78-49d9-bf53-c723619d82d8"],
   ["I'm very grateful.","Se lo agradezco mucho.","183c9aab-6cc8-4ef7-a550-78a8a5054418","c29f704b-99a6-4a9d-82fc-8785819f7628"]
  ],
  "eng_for_spa:pod-1:SC10-S08": [
   ["You're welcome.","De nada.","5d55041c-5685-48c7-9859-fde2677a459f","1bb4d88d-e7dc-45dc-83fe-7de3ab3b1394"],
   ["Are you here on holiday?","¿Está aquí de vacaciones?","909170cd-510c-4d58-8f30-89233fe84c43","4e8aef98-0e7b-4e1e-8148-d7d4b6e0b99e"],
   ["You speak very good English.","Habla usted muy bien inglés.","d930f751-8149-409f-995b-67eb885cda2c","32c4b092-5834-4433-bad1-96a96280181c"]
  ],
  "eng_for_spa:pod-1:SC10-S09": [
   ["That's very kind of you!","¡Es usted muy amable!","c2c7822d-85f6-4eea-9869-edd3f40db30f","369461f4-b261-405f-8277-65876c01bb70"],
   ["Yes, I'm on holiday,","Sí, estoy de vacaciones,","de432528-dcca-4ce7-83d7-9b34da210201","d14d9fdd-a8dc-4d3e-a570-39e4de1463e4"],
   ["and I need to practice more","y necesito practicar más","4d2b0867-925e-4aad-bb73-da9b5cae2843","c2cf72e3-1e5e-454e-938e-fe67dd81a5f8"],
   ["to speak English better.","para hablar mejor inglés.","a69b525a-18c7-4c5c-9fe5-feaba6e1cc9f","4f2b58be-147a-404f-a905-32e0b0428884"],
   ["Thank you very much, and goodbye.","Muchas gracias, y adiós.","9dbc5c36-be61-49de-91f1-b5901009c321","f915a182-297c-4b0c-9323-0fb44b231b7b"]
  ]
 }
