  ],
  "eng_for_zho:pod-1:SC09-S08": [
   ["The lamb is excellent.","羊肉非常好。","47f95686-b1e2-4b48-83ae-5fb7e353f2ac","e0f492a5-88a1-49cf-be85-e1c5c0f267f7"],
