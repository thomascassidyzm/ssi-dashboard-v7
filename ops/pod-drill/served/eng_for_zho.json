   ["I've been here for two years.","我在这里已经两年了。","6787458b-7bf7-438a-9a06-f25d960191db","e793656d-2715-4bf7-be0b-fba75a644e59"]
  ],
  "eng_for_zho:pod-1:SC06-S07": [
