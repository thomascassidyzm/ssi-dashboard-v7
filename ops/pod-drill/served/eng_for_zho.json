  ],
  "eng_for_zho:pod-1:SC06-S08": [
   ["I'm a nurse,","我是护士，","66c08773-855e-494b-9132-96d779bdbf52","75950f6f-40ac-484a-8c7f-8e1d2a8ca966"],
   ["at the hospital just round the corner.","就在拐角那家医院工作。","224157b8-3cb9-4f16-ab38-eee9ea81cbef","8193f229-88e8-4fe4-a8f4-ebd2d4616664"],
