   ["and they're both local.","两款都是本地的。","ceb53cc2-0ea3-4f77-80f6-d6fa308291a8","95a40697-1ad6-4534-a3d2-f68a91abd2d8"]
  ],
  "eng_for_zho:pod-1:SC08-S06": [
