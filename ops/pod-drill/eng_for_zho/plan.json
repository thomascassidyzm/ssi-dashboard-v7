    {"id": "SC07-S10", "whole": "one statement, right size"},
    {"id": "SC07-S11", "pieces": [["Could I pay by card?", "我可以刷卡吗？"], ["Do you have contactless?", "您们有非接触式支付吗？"]]},
    {"id": "SC07-S12", "pieces": [["Of course.", "当然可以。"], ["There's the machine.", "机器在那边。"]]},
    {"id": "SC07-S13", "pieces": [["Good morning.", "早上好。"], ["Two Americanos and a cup of tea, please.", "麻烦您，两杯美式咖啡和一杯茶。"]]},
    {"id": "SC07-S14", "pieces": [["Would you like to sit-in?", "您要堂食吗？"], ["The table by the window is free.", "靠窗的那张桌子是空的。"]]},
