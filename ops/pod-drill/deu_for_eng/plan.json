    {"id":"SC07-S012","pieces":[["Natürlich.","Of course."],["Das Gerät ist hier.","There's the machine."]]},
    {"id":"SC07-S013","pieces":[["Guten Morgen.","Good morning."],["Zwei Americanos und einen Tee, bitte.","Two Americanos and a cup of tea, please."]]},
