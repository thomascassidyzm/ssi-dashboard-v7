   "set": {
    "known_text": "今面白いことをやっている",
    "known_audio_id": "981b3cfe-cba2-40dc-9144-aece28d5bc5b"
   }
  },
  {
   "op": "phrase.update",
   "phrase_id": "eng_for_jpn:S0071L05U12",
   "set": {
    "known_text": "私は本当のことを言いたくなかったので少し時間がかかりました",
