  {
   "id": "zho_for_eng:pod-1:SC09-S005",
   "pod": "zho_for_eng:pod-1",
   "scene": 9,
   "speaker": "Diner 1",
   "target": "麻烦一下——你们有无麸质的菜吗？或者适合素食者的？",
