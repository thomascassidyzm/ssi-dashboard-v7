  {
   "id": "zho_for_eng:pod-1:SC09-S017",
   "pod": "zho_for_eng:pod-1",
   "scene": 9,
   "speaker": "Diner 2",
   "target": "还有账单，方便的时候给我们。可以分开付吗？",
   "known": "And the bill, when you're ready. Could we split it?",
   "targetAudioId": "29dea8d0-3e74-4d26-9c9d-ce1cce8ce7c8",
   "knownAudioId": "f7621e32-60ee-4a98-be81-cc6bc005a3d6",
