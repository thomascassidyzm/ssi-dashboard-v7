  },
  {
   "id": "zho_for_eng:pod-1:SC12-S001",
   "pod": "zho_for_eng:pod-1",
   "scene": 12,
   "speaker": "Customer",
   "target": "早上好。我感觉不太舒服——你能给我推荐点什么吗？",
   "known": "Good morning. I'm not feeling great - could you recommend something?",
   "targetAudioId": "da12e3b9-1322-451d-ae6d-072857b8d956",
   "knownAudioId": "b56985b0-2cb3-48cc-bb75-1b468e738d16",
   "targetVoice": "xai_33g9t0jl",
   "knownVoice": "xai_bedd6226",
   "wordTimings": null,
   "knownWordTimings": null,
   "chunks": [],
   "kind": "whole-turn",
   "why": "no sentence clips"
  },
  {
   "id": "zho_for_eng:pod-1:SC14-S002",
   "pod": "zho_for_eng:pod-1",
   "scene": 14,
   "speaker": "Driver",
   "target": "好的，当然可以。可能要花一点时间，现在路上很堵。",
   "known": "Yes, of course. It may take some time, there's a lot of traffic at the moment.",
   "targetAudioId": "9cbf2d14-ee84-49be-9821-218e29539c34",
   "knownAudioId": "88db5158-65ef-426c-915e-b19fcad9e798",
   "targetVoice": "xai_33g9t0jl",
   "knownVoice": "xai_bedd6226",
   "wordTimings": null,
   "knownWordTimings": null,
