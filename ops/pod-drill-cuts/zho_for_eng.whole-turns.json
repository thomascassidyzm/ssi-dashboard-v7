  {
   "id": "zho_for_eng:pod-1:SC11-S008",
   "pod": "zho_for_eng:pod-1",
   "scene": 11,
   "speaker": "Receptionist",
   "target": "从七点半到十点。有水果和麦片，也有热食早餐。",
   "known": "From half-past seven until ten o'clock. We have fruit and cereals or a cooked breakfast.",
   "targetAudioId": "361cac7f-15d0-45e9-8425-19fd9bff381f",
   "knownAudioId": "eb04d32e-3691-4c7d-8ab5-98ae02e45747.v2",
   "targetVoice": "xai_33g9t0jl",
   "knownVoice": "bedd6226",
