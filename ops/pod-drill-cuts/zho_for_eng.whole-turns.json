  {
   "id": "zho_for_eng:pod-1:SC10-S009",
   "pod": "zho_for_eng:pod-1",
   "scene": 10,
   "speaker": "Customer",
   "target": "你太好了！是的，我在度假，我需要多练习才能把中文说得更好。谢谢你，再见。",
   "known": "That's very kind of you! Yes, I'm on holiday, and I need to practice more to speak Chinese better. Thank you very much, and goodbye.",
   "targetAudioId": "7d7a2d87-d3c2-49e3-bbaf-a05eefb68d94",
   "knownAudioId": "392188c9-951e-42e4-a7fb-ec4afe6f18c9",
