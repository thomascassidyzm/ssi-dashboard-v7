# SSi Automation Configuration Template
# Copy this file to .env.automation and customize for your local machine

# =============================================================================
# REQUIRED: Path to your SSi Course Production folder
# =============================================================================
# This is the ONLY thing you must configure!
#
# Tom's path:
# VFS_ROOT=/Users/tomcassidy/SSi/SSi_Course_Production
#
# Kai's path:
# VFS_ROOT=/Users/kai/Projects/SSi_Course_Production
#
VFS_ROOT=/path/to/your/SSi_Course_Production

# =============================================================================
# Node.js Memory Configuration
# =============================================================================
# Increase Node.js heap memory limit for large course builds and manifest generation
# Default Node limit is ~2GB, we increase to 8GB for memory-intensive operations
# This is already set in package.json scripts, but can be overridden here
#
# NODE_OPTIONS=--max-old-space-size=8192

# =============================================================================
# Core Configuration
# =============================================================================

# Base port for automation services (others auto-increment from this)
# Default: 3456
BASE_PORT=3456

# Checkpoint mode controls phase automation behavior
# - manual: Pause between phases, require user approval (safest for testing)
# - gated: Auto-run phases but pause if validators fail (recommended)
# - full: Full automation, no stops (for production after validation)
# Default: gated
CHECKPOINT_MODE=gated

# Use legacy monolith automation_server.cjs instead of layered services
# Set to 'true' if new layered services not yet ready
# Default: false
# LEGACY_MODE=false

# =============================================================================
# Port Assignments (auto-configured by start-automation.cjs)
# =============================================================================
# Orchestrator:           3456 (BASE_PORT)
# Phase 1 Translation:    3457 (BASE_PORT + 1)
# Phase 1 LEGO:           3458 (BASE_PORT + 2)
# Phase 3 Basket:         3459 (BASE_PORT + 3)
# Manifest Compilation:   3464 (BASE_PORT + 8)
# Phase 8 Audio:          3465 (BASE_PORT + 9)
# Phase 9 Manifest:       3466 (BASE_PORT + 10)
# Production API:         3470 (BASE_PORT + 14)

# =============================================================================
# Supabase Configuration (REQUIRED for Phase 8 & 9)
# =============================================================================
# Supabase is the Master Audio Registry (MAR) for audio generation
#
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=sb_secret_your_key_here

# Direct-Postgres credentials (SUPABASE_DB_PASSWORD, DATABASE_URL) do NOT
# belong in .env. Service code uses SUPABASE_SERVICE_KEY via the REST API —
# nothing in the running backend reads DATABASE_URL.
#
# If you genuinely need psql/pg_dump/migration tooling, put those in a
# separate `.env.psql` (gitignored via `.env.*`) and source it explicitly:
#
#   set -a; . .env.psql; set +a; psql "$DATABASE_URL"
#
# This keeps the direct-DB blast radius isolated from the main env file
# that sits next to the service-role key.

# =============================================================================
# AWS/S3 Configuration (REQUIRED for audio storage)
# =============================================================================
# S3 bucket:
# - ssi-audio-stage: THE ONLY S3 bucket we use (eu-west-1)
#
# NOTE: popty-bach-lfs is DEPRECATED - do NOT use it
#
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=eu-west-1

# S3 bucket names (defaults shown)
# S3_BUCKET=ssi-audio-stage          # Primary S3 bucket for course files
# S3_AUDIO_BUCKET=ssi-audio-stage    # Dedicated bucket for audio files
# AWS_S3_BUCKET=ssi-audio-stage      # Alias for S3_BUCKET (used in some services)
# S3_REGION=eu-west-1                # Alias for AWS_REGION (used in some services)

# =============================================================================
# TTS Services (REQUIRED for audio generation)
# =============================================================================

# Azure Speech Services (used for target1/target2 roles)
# Generate key at: https://portal.azure.com
AZURE_SPEECH_KEY=your_azure_key
AZURE_SPEECH_REGION=westeurope

# ElevenLabs API (used for source/presentation roles)
# Generate key at: https://elevenlabs.io/app/settings
ELEVENLABS_API_KEY=your_elevenlabs_key

# xAI TTS (used for known-side/English audio)
# Without this, xAI voice calls fail with "xAI not configured (XAI_API_KEY not set)"
# Generate key at: https://console.x.ai
XAI_API_KEY=your_xai_key

# Audio generation concurrency (parallel TTS requests)
# Azure S0 tier supports up to 20 concurrent connections
# Default: 5 (conservative to avoid rate limiting)
# AUDIO_CONCURRENCY=5

# =============================================================================
# Service Mesh URLs (auto-configured by start-automation.cjs)
# =============================================================================
# These are automatically set when start-automation.cjs runs.
# You can override them if needed for custom configurations.
#
# ORCHESTRATOR_URL=http://localhost:3456
# PHASE1_TRANSLATION_URL=http://localhost:3457
# PHASE1_LEGO_URL=http://localhost:3458
# PHASE3_URL=http://localhost:3459
# MANIFEST_URL=http://localhost:3464
# PHASE8_URL=http://localhost:3465
# PHASE9_URL=http://localhost:3466
# AUDIO_URL=http://localhost:3465
# PRODUCTION_API_URL=http://localhost:3470

# =============================================================================
# Multi-Agent Orchestration Configuration
# =============================================================================

# Delay between spawning agents (milliseconds) to avoid clipboard race conditions
# Default: 5000 (5 seconds)
# AGENT_SPAWN_DELAY=5000

# Advanced batch processing configuration
# These override the auto-calculated defaults based on seed range size
# SEGMENT_SIZE=50              # Seeds per segment
# AGENTS_PER_SEGMENT=5         # Agents per segment
# SEEDS_PER_AGENT=10           # Seeds per agent

# VFS monitoring interval (milliseconds) for file system watcher
# Default: 2000 (2 seconds)
# VFS_MONITOR_INTERVAL=2000

# Use orchestrator v2 architecture (experimental)
# Default: false
# USE_ORCHESTRATOR_V2=false

# Enable automatic git merging of agent branches
# Default: true
# GIT_AUTO_MERGE=true

# =============================================================================
# Validation Thresholds
# =============================================================================

# Phase 3 maximum acceptable error rate (0.0-1.0)
# Default: 0.05 (5% error rate)
# VALIDATION_THRESHOLD_PHASE3_ERROR_RATE=0.05

# Phase 5 maximum gate violations rate (0.0-1.0)
# Default: 0.02 (2% violation rate)
# VALIDATION_THRESHOLD_PHASE5_GATE_VIOLATIONS=0.02

# Phase 5 minimum quality score (0.0-1.0)
# Default: 0.95 (95% quality score)
# VALIDATION_THRESHOLD_PHASE5_QUALITY_SCORE=0.95

# =============================================================================
# Server Configuration
# =============================================================================

# Override individual service ports (auto-calculated from BASE_PORT if not set)
# PORT=3456                    # Override port for current service
# PRODUCTION_API_PORT=3470     # Production API port

# CORS origin for API requests
# Default: * (allow all origins)
# CORS_ORIGIN=*

# Base URL for authentication magic links and invites
# Default: http://localhost:5173
# BASE_URL=http://localhost:5173

# Service name for logging (auto-set by each service)
# SERVICE_NAME=Orchestrator

# Debug mode for verbose logging
# DEBUG=true

# =============================================================================
# Google Cloud TTS (Optional - alternative TTS provider)
# =============================================================================
# Google Cloud Text-to-Speech credentials
# Generate credentials at: https://console.cloud.google.com
#
# GOOGLE_PROJECT_ID=your-gcp-project-id
# GOOGLE_TTS_API_KEY=your-google-tts-key

# =============================================================================
# Database Architecture Flags (LEGACY - defaults to DATABASE mode)
# =============================================================================
# As of January 2026, courses are DATABASE-ONLY (Supabase).
# These flags exist for debugging only - DO NOT set to false in production.
#
# USE_DATABASE_WRITES=true   # Default: true - Write course data to Supabase
# USE_DATABASE_READS=true    # Default: true - Read course data from Supabase
#
# IMPORTANT: JSON files (lego_pairs.json, lego_baskets.json) are DEPRECATED.
# All course data (seeds, LEGOs, practice phrases, audio) lives in Supabase.
# The manifest is generated ON-DEMAND from database by manifest-generator.cjs.

# =============================================================================
# Deprecated/Legacy Services
# =============================================================================

# Legacy Phase 5 server URL (deprecated - use Phase 3)
# PHASE5_SERVER_URL=http://localhost:3459

# Training URL for dashboard links
# Default: https://ssi-dashboard-v7.vercel.app
# TRAINING_URL=https://ssi-dashboard-v7.vercel.app

# Test course code for development
# TEST_COURSE=spa_for_eng

# =============================================================================
# Optional Services
# =============================================================================

# Ngrok URL for external agent access (if using ngrok for orchestrator)
# Default: http://localhost:3456
# NGROK_URL=https://your-ngrok-url.ngrok.io

# Anthropic API for Claude-powered agents
# Generate key at: https://console.anthropic.com
# ANTHROPIC_API_KEY=your_anthropic_key

# =============================================================================
# Better Stack — uptime monitoring (optional)
# =============================================================================
# Powers the Maintenance > Uptime panel. Without this, the panel shows a setup
# CTA instead of live monitor data. Create a token at:
#   https://uptime.betterstack.com  → Integrations → API Tokens
# Monitors to add (60s interval each):
#   - https://saysomethingin.app/
#   - https://staging.saysomethingin.app/
#   - audio proxy health endpoint (TBD; for now ping prod root)
#
# BETTERSTACK_API_KEY=your_betterstack_token

# =============================================================================
# GitHub API (for dashboard editing - commits directly to GitHub)
# =============================================================================
# Generate a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo (Full control of private repositories)
#
# GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# Optional: Override defaults if using a different repo
# GITHUB_OWNER=thomascassidyzm
# GITHUB_REPO=ssi-dashboard-v7
# GITHUB_BRANCH=main

# =============================================================================
# Audio-intelligence engine (services/audio-intelligence/) — all optional
# =============================================================================
# No secrets here. Every value below has a working default baked into the code,
# so the engine runs with none of them set; they exist for calibration and for
# machines where the binaries are not on PATH.
#
# External binaries. decode.cjs shells out to these; defaults assume PATH.
# FFMPEG=ffmpeg
# FFPROBE=ffprobe
#
# Tier 1 — duration (tiers/duration.cjs)
# AIE_DURATION_SIGMA=2.5      # sigmas below expected duration before flagging short
# AIE_MAX_SYL_PER_SEC=9       # above this is not a speaking rate, it is damage
#
# Tier 2 — energy (tiers/energy.cjs)
# AIE_TAIL_MS=50              # window at the clip end that must not be cut mid-word
# AIE_CUT_DB=-6               # dB step across the tail that reads as a hard cut
#
# Tier 3 — VAD (tiers/vad.cjs)
# AIE_VAD_MARGIN_DB=12        # dB above the noise floor that counts as speech
# AIE_VAD_BRIDGE_MS=120       # gaps shorter than this are bridged, not split

# =============================================================================
# Build identity (services/shared/build-identity.cjs) — all optional
# =============================================================================
# Set these ONLY where git is unavailable at runtime (containers, cut snapshots).
# When set they are authoritative and the dirty-tree check is skipped, so whoever
# sets them is asserting what was actually deployed. Unset, identity is read from
# git in the checkout the process is running from.
#
# POPTY_BUILD_SHA=
# POPTY_BUILD_BRANCH=
