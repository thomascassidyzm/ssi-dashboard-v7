{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LEGO Baskets v11",
  "description": "Practice phrase baskets for each LEGO with structured IDs and phrase categories",
  "type": "object",
  "required": ["version", "course_code", "baskets"],
  "properties": {
    "version": {
      "type": "string",
      "const": "11.0.0"
    },
    "course_code": {
      "type": "string",
      "pattern": "^[a-z]{3}_for_[a-z]{3}$",
      "description": "Course identifier, e.g., spa_for_eng"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "baskets": {
      "type": "object",
      "description": "Map of LEGO ID to basket",
      "additionalProperties": {
        "$ref": "#/definitions/basket"
      }
    }
  },
  "definitions": {
    "basket": {
      "type": "object",
      "required": ["lego_id", "seed_id", "type", "lego", "debut", "practice_phrases"],
      "properties": {
        "lego_id": {
          "type": "string",
          "pattern": "^S[0-9]{4}L[0-9]{2}$",
          "description": "LEGO identifier, e.g., S0042L01"
        },
        "seed_id": {
          "type": "string",
          "pattern": "^S[0-9]{4}$",
          "description": "Parent seed identifier, e.g., S0042"
        },
        "type": {
          "type": "string",
          "enum": ["A", "M"],
          "description": "A=Atomic (single word), M=Molecular (multi-word)"
        },
        "new": {
          "type": "boolean",
          "description": "true=first introduction, false=review (no intro_item in manifest)"
        },
        "lego": {
          "$ref": "#/definitions/phrase",
          "description": "The LEGO itself (known/target pair)"
        },
        "components": {
          "type": "array",
          "description": "Building blocks for M-type LEGOs (empty for A-type)",
          "items": {
            "$ref": "#/definitions/indexed_phrase"
          }
        },
        "debut": {
          "$ref": "#/definitions/indexed_phrase",
          "description": "The LEGO as first practice (is_debut: true)"
        },
        "practice_phrases": {
          "type": "array",
          "description": "Core practice phrases, ordered by difficulty/length",
          "items": {
            "$ref": "#/definitions/indexed_phrase"
          }
        },
        "eternal_phrases": {
          "type": "array",
          "description": "Phrases for spaced repetition and long-term review",
          "items": {
            "$ref": "#/definitions/indexed_phrase"
          }
        }
      }
    },
    "phrase": {
      "type": "object",
      "required": ["known", "target"],
      "properties": {
        "known": {
          "type": "string",
          "description": "Source language text (e.g., English)"
        },
        "target": {
          "type": "string",
          "description": "Target language text (e.g., Spanish)"
        }
      }
    },
    "indexed_phrase": {
      "type": "object",
      "required": ["id", "known", "target"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^S[0-9]{4}L[0-9]{2}-(C|P|E|DEB)[0-9]{0,3}$",
          "description": "Structured ID: S0042L01-P001, S0042L01-C01, S0042L01-DEB0, S0042L01-E001"
        },
        "known": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "notes": {
          "type": "string",
          "description": "Optional notes for QA or context"
        }
      }
    }
  }
}
