# APML Service: Course Builder API
# Version: 4.0.0 (2026-02-09)
# Status: Production-ready
# Server Port: 3471

service CourseBuilderAPI:
  name: "Course Builder API"
  version: "4.0.0"
  port: 3471
  purpose: "Bulletproof API for LLM agents to insert course content"

  ## ==========================================================================
  ## OVERVIEW
  ## ==========================================================================

  description: |
    The Course Builder API provides a validated, bulletproof interface for LLM agents
    to insert course content (seeds, LEGOs, practice phrases) into the database.

    All content is validated BEFORE insertion using multiple quality gates.
    The API enforces functional determinism (ZUT principle) and proper M-LEGO structure.

    v4.0 adds parallel draft builds (multi-agent seed decomposition with finalization),
    a full QA workflow (flag/resolve/dismiss lifecycle), QA agent spawning, and
    cross-course calibration endpoints.

  architecture:
    database: "Supabase (course_seeds, course_legos, course_practice_phrases, course_seed_drafts, course_qa_flags)"
    validation: "All validations run BEFORE any database writes"
    atomicity: "Golden path endpoint is all-or-nothing"

  endpoint_count: 71

  ## ==========================================================================
  ## GOLDEN PATH: POST /api/seed/complete
  ## ==========================================================================

  golden_path:
    endpoint: "POST /api/seed/complete"
    description: |
      THE RECOMMENDED APPROACH: Submit a complete seed with translation and all LEGOs atomically.
      Validates everything upfront, inserts all or nothing.

      Agent completes one seed at a time:
      1. Translate the seed (known -> target)
      2. Decompose into LEGOs
      3. Create practice phrases for each LEGO
      4. Submit everything in one request

      Draft mode: Append ?draft=true to route submissions to course_seed_drafts
      instead of live tables. Used during parallel builds where multiple agents
      decompose seeds concurrently and a finalization step resolves collisions.

    request_body:
      course_code: "string (e.g., 'zho_for_eng')"
      seed_number: "integer (1-668)"
      known_text: "string (English seed sentence)"
      target_text: "string (target language translation)"
      legos: |
        array of LEGO objects:
        [
          {
            "idx": 1,
            "type": "A",
            "known": "I",
            "target": "我",
            "phrases": [{"known": "I speak", "target": "我说"}, ...]
          },
          {
            "idx": 2,
            "type": "M",
            "known": "want to learn",
            "target": "想学",
            "components": [{"known": "want", "target": "想"}, {"known": "learn", "target": "学"}],
            "phrases": [...]
          }
        ]

    example_request: |
      POST /api/seed/complete
      {
        "course_code": "zho_for_eng",
        "seed_number": 42,
        "known_text": "I want to learn Chinese",
        "target_text": "我想学中文",
        "legos": [
          {
            "idx": 1,
            "type": "A",
            "known": "I",
            "target": "我",
            "phrases": [
              {"known": "I speak", "target": "我说"},
              {"known": "I understand", "target": "我明白"}
            ]
          },
          {
            "idx": 2,
            "type": "M",
            "known": "want to learn",
            "target": "想学",
            "components": [
              {"known": "want", "target": "想"},
              {"known": "learn", "target": "学"}
            ],
            "phrases": [
              {"known": "I want to learn", "target": "我想学"},
              {"known": "want to learn Chinese", "target": "想学中文"}
            ]
          },
          {
            "idx": 3,
            "type": "A",
            "known": "Chinese",
            "target": "中文",
            "phrases": [
              {"known": "speak Chinese", "target": "说中文"},
              {"known": "learn Chinese", "target": "学中文"}
            ]
          }
        ]
      }

    success_response: |
      {
        "ok": true,
        "seed": "S0042",
        "known_text": "I want to learn Chinese",
        "target_text": "我想学中文",
        "legos": 3,
        "duplicates_skipped": 0,
        "phrases": 24,
        "buildup_phrases": 3
      }

    failure_response: |
      {
        "error": "Validation failed",
        "seed": "S0042",
        "errors": [
          {
            "type": "zut",
            "message": "ZUT violation - same known text maps to different targets",
            "violations": [...],
            "skills": ["/ssi-decompose-seed", "/ssi-add-overlapping-legos"]
          }
        ],
        "skills": ["/ssi-learner-pattern", "/ssi-decompose-seed", "/ssi-build-phrases"],
        "hint": "Fix all errors and resubmit. Nothing was inserted. Review listed skills for guidance."
      }

  ## ==========================================================================
  ## VALIDATION GATES
  ## ==========================================================================

  validation_gates:
    description: |
      All validations run BEFORE any database writes.
      If ANY validation fails, NOTHING is inserted.

      Smart vocabulary caching: LRU cache with 30-minute TTL, max 10 courses.
      loadCourseVocab() loads existing DB vocabulary before tiling check,
      so agents only need to submit NEW LEGOs -- prior vocabulary is already known.

      Draft mode: When ?draft=true, submissions go to course_seed_drafts
      instead of live tables. Vocabulary validation still runs against
      existing live-table LEGOs plus a local vocabSet for the draft session.
      Collisions are deferred to the finalization step.

    ## =========================================================================
    ## SKILL REFERENCES - Error -> Guidance Mapping
    ## =========================================================================
    ##
    ## When validation fails, error responses include relevant skills for agents
    ## to review. Skills are Claude Code commands in .claude/commands/
    ##
    skill_mapping:
      canonical_mismatch:
        skills: ["/course-resume"]
        rationale: "Agent likely lost context - resume skill explains recovery"

      zut_violation:
        skills: ["/ssi-decompose-seed", "/ssi-add-overlapping-legos"]
        rationale: "Agent needs to understand upchunking and overlap patterns"

      vocabulary_violation:
        skills: ["/ssi-build-phrases"]
        rationale: "Agent needs to understand available vocabulary rules"

      phrase_count:
        skills: ["/ssi-build-phrases", "/ssi-phrase-variety"]
        rationale: "Agent needs phrase count rules and distribution guidance"

      phrase_tier:
        skills: ["/ssi-build-phrases", "/ssi-phrase-variety"]
        rationale: "Agent needs SHORT/MEDIUM/LONG distribution guidance"

      grammar_explanation:
        skills: ["/ssi-decompose-seed", "/ssi-learner-pattern"]
        rationale: "Agent included grammar labels in known_text (zero explanations rule)"

      general_methodology:
        skills: ["/ssi-learner-pattern", "/ssi-decompose-seed", "/ssi-build-phrases"]
        rationale: "Core methodology skills for any confusion"

    gate_0_canonical_mismatch:
      name: "Canonical Seed Validation"
      description: |
        Prevents hallucinated seeds after context compaction.
        If agent provides known_text, it MUST match the canonical seed in the database.

        Why this matters:
        - After long runs, context compaction may cause agent to "invent" seeds
        - Agent might follow patterns rather than fetching actual seed text
        - This gate catches the mismatch and shows the correct seed

      check: "agent_known_text vs course_seeds.known_text (normalized comparison)"
      error_format: |
        {
          "error": "CANONICAL MISMATCH: Your known_text does not match the canonical seed",
          "seed": "S0105",
          "you_sent": "[hallucinated seed text]",
          "canonical": "[actual seed from database]",
          "skills": ["/course-resume"],
          "hint": "Use the EXACT canonical seed text. Fetch from GET /api/seeds if unsure. Review /course-resume for context recovery."
        }

      resolution: "Agent must fetch correct seed via GET /api/seeds and resubmit"

    gate_1_zut_conflict:
      name: "ZUT (Zero Untaught) Conflict Detection"
      description: |
        Same known text cannot map to different targets (ambiguous prompt).
        This is a functional determinism violation - learner wouldn't know which answer is correct.

      scenarios:
        no_conflict:
          condition: "Known text is unique (not seen before)"
          action: "Proceed with is_new: true"

        duplicate:
          condition: "Same known + same target exists"
          action: "Mark is_new: false, skip basket generation"
          rationale: "LEGO already introduced - don't create redundant baskets"

        zut_violation:
          condition: "Same known + DIFFERENT target exists"
          action: "REJECT with helpful error"
          error_format: |
            {
              "error": "ZUT violation: ambiguous prompt",
              "known_text": "to learn",
              "new_target": "学习",
              "existing": [{"target": "学", "legoId": "S0002L02"}],
              "skills": ["/ssi-decompose-seed", "/ssi-add-overlapping-legos"],
              "suggestions": [
                "UPCHUNK: Add context to disambiguate (recommended)",
                "  - 'to learn' -> '学' (existing)",
                "  - '[more specific phrase]' -> '学习' (new)",
                "SYNONYM: Use different known text",
                "  - Find a synonym or variant for 'to learn'",
                "Review /ssi-add-overlapping-legos for overlap patterns"
              ]
            }

      resolution_strategies:
        upchunk:
          description: "Add context to disambiguate - creates natural M-LEGO"
          example:
            before: "'to learn' -> '学习' (conflicts with 'to learn' -> '学')"
            after: "'to study formally' -> '学习' (no conflict)"
          recommended: true

        synonym:
          description: "Use different known text"
          example:
            before: "'to learn' -> '学习'"
            after: "'to study' -> '学习'"
          note: "Less elegant but acceptable"

    gate_2_vocabulary:
      name: "Vocabulary Validation (ZUT Principle)"
      description: |
        Phrases can only use vocabulary that has been introduced.
        Per-course vocabulary tracking with LRU cache (max 10 courses, 30-min TTL).

        loadCourseVocab() loads existing vocabulary from the database before checking,
        so agents do not need to resubmit already-introduced LEGOs.

      what_counts_as_introduced:
        - "A-type LEGO target text (single word)"
        - "M-type LEGO target text (all words)"
        - "M-type component targets (individual words)"

      chinese_mode: "Character-level validation"
      european_mode: "Word-level validation (space-separated)"

      example_violation:
        lego: {known: "I", target: "我"}
        phrase: {known: "I drink", target: "我喝"}
        error: "Vocabulary violation: '喝' not yet introduced"

      error_format: |
        {
          "error": "Vocabulary violation",
          "phrase": "我喝",
          "unknown_words": ["喝"],
          "skills": ["/ssi-build-phrases"],
          "hint": "Phrases can only use vocabulary already introduced. Review /ssi-build-phrases for available vocabulary rules."
        }

    gate_3_phrase_count:
      name: "Minimum Phrase Count"
      description: |
        Each LEGO must have sufficient practice phrases.
        Graduated minimums based on LEGO position in course.

      minimums:
        positions_1_3: "1 phrase minimum (first 3 LEGOs)"
        positions_4_6: "2 phrases minimum"
        positions_7_10: "3 phrases minimum"
        positions_11_plus: "7 phrases minimum"

      target: "10 phrases per LEGO"
      maximum: "13 phrases (diminishing returns)"

      error_format: |
        {
          "error": "Insufficient phrases",
          "lego_id": "S0042L03",
          "position": 42,
          "submitted": 3,
          "minimum_required": 7,
          "skills": ["/ssi-build-phrases", "/ssi-phrase-variety"],
          "hint": "Position 42 requires minimum 7 phrases. Review /ssi-build-phrases for phrase generation guidance."
        }

    gate_4_phrase_tier_distribution:
      name: "Phrase Length Tier Distribution"
      description: |
        Phrases must have smooth SHORT -> MEDIUM -> LONG progression.
        Common failure: jumping directly from SHORT to LONG, skipping MEDIUM.

      tiers:
        SHORT: "3-5 syllables (or 3-5 Chinese characters)"
        MEDIUM: "6-9 syllables (or 6-9 Chinese characters)"
        LONG: "10+ syllables (or 10+ Chinese characters)"

      minimums_by_seed:
        seeds_1_5: "Relaxed - quality over quantity with limited vocab"
        seeds_6_20: "1+ SHORT, 1+ MEDIUM, 2+ LONG"
        seeds_21_plus: "2+ SHORT, 2+ MEDIUM, 3+ LONG"

      error_format: |
        {
          "error": "Phrase tier distribution violation",
          "lego_id": "S0042L03",
          "distribution": {"SHORT": 3, "MEDIUM": 0, "LONG": 4},
          "issue": "Missing MEDIUM phrases - gap between SHORT and LONG",
          "skills": ["/ssi-build-phrases", "/ssi-phrase-variety"],
          "hint": "Ensure smooth progression. Add phrases in 6-9 syllable range. Review /ssi-phrase-variety."
        }

    gate_5_zero_explanations:
      name: "Zero Explanations Validation"
      description: |
        ALL known_text becomes TTS audio. The learner HEARS everything.
        Grammar is INFERRED through pattern recognition, never explicitly taught.

        known_text must be NATURAL ENGLISH that a learner would want to say.
        NEVER include grammar labels, linguistic terms, or parenthetical notes.

      forbidden_patterns:
        grammar_labels:
          - "negation wrap"
          - "verb-final"
          - "complement marker"
          - "aspect marker"
          - "completed action"
        linguistic_terms:
          - "subordinate"
          - "reflexive"
          - "infinitive"
          - "gerund"
          - "participle"
        pattern_descriptions:
          - "A-not-A"
          - "V-not-V"
          - "time before verb"
          - "SOV pattern"
        parenthetical_notes:
          - "(verb)"
          - "(noun)"
          - "(modal)"
          - "(particle)"

      examples:
        wrong:
          - known: "not (negation wrap)"
            target: "ne...pas"
            issue: "Grammar label in parentheses"
          - known: "verb-得-result pattern"
            target: "V得+result"
            issue: "Pattern description, not natural language"
          - known: "whether I can (verb-final)"
            target: "ob ich kann"
            issue: "Grammar annotation in parentheses"

        correct:
          - known: "I don't want"
            target: "je ne veux pas"
          - known: "speak well"
            target: "说得好"
          - known: "whether I can"
            target: "ob ich kann"

      error_format: |
        {
          "error": "Zero explanations violation",
          "known_text": "not (negation wrap)",
          "detected_pattern": "parenthetical grammar label",
          "skills": ["/ssi-decompose-seed", "/ssi-learner-pattern"],
          "hint": "known_text becomes TTS audio. Use natural English only. No grammar labels, no linguistic terms, no parenthetical notes. Review /ssi-learner-pattern for methodology."
        }

  ## ==========================================================================
  ## M-LEGO BUILD-UP AUTO-GENERATION
  ## ==========================================================================

  m_lego_buildup:
    description: |
      For M-type (molecular) LEGOs, the API automatically generates "build-up" phrases
      that introduce meaningful components before the complete LEGO.

      AGENTS DO NOT PROVIDE BUILD-UP - it is always auto-generated.
      Agents only provide practice phrases; the API handles the rest.

    structure:
      positions_1_to_N: "Meaningful component phrases (one per component)"
      position_N_plus_1: "The LEGO itself"
      positions_N_plus_2_onwards: "Agent's practice phrases"

    particle_handling:
      description: "Particles are SKIPPED in build-up (no separate position)"
      chinese_particles: ["了", "着", "过", "的", "地", "得", "吗", "呢", "吧", "啊", "把", "被"]
      rationale: "Learners see particles as 'grammatical glue' when full LEGO appears"

    example:
      lego:
        known_text: "I've been learning"
        target_text: "我学了"
        type: "M"
        components:
          - {known: "I", target: "我"}
          - {known: "learn", target: "学"}
          - {known: "completed", target: "了"}  # PARTICLE - skipped

      auto_generated_buildup:
        - {position: 1, known_text: "I", target_text: "我"}
        - {position: 2, known_text: "learn", target_text: "学"}
        - {position: 3, known_text: "I've been learning", target_text: "我学了"}

      agent_phrases_start_at: "position 4"

  ## ==========================================================================
  ## OTHER CONTENT ENDPOINTS
  ## ==========================================================================

  other_endpoints:
    description: |
      These endpoints exist for backwards compatibility and edge cases.
      The golden path (POST /api/seed/complete) is recommended for new work.

    post_api_lego:
      path: "POST /api/lego"
      purpose: "Insert a single LEGO with phrases"
      includes: "ZUT detection, M-LEGO build-up, vocab validation"
      body:
        course_code: "string"
        seed: "integer"
        idx: "integer"
        type: "'A' or 'M'"
        known: "string"
        target: "string"
        components: "array (for M-type only)"
        phrases: "array of {known, target}"

    post_api_batch:
      path: "POST /api/batch"
      purpose: "Insert multiple LEGOs at once"
      includes: "ZUT detection, M-LEGO build-up, vocab validation"
      body:
        course_code: "string"
        legos: "array of LEGO objects"

    patch_api_seed:
      path: "PATCH /api/seed/:courseCode/:seedNumber"
      purpose: "Update seed translation"
      body:
        target_text: "string"

    get_api_resume:
      path: "GET /api/resume/:courseCode"
      purpose: "Get everything needed to resume after context compaction"
      returns: |
        {
          "next_seed": {"seed_number": 107, "known_text": "...", "hint": "..."},
          "recent_seeds": [...last 5 completed with translations...],
          "recent_legos": [...last 20 new LEGOs for phrase context...],
          "progress": "15.9%",
          "completed_seeds": 106,
          "total_seeds": 668,
          "vocab_size": 241,
          "vocab_mode": "characters"
        }
      critical: "ALWAYS call this after context compaction - do NOT guess seeds"

    get_api_next:
      path: "GET /api/next/:courseCode"
      purpose: "Get next incomplete seed with vocabulary context and example decompositions"
      description: |
        Returns the next seed that needs decomposition along with:
        - Full vocabulary list grouped by seed (newest first, starred for recent)
        - 3 example completed seeds (seed 1, seed 10, previous seed) as templates
        - Submission template matching the expected shape
      returns: |
        {
          "course_code": "courseCode",
          "seed": { "seed_number": 42, "known_text": "...", "target_text": "..." },
          "vocabulary": ["...vocab lines..."],
          "examples": [...completed seed decompositions...],
          "template": { ... submission template ... },
          "next_action": "After submitting, call GET /api/next/:courseCode for the next seed."
        }

    get_api_seeds:
      path: "GET /api/seeds"
      purpose: "Get canonical seeds (668 master English seeds with {target} placeholder)"
      query_params:
        limit: "integer (default: 668)"
        offset: "integer (default: 0)"
      returns: "Array of seed objects from canonical_seeds table"

    get_api_seeds_course:
      path: "GET /api/seeds/:courseCode"
      purpose: "Get course-specific seeds (with translations)"
      query_params:
        limit: "integer (default: 300)"
        offset: "integer (default: 0)"
      returns: "Array of seed objects with known_text and target_text"

    get_api_stats:
      path: "GET /api/stats/:courseCode"
      purpose: "Get course quality metrics"
      returns: "LEGOs count, phrases count, ratio, vocab size, draft counts"

    get_api_vocab:
      path: "GET /api/vocab/:courseCode"
      purpose: "Get current vocabulary set for a course"
      returns: "Vocabulary list (for debugging)"

    get_api_phrases:
      path: "GET /api/phrases/:courseCode"
      purpose: "Get phrases with filters (for QA audit)"
      query_params:
        limit: "integer (default: 100, max: 500)"
        offset: "integer (default: 0)"
        seed_min: "integer (optional)"
        seed_max: "integer (optional)"
        role: "string (optional: 'build', 'use', 'practice', 'component')"
      returns: "Paginated array of phrase objects"

    patch_api_phrases:
      path: "PATCH /api/phrases/:id"
      purpose: "Update a phrase (for Fixer agent)"
      body:
        known_text: "string (optional)"
        target_text: "string (optional)"
      returns: |
        {
          "success": true,
          "phrase_id": "uuid",
          "changes": { "known_text": "...", "target_text": "..." },
          "phrase": { ... updated phrase object ... }
        }

    delete_api_course:
      path: "DELETE /api/course/:courseCode"
      purpose: "Clear all data for a course"
      warning: "Destructive - use with caution"

  ## ==========================================================================
  ## DRAFT & FINALIZATION ENDPOINTS (Parallel Builds)
  ## ==========================================================================

  draft_finalization:
    description: |
      Parallel build mode allows multiple agents to decompose seeds concurrently.
      Submissions go to course_seed_drafts (staging table) instead of live tables.
      After all agents finish, finalization processes drafts in seed order,
      detects duplicates and collisions, and writes clean data to live tables.

    get_api_course_drafts:
      path: "GET /api/course/:code/drafts"
      purpose: "List draft seeds with status summary"
      query_params:
        status: "string (optional: 'valid', 'collision', 'rework')"
      returns: |
        {
          "course_code": "courseCode",
          "total_drafts": 250,
          "valid": 245,
          "collision": 3,
          "rework": 2,
          "drafts": [
            {
              "seed_number": 11,
              "validation_status": "valid",
              "validation_notes": null,
              "created_at": "ISO timestamp",
              "updated_at": "ISO timestamp"
            }
          ]
        }

    post_api_course_finalize:
      path: "POST /api/course/:code/finalize"
      purpose: "Process all drafts into live tables"
      description: |
        Steps:
        1. Load baseline LEGOs from live tables (golden seeds already finalized)
        2. Load all drafts in seed order
        3. Process: dedup (same known+target) and detect collisions (same known, different target)
        4. If collisions found -> report collisions, mark drafts, abort (nothing written)
        5. If clean -> write to live tables (course_seeds, course_legos, course_practice_phrases),
           handle empty seeds (all-duplicate LEGOs), cleanup drafts, invalidate vocab cache
      returns: |
        {
          "ok": true,
          "status": "FINALIZED",
          "course_code": "courseCode",
          "seeds_written": 250,
          "legos_introduced": 180,
          "legos_deduplicated": 420,
          "empty_seeds": 15,
          "empty_seed_numbers": [45, 67, ...],
          "phrases_written": 4200,
          "collisions": 0
        }
      collision_response: |
        {
          "error": "COLLISIONS_DETECTED",
          "message": "3 LEGO collision(s) found - cannot finalize until resolved",
          "collisions": [
            {
              "seed_number": 55,
              "lego_known": "to learn",
              "lego_target": "apprendre",
              "lego_idx": 2,
              "conflicts_with": {
                "target_text": "etudier",
                "seed_number": 12,
                "lego_index": 1
              }
            }
          ],
          "colliding_seeds": [55],
          "resolution": {
            "steps": [
              "1. Query GET /api/course/:code/drafts?status=collision to see affected seeds",
              "2. Redecompose colliding seeds with bigger chunks (M-LEGOs) to avoid collision",
              "3. Resubmit via POST /api/seed/complete?draft=true (upsert replaces old draft)",
              "4. Run POST /api/course/:code/finalize again"
            ]
          }
        }

  ## ==========================================================================
  ## BUILD MANAGEMENT ENDPOINTS
  ## ==========================================================================

  build_management:
    description: |
      Build management endpoints control the automated course building process.
      Supports parallel build mode where multiple agents decompose seeds concurrently
      into the drafts table, followed by a finalization step.

    post_api_build_start:
      path: "POST /api/build/start/:courseCode"
      purpose: "Start a parallel build with agent spawning"
      description: |
        Spawns a coordinator agent that orchestrates multiple sub-agents for
        parallel seed decomposition. Submissions go to course_seed_drafts.
        Build mode is always 'parallel'.
      body:
        terminal: "string (default: 'iTerm2') - terminal app to use"
        targetSeeds: "integer (default: 668) - total seeds to complete"
      returns: |
        {
          "ok": true,
          "course_code": "courseCode",
          "status": "started",
          "build_mode": "parallel",
          "agent_count": 1,
          "message": "Build started for courseCode"
        }

    post_api_build_stop:
      path: "POST /api/build/stop/:courseCode"
      purpose: "Stop an active build"
      returns: |
        {
          "ok": true,
          "course_code": "courseCode",
          "status": "stopped",
          "message": "Build stopped for courseCode"
        }

    post_api_build_rebuild:
      path: "POST /api/build/rebuild/:courseCode"
      purpose: "Wipe and rebuild a seed range"
      description: |
        Deletes phrases + LEGOs in the specified range, NULLs decomposed_at,
        clears vocab cache. Used for pass-2 rebuilds where seed translations
        already exist. Checks for active build_jobs and rejects if one is running.
      body:
        from_seed: "integer (default: 11) - start of range"
        to_seed: "integer (default: 300) - end of range"
      returns: |
        {
          "ok": true,
          "seeds_to_build": 290,
          "phrases_deleted": 5200,
          "legos_deleted": 780,
          "seeds_reset": 290
        }

    get_api_build_status:
      path: "GET /api/build/status/:courseCode"
      purpose: "Get build status for a course"
      description: |
        Returns build progress including draft counts for parallel builds.
      returns: |
        {
          "course_code": "courseCode",
          "status": "agent_running",
          "build_mode": "parallel",
          "agent_count": 3,
          "current_seed": 87,
          "progress": "13%",
          "last_activity": "ISO timestamp"
        }

    get_api_build_active:
      path: "GET /api/build/active"
      purpose: "List all active builds"
      description: |
        Returns builds from three sources:
        1. Formally registered builds (activeBuilds Map)
        2. Courses with recent activity (courseActivity Map)
        3. Courses with active heartbeats
      returns: |
        {
          "active_builds": 2,
          "builds": [
            {
              "course_code": "zho_for_eng",
              "status": "agent_running",
              "agent_count": 1,
              "progress": { "completed": 42, "total": 668, "percent": "6.3%" },
              "source": "registered"
            },
            {
              "course_code": "jpn_for_eng",
              "status": "agent_running",
              "source": "heartbeat",
              "agent_id": "agent-1",
              "current_seed": 15,
              "last_heartbeat": "ISO timestamp"
            }
          ]
        }

    get_api_build_seed_grid:
      path: "GET /api/build/seed-grid/:courseCode"
      purpose: "Seed status grid for visualization"
      description: |
        Returns status of every seed: complete, drafted, collision, rework, building, or empty.
        Polled by dashboard to show real-time build progress.
        Includes draft status from course_seed_drafts for parallel builds.
      returns: |
        {
          "seeds": [
            { "seed": 1, "status": "complete", "legos": 3, "phrases": 28 },
            { "seed": 2, "status": "drafted", "legos": 0, "phrases": 0 },
            { "seed": 3, "status": "collision", "legos": 0, "phrases": 0 },
            { "seed": 4, "status": "empty", "legos": 0, "phrases": 0 }
          ],
          "total": 300,
          "complete": 10,
          "drafted": 245,
          "collision": 3,
          "building": 0,
          "empty": 42
        }

  ## ==========================================================================
  ## ACTIVITY TRACKING ENDPOINTS (Stall Detection)
  ## ==========================================================================

  activity_tracking:
    description: |
      Activity tracking endpoints monitor agent progress and detect stalled builds.
      The stall detection system identifies courses where no submissions have been
      made within the threshold period (default 5 minutes).

    get_api_activity:
      path: "GET /api/activity"
      purpose: "Get activity status for all courses with stall detection"
      returns: |
        {
          "courses": { "courseCode": { "lastSubmission": timestamp, "stalled": bool, ... } },
          "stalled": ["courseCode1", ...],
          "stalled_count": 0,
          "threshold_minutes": 5,
          "agents": {
            "running": [...],
            "running_count": 0,
            "total_tracked": 0
          },
          "message": "Status message"
        }

    post_api_activity_ping:
      path: "POST /api/activity/:courseCode/ping"
      purpose: "Mark a course as active (resets stall timer)"
      use_case: "Call when spawning a new agent to reset the stall timer"
      body:
        seed_number: "integer (optional, current seed being worked on)"
      returns: |
        {
          "ok": true,
          "course_code": "courseCode",
          "message": "Activity recorded - stall timer reset"
        }

    post_api_activity_reset_session:
      path: "POST /api/activity/:courseCode/reset-session"
      purpose: "Reset session counter for new agent"
      use_case: "Call when spawning a new agent to reset seeds_this_session counter"
      returns: |
        {
          "ok": true,
          "course_code": "courseCode",
          "seeds_this_session": 0,
          "batch_size": 30,
          "message": "Session counter reset - new agent can work for 30 seeds"
        }

  ## ==========================================================================
  ## HEARTBEAT ENDPOINTS (Agent Liveness Tracking)
  ## ==========================================================================

  heartbeat_endpoints:
    description: |
      Heartbeat endpoints track agent liveness separately from seed submissions.
      Agents should call POST /api/heartbeat/:courseCode every 60 seconds while working.
      Used by stall watcher and /api/build/active to detect live agents.

    post_api_heartbeat:
      path: "POST /api/heartbeat/:courseCode"
      purpose: "Send agent heartbeat"
      interval: "Every 60 seconds while working"
      body:
        agent_id: "string (optional, agent identifier)"
        status: "string (optional, e.g., 'working')"
        current_seed: "integer (optional, current seed number)"
      returns: |
        {
          "ok": true,
          "course_code": "courseCode",
          "heartbeat_interval_ms": 60000,
          "timeout_ms": 180000,
          "message": "Heartbeat received"
        }

    get_api_heartbeats:
      path: "GET /api/heartbeats"
      purpose: "Get all active heartbeats"
      returns: |
        {
          "active_agents": 1,
          "heartbeats": [
            {
              "course_code": "zho_for_eng",
              "agent_id": "agent-1",
              "status": "working",
              "current_seed": 42,
              "last_heartbeat": "ISO timestamp",
              "elapsed_ms": 30000,
              "is_alive": true,
              "started_at": "ISO timestamp"
            }
          ]
        }

  ## ==========================================================================
  ## AGENT MANAGEMENT ENDPOINTS
  ## ==========================================================================

  agent_management:
    description: |
      Agent management endpoints track and control build agents.
      Used by the build monitor to register, track, and manage agent processes.

    post_api_agents_register:
      path: "POST /api/agents/register"
      purpose: "Register a new agent (called by monitor when spawning)"
      body:
        pid: "integer (process ID) - required"
        course_code: "string - required"
      returns: |
        {
          "ok": true,
          "message": "Agent {pid} registered for {course_code}"
        }

    post_api_agents_submission:
      path: "POST /api/agents/:pid/submission"
      purpose: "Record a submission from an agent"
      body:
        seed_number: "integer (optional)"
      returns: |
        { "ok": true }

    post_api_agents_complete:
      path: "POST /api/agents/:pid/complete"
      purpose: "Mark an agent as completed"
      returns: |
        {
          "ok": true,
          "message": "Agent {pid} marked complete"
        }

    get_api_agents:
      path: "GET /api/agents"
      purpose: "List all tracked agents"
      returns: |
        {
          "agents": [
            {
              "pid": 12345,
              "course_code": "zho_for_eng",
              "status": "running",
              "started_at": "ISO timestamp",
              "last_submission": "ISO timestamp",
              "submissions": 5
            }
          ],
          "total": 1
        }

    delete_api_agents:
      path: "DELETE /api/agents/:pid"
      purpose: "Kill an agent by PID"
      action: "Sends SIGTERM to the process and marks agent complete"
      returns: |
        {
          "ok": true,
          "message": "Sent SIGTERM to agent {pid}"
        }

  ## ==========================================================================
  ## QA WORKFLOW ENDPOINTS
  ## ==========================================================================

  qa_workflow:
    description: |
      Full QA lifecycle for reviewing course phrases. Supports:
      - Fetching unchecked phrases and random samples for audit
      - Flagging issues (grammar, semantic, naturalness, vocabulary, variety)
      - Bulk operations for efficient agent-driven QA
      - Resolving/dismissing flags with reasoning
      - Deleting bad phrases
      - Summary dashboard with progress tracking

    post_api_qa_start:
      path: "POST /api/qa/start/:courseCode"
      purpose: "Start a parallel QA pass"
      description: |
        Spawns a coordinator agent which orchestrates ~10 sub-agents
        to check grammar/naturalness across all unchecked phrases.
      body:
        terminal: "string (default: 'iTerm2')"
      returns: |
        {
          "ok": true,
          "mode": "parallel_qa",
          "course_code": "courseCode",
          "batches": 10,
          "phrases": { "total": 5000, "unchecked": 3200 },
          "message": "Parallel QA started - coordinator agent spawned with 10 batches"
        }

    get_api_qa_unchecked:
      path: "GET /api/qa/unchecked/:courseCode"
      purpose: "Get unchecked phrases (qa_checked IS NULL)"
      query_params:
        limit: "integer (default: 50)"
        role: "string (optional: 'use', 'practice', 'component')"
      returns: |
        {
          "course_code": "courseCode",
          "role_filter": "use",
          "unchecked_count": 50,
          "phrases": [...]
        }

    get_api_qa_sample:
      path: "GET /api/qa/sample/:courseCode"
      purpose: "Get random sample of phrases for AUDIT mode (any qa_checked status)"
      query_params:
        limit: "integer (default: 100, max: 500)"
        seed_min: "integer (default: 1)"
        seed_max: "integer (default: 999)"
      returns: |
        {
          "course_code": "courseCode",
          "sample_size": 100,
          "seed_range": { "min": 1, "max": 999 },
          "phrases": [...]
        }

    post_api_qa_flag:
      path: "POST /api/qa/flag"
      purpose: "Insert or update a QA flag for a phrase"
      body:
        course_code: "string - required"
        phrase_id: "uuid (optional)"
        seed_number: "integer (optional)"
        lego_id: "string (optional)"
        check_type: "string - required (grammar|semantic|naturalness|lego_frequency|lego_spread|variety|vocabulary)"
        severity: "string (optional: error|warning|info, default: warning)"
        issue: "string - required (description of the issue)"
        details: "object (optional, additional context)"
      returns: |
        {
          "success": true,
          "flag": { ... flag object ... }
        }

    post_api_qa_bulk_flag:
      path: "POST /api/qa/bulk-flag"
      purpose: "Insert/upsert multiple QA flags at once"
      description: "Also marks flagged phrase_ids as qa_checked automatically."
      body:
        flags: "array of flag objects (same shape as POST /api/qa/flag body)"
      returns: |
        {
          "success": true,
          "created": 5,
          "updated": 2,
          "total": 7,
          "phrases_marked_checked": 7
        }

    post_api_qa_bulk_mark_checked:
      path: "POST /api/qa/bulk-mark-checked"
      purpose: "Mark all phrases in a seed range as QA checked"
      description: "Efficient when agent finishes a batch with no flags."
      body:
        course_code: "string - required"
        seed_min: "integer - required"
        seed_max: "integer - required"
      returns: |
        {
          "success": true,
          "course_code": "courseCode",
          "seed_min": 1,
          "seed_max": 50,
          "phrases_checked": 850
        }

    post_api_qa_mark_checked:
      path: "POST /api/qa/mark-checked"
      purpose: "Mark specific phrases as QA checked by ID"
      body:
        phrase_ids: "array of uuids - required"
      returns: |
        {
          "success": true,
          "checked_count": 10
        }

    get_api_qa_flags_pending:
      path: "GET /api/qa/flags/:courseCode/pending"
      purpose: "Get open flags needing review (for Fixer agent)"
      query_params:
        limit: "integer (default: 20, max: 100)"
        severity: "string (optional: error|warning|info)"
      returns: |
        {
          "course_code": "courseCode",
          "pending_count": 15,
          "flags": [...]
        }

    patch_api_qa_flag:
      path: "PATCH /api/qa/flag/:flagId"
      purpose: "Update a flag status (resolve, dismiss, etc.)"
      body:
        status: "string (open|resolved|ignored|false_positive)"
        resolution_notes: "string (optional)"
      returns: |
        {
          "success": true,
          "flag": { ... updated flag object ... }
        }

    post_api_qa_flag_resolve:
      path: "POST /api/qa/flag/:id/resolve"
      purpose: "Mark flag as resolved with fix applied"
      body:
        resolution: "string (optional, default: 'fixed')"
        fix_applied: "string (optional, description of fix)"
        reasoning: "string (optional)"
      returns: |
        {
          "success": true,
          "flag": { ... resolved flag with merged details ... }
        }

    post_api_qa_flag_dismiss:
      path: "POST /api/qa/flag/:id/dismiss"
      purpose: "Dismiss flag as false positive"
      body:
        reasoning: "string (optional)"
      returns: |
        {
          "success": true,
          "flag": { ... dismissed flag with status 'false_positive' ... }
        }

    get_api_qa_flags:
      path: "GET /api/qa/flags/:courseCode"
      purpose: "Get all QA flags for a course with summary"
      query_params:
        status: "string (default: 'open', use 'all' for everything)"
      returns: |
        {
          "course_code": "courseCode",
          "total": 25,
          "by_severity": { "error": 5, "warning": 15, "info": 5 },
          "by_type": { "grammar": 10, "naturalness": 8, "variety": 7 },
          "flags": [...]
        }

    get_api_qa_summary:
      path: "GET /api/qa/summary/:courseCode"
      purpose: "QA summary for dashboard"
      returns: |
        {
          "course_code": "courseCode",
          "phrases": {
            "total": 5000,
            "checked": 4200,
            "unchecked": 800,
            "progress_percent": 84
          },
          "flags": {
            "total": 30,
            "open": 12,
            "errors": 3,
            "warnings": 7,
            "info": 2
          }
        }

    get_api_qa_flagged_phrases:
      path: "GET /api/qa/flagged-phrases/:courseCode"
      purpose: "Get phrases with their flags for UI (paginated, with phrase data merged)"
      query_params:
        limit: "integer (default: 50, max: 200)"
        offset: "integer (default: 0)"
        severity: "string (optional: error|warning|info)"
      returns: |
        {
          "course_code": "courseCode",
          "total": 25,
          "limit": 50,
          "offset": 0,
          "has_more": false,
          "flags": [
            {
              "id": "uuid",
              "phrase_id": "uuid",
              "seed_number": 42,
              "check_type": "grammar",
              "severity": "error",
              "issue": "Incorrect verb conjugation",
              "details": { ... },
              "flagged_at": "ISO timestamp",
              "phrase": {
                "known_text": "I want to learn",
                "target_text": "je veux apprendre",
                "seed_number": 42,
                "phrase_role": "use"
              }
            }
          ]
        }

    delete_api_qa_phrase:
      path: "DELETE /api/qa/phrase/:phraseId"
      purpose: "Delete a flagged phrase and auto-resolve its flags"
      returns: |
        {
          "success": true,
          "deleted": "uuid"
        }

  ## ==========================================================================
  ## QA SPAWN AGENT ENDPOINTS
  ## ==========================================================================

  qa_spawn_agents:
    description: |
      Endpoints that spawn specialized QA agents in iTerm2.
      Each agent runs in a new terminal window and works autonomously.

    post_api_qa_spawn_fixer:
      path: "POST /api/qa/spawn-fixer/:courseCode"
      purpose: "Spawn Opus phrase fixer agent"
      description: |
        Reads pending flags and fixes phrases by updating known_text/target_text,
        then resolves the corresponding flags.
      returns: |
        {
          "success": true,
          "message": "Phrase fixer spawning for courseCode",
          "course_code": "courseCode"
        }

    post_api_qa_spawn_polisher:
      path: "POST /api/qa/spawn-polisher/:courseCode"
      purpose: "Spawn Opus phrase polisher (high-quality pass on first N rounds)"
      body:
        round_limit: "integer (default: 50)"
      returns: |
        {
          "success": true,
          "message": "Opus polisher spawning for courseCode - first 50 rounds",
          "course_code": "courseCode",
          "round_limit": 50
        }

    post_api_qa_spawn_audit:
      path: "POST /api/qa/spawn-audit/:courseCode"
      purpose: "Spawn Sonnet phrase auditor agent (random sample)"
      body:
        sample_size: "integer (default: 100)"
      returns: |
        {
          "success": true,
          "message": "Phrase auditor spawning for courseCode",
          "course_code": "courseCode",
          "sample_size": 100
        }

  ## ==========================================================================
  ## CALIBRATION ENDPOINTS
  ## ==========================================================================

  calibration:
    description: |
      Calibration endpoints manage golden seed decompositions that guide future agents.
      Golden decompositions are stored in courses.quality_rules.golden_decompositions
      and serve as calibration metadata (NOT course content visible in Script Viewer).

      Accepts markdown format (Content-Type: text/markdown) or JSON.
      Golden decompositions merge by seed_number - submit one seed at a time
      without overwriting others.

    post_api_course_calibration:
      path: "POST /api/course/:courseCode/calibration"
      purpose: "Submit golden seed decompositions (markdown or JSON)"
      content_type: "text/markdown or application/json"
      description: |
        Markdown format uses:
        ## Seed N
        ### LN [M/A] "known" -> "target"
        BUILD/USE/Contrastive/Key insight sections
      returns: |
        {
          "ok": true,
          "course_code": "courseCode",
          "seeds_submitted": 1,
          "message": "Calibration data saved"
        }

    get_api_course_calibration:
      path: "GET /api/course/:courseCode/calibration"
      purpose: "Get calibration data for a course"
      returns: |
        {
          "course_code": "courseCode",
          "golden_decompositions": { ... },
          "calibration_metadata": { ... }
        }

    get_api_calibrations_patterns:
      path: "GET /api/calibrations/patterns"
      purpose: "Cross-course calibration patterns"
      description: "Analyzes golden decompositions across all courses to find common patterns."
      returns: |
        {
          "patterns": { ... cross-course analysis ... },
          "courses_analyzed": 4
        }

    get_api_calibrations_seed:
      path: "GET /api/calibrations/seed/:seedNumber"
      purpose: "Get calibration data for a specific seed across all courses"
      returns: |
        {
          "seed_number": 1,
          "courses": {
            "fra_for_eng": { ... decomposition ... },
            "deu_for_eng": { ... decomposition ... }
          }
        }

  ## ==========================================================================
  ## QUALITY RULES ENDPOINTS
  ## ==========================================================================

  quality_rules:
    description: |
      Quality rules store methodology guidance per course. Includes language-specific
      analysis, avoid patterns, trust tests, and structural notes.
      Stored in courses.quality_rules JSONB column.

    post_api_quality_rules:
      path: "POST /api/course/:courseCode/quality-rules"
      purpose: "Save methodology guidance for a course"
      body:
        quality_rules: |
          {
            "analysis_date": "2026-01-29",
            "known_language": "eng",
            "target_language": "ara",
            "known_language_guidance": { "quality_bar": "...", "avoid_patterns": [...] },
            "target_language_guidance": { "quality_bar": "...", "structural_notes": [...] },
            "zut_direction": "eng -> ara",
            "methodology_insights": [...]
          }
      returns: |
        {
          "success": true,
          "course_code": "courseCode",
          "message": "Quality rules saved - methodology guidance now available for future agents"
        }

    get_api_quality_rules:
      path: "GET /api/course/:courseCode/quality-rules"
      purpose: "Retrieve methodology guidance"
      returns: |
        {
          "course_code": "courseCode",
          "display_name": "Arabic for English Speakers",
          "quality_rules": { ... }
        }

  ## ==========================================================================
  ## RECENCY AND BALANCE ENDPOINTS
  ## ==========================================================================

  recency_balance:
    description: |
      Endpoints for analyzing pattern distribution and vocabulary balance.
      Helps detect pattern fatigue and vocabulary reinforcement needs.

    get_api_recency:
      path: "GET /api/recency/:courseCode"
      purpose: "Analyze pattern and vocabulary recency"
      query_params:
        window: "integer (optional, default: 50) - window size for analysis"
      returns: |
        {
          "course_code": "courseCode",
          "window_size": 50,
          "pattern_fatigue_threshold": 0.3,
          "reinforcement_zone": [5, 15],
          "overused_patterns": ["pattern1", "pattern2"],
          "overused_count": 2,
          "needs_reinforcement": ["vocab1", "vocab2"],
          "reinforcement_count": 2,
          "health": "HEALTHY - Good pattern distribution"
        }

    get_api_balance:
      path: "GET /api/balance/:courseCode"
      purpose: "Get LEGO balance scores for vocabulary variety"
      query_params:
        seed: "integer (optional, default: 999) - current seed number"
      returns: |
        {
          "course_code": "courseCode",
          "current_seed": 42,
          "avg_practice_score": 5.2,
          "thresholds": {
            "underused": "< 3",
            "overused": "> 8"
          },
          "underused_legos": ["S0001L01", "S0005L02"],
          "overused_legos": ["S0003L01"],
          "strikes": 0,
          "hint": "Include underused LEGOs in your phrases to maintain balance"
        }

  ## ==========================================================================
  ## TRANSLATION WORKFLOW ENDPOINTS
  ## ==========================================================================

  translation_workflow:
    description: |
      Two-pass workflow for course creation:
      Pass 1: Translate all seeds, discover language-specific issues
      Pass 2: Build LEGOs and phrases with full knowledge of pitfalls

    get_api_course_translate:
      path: "GET /api/course/:courseCode/translate"
      purpose: "Get seeds needing translation with guidance"
      query_params:
        limit: "integer (optional, default: 260)"
        offset: "integer (optional, default: 0)"
      description: |
        Returns canonical seeds that need translation along with SSi method guidance.
        For X_for_eng: known is instant, needs target translations
        For eng_for_X: target is instant, needs known translations
        For X_for_Y: needs both translations
      returns: |
        {
          "course_code": "zho_for_eng",
          "target_language": "Chinese",
          "known_language": "eng",
          "mode": "translate_targets",
          "total_seeds": 260,
          "needs_translation": 260,
          "seeds": [
            {
              "seed_number": 1,
              "canonical_english": "I want to learn Chinese",
              "current_known": "I want to learn Chinese",
              "current_target": null,
              "needs_known": false,
              "needs_target": true
            }
          ],
          "guidance": {
            "principles": ["CONSISTENCY", "COGNATES", "PATTERNS", "SIMPLICITY", "ZUT"],
            "tips": ["Translate all seeds together...", ...]
          }
        }

    post_api_course_translate:
      path: "POST /api/course/:courseCode/translate"
      purpose: "Submit batch translations"
      body:
        translations: |
          array of translation objects:
          [{ "seed_number": 1, "target_text": "..." }, ...]
          Optional: known_text for non-English known languages
      returns: |
        {
          "course_code": "courseCode",
          "submitted": 260,
          "updated": 260,
          "errors": null,
          "message": "260 seeds translated successfully"
        }

    post_api_course_analysis:
      path: "POST /api/course/:courseCode/analysis"
      purpose: "Save translation analysis after Pass 1"
      description: "Stores language-specific analysis discovered during translation"
      body:
        analysis: |
          {
            "generated_at": "ISO timestamp",
            "seeds_analyzed": 260,
            "register": { "choice": "casual-polite", "markers": ["です", "ます"] },
            "problem_verbs": [...],
            "golden_keys": [...],
            "zut_concerns": [...]
          }
      returns: |
        {
          "success": true,
          "course_code": "courseCode",
          "message": "Translation analysis saved for 260 seeds",
          "summary": {
            "problem_verbs": 5,
            "golden_keys": 10,
            "zut_concerns": 3,
            "register": "casual-polite"
          }
        }

    get_api_course_analysis:
      path: "GET /api/course/:courseCode/analysis"
      purpose: "Retrieve translation analysis"
      returns: |
        {
          "course_code": "courseCode",
          "display_name": "Chinese for English Speakers",
          "analysis": { ... translation analysis object ... }
        }
      error_response: |
        {
          "error": "No translation analysis found",
          "hint": "Complete Pass 1 (translate all seeds) and POST analysis to /api/course/:code/analysis",
          "course_code": "courseCode"
        }

  ## ==========================================================================
  ## PHRASES MANAGEMENT
  ## ==========================================================================

  phrases_management:
    description: |
      Endpoint for adding phrases to existing LEGO baskets.
      Used for topping up baskets that need more phrases.

    post_api_phrases:
      path: "POST /api/phrases"
      purpose: "Add phrases to an existing LEGO basket"
      use_case: "Topping up baskets that need more phrases"
      body:
        course_code: "string - required"
        seed_number: "integer - required"
        lego_index: "integer - required"
        phrases: |
          array of phrase objects - required:
          [{ "known": "I speak", "target": "我说", "score": 7 }, ...]
          Note: USE phrases (position 8+) must have scores 1-9
      validation:
        - "LEGO must exist"
        - "Vocabulary validation (phrases can only use introduced vocabulary)"
        - "Score validation for USE phrases (position 8+)"
      returns: |
        {
          "ok": true,
          "lego": "S0042L01",
          "added": 3,
          "phrases": [
            { "position": 11, "target": "我说中文" },
            { "position": 12, "target": "我说英文" }
          ]
        }
      error_response: |
        {
          "error": "Vocabulary violations detected",
          "violations": [{ "phrase": "我喝水", "unknown": "喝水" }],
          "message": "These phrases use characters not yet introduced"
        }

  ## ==========================================================================
  ## CHECKPOINT/QA WORKFLOW ENDPOINTS
  ## ==========================================================================

  checkpoint_workflow:
    description: |
      Checkpoint system provides QA gates for build verification.
      Builds pause at predefined seed numbers for quality review.
      QA can be human-only, auto-approve, or auto with flagging.

    checkpoint_seeds: [50, 100, 150, 200, 260, 350, 450, 550, 668]

    get_api_checkpoint_summary:
      path: "GET /api/checkpoint/summary/:courseCode"
      purpose: "Get checkpoint summary for QA"
      returns: |
        {
          "course_code": "courseCode",
          "checkpoint": {
            "checkpoint_seeds": [50, 100, ...],
            "next_checkpoint": 50,
            "checkpoints": { "50": { "approved": false }, ... },
            "drift_history": [...],
            "calibration_feedback": "..."
          },
          "summary": {
            "seeds_complete": 45,
            "total_legos": 135,
            "total_phrases": 1350,
            "use_phrases_count": 800,
            "avg_score": "7.50",
            "score_distribution": { "1": 0, "2": 0, ..., "9": 50 }
          },
          "sample_for_qa": {
            "count": 50,
            "phrases": [...],
            "instructions": [...]
          },
          "actions": {
            "status": "AWAITING_APPROVAL",
            "approve_url": "POST /api/checkpoint/approve/courseCode?seed=50",
            "message": "Run QA review, then approve checkpoint at seed 50"
          }
        }

    post_api_checkpoint_approve:
      path: "POST /api/checkpoint/approve/:courseCode"
      purpose: "Approve checkpoint to unblock build"
      query_params:
        seed: "integer (optional, which checkpoint seed to approve)"
      body:
        approved_by: "string (default: 'human')"
        qa_report: "object (optional, QA summary for audit trail)"
      description: |
        Approves a checkpoint and optionally auto-spawns a fresh build agent.
        If QA report provided, checks against quality thresholds.
        Human override always approves.
      returns: |
        {
          "ok": true,
          "status": "APPROVED",
          "course_code": "courseCode",
          "checkpoint_seed": 50,
          "checkpoint_number": 1,
          "message": "Checkpoint 50 approved. Next checkpoint at seed 100",
          "approved_by": "human",
          "approved_at": "ISO timestamp",
          "calibration_feedback": "...",
          "next_checkpoint": 100,
          "auto_spawn": true,
          "agents_running": 0,
          "next_action": "Fresh agent spawned automatically"
        }
      flagged_response: |
        {
          "ok": true,
          "status": "FLAGGED_FOR_HUMAN",
          "course_code": "courseCode",
          "checkpoint_seed": 50,
          "reason": "Quality 6.50 < threshold 7.0",
          "qa_metrics": { "quality": 6.5, "drift": 0.15 },
          "thresholds": { "min_quality": 7.0, "max_drift": 0.20 },
          "message": "QA check outside tolerance - flagged for human review",
          "action": "Human must review and manually approve"
        }

    get_api_checkpoint_status:
      path: "GET /api/checkpoint/status/:courseCode"
      purpose: "Get checkpoint status"
      returns: |
        {
          "course_code": "courseCode",
          "checkpoint_enabled": true,
          "checkpoint_seeds": [50, 100, ...],
          "next_checkpoint": 50,
          "checkpoints": { "50": { "approved": false }, ... },
          "summary": {
            "total_checkpoints": 9,
            "approved_count": 0,
            "all_approved": false
          },
          "message": "Checkpoint 50 awaiting approval (0/9 complete)"
        }

    get_api_checkpoint_config:
      path: "GET /api/checkpoint/config/:courseCode"
      purpose: "Get checkpoint configuration for course"
      returns: |
        {
          "course_code": "courseCode",
          "checkpoint_seeds": [50, 100, ...],
          "config": [
            {
              "checkpoint_seed": 50,
              "review_mode": "human",
              "min_quality_score": 7.0,
              "max_drift_rate": 0.20,
              "source": "_default"
            },
            ...
          ],
          "usage": {
            "human": "Build stops, waits for human approval",
            "auto": "QA agent auto-approves if gates pass",
            "auto_with_flag": "Auto-approve but flag for later human spot-check"
          }
        }

    put_api_checkpoint_config:
      path: "PUT /api/checkpoint/config/:courseCode"
      purpose: "Update checkpoint configuration"
      body:
        checkpoint_seed: "integer - required (must be valid checkpoint seed)"
        review_mode: "string - required ('human', 'auto', or 'auto_with_flag')"
        min_quality_score: "number (optional, default: 7.0)"
        max_drift_rate: "number (optional, default: 0.20)"
      returns: |
        {
          "ok": true,
          "course_code": "courseCode",
          "checkpoint_seed": 50,
          "review_mode": "auto",
          "message": "Checkpoint 50 now uses 'auto' review mode"
        }

    get_api_checkpoint_qa_sample:
      path: "GET /api/checkpoint/qa-sample/:courseCode"
      purpose: "Get sample phrases for QA scoring"
      query_params:
        checkpoint: "integer (optional, specific checkpoint seed)"
        reveal_scores: "string ('true'/'false', default: 'false')"
      description: |
        Returns ~20 USE phrases from the checkpoint range.
        Agent scores are hidden by default - QA should score first.
      returns: |
        {
          "ok": true,
          "course_code": "courseCode",
          "checkpoint_seed": 50,
          "checkpoint_number": 1,
          "range": { "start": 1, "end": 50 },
          "sample_size": 20,
          "agent_avg": "[HIDDEN]",
          "drift_threshold": 0.5,
          "phrases": [
            {
              "phrase_id": "uuid",
              "known": "I speak Chinese",
              "target": "我说中文",
              "seed": 15,
              "lego": 2,
              "agent_score": "[HIDDEN - score first]"
            },
            ...
          ],
          "instructions": [...]
        }

    post_api_checkpoint_qa_result:
      path: "POST /api/checkpoint/qa-result/:courseCode"
      purpose: "Submit QA scoring results"
      description: |
        Automatically approves if drift is within threshold,
        otherwise flags for human review.
      body:
        checkpoint_seed: "integer (optional if pending QA job exists)"
        scores: |
          array of scored phrases - required:
          [{ "phrase_id": "uuid", "qa_score": 8 }, ...]
        overall_assessment: "string (optional)"
        recommendation: "string (optional)"
      returns: |
        {
          "ok": true,
          "status": "AUTO_APPROVED",
          "course_code": "courseCode",
          "checkpoint_seed": 50,
          "qa_avg": "7.80",
          "agent_avg": "7.50",
          "drift": "0.30",
          "drift_threshold": 0.5,
          "message": "Checkpoint 50 auto-approved. Drift 0.30 <= 0.5. Build agent can continue.",
          "next_action": "Build agent will automatically continue to next seed"
        }
      flagged_response: |
        {
          "ok": true,
          "status": "FLAGGED_FOR_HUMAN",
          "course_code": "courseCode",
          "checkpoint_seed": 50,
          "qa_avg": "6.50",
          "agent_avg": "7.50",
          "drift": "1.00",
          "drift_threshold": 0.5,
          "reason": "Drift too high (1.00 > 0.5)",
          "message": "Checkpoint 50 flagged for human review.",
          "next_action": "Human must approve at POST /api/checkpoint/approve/courseCode"
        }

    get_api_checkpoint_qa_status:
      path: "GET /api/checkpoint/qa-status/:courseCode"
      purpose: "Check if QA is pending"
      returns: |
        {
          "course_code": "courseCode",
          "qa_pending": false,
          "job": null
        }

  ## ==========================================================================
  ## HEALTH CHECK ENDPOINT
  ## ==========================================================================

  health_check:
    path: "GET /health"
    purpose: "Health check endpoint"
    returns: |
      { "ok": true }

  ## ==========================================================================
  ## VALIDATION BYPASS
  ## ==========================================================================

  validation_bypass:
    description: |
      For testing and edge cases, validation can be bypassed.
      NOT RECOMMENDED for production use.

    how_to_bypass: "Include SKIP_VALIDATION: true in request body or ?skip_validation=true query param"

    example: |
      POST /api/seed/complete
      {
        "course_code": "test_course",
        "seed_number": 1,
        "known_text": "Test",
        "target_text": "测试",
        "legos": [...],
        "SKIP_VALIDATION": true
      }

  ## ==========================================================================
  ## STARTUP BANNER
  ## ==========================================================================

  startup_banner: |
    ╔══════════════════════════════════════════════════════════════╗
    ║  Course Builder API - Port 3471 (v4.0.0)                     ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  QUALITY GATES:                                              ║
    ║  * Phrases per LEGO: graduated minimums, target 10, max 13   ║
    ║  * Vocabulary validation: LRU cache (30-min TTL, 10 courses) ║
    ║  * M-LEGO build-up: Auto-generated (components->LEGO->USE)   ║
    ║  * Conflict detection: ZUT reject, duplicates -> is_new=false ║
    ║  * loadCourseVocab(): DB vocab loaded before tiling check     ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  GOLDEN PATH:                                                ║
    ║  POST /api/seed/complete - Atomic seed+LEGOs+phrases         ║
    ║  POST /api/seed/complete?draft=true - Draft mode (parallel)   ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  Content Endpoints:                                          ║
    ║  GET  /api/seeds - Canonical seeds (668 master English)       ║
    ║  GET  /api/seeds/:code - Course-specific seeds               ║
    ║  GET  /api/next/:code - Next seed + vocab + examples          ║
    ║  POST /api/lego - Insert single LEGO                         ║
    ║  POST /api/batch - Insert multiple LEGOs                     ║
    ║  POST /api/phrases - Add phrases to existing LEGO            ║
    ║  GET  /api/phrases/:code - Get phrases with filters           ║
    ║  PATCH /api/phrases/:id - Update a phrase                     ║
    ║  PATCH /api/seed/:code/:num - Update seed translation        ║
    ║  GET  /api/stats/:code - Quality metrics + vocab size        ║
    ║  GET  /api/vocab/:code - Current vocabulary set              ║
    ║  GET  /api/resume/:code - Resume context after compaction    ║
    ║  DELETE /api/course/:code - Clear course + vocab cache       ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  Translation Workflow:                                       ║
    ║  GET  /api/course/:code/translate - Seeds needing translation ║
    ║  POST /api/course/:code/translate - Submit batch translations ║
    ║  POST /api/course/:code/analysis - Save translation analysis ║
    ║  GET  /api/course/:code/analysis - Retrieve analysis         ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  Calibration:                                                ║
    ║  POST /api/course/:code/calibration - Submit golden seeds    ║
    ║  GET  /api/course/:code/calibration - Get calibration data   ║
    ║  GET  /api/calibrations/patterns - Cross-course patterns     ║
    ║  GET  /api/calibrations/seed/:num - Seed across courses      ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  Quality Rules:                                              ║
    ║  POST /api/course/:code/quality-rules - Save guidance        ║
    ║  GET  /api/course/:code/quality-rules - Retrieve guidance    ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  Draft & Finalization (Parallel Builds):                     ║
    ║  GET  /api/course/:code/drafts - Draft status summary        ║
    ║  POST /api/course/:code/finalize - Finalize drafts to live   ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  Activity & Heartbeat:                                       ║
    ║  GET  /api/activity - Stall detection status                 ║
    ║  POST /api/activity/:code/ping - Reset stall timer           ║
    ║  POST /api/activity/:code/reset-session - Reset session      ║
    ║  POST /api/heartbeat/:code - Agent heartbeat                 ║
    ║  GET  /api/heartbeats - All active heartbeats                ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  Agent Management:                                           ║
    ║  POST /api/agents/register - Register new agent              ║
    ║  POST /api/agents/:pid/submission - Record submission        ║
    ║  POST /api/agents/:pid/complete - Mark agent complete        ║
    ║  GET  /api/agents - List all tracked agents                  ║
    ║  DELETE /api/agents/:pid - Kill agent by PID                 ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  Build Management:                                           ║
    ║  POST /api/build/start/:code - Start parallel build          ║
    ║  POST /api/build/stop/:code - Stop build                     ║
    ║  POST /api/build/rebuild/:code - Wipe + rebuild seed range   ║
    ║  GET  /api/build/status/:code - Build status                 ║
    ║  GET  /api/build/active - List all active builds             ║
    ║  GET  /api/build/seed-grid/:code - Seed status grid          ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  Quality & Balance:                                          ║
    ║  GET  /api/recency/:code - Pattern/vocab recency analysis    ║
    ║  GET  /api/balance/:code - LEGO balance scores               ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  QA Workflow:                                                ║
    ║  POST /api/qa/start/:code - Start parallel QA pass           ║
    ║  GET  /api/qa/unchecked/:code - Unchecked phrases            ║
    ║  GET  /api/qa/sample/:code - Random phrase sample            ║
    ║  POST /api/qa/flag - Flag a phrase                           ║
    ║  POST /api/qa/bulk-flag - Bulk flag phrases                  ║
    ║  POST /api/qa/mark-checked - Mark phrases checked            ║
    ║  POST /api/qa/bulk-mark-checked - Bulk mark checked          ║
    ║  GET  /api/qa/flags/:code/pending - Open flags               ║
    ║  GET  /api/qa/flags/:code - All flags with summary           ║
    ║  GET  /api/qa/summary/:code - QA dashboard summary           ║
    ║  GET  /api/qa/flagged-phrases/:code - Flags+phrases for UI   ║
    ║  PATCH /api/qa/flag/:id - Update flag status                 ║
    ║  POST /api/qa/flag/:id/resolve - Resolve flag                ║
    ║  POST /api/qa/flag/:id/dismiss - Dismiss as false positive   ║
    ║  DELETE /api/qa/phrase/:id - Delete flagged phrase            ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  QA Spawn Agents:                                            ║
    ║  POST /api/qa/spawn-fixer/:code - Spawn fixer agent          ║
    ║  POST /api/qa/spawn-polisher/:code - Spawn polisher agent    ║
    ║  POST /api/qa/spawn-audit/:code - Spawn audit agent          ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  Checkpoint/QA Workflow:                                     ║
    ║  GET  /api/checkpoint/summary/:code - Checkpoint summary     ║
    ║  POST /api/checkpoint/approve/:code - Approve checkpoint     ║
    ║  GET  /api/checkpoint/status/:code - Checkpoint status       ║
    ║  GET  /api/checkpoint/config/:code - Get config              ║
    ║  PUT  /api/checkpoint/config/:code - Update config           ║
    ║  GET  /api/checkpoint/qa-sample/:code - QA sample phrases    ║
    ║  POST /api/checkpoint/qa-result/:code - Submit QA results    ║
    ║  GET  /api/checkpoint/qa-status/:code - QA pending status    ║
    ╠══════════════════════════════════════════════════════════════╣
    ║  Health: GET /health                                         ║
    ╚══════════════════════════════════════════════════════════════╝

  ## ==========================================================================
  ## AGENT WORKFLOW SUMMARY
  ## ==========================================================================

  agent_workflow:
    description: "Recommended workflow for LLM agents building a course"

    for_each_seed:
      step_1: "Get the canonical English seed from GET /api/seeds or GET /api/next/:courseCode"
      step_2: "Translate to target language"
      step_3: "Decompose into LEGOs (identify A-type and M-type)"
      step_4: "For each LEGO, generate 10+ practice phrases"
      step_5: "Submit via POST /api/seed/complete (or ?draft=true for parallel builds)"
      step_6: "Handle errors if validation fails, fix and resubmit"

    on_zut_violation:
      description: "When same known text maps to different targets"
      preferred: "Upchunk - add context to create a more specific M-LEGO"
      alternative: "Synonym - use different known text"

    on_duplicate:
      description: "When same known + same target already exists"
      action: "API handles automatically (is_new=false, no baskets)"
      agent_action: "Nothing special needed - submit as normal"

  ## ==========================================================================
  ## AUTONOMOUS OPERATION
  ## ==========================================================================

  autonomous:
    description: |
      For autonomous course building without human intervention.
      Agent processes seeds in batches, continues until complete.

    ## FIRST THING AFTER RESUMING OR COMPACTION
    resume_first: |
      If you're resuming work or your context was compacted:
      IMMEDIATELY call: GET /api/resume/:courseCode

      This gives you the exact next seed. Do NOT proceed from memory.
      Do NOT guess what seed comes next. The API knows the truth.

    task: "Build complete course from canonical seeds"
    batch_size: 300

    quality_bar: |
      - No lazy shortcuts (don't make whole sentence one LEGO)
      - Proper granular decomposition (reusable units that combine well)
      - Meaningful components (no placeholder junk like "..." or empty meanings)
      - 10+ natural, useful practice phrases per LEGO
      - Trust your linguistic judgment - you know the languages

    workflow: |
      1. GET /api/seeds/:courseCode to fetch canonical English seeds
      2. Process batch of 30 seeds
      3. For each seed: translate, decompose, generate phrases, submit
      4. On success: continue to next batch
      5. On error: fix and resubmit, then continue
      6. Repeat until all seeds complete

    on_context_compaction: |
      If conversation context compacts mid-task:
      1. GET /api/resume/:courseCode - This single call returns EVERYTHING:
         - next_seed: The exact seed number and known_text to work on
         - recent_seeds: Last 5 completed seeds (translation style reference)
         - recent_legos: Last 20 new LEGOs (phrase vocabulary context)
         - progress: Percentage complete, vocab size
      2. Continue from next_seed immediately - do NOT guess or invent seeds

      CRITICAL: After compaction, ALWAYS use /api/resume to get the canonical
      seed text. Do NOT hallucinate seeds based on patterns you remember.

    done_when: "All seeds submitted successfully via POST /api/seed/complete"

  ## ==========================================================================
  ## VERSION HISTORY
  ## ==========================================================================

  version_history:
    v4_0_0:
      date: "2026-02-09"
      changes:
        - "Added parallel draft & finalization endpoints (GET /api/course/:code/drafts, POST /api/course/:code/finalize)"
        - "Build management now supports parallel mode (build_mode: 'parallel') with coordinator agent"
        - "Added POST /api/build/rebuild/:courseCode for wipe+rebuild of seed ranges"
        - "Added GET /api/build/seed-grid/:courseCode with draft/collision/rework status"
        - "Added full QA workflow: 14 endpoints for flag/resolve/dismiss lifecycle"
        - "Added QA spawn agents: POST /api/qa/spawn-fixer, spawn-polisher, spawn-audit"
        - "Added POST /api/qa/start/:courseCode for parallel QA orchestration"
        - "Added calibration endpoints (POST/GET calibration, cross-course patterns, per-seed)"
        - "Added quality rules endpoints (POST/GET /api/course/:code/quality-rules)"
        - "Added GET /api/next/:courseCode with vocab context and example decompositions"
        - "Added GET /api/seeds (canonical seeds), GET /api/phrases/:code, PATCH /api/phrases/:id"
        - "Validation gates now document smart vocab caching (LRU, 30-min TTL, max 10 courses)"
        - "loadCourseVocab() loads existing DB vocabulary -- agents only submit NEW LEGOs"
        - "Draft mode: ?draft=true routes to course_seed_drafts for parallel builds"
        - "Endpoint count: 71 (was 42 in v3.0)"

    v3_0_0:
      date: "2026-01-28"
      changes:
        - "Initial comprehensive APML spec with 42 endpoints"
        - "Golden path, validation gates, M-LEGO build-up, checkpoint system"
        - "Activity tracking, heartbeat, agent management, build management"
        - "Translation workflow, recency/balance analysis"
