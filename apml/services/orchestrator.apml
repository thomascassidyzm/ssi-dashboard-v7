# APML: Orchestrator Service
# Version: 1.2.0 (2026-01-15)
# Status: CANONICAL - This is the source of truth
# Type: SERVICE SPECIFICATION

service Orchestrator:
  name: "SSi Automation Orchestrator"
  purpose: "Coordinate course creation and service mesh"
  version: "1.2.0"
  port: 3456
  script: "services/orchestration/orchestrator.cjs"

  ## ==========================================================================
  ## OVERVIEW
  ## ==========================================================================

  overview: |
    The Orchestrator is the central coordination service for the SSi
    course production pipeline. It manages:

    1. Course creation (database-first - inserts into Supabase)
    2. Service mesh coordination (proxying to phase servers)
    3. Health monitoring for all services
    4. Legacy VFS support for existing courses

    **APML v14 Architecture (January 2026):**
    - Course creation: Just inserts into Supabase `courses` table
    - Content creation: Delegated to Course Builder API (port 3471)
    - Audio generation: Phase 8 (port 3465)
    - Manifest compilation: Phase 9 (port 3466)

    The orchestrator does NOT handle content generation directly -
    that's delegated to Course Builder API, Phase 8, and Phase 9.

  ## ==========================================================================
  ## ENDPOINTS
  ## ==========================================================================

  endpoints:
    ## Health & Status
    health:
      path: "GET /health"
      description: "Health check"
      response: '{"status": "ok", "uptime": 12345, "version": "1.1.0"}'

    health_all:
      path: "GET /health/all"
      description: "Health check for all services in mesh"

    api_health:
      path: "GET /api/health"
      description: "API health check with port info"

    ## Course Management
    list_courses:
      path: "GET /api/courses"
      description: "List all available courses"

    get_course:
      path: "GET /api/courses/:courseCode"
      description: "Get course details"

    course_exists:
      path: "GET /api/courses/:courseCode/exists"
      description: "Check if course exists (database + VFS + S3)"
      details: |
        Checks Supabase first (source of truth), then VFS, then S3.
        Returns existsDatabase, existsLocal, existsS3 flags.
        Suggests next version (e.g., zho_for_eng_v2) if course exists.

    course_status:
      path: "GET /api/courses/:courseCode/status"
      description: "Get course pipeline status"

    course_progress:
      path: "GET /api/courses/:courseCode/progress"
      description: "Get course progress across phases"

    course_analyze:
      path: "GET /api/courses/:courseCode/analyze"
      description: "Analyze course content"

    create_course:
      path: "POST /api/courses/create"
      description: "Create a new course (DATABASE-FIRST, APML v14)"
      details: |
        Inserts into Supabase `courses` table only. No VFS directory creation.
        Course Builder API (port 3471) handles all content creation via /api/seed/complete.
        VFS directories are legacy artifacts - not needed for new courses.
      request:
        courseCode: "zho_for_eng"
        displayName: "Chinese for English Speakers"
        sourceLanguage: "eng"
        targetLanguage: "zho"
      response:
        success: true
        courseCode: "zho_for_eng"
        message: "Course created. Use Course Builder to add content."

    sync_course:
      path: "POST /api/courses/:courseCode/sync"
      description: "Sync course data"

    ## Phase Execution
    start_phase:
      path: "POST /api/courses/:courseCode/start-phase"
      description: "Start a specific phase for a course"

    phase_complete:
      path: "POST /phase-complete"
      description: "Mark a phase as complete (called by phase servers)"

    ## Phase 1: Translation
    phase1_submit:
      path: "POST /api/phase1/:courseCode/submit"
      description: "Submit Phase 1 translation"

    phase1_upload_batch:
      path: "POST /api/phase1/:courseCode/upload-batch"
      description: "Upload batch of Phase 1 translations"

    phase1_master_complete:
      path: "POST /api/phase1/:courseCode/master-complete"
      description: "Mark Phase 1 as complete"

    phase1_stop:
      path: "POST /phase1/stop/:courseCode"
      description: "Stop Phase 1 processing"

    ## Phase 2: Conflict Resolution
    phase2_draft:
      path: "GET /api/phase2/:courseCode/draft"
      description: "Get Phase 2 draft LEGOs"

    phase2_seeds:
      path: "GET /api/phase2/:courseCode/seeds"
      description: "Get Phase 2 seeds"

    phase2_upload:
      path: "POST /api/phase2/:courseCode/upload"
      description: "Upload Phase 2 conflict resolution"

    phase2_upload_batch:
      path: "POST /api/phase2/:courseCode/upload-batch"
      description: "Upload batch of Phase 2 resolutions"

    phase2_master_complete:
      path: "POST /api/phase2/:courseCode/master-complete"
      description: "Mark Phase 2 as complete"

    phase2_stats:
      path: "GET /api/courses/:courseCode/phase2-stats"
      description: "Get Phase 2 statistics"

    ## Phase 3: Basket Generation
    phase3_submit:
      path: "POST /api/phase3/:courseCode/submit"
      description: "Submit Phase 3 baskets"
      aliases:
        - "POST /api/phase5/:courseCode/submit (legacy)"

    phase3_validate:
      path: "POST /api/courses/:courseCode/phase/3/validate"
      description: "Validate Phase 3 baskets"

    phase3_infinitive_check:
      path: "POST /api/courses/:courseCode/phase/3/infinitive-check"
      description: "Check infinitive forms in baskets"

    phase3_fix_collisions:
      path: "POST /api/courses/:courseCode/phase/3/fix-collisions"
      description: "Fix FD/LUT collisions in baskets"

    phase3_start:
      path: "POST /phase3/start"
      description: "Start Phase 3 basket generation"

    phase3_stop:
      path: "POST /phase3/stop/:courseCode"
      description: "Stop Phase 3 processing"

    phase3_abort:
      path: "POST /phase5/abort/:courseCode"
      description: "Abort Phase 3 processing (legacy route)"

    ## Basket Management
    baskets_gaps:
      path: "GET /api/courses/:courseCode/baskets/gaps"
      description: "Get missing baskets"

    baskets_cleanup:
      path: "POST /api/courses/:courseCode/baskets/cleanup"
      description: "Cleanup baskets"

    baskets_regenerate:
      path: "POST /api/courses/:courseCode/baskets/regenerate"
      description: "Regenerate baskets"

    upload_basket:
      path: "POST /upload-basket"
      description: "Upload a single basket"

    ## Phase 8: Audio Generation (proxied to port 3465)
    audio_plan:
      path: "POST /api/audio/plan"
      description: "Get audio generation plan"
      aliases:
        - "POST /api/phase8/plan (legacy)"

    audio_start:
      path: "POST /api/audio/start"
      description: "Start audio generation"
      aliases:
        - "POST /api/audio/generate"
        - "POST /api/phase8/start (legacy)"

    audio_status:
      path: "GET /api/audio/status/:courseCode"
      description: "Get audio generation status"
      aliases:
        - "GET /api/audio/generation-status/:courseCode"
        - "GET /api/phase8/status/:courseCode (legacy)"

    audio_progress:
      path: "GET /api/audio/progress/:courseCode"
      description: "Get audio generation progress"

    audio_continue:
      path: "POST /api/audio/continue"
      description: "Continue audio generation"
      aliases:
        - "POST /api/phase8/continue (legacy)"

    audio_regenerate:
      path: "POST /api/audio/regenerate"
      description: "Regenerate specific audio"
      aliases:
        - "POST /api/phase8/regenerate (legacy)"

    audio_regenerate_role:
      path: "POST /api/audio/regenerate-role/:courseCode"
      description: "Regenerate audio for a role"

    audio_regenerate_presentations:
      path: "POST /api/audio/regenerate-presentations/:courseCode"
      description: "Regenerate presentation audio"

    audio_qc_report:
      path: "GET /api/audio/qc-report/:courseCode"
      description: "Get audio QC report"
      aliases:
        - "GET /api/phase8/qc-report/:courseCode (legacy)"

    audio_status_all:
      path: "GET /api/audio/status"
      description: "Get status of all audio jobs"

    audio_voices:
      path: "GET /api/audio/voices"
      description: "Get available TTS voices"

    audio_stream:
      path: "GET /api/audio/stream/:uuid"
      description: "Stream audio file by UUID"

    audio_random_sample:
      path: "GET /api/audio/random-sample/:courseCode/:role"
      description: "Get random audio sample for QC"

    audio_random_cycle:
      path: "GET /api/audio/random-cycle/:courseCode"
      description: "Get random audio cycle for QC"

    audio_flag_sample:
      path: "POST /api/audio/flag-sample"
      description: "Flag audio sample for review"

    ## Manifest Compilation (Phase 9 - proxied to port 3466)
    manifest_submit:
      path: "POST /api/manifest/:courseCode/submit"
      description: "Submit manifest compilation request"
      aliases:
        - "POST /api/phase7/:courseCode/submit (legacy)"

    manifest_regenerate:
      path: "POST /api/courses/:courseCode/regenerate/manifest"
      description: "Regenerate course manifest"
      aliases:
        - "POST /api/courses/:courseCode/regenerate/phase7 (legacy)"

    regenerate_manifest_legacy:
      path: "POST /api/regenerate-manifest"
      description: "Regenerate manifest (legacy)"

    ## Voice Configuration
    voice_config_get:
      path: "GET /api/courses/:courseCode/voice-config"
      description: "Get voice configuration for course"

    voice_config_update:
      path: "PUT /api/courses/:courseCode/voice-config"
      description: "Update voice configuration"

    voices_discover:
      path: "GET /api/voices/discover/:languageCode"
      description: "Discover available voices for language"

    voices_preview:
      path: "POST /api/voices/preview"
      description: "Generate voice preview"

    voices_samples:
      path: "GET /api/voices/samples/:languageCode"
      description: "Get voice samples for language"

    ## Preview/Sample Generation
    sample_phrases:
      path: "GET /api/courses/:courseCode/sample-phrases"
      description: "Get sample phrases for preview"

    preview_generate:
      path: "POST /api/courses/:courseCode/preview/generate"
      description: "Generate preview audio"

    preview_generate_single:
      path: "POST /api/courses/:courseCode/preview/generate-single"
      description: "Generate single preview"

    preview_compare:
      path: "POST /api/courses/:courseCode/preview/compare"
      description: "Compare voice previews"

    preview_delete:
      path: "DELETE /api/courses/:courseCode/preview/:previewId"
      description: "Delete preview"

    preview_cleanup:
      path: "POST /api/courses/:courseCode/preview/cleanup"
      description: "Cleanup preview files"

    ## Pipeline Management
    pipelines_list:
      path: "GET /api/pipelines"
      description: "List all pipelines"

    pipelines_active:
      path: "GET /api/pipelines/active"
      description: "Get active pipelines"

    pipeline_get:
      path: "GET /api/pipelines/:pipelineId"
      description: "Get pipeline by ID"

    pipeline_create:
      path: "POST /api/courses/:courseCode/pipeline"
      description: "Create pipeline for course"

    pipeline_get_course:
      path: "GET /api/courses/:courseCode/pipeline"
      description: "Get pipeline for course"

    pipeline_update_phase:
      path: "PUT /api/pipelines/:pipelineId/phases/:phase"
      description: "Update pipeline phase"

    pipeline_add_job:
      path: "POST /api/pipelines/:pipelineId/jobs"
      description: "Add job to pipeline"

    pipeline_get_jobs:
      path: "GET /api/pipelines/:pipelineId/jobs"
      description: "Get pipeline jobs"

    ## Validation
    validate_all:
      path: "GET /api/courses/validate/all"
      description: "Validate all courses"

    validate_course:
      path: "GET /api/courses/:courseCode/validate"
      description: "Validate specific course"

    ## Cancellation
    cancel_course:
      path: "POST /api/cancel/:courseCode"
      description: "Cancel processing for course"

    cancel_all:
      path: "POST /api/cancel-all"
      description: "Cancel all processing"

    force_kill:
      path: "POST /api/force-kill/:courseCode"
      description: "Force kill course processing"

    ## Jobs & Events
    jobs_list:
      path: "GET /api/jobs"
      description: "List all jobs"

    events_push:
      path: "POST /api/events/:courseCode"
      description: "Push event for course"

    events_state:
      path: "GET /api/events/:courseCode/state"
      description: "Get event state for course"

    events_clear:
      path: "DELETE /api/events/:courseCode"
      description: "Clear events for course"

    ## VFS Management
    vfs_read:
      path: "GET /api/vfs/courses/:code/:file"
      description: "Read VFS file"

    course_files:
      path: "GET /api/courses/:courseCode/files/:filename"
      description: "Get course file"

    phase_outputs_get:
      path: "GET /api/courses/:courseCode/phase-outputs/:phase/:file"
      description: "Get phase output file"

    phase_outputs_put:
      path: "PUT /api/courses/:courseCode/phase-outputs/:phase/:file"
      description: "Update phase output file"

    ## Languages & Seeds
    languages_list:
      path: "GET /api/languages"
      description: "List supported languages"

    canonical_seeds:
      path: "GET /api/canonical-seeds"
      description: "Get canonical seed phrases"

    ## Flags
    flags_set:
      path: "POST /api/courses/:courseCode/flags"
      description: "Set course flags"

    flags_get:
      path: "GET /api/courses/:courseCode/flags"
      description: "Get course flags"

    flags_delete:
      path: "DELETE /api/courses/:courseCode/flags/:flagId"
      description: "Delete course flag"

    ## Miscellaneous
    translations_update:
      path: "PUT /api/courses/:courseCode/translations/:seedId"
      description: "Update translation for seed"

    phase_intelligence:
      path: "GET /api/phase-intelligence/:phase"
      description: "Get phase intelligence/prompts"

    zut_examples:
      path: "GET /api/zut-examples/:known/:target"
      description: "Get ZUT examples"

    course_script:
      path: "GET /api/courses/:courseCode/script"
      description: "Get course script"

    course_agents:
      path: "GET /api/courses/:courseCode/agents"
      description: "Get active agents for course"

    ## Language Brief
    language_brief_get:
      path: "GET /api/language-brief/:known/:target"
      description: "Get language brief"

    language_brief_create:
      path: "POST /api/language-brief"
      description: "Create language brief"

    language_brief_update:
      path: "PUT /api/language-brief/:known/:target"
      description: "Update language brief"

    language_brief_generate:
      path: "POST /api/language-brief/generate"
      description: "Generate language brief"

    ## Prompts
    prompts_get:
      path: "GET /api/prompts/:phaseCode"
      description: "Get prompt for phase"

    prompts_versions:
      path: "GET /api/prompts/:phaseCode/versions"
      description: "Get prompt versions"

    prompts_create:
      path: "POST /api/prompts/:phaseCode"
      description: "Create new prompt"

    prompts_activate:
      path: "POST /api/prompts/:phaseCode/:version/activate"
      description: "Activate prompt version"

    ## Briefs
    briefs_get:
      path: "GET /api/briefs/:knownCode/:targetCode"
      description: "Get brief for language pair"

    briefs_create:
      path: "POST /api/briefs/:knownCode/:targetCode"
      description: "Create brief for language pair"

    ## Preview
    preview_list:
      path: "GET /api/preview/:courseCode"
      description: "Get preview for course"

    preview_phase:
      path: "GET /api/preview/:courseCode/:phase"
      description: "Get preview for specific phase"

    ## Scaffolds
    scaffolds_batch:
      path: "GET /scaffolds/:courseCode/batch"
      description: "Get scaffold batch"

    scaffolds_seed:
      path: "GET /scaffolds/:courseCode/seed/:seedId"
      description: "Get scaffold for seed"

    ## Master Heartbeat
    master_heartbeat:
      path: "POST /master-heartbeat"
      description: "Master agent heartbeat"

    masters_get:
      path: "GET /masters/:courseCode/:phase"
      description: "Get master for phase"

    ## Course Generation (DEPRECATED - use Course Builder API)
    generate_course:
      path: "POST /api/courses/generate"
      description: "DEPRECATED - Was Phase 5 trigger, now use Course Builder API (port 3471)"
      deprecated: true
      replacement: "POST /api/seed/complete on port 3471 (Course Builder API)"

    ## Modes & Profiles
    modes_list:
      path: "GET /api/modes"
      description: "List processing modes"

    machine_profiles:
      path: "GET /api/machine-profiles"
      description: "List machine profiles"

    machine_profile_pattern:
      path: "GET /api/machine-profiles/:profileId/pattern"
      description: "Get machine profile pattern"

    ## Import
    import_course:
      path: "POST /api/import-course"
      description: "Import course from external source"

    ## Documentation
    docs_list:
      path: "GET /api/docs/list"
      description: "List available docs"

    docs_get:
      path: "GET /api/docs/:slug"
      description: "Get doc by slug"

    ## Production API Proxy
    production_proxy:
      path: "/api/production/*"
      description: "Proxied to production-api on port 3470"

  ## ==========================================================================
  ## MULTI-AGENT COORDINATION
  ## ==========================================================================

  multi_agent:
    description: |
      The orchestrator coordinates multiple Claude agents working in parallel
      on different seed ranges. Each agent works in its own git branch.

    workflow:
      1: "User requests seed range (e.g., S0001-S0100)"
      2: "Orchestrator divides into segments (e.g., 5 agents × 20 seeds)"
      3: "Orchestrator creates agent branches (agent-01, agent-02, etc.)"
      4: "Orchestrator spawns agents via browser automation"
      5: "Agents work independently, committing to their branches"
      6: "Orchestrator monitors completion via VFS polling"
      7: "Orchestrator merges completed branches to main"

    configuration:
      AGENT_SPAWN_DELAY: 5000  # ms between spawns
      SEGMENT_SIZE: 50         # seeds per segment
      AGENTS_PER_SEGMENT: 5    # agents per segment
      SEEDS_PER_AGENT: 10      # seeds per agent
      GIT_AUTO_MERGE: true     # auto-merge completed branches

    browser_automation:
      method: "AppleScript (macOS)"
      target: "https://claude.ai/code"
      clipboard: "pbcopy for prompts"

  ## ==========================================================================
  ## CHECKPOINT MODES
  ## ==========================================================================

  checkpoint_modes:
    manual:
      description: "Pause between phases, require user approval"
      use_case: "Testing and debugging"
      behavior: "Pause after each phase, wait for user input"

    gated:
      description: "Auto-run but pause if validators fail"
      use_case: "Normal development (recommended)"
      behavior: "Continue if validation passes, pause on failure"

    full:
      description: "Full automation, no stops"
      use_case: "Production after validation"
      behavior: "Run all phases without pausing"

  ## ==========================================================================
  ## VFS MANAGEMENT
  ## ==========================================================================

  vfs:
    description: |
      Virtual File System for course data files.
      Maps logical paths to physical locations.

    root: "VFS_ROOT environment variable"
    structure:
      courses:
        pattern: "{VFS_ROOT}/courses/{courseCode}/"
        contents:
          - "canonical_seeds.json"
          - "draft_lego_pairs.json"
          - "lego_pairs.json"
          - "lego_baskets.json"
          - "course_manifest.json"

    polling:
      interval: 2000  # ms
      purpose: "Monitor for agent completion"
      triggers:
        - "New file written"
        - "File modified"
        - "Git commit detected"

  ## ==========================================================================
  ## SERVICE MESH (PHASE_SERVERS)
  ## ==========================================================================

  service_mesh:
    description: |
      Inter-service communication. The orchestrator maintains a PHASE_SERVERS
      mapping that routes requests to phase-specific services. Each service
      can be overridden via environment variables for remote/tunnel access.

    phase_servers:
      ## PHASE_SERVERS constant in orchestrator.cjs
      1_translation:
        port: 3457
        env_var: "PHASE1_TRANSLATION_URL"
        default: "http://localhost:3457"
        description: "Phase 1: Translation + LEGO Extraction"

      1_lego:
        port: 3458
        env_var: "PHASE1_LEGO_URL"
        default: "http://localhost:3458"
        description: "Phase 1 (LEGO extraction service)"

      2:
        port: 3458
        env_var: "PHASE1_LEGO_URL"
        default: "http://localhost:3458"
        description: "Phase 2: Conflict Resolution (shares server with 1_lego)"

      3:
        port: 3459
        env_var: "PHASE3_URL"
        default: "http://localhost:3459"
        description: "Phase 3: Basket Generation (APML v9.0)"

      8:
        port: 3465
        env_var: "PHASE8_URL"
        fallback_env: "AUDIO_URL"
        default: "http://localhost:3465"
        description: "Phase 8: Audio Generation (TTS)"

      9:
        port: 3466
        env_var: "PHASE9_URL"
        default: "http://localhost:3466"
        description: "Phase 9: Manifest Compilation (Supabase-backed)"

      manifest:
        port: 3464
        env_var: "MANIFEST_URL"
        default: "http://localhost:3464"
        description: "Legacy Phase 7 - DEPRECATED"

      audio:
        port: 3465
        env_var: "AUDIO_URL"
        default: "http://localhost:3465"
        description: "Alias for Phase 8"

    legacy_aliases:
      ## LEGACY_PHASE_ALIASES for backward compatibility
      1: "→ 1_translation (port 3457)"
      5: "→ Phase 3 (port 3459) - Legacy Phase 5"
      7: "→ manifest (port 3464) - DEPRECATED"
      8: "→ Phase 8 (port 3465)"
      9: "→ Phase 9 (port 3466)"

    production_api:
      port: 3470
      env_var: "PRODUCTION_API_URL"
      default: "http://localhost:3470"
      description: "Production API for QA, recording, WebSocket"
      routes:
        - "All /api/production/* routes proxied"

  ## ==========================================================================
  ## DEPENDENCIES
  ## ==========================================================================

  dependencies:
    node_packages:
      - "express"
      - "cors"
      - "socket.io"
      - "fs-extra"
      - "@supabase/supabase-js"

    external:
      - "Git (for branch management)"
      - "PM2 (process management)"
      - "AppleScript (browser automation on macOS)"

  ## ==========================================================================
  ## STARTUP
  ## ==========================================================================

  startup:
    script: "start-automation.cjs"
    process_name: "ssi-orchestrator"

    steps:
      1: "Load environment variables"
      2: "Calculate service ports from BASE_PORT"
      3: "Start all phase services via PM2"
      4: "Verify health of all services"
      5: "Begin VFS polling"
      6: "Open WebSocket for real-time updates"

## ============================================================================
## GENERATED: 2026-01-12
## APML Orchestrator Service v1.1.0
## Synchronized with orchestrator.cjs - PHASE_SERVERS mapping verified
## ============================================================================
