# APML: Dashboard UI Components
# Version: 1.0.0 (2026-01-03)
# Status: CANONICAL - This is the source of truth
# Type: INTERFACE SPECIFICATION

interface DashboardUI:
  name: "SSi Dashboard Vue Components"
  purpose: "Catalog of all Vue components - PRESERVE THESE"
  version: "1.0.0"
  framework: "Vue 3 Composition API"
  styling: "Tailwind CSS"
  component_count: 102

  ## ==========================================================================
  ## QUALITY STATEMENT
  ## ==========================================================================

  quality:
    status: "EXCELLENT"
    notes: |
      These Vue components represent significant design and development work.
      They are visually polished, functionally complete, and should be
      preserved when creating new repos.

      The "Mission Control" aesthetic is particularly noteworthy -
      professional, clean, and appropriate for a content production tool.

  ## ==========================================================================
  ## MAIN VIEWS (src/views/)
  ## ==========================================================================

  views:
    description: "Top-level page components - routes to these"

    core:
      Dashboard.vue:
        route: "/"
        description: "Main landing page"

      MissionControl.vue:
        route: "/mission-control"
        description: "Central operations dashboard"
        quality: "FLAGSHIP - excellent design"

      CourseEditor.vue:
        route: "/course/:courseCode/edit"
        description: "Edit seeds, LEGOs, baskets for a course"

      CourseGeneration.vue:
        route: "/generate"
        description: "Launch multi-agent course generation"

      CourseBrowser.vue:
        route: "/courses"
        description: "Browse all courses"

      NewCourse.vue:
        route: "/courses/new"
        description: "Create new course form"

    content:
      CanonicalSeeds.vue:
        route: "/seeds"
        description: "View canonical seed phrases"

      CanonicalContent.vue:
        route: "/content"
        description: "Browse canonical content library"

      CourseScriptView.vue:
        route: "/course/:courseCode/script"
        description: "Full script view with audio playback"

    production:
      description: "Production suite views - QA and audio workflow"
      location: "src/views/production/"

      MissionControl.vue:
        route: "/production/:courseCode"
        description: "Production dashboard for a course"

      AudioPipeline.vue:
        route: "/production/:courseCode/audio"
        description: "Audio generation pipeline view"

      ScriptViewer.vue:
        route: "/production/:courseCode/script"
        description: "Script with audio playback and editing"

      RecordingStudio.vue:
        route: "/production/:courseCode/recording"
        description: "Human recording interface"

      UserFeedback.vue:
        route: "/production/:courseCode/feedback"
        description: "Crowdsourced feedback aggregation"

    audio:
      AudioGeneration.vue:
        route: "/audio"
        description: "Audio generation controls"

      AudioPipelineView.vue:
        route: "/audio/pipeline"
        description: "Audio pipeline status"

    pedagogy:
      Pedagogy.vue:
        route: "/pedagogy"
        description: "SSi methodology documentation"

      PhaseIntelligence.vue:
        route: "/phases"
        description: "Phase intelligence reference"

      APMLSpec.vue:
        route: "/apml"
        description: "APML specification viewer"

    admin:
      Login.vue:
        route: "/login"
        description: "Authentication login"

      AuthVerify.vue:
        route: "/auth/verify"
        description: "Magic link verification"

      UserManagement.vue:
        route: "/admin/users"
        description: "User management (admin only)"

    other:
      CourseProgress.vue:
        route: "/course/:courseCode/progress"
        description: "Course completion progress"

      CourseCompilation.vue:
        route: "/course/:courseCode/compile"
        description: "Manifest compilation view"

      CourseValidator.vue:
        route: "/course/:courseCode/validate"
        description: "Course validation results"

      ProcessOverview.vue:
        route: "/process"
        description: "Pipeline process overview"

      RecursiveUpregulation.vue:
        route: "/upregulation"
        description: "Learning optimization view"

      DocsIndex.vue:
        route: "/docs"
        description: "Documentation index"

      TerminologyGlossary.vue:
        route: "/glossary"
        description: "SSi terminology reference"

