interface StatusBadge:
  file: "src/components/production/qa/StatusBadge.vue"
  purpose: "Cinematic status indicator for audio samples"

  props:
    status:
      type: String
      required: false
      default: "pending"
      values: ["pending", "flagged_regen_tts", "flagged_human_needed", "in_pipeline", "in_recording", "needs_review", "approved", "rejected"]
      description: "Sample status"
    size:
      type: String
      required: false
      default: "md"
      values: ["sm", "md", "lg"]
      description: "Badge size variant"

  features:
    - "Pill-shaped badge with status dot"
    - "Cinematic color palette (amber, red, cyan, green)"
    - "Animated pulse for in_progress status"
    - "Glow effect for flagged and approved states"
    - "Size variants: sm (0.65rem), md (0.75rem), lg (0.85rem)"
    - "Monospace font (IBM Plex Mono)"
    - "Uppercase with letter-spacing"

## ----------------------------------------------------------------------------

interface CourseSelector:
  file: "src/components/production/CourseSelector.vue"
  purpose: "Production suite course browser with phase completion display"

  props:
    # No external props - self-contained page

  internal_state:
    courses:
      type: Array
      description: "List of courses from API"
    searchQuery:
      type: String
      description: "Search filter text"
    loading:
      type: Boolean
      description: "Loading state"

  features:
    - "Course cards with code, name, status badge"
    - "Search by course code, language name, or phase"
    - "Stats display: SEED_PAIRS, LEGO_PAIRS, LEGO_BASKETS, INTRODUCTIONS"
    - "Phase completion indicators: 1, 3, M (Manifest), A (Audio)"
    - "Click navigates to /production/:courseCode"
    - "Language name mapping for 14 languages"
    - "Responsive grid layout (1-3 columns)"

