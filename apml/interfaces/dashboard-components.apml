interface MissionControl:
  file: "src/views/production/MissionControl.vue"
  purpose: "Central production dashboard with pipeline status and quick actions"

  props:
    courseCode:
      type: String
      required: false
      description: "Course code from route params"

  internal_state:
    selectedCourse:
      type: String
      description: "Currently selected course"
    showImportModal:
      type: Boolean
      description: "Import course modal visibility"
    showLegacyExportDialog:
      type: Boolean
      description: "Legacy export dialog visibility"

  events:
    # Internal navigation and action handlers

  features:
    - "Overall progress section with ProgressRing"
    - "Audio stats: NEEDED, GENERATED, PENDING, FLAGGED"
    - "BlockerList component for release blockers"
    - "Pipeline stage cards grid (StageCard component)"
    - "Quick actions panel with 10 action buttons"
    - "Import Course modal integration"
    - "Legacy Export dialog integration"
    - "Launch Learning App with QA token"
    - "WebSocket status indicator"
    - "Responsive layout with mobile support"

  quick_actions:
    - "import_course: Import Legacy Course"
    - "generate_audio: Generate Audio (TTS)"
    - "review_samples: Review Samples"
    - "record_human: Record Human Voice"
    - "recording_optimizer: LEGO Splice Engine"
    - "compile_manifest: Compile Manifest"
    - "user_feedback: User Feedback"
    - "launch_learning_app: Open in Learning App"
    - "agent_monitor: Agent Monitor"
    - "export_legacy: Export Legacy Format"

## ============================================================================
## VISUALIZATION COMPONENTS
## ============================================================================

interface LegoVisualizer:
  file: "src/components/LegoVisualizer.vue"
  purpose: "LEGO amino acids browser with filtering, editing, and provenance"

  props:
    courseCode:
      type: String
      required: true
      description: "Course identifier"
    editable:
      type: Boolean
      required: false
      default: true
      description: "Enable edit mode"
    initialFilters:
      type: Object
      required: false
      description: "Pre-set filter values"

  events:
    lego-edited:
      payload: "Updated LEGO object"
      description: "Emitted when LEGO text is saved"
    show-provenance:
      payload: "{ lego, provenance } or { lego, type: 'impact' }"
      description: "Emitted when provenance or impact requested"

  features:
    - "LEGO cards with text, provenance chain, and 3 scores (FCFS, Utility, Pedagogical)"
    - "Score bars with color-coded fills"
    - "Search by LEGO text"
    - "FCFS and Utility range sliders"
    - "Sort by: FCFS (asc/desc), Utility (asc/desc), Alphabetical"
    - "Pagination (20 items per page)"
    - "Inline editing with Save/Cancel"
    - "Provenance modal showing source SEED and translation UUIDs"
    - "Show Impact button for downstream analysis"
    - "Reset Filters button"
    - "Responsive custom scrollbars"

  api_endpoint: "GET /api/visualization/legos/:courseCode"

## ----------------------------------------------------------------------------

interface SeedProgressGrid:
  file: "src/components/generation/SeedProgressGrid.vue"
  purpose: "Mission Control aesthetic grid showing seed phase completion"

  props:
    courseCode:
      type: String
      required: true
      description: "Course identifier"
    targetSeedCount:
      type: Number
      required: false
      default: 668
      description: "Total seeds expected"
    seedProgress:
      type: Array
      required: false
      default: []
      description: "Array of { seed, seedId, phase1, phase2, phase3 }"

  events:
    refresh:
      payload: "none"
      description: "Emitted when refresh button clicked"

  features:
    - "Dense grid of seed cells (dynamic columns based on count)"
    - "3 colored phase bars per cell: P1 (blue), P2 (purple), P3 (green)"
    - "Stats bar showing completion counts per phase"
    - "Animated scan line effect on refresh"
    - "Hover tooltip showing seed ID and phase status"
    - "Legend for phase colors and pending/complete states"
    - "Scrollable viewport with custom scrollbar"
    - "JetBrains Mono font for mission control aesthetic"
    - "Responsive layout for mobile"

## ============================================================================
## EXECUTION MODE COMPONENT
## ============================================================================

interface ExecutionModeSelector:
  file: "src/components/ExecutionModeSelector.vue"
  purpose: "Select execution mode for course generation (Web/Local/API)"

  props:
    modelValue:
      type: String
      required: false
      default: "web"
      values: ["web", "local", "api"]
      description: "Currently selected mode (v-model)"

  events:
    update:modelValue:
      payload: "String (web|local|api)"
      description: "Emitted when mode selection changes"

  features:
    - "3 mode cards with detailed explanations"
    - "Web Mode: Browser automation to claude.ai/code, uses Pro subscription"
    - "Local Mode: iTerm2 windows + Claude CLI, parallel agents"
    - "API Mode: Server-side Anthropic API calls"
    - "Selected state highlight with emerald border"
    - "Recommended badge on Web mode"
    - "Pro/con list with checkmarks and warnings"
    - "Requirements section per mode"
    - "Info box explaining mode differences"
    - "v-model compatible (modelValue/update:modelValue)"

## ============================================================================
## COMPONENT RELATIONSHIPS
## ============================================================================

relationships:
  MissionControl:
    uses:
      - "ProgressRing"
      - "StageCard"
      - "BlockerList"
      - "QuickActions"
      - "EnvironmentSwitcher"
      - "ImportCourseModal"
      - "LegacyExportDialog"

  QualityDashboard:
    navigates_to: "SeedQualityReview"

  SeedQualityReview:
    uses: "LegoVisualizer"
    navigates_to: "QualityDashboard"

  Dashboard:
    uses:
      - "SchemaHealth"
      - "EnvironmentSwitcher"

## ============================================================================
## DESIGN PATTERNS
## ============================================================================

patterns:
  state_management:
    - "Props for configuration, internal refs for UI state"
    - "Computed for derived values (filtered lists, percentages)"
    - "localStorage for persistence (environment, api_base_url)"
    - "Pinia stores for complex shared state (useProductionStore)"

  api_integration:
    - "Axios for API calls with ngrok-skip-browser-warning header"
    - "getApiUrl() helper for environment-aware base URL"
    - "Polling with setInterval for real-time updates"
    - "AbortSignal for timeout handling"

  ui_patterns:
    - "Card-based layouts with dark slate backgrounds"
    - "Emerald accent color for success/active states"
    - "Progress bars with animated fills"
    - "Modal dialogs for detailed views"
    - "Keyboard shortcuts for power users"
    - "Responsive grid layouts"

