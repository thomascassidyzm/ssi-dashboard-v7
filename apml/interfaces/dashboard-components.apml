interface DashboardComponents:
  name: "SSi Dashboard Component Specifications"
  purpose: "Detailed props/events documentation for critical Vue components"
  version: "1.0.0"
  framework: "Vue 3 Composition API"
  styling: "Tailwind CSS"
  documented_count: 16

## ============================================================================
## DASHBOARD/STATUS COMPONENTS
## ============================================================================

interface SchemaHealth:
  file: "src/components/SchemaHealth.vue"
  purpose: "Database schema validation indicator with drift detection"

  props:
    # No external props - self-contained component

  internal_state:
    loading:
      type: Boolean
      description: "Whether validation is in progress"
    error:
      type: String
      description: "Error message if validation failed"
    validation:
      type: Object
      description: "Validation result with tables, summary, and status"
    showDetails:
      type: Boolean
      description: "Whether dropdown details panel is visible"

  events:
    # Emits no external events - click toggles internal showDetails

  features:
    - "Compact status indicator (Schema OK / Schema Drift)"
    - "Clickable dropdown with detailed table-by-table validation"
    - "Color-coded status: green=OK, red=MISSING, yellow=column issues"
    - "Refresh button to re-run validation on demand"
    - "Shows schema version and last validated timestamp"
    - "Auto-validates on component mount"

  api_endpoint: "GET /api/production/schema/validate"

## ----------------------------------------------------------------------------

interface EnvironmentSwitcher:
  file: "src/components/EnvironmentSwitcher.vue"
  purpose: "Multi-machine coordination switcher (Tom/Kai/API)"

  props:
    # No external props - reads/writes localStorage

  internal_state:
    selectedEnv:
      type: String
      values: ["tom", "kai", "api"]
      description: "Currently selected environment"
    connectionStatus:
      type: Object
      properties:
        connected: Boolean
        message: String
      description: "Connection health status"

  features:
    - "Three environments: Tom's Machine, Kai's Machine, API Server"
    - "Inline status dot showing connection health (green/red)"
    - "Auto-checks connection to selected environment on mount"
    - "Persists selection in localStorage (ssi_environment)"
    - "Sets api_base_url and ssi_machine_profile in localStorage"
    - "Triggers page reload on environment switch to reinitialize API"
    - "Default environment configurable via VITE_DEFAULT_ENVIRONMENT"

  environments:
    tom:
      url: "https://popty.ngrok.app"
      machineProfile: "tom"
    kai:
      url: "https://kai-lizard-function.ngrok-free.dev"
      machineProfile: "kai"
    api:
      url: "http://localhost:3470"
      machineProfile: "default"

## ----------------------------------------------------------------------------

interface ProgressMonitor:
  file: "src/components/ProgressMonitor.vue"
  purpose: "Real-time pipeline progress monitoring with phase tracking"

  props:
    courseCode:
      type: String
      required: true
      description: "Course identifier for progress polling"
    pollInterval:
      type: Number
      required: false
      default: 5000
      description: "Polling interval in milliseconds"
    seedCount:
      type: Number
      required: false
      description: "Optional total seed count for display"

  internal_state:
    liveProgress:
      type: Object
      description: "Current progress data from API"
    executionMode:
      type: String
      values: ["web", "local", "hybrid"]
      description: "Current execution mode"

  features:
    - "Live progress bar with percentage and seed counts"
    - "Phase title display (Phase 1, Phase 3, Manifest, Audio)"
    - "ETA estimation when available"
    - "Recent activity log (last 5 events)"
    - "Execution mode badge (Web/Local/Hybrid)"
    - "Auto-polls API at configurable interval"
    - "Graceful fallback when no active pipeline"

  api_endpoint: "GET /api/courses/:courseCode/progress"

## ----------------------------------------------------------------------------

interface PipelineProgress:
  file: "src/components/PipelineProgress.vue"
  purpose: "4-segment progress bar for course creation (Translate/Extract/Practice/Build)"

  props:
    courseCode:
      type: String
      required: true
      description: "Course identifier"
    currentPhase:
      type: Number
      required: false
      default: 1
      description: "Current phase number (1, 3, 5, or 7)"
    seedsProcessed:
      type: Number
      required: false
      default: 0
      description: "Seeds completed in current phase"
    totalSeeds:
      type: Number
      required: false
      default: 30
      description: "Total seeds to process"
    startedAt:
      type: String
      required: false
      description: "ISO timestamp when processing started"

  computed:
    progressPercent:
      description: "Overall progress (each phase = 25%)"
    progressText:
      description: "Human-readable progress text"
    timeEstimate:
      description: "Estimated time remaining"

  features:
    - "4 phase indicators: Translate, Extract, Practice, Build"
    - "Phase status: completed (checkmark), active (dots), pending (empty)"
    - "Animated progress bar with pulse effect"
    - "Dynamic status message per phase"
    - "Time estimate calculation from elapsed time"
    - "Emoji indicators per phase"

## ============================================================================
## QUALITY REVIEW COMPONENTS
## ============================================================================

interface QualityDashboard:
  file: "src/components/quality/QualityDashboard.vue"
  purpose: "Quality metrics dashboard with filtering, sorting, and bulk actions"

  props:
    courseCode:
      type: String
      required: true
      description: "Course identifier"

  internal_state:
    seeds:
      type: Array
      description: "List of seeds with quality scores"
    selectedSeeds:
      type: Array
      description: "Selected seed IDs for bulk actions"
    filters:
      type: Object
      properties:
        search: String
        status: String
        qualityRange: String
        concern: String
        sortBy: String
        sortDesc: Boolean

  events:
    # Internal navigation events

  features:
    - "5-column stats bar: Avg Quality, Flagged, Accepted, Avg Attempts, Pending"
    - "Interactive quality distribution histogram (0-10 scale)"
    - "Multi-filter system: search, status, quality range, concerns"
    - "Sort options: Quality Score, Attempts, SEED ID, Status"
    - "Bulk actions: Accept, Re-run, Remove selected"
    - "Paginated seed list with 20 items per page"
    - "Keyboard shortcuts: j/k navigate, a accept, r re-run, x toggle, ? help"
    - "Quick action buttons per seed row"
    - "Export to CSV/PDF functionality"

  filter_options:
    status: ["pending", "flagged", "accepted", "rejected"]
    qualityRange: ["9-10", "8-9", "7-8", "0-7"]
    concerns: ["boundary", "overlap", "missing", "semantic", "complex"]

## ----------------------------------------------------------------------------

interface CourseHealthReport:
  file: "src/components/quality/CourseHealthReport.vue"
  purpose: "Comprehensive course health metrics and recommendations"

  props:
    courseCode:
      type: String
      required: true
      description: "Course identifier"

  features:
    - "Circular overall health score (0-100) with color gradient"
    - "6 health factors with progress bars: Extraction Quality, Coverage, Consistency, Boundary Accuracy, Semantic Coherence, System Efficiency"
    - "30-day quality trend chart with interactive tooltips"
    - "Phase completion status with progress bars"
    - "Re-run statistics: attempts distribution, re-run reasons"
    - "Common concerns section with recommended actions"
    - "System configuration display (prompt version, model, thresholds)"
    - "Performance metrics (API calls, success rate, cache hit rate)"
    - "Prioritized recommendations with Apply button"
    - "Export to PDF/CSV and scheduled reports"

## ----------------------------------------------------------------------------

interface SeedQualityReview:
  file: "src/components/quality/SeedQualityReview.vue"
  purpose: "Detailed seed-level quality review with attempt comparison"

  props:
    courseCode:
      type: String
      required: true
      description: "Course identifier"
    seedId:
      type: String
      required: true
      description: "SEED identifier to review"

  internal_state:
    attempts:
      type: Array
      description: "List of extraction attempts for this seed"
    currentAttemptIndex:
      type: Number
      description: "Currently viewed attempt index"
    compareWithIndex:
      type: Number
      description: "Index of attempt to compare with (or null)"

  features:
    - "Large quality score display with status badge"
    - "Timeline navigation between attempts"
    - "5-dimension quality breakdown: Boundaries, Coverage, Semantics, Overlap, Complexity"
    - "Agent's self-assessment text and identified concerns"
    - "Side-by-side LEGO extraction comparison (uses LegoVisualizer)"
    - "Diff summary: added/removed/modified LEGOs"
    - "LEGO details table with text, span, type, confidence"
    - "Extraction context: prompt version, model, timestamp, processing time"
    - "View full prompt toggle"
    - "Action buttons: Accept, Reject, Re-run, Remove from Corpus"
    - "Keyboard shortcuts: a accept, r re-run, arrows navigate attempts"

