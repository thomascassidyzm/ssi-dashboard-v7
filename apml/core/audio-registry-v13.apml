# APML: Audio Registry Architecture
# Version: 13.2.0 (2026-01-05)
# Status: CANONICAL - This is the source of truth
# Type: CORE ARCHITECTURE SPECIFICATION

architecture AudioRegistry:
  name: "Course-Owned Audio Architecture"
  purpose: "Simple, course-centric audio ownership with shared audio for reusables"
  version: "13.2.0"

  ## ==========================================================================
  ## BREAKING CHANGE FROM v12
  ## ==========================================================================

  breaking_change:
    summary: |
      v13 REMOVES the texts/audio_files indirection layer.
      Audio is now directly owned by courses (course_audio) or shared globally (shared_audio).

    problem_with_v12: |
      v12 separated text from audio with a join table:
        texts → audio_files → course_audio

      This was over-engineered:
      1. Most audio is course-specific, not shared
      2. The join complexity made queries slow and error-prone
      3. Deduplication across courses was rarely needed
      4. Human audio (Welsh courses) doesn't fit the TTS model

    solution: |
      Two simple tables:
      - course_audio: Course owns its audio directly
      - shared_audio: Only for genuinely shared content (encouragements)

      No joins. No indirection. Course-centric ownership.

  ## ==========================================================================
  ## CORE PRINCIPLE: Courses Own Their Audio
  ## ==========================================================================

  principle: |
    A course is the unit of ownership. Each course has its own audio.

    ┌─────────────────────────────────────────────────────────────────┐
    │                     SIMPLE OWNERSHIP                            │
    │                                                                 │
    │  courses ──────────── course_audio ──────────── S3             │
    │  (voice_config)       (text, role, s3_key)      (bytes)        │
    │                                                                 │
    │  shared_audio ─────────────────────────────────── S3           │
    │  (encouragements, instructions)                  (bytes)        │
    │                                                                 │
    └─────────────────────────────────────────────────────────────────┘

    - Course audio: Unique per course+text+language+role
    - Shared audio: Unique per text+language+audio_type (encouragements/instructions)
    - No joins needed for basic operations

  ## ==========================================================================
  ## S3 STORAGE
  ## ==========================================================================

  s3:
    bucket: "ssi-audio-stage"
    region: "eu-west-1"

    ## =========================================================================
    ## CRITICAL: s3_key IS THE TRUTH
    ## =========================================================================
    ##
    ## The course_audio.s3_key column contains the ACTUAL S3 object key.
    ## Use it AS-IS to construct URLs. Do NOT normalize or modify it.
    ##
    ## URL construction:
    ##   https://ssi-audio-stage.s3.eu-west-1.amazonaws.com/{s3_key}
    ##
    ## =========================================================================

    storage_model: |
      S3 is a dumb blob store. All metadata lives in Supabase.
      The s3_key column is the actual S3 object key - use it as-is.

    key_formats:
      mastered:
        pattern: "mastered/{UUID}.mp3"
        location: "mastered/ folder"
        example: "mastered/7372F60B-5312-4985-B0A0-A97F92323F83.mp3"
        used_by: "ALL new audio generated by phase8-audio-v13 (January 2026+)"

      legacy_flat:
        pattern: "{UUID}.mp3"
        location: "bucket root"
        example: "7372F60B-5312-4985-B0A0-A97F92323F83.mp3"
        used_by: "Early v13 Spanish presentation audio (to be migrated)"
        note: "These files exist but were not mastered - will be regenerated"

    important: |
      BOTH formats exist in S3. The s3_key column tells you exactly where
      the file is. Do NOT try to normalize or strip paths.

      For Dashboard Agent:
        - ALL new audio: use mastered/{UUID}.mp3 format
        - Audio is normalized (-16 LUFS) before upload
        - The s3_key you store must match the actual S3 object key

      For Learning App:
        - Read s3_key from database
        - Construct URL: https://ssi-audio-stage.s3.eu-west-1.amazonaws.com/{s3_key}
        - Works for both formats automatically

    uuid_format: "UPPERCASE"
    rationale_uppercase: |
      UUIDs are stored in UPPERCASE for consistency:
      - All letters same height in URLs (neater)
      - Matches existing S3 records convention
      - Generated via uuidv4().toUpperCase()

    examples:
      mastered_format:
        s3_key: "mastered/7372F60B-5312-4985-B0A0-A97F92323F83.mp3"
        full_url: "https://ssi-audio-stage.s3.eu-west-1.amazonaws.com/mastered/7372F60B-5312-4985-B0A0-A97F92323F83.mp3"

      legacy_flat:
        s3_key: "7A30E5E0-3167-5FA2-946B-BA37B022D8FD.mp3"
        full_url: "https://ssi-audio-stage.s3.eu-west-1.amazonaws.com/7A30E5E0-3167-5FA2-946B-BA37B022D8FD.mp3"

  ## ==========================================================================
  ## AUDIO MASTERING PIPELINE
  ## ==========================================================================

  mastering:
    purpose: |
      All TTS-generated audio is mastered before upload to ensure consistent
      playback quality across all courses and devices.

    pipeline: |
      1. TTS Generation (Azure/ElevenLabs)
         ↓ raw audio buffer
      2. Normalization (ffmpeg loudnorm)
         - Target: -16 LUFS (broadcast standard)
         - LRA: 11 (loudness range)
         - True peak: -1.5 dBFS
         ↓ normalized audio
      3. Duration Extraction (ffprobe)
         - Extract duration in milliseconds
         - Store in course_audio.duration_ms
         ↓ mastered audio + duration
      4. S3 Upload
         - Key: mastered/{UUID}.mp3
         - ContentType: audio/mpeg

    requirements:
      - ffmpeg: Required for normalization
      - ffprobe: Required for duration extraction
      - Temp directory for processing (cleaned up automatically)

    implementation:
      file: "services/phases/phase8-audio-v13.cjs"
      function: "masterAudio(audioBuffer)"
      returns: "{ buffer: Buffer, durationMs: number }"

  deprecated_buckets:
    - bucket: "popty-bach-lfs"
      note: "DO NOT USE - legacy bucket, deleted"

  ## ==========================================================================
  ## SCHEMA DEFINITION
  ## ==========================================================================

  schema:
    version: "13.2.0"
    database: "supabase"
    compiler_target: "postgresql"

    ## ------------------------------------------------------------------------
    ## COURSES TABLE - Course metadata with voice configuration
    ## ------------------------------------------------------------------------

    table courses:
      description: "All courses with their voice assignments"

      columns:
        code:
          type: "TEXT"
          primary_key: true
          description: "Course identifier (e.g., 'spa_for_eng', 'cym_north_for_eng')"

        display_name:
          type: "TEXT"
          nullable: false
          description: "Human-readable name"

        known_lang:
          type: "TEXT"
          nullable: false
          description: "ISO 639-3 code for known language (e.g., 'eng')"

        target_lang:
          type: "TEXT"
          nullable: false
          description: "ISO 639-3 code for target language (e.g., 'spa')"

        voice_config:
          type: "JSONB"
          nullable: false
          default: "{}"
          description: |
            Voice assignments per role. Structure:
            {
              "known": "azure_en-GB-SoniaNeural",
              "target1": "azure_es-ES-ElviraNeural",
              "target2": "azure_es-ES-AlvaroNeural",
              "presentation": "human_aran"
            }

        course_type:
          type: "TEXT"
          nullable: false
          default: "'official'"
          check: "course_type IN ('official', 'community')"

        status:
          type: "TEXT"
          nullable: false
          default: "'draft'"
          check: "status IN ('draft', 'beta', 'released')"

        seed_count:
          type: "INTEGER"
          nullable: true
          description: "Target number of seeds (10=test, 250=beta, 668=full)"

        creator_email:
          type: "TEXT"
          nullable: true
          description: "For community courses - attribution"

        created_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

        updated_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

    ## ------------------------------------------------------------------------
    ## COURSE_AUDIO TABLE - Audio owned by a specific course
    ## ------------------------------------------------------------------------

    table course_audio:
      description: "All audio files belonging to a course"

      columns:
        id:
          type: "UUID"
          primary_key: true
          default: "gen_random_uuid()"

        course_code:
          type: "TEXT"
          nullable: false
          references: "courses(code)"
          on_delete: "CASCADE"

        text:
          type: "TEXT"
          nullable: false
          description: "The spoken text (original case)"

        text_normalized:
          type: "TEXT"
          nullable: false
          description: "Lowercased, trimmed for matching (auto-populated by trigger)"

        language:
          type: "TEXT"
          nullable: false
          description: "ISO 639-3 language code"

        role:
          type: "TEXT"
          nullable: false
          check: "role IN ('known', 'target1', 'target2', 'presentation', 'encouragement', 'instruction')"
          description: |
            Audio role in the learning cycle:
            - known: Prompt in learner's known language
            - target1: First target language voice
            - target2: Second target language voice
            - presentation: LEGO introduction narration (course-specific)
            - encouragement: Motivational messages (from shared_audio)
            - instruction: Meta-learning content (from shared_audio)

        voice_id:
          type: "TEXT"
          nullable: false
          description: "Voice identifier (e.g., 'azure_es-ES-ElviraNeural', 'human_aran')"

        origin:
          type: "TEXT"
          nullable: false
          check: "origin IN ('tts', 'human')"
          description: |
            How the audio was created:
            - tts: Generated via TTS API (regenerable)
            - human: Recorded by human (precious, not regenerable)

        s3_key:
          type: "TEXT"
          nullable: false
          description: |
            S3 object key. New audio uses mastered/ prefix:
            - New (mastered): 'mastered/7372F60B-5312-4985-B0A0-A97F92323F83.mp3'
            - Legacy (flat): '7372F60B-5312-4985-B0A0-A97F92323F83.mp3'
            Use as-is to construct S3 URL - do not normalize or modify.

        duration_ms:
          type: "INTEGER"
          nullable: true
          description: |
            Audio duration in milliseconds.
            Automatically extracted during mastering for TTS audio.
            Used by learning app for timing and progress tracking.

        lego_id:
          type: "TEXT"
          nullable: true
          description: |
            For presentation audio: the LEGO this introduces.
            Stored directly to avoid regex parsing of presentation text.
            NULL for non-presentation roles (known, target1, target2, etc.)
            Example: 'S0001L01'

        file_size_bytes:
          type: "INTEGER"
          nullable: true

        created_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

      constraints:
        unique_course_audio:
          type: "UNIQUE"
          columns: ["course_code", "text_normalized", "language", "role"]
          description: "One audio per course+text+language+role combination"

      indexes:
        idx_course_audio_course:
          columns: ["course_code"]
        idx_course_audio_lookup:
          columns: ["course_code", "text_normalized", "language", "role"]
        idx_course_audio_lego:
          columns: ["course_code", "lego_id"]
          where: "lego_id IS NOT NULL"
          description: "Fast lookup of presentation audio by LEGO"

      triggers:
        normalize_text:
          timing: "BEFORE INSERT OR UPDATE"
          action: "SET text_normalized = LOWER(TRIM(text))"

    ## ------------------------------------------------------------------------
    ## SHARED_AUDIO TABLE - Audio shared across courses
    ## ------------------------------------------------------------------------

    table shared_audio:
      description: "Audio reused across courses (encouragements, instructions)"
      purpose: |
        Only for genuinely shared content:
        - Encouragements ("Da iawn!", "Excellent!")
        - Instructions ("Listen and repeat", "Now try saying...")

        NOT for course content (phrases, LEGOs) - those go in course_audio.

      columns:
        id:
          type: "UUID"
          primary_key: true
          default: "gen_random_uuid()"

        text:
          type: "TEXT"
          nullable: false

        text_normalized:
          type: "TEXT"
          nullable: false

        language:
          type: "TEXT"
          nullable: false
          description: "The known language this is spoken in"

        audio_type:
          type: "TEXT"
          nullable: false
          check: "audio_type IN ('encouragement', 'instruction')"

        voice_id:
          type: "TEXT"
          nullable: false

        origin:
          type: "TEXT"
          nullable: false
          check: "origin IN ('tts', 'human')"

        s3_key:
          type: "TEXT"
          nullable: false
          description: "S3 object key - just the UUID in UPPERCASE (e.g., 'A1B2C3D4-...mp3')"

        duration_ms:
          type: "INTEGER"
          nullable: true

        created_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

      constraints:
        unique_shared_audio:
          type: "UNIQUE"
          columns: ["text_normalized", "language", "audio_type"]

      indexes:
        idx_shared_audio_lookup:
          columns: ["text_normalized", "language", "audio_type"]

      triggers:
        normalize_text:
          timing: "BEFORE INSERT OR UPDATE"
          action: "SET text_normalized = LOWER(TRIM(text))"

    ## ------------------------------------------------------------------------
    ## LEGO_INTRODUCTIONS TABLE - Links LEGOs to their presentation audio
    ## ------------------------------------------------------------------------

    table lego_introductions:
      description: "Links LEGOs to their presentation audio for introduction sequences"

      purpose: |
        An INTRODUCTION is a modified LEGO cycle that teaches a new LEGO:

        ┌─────────────────────────────────────────────────────────────────┐
        │  NORMAL CYCLE              vs    INTRODUCTION CYCLE            │
        │  ─────────────                   ──────────────────            │
        │  1. prompt (known audio)         1. presentation audio         │
        │  2. pause (learner thinks)          "The Spanish for 'X' is:"  │
        │  3. target1                      2. target1                    │
        │  4. target2                      3. target2                    │
        └─────────────────────────────────────────────────────────────────┘

        The introduction is a "reveal" cycle - no prompt/pause because
        the learner doesn't know it yet. Presentation teaches, then
        target1/target2 demonstrate the pronunciation.

        This table only stores presentation_audio_id because target1/target2
        can be derived from course_audio using the LEGO's target_text.

      columns:
        id:
          type: "UUID"
          primary_key: true
          default: "gen_random_uuid()"

        course_code:
          type: "TEXT"
          nullable: false
          references: "courses(code)"
          on_delete: "CASCADE"

        lego_id:
          type: "TEXT"
          nullable: false
          description: "LEGO identifier (e.g., 'S0001L01')"

        presentation_audio_id:
          type: "UUID"
          nullable: true
          references: "course_audio(id)"
          description: |
            The introduction narration audio.
            Format: "The {language} for '{known}', as in '{seed}', is:"
            Example: "The Spanish for 'I want', as in 'I want to speak Spanish', is:"

        audio_uuid:
          type: "UUID"
          nullable: true
          description: "Legacy field - use presentation_audio_id instead"

        duration_ms:
          type: "INTEGER"
          nullable: true
          description: "Duration of presentation audio in milliseconds"

        version:
          type: "INTEGER"
          default: 1

        updated_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

      constraints:
        unique_lego_intro:
          type: "UNIQUE"
          columns: ["lego_id"]
          description: "One introduction record per LEGO"

      indexes:
        idx_lego_intro_course:
          columns: ["course_code"]
        idx_lego_intro_lego:
          columns: ["lego_id"]

      audio_lookup: |
        To play an introduction, the player needs 3 audio files:

        1. PRESENTATION AUDIO (from this table):
           SELECT presentation_audio_id
           FROM lego_introductions
           WHERE lego_id = 'S0001L01'

        2. TARGET1 & TARGET2 (derived from course_audio):
           -- First get the LEGO's target_text from course_legos or script
           -- Then lookup by exact text match:
           SELECT id, role, s3_key
           FROM course_audio
           WHERE course_code = 'spa_for_eng'
           AND text_normalized = 'quiero'  -- the LEGO's target_text
           AND role IN ('target1', 'target2')

        This avoids storing redundant target1_audio_id/target2_audio_id
        columns since the LEGO already knows its target_text.

  ## ==========================================================================
  ## ROLES EXPLAINED
  ## ==========================================================================

  roles:
    known:
      description: "Prompt audio in the learner's known language"
      language: "Same as course.known_lang"
      used_in: "PROMPT phase of learning cycle"
      example: "I want to learn" (for English speaker learning Spanish)

    target1:
      description: "First target language voice"
      language: "Same as course.target_lang"
      used_in: "VOICE_1 phase of learning cycle"
      example: "Quiero aprender" (female Spanish voice)

    target2:
      description: "Second target language voice"
      language: "Same as course.target_lang"
      used_in: "VOICE_2 phase of learning cycle"
      example: "Quiero aprender" (male Spanish voice)

    presentation:
      description: "LEGO introduction narration"
      language: "Same as course.known_lang"
      used_in: "When introducing a new LEGO"
      example: "In this lesson you'll learn to say 'I want'"
      notes: |
        For Welsh courses: Often human-recorded, precious
        For TTS courses: Can be generated

    encouragement:
      description: "Motivational messages"
      language: "Same as course.known_lang"
      used_in: "Randomly during learning sessions"
      example: "Your brain is the most complex object in the universe"
      notes: |
        Copied from shared_audio at course import time.
        Shared across all courses with same known language.

    instruction:
      description: "Meta-learning content"
      language: "Same as course.known_lang"
      used_in: "Played in sequence during course"
      example: "Your brain has 100 billion neurons..."
      notes: |
        Copied from shared_audio at course import time.
        Longer instructional content about learning strategies.

  ## ==========================================================================
  ## ORIGIN (TTS vs HUMAN)
  ## ==========================================================================

  origin:
    tts:
      description: "Generated via TTS API"
      regenerable: true
      examples:
        - "azure_en-GB-SoniaNeural"
        - "elevenlabs_rachel"
      workflow: "Can be regenerated if quality issues"

    human:
      description: "Recorded by a human speaker"
      regenerable: false
      precious: true
      examples:
        - "human_aran" (Aran from Welsh courses)
        - "human_catrin" (Catrin from Welsh courses)
      workflow: "Preserve at all costs, never overwrite"

  ## ==========================================================================
  ## SHARED AUDIO WORKFLOW
  ## ==========================================================================

  shared_audio_workflow:
    purpose: |
      shared_audio is a TEMPLATE table. Its records get COPIED to course_audio
      when a course is imported. This keeps the learning app simple - it only
      queries course_audio, never shared_audio.

    terminology_mapping:
      legacy_orderedEncouragements: "instruction"   # Played in sequence
      legacy_pooledEncouragements: "encouragement"  # Randomly selected

    how_it_works: |
      ┌─────────────────────────────────────────────────────────────────────┐
      │                    SHARED AUDIO WORKFLOW                            │
      │                                                                     │
      │  1. IMPORT SHARED AUDIO (once per known language)                   │
      │     └─► shared_audio table (template)                               │
      │         • 48 instructions (orderedEncouragements)                   │
      │         • 26 encouragements (pooledEncouragements)                  │
      │         • Each row has s3_key pointing to audio file                │
      │                                                                     │
      │  2. COPY TO COURSE (on course import)                               │
      │     └─► course_audio table (per-course)                             │
      │         • Same s3_key copied (not the file!)                        │
      │         • Course now "owns" its copy of the reference               │
      │                                                                     │
      │  3. LEARNING APP QUERIES                                            │
      │     └─► Only queries course_audio                                   │
      │         • Simple: one table, no joins                               │
      │         • All audio for a course in one place                       │
      │                                                                     │
      └─────────────────────────────────────────────────────────────────────┘

    s3_sharing: |
      Multiple course_audio rows can point to the SAME S3 file.
      The s3_key is duplicated in the database, but there's only one MP3 in S3.

      Example:
        shared_audio (eng, instruction)     →  s3_key: "7372F60B-5312-4985-B0A0-A97F92323F83.mp3"
        course_audio (cym_s_for_eng)        →  s3_key: "7372F60B-5312-4985-B0A0-A97F92323F83.mp3"  (copied)
        course_audio (spa_for_eng)          →  s3_key: "7372F60B-5312-4985-B0A0-A97F92323F83.mp3"  (copied)
        course_audio (ita_for_eng)          →  s3_key: "7372F60B-5312-4985-B0A0-A97F92323F83.mp3"  (copied)
                                                        ↓
                                               S3: ONE FILE (7372F60B-5312-4985-B0A0-A97F92323F83.mp3)

    import_scripts:
      import_shared_audio: |
        node database/import-shared-audio.cjs <manifest.json>
        - Reads orderedEncouragements → shared_audio (audio_type: instruction)
        - Reads pooledEncouragements → shared_audio (audio_type: encouragement)
        - One-time per known language (e.g., run once for 'eng')

      copy_shared_to_course: |
        node database/copy-shared-to-course.cjs <course_code>
        - Copies shared_audio rows to course_audio for a specific course
        - Maps audio_type → role (encouragement → encouragement, instruction → instruction)
        - Skips if already exists (idempotent)

    why_copy_not_join: |
      We copy references instead of joining at query time because:
      1. Learning app stays simple (one table)
      2. Course can override shared audio if needed (course-specific version)
      3. No runtime dependency on shared_audio table
      4. Easier to reason about what audio a course has

  ## ==========================================================================
  ## VIEWS (for convenience)
  ## ==========================================================================

  views:
    course_audio_inventory:
      description: "Summary of audio per course/role"
      sql: |
        SELECT course_code, role, origin,
               COUNT(*) as count,
               COUNT(DISTINCT voice_id) as voice_count
        FROM course_audio
        GROUP BY course_code, role, origin

    course_voice_breakdown:
      description: "Voice usage per course/role"
      sql: |
        SELECT course_code, role, voice_id, origin, COUNT(*) as count
        FROM course_audio
        GROUP BY course_code, role, voice_id, origin

  ## ==========================================================================
  ## HELPER FUNCTIONS
  ## ==========================================================================

  functions:
    get_missing_audio:
      description: "Find phrases that need audio generation"
      params:
        - "p_course_code TEXT"
        - "p_needed JSONB"  # Array of {text, language, role}
      returns: "TABLE (text, language, role)"
      logic: |
        Compare needed list against course_audio.
        Return items where no matching audio exists.

    get_course_audio_summary:
      description: "Get audio inventory for a course"
      params:
        - "p_course_code TEXT"
      returns: "TABLE (role, origin, count, voice_count)"

  ## ==========================================================================
  ## MIGRATION FROM v12
  ## ==========================================================================

  migration:
    from_v12:
      strategy: |
        v12 had: texts → audio_files → course_audio
        v13 has: course_audio (flat), shared_audio

        Migration:
        1. For each course_audio row in v12:
           - Join to get text content from texts table
           - Insert directly into v13 course_audio
        2. Identify genuinely shared audio (encouragements)
           - Insert into shared_audio
        3. Drop old tables: texts, audio_files, old course_audio

      notes: |
        The Welsh courses have human audio that must be preserved.
        Run import scripts before dropping old tables.

  ## ==========================================================================
  ## WHAT'S NOT IN THIS SPEC (YAGNI)
  ## ==========================================================================

  excluded:
    voices_table: "Course voice_config JSONB is sufficient"
    texts_table: "No need for separate text identity"
    audio_files_table: "No indirection layer needed"
    sample_flags: "QA workflow is separate concern"
    recording_provenance: "Nice-to-have, add later if needed"
    build_numbers: "Use updated_at timestamp"

## ============================================================================
## GENERATED: 2026-01-04
## APML v13.1.0 - Course-Owned Audio Architecture
## Supersedes: v12.0.0 (texts → audio_files → course_audio)
## Changes in v13.1:
##   - Added encouragement and instruction roles to course_audio
##   - Documented shared_audio workflow (template → copy to course)
##   - Mapped legacy terminology (orderedEncouragements, pooledEncouragements)
## ============================================================================
