# APML: Audio Registry Architecture
# Version: 13.6.0 (2026-02-15)
# Status: CANONICAL - This is the source of truth
# Type: CORE ARCHITECTURE SPECIFICATION
# Changelog: Added course_gender_expansions table and gender services documentation

architecture AudioRegistry:
  name: "Course-Owned Audio Architecture"
  purpose: "Simple, course-centric audio ownership with shared audio for reusables"
  version: "13.5.0"

  ## ==========================================================================
  ## BREAKING CHANGE FROM v12
  ## ==========================================================================

  breaking_change:
    summary: |
      v13 REMOVES the texts/audio_files indirection layer.
      Audio is now directly owned by courses (course_audio) or shared globally (shared_audio).

    problem_with_v12: |
      v12 separated text from audio with a join table:
        texts → audio_files → course_audio

      This was over-engineered:
      1. Most audio is course-specific, not shared
      2. The join complexity made queries slow and error-prone
      3. Deduplication across courses was rarely needed
      4. Human audio (Welsh courses) doesn't fit the TTS model

    solution: |
      Two simple tables:
      - course_audio: Course owns its audio directly
      - shared_audio: Only for genuinely shared content (encouragements)

      No joins. No indirection. Course-centric ownership.

  ## ==========================================================================
  ## CORE PRINCIPLE: Courses Own Their Audio
  ## ==========================================================================

  principle: |
    A course is the unit of ownership. Each course has its own audio.

    ┌─────────────────────────────────────────────────────────────────┐
    │                     SIMPLE OWNERSHIP                            │
    │                                                                 │
    │  courses ──────────── course_audio ──────────── S3             │
    │  (voice_config)       (text, role, s3_key)      (bytes)        │
    │                                                                 │
    │  shared_audio ─────────────────────────────────── S3           │
    │  (encouragements, instructions)                  (bytes)        │
    │                                                                 │
    └─────────────────────────────────────────────────────────────────┘

    - Course audio: Unique per course+text+language+role
    - Shared audio: Unique per text+language+audio_type (encouragements/instructions)
    - No joins needed for basic operations

  ## ==========================================================================
  ## S3 STORAGE
  ## ==========================================================================

  s3:
    bucket: "ssi-audio-stage"
    region: "eu-west-1"

    ## =========================================================================
    ## CRITICAL: s3_key IS THE TRUTH
    ## =========================================================================
    ##
    ## The course_audio.s3_key column contains the ACTUAL S3 object key.
    ## Use it AS-IS to construct URLs. Do NOT normalize or modify it.
    ##
    ## URL construction:
    ##   https://ssi-audio-stage.s3.eu-west-1.amazonaws.com/{s3_key}
    ##
    ## =========================================================================

    storage_model: |
      S3 is a dumb blob store. All metadata lives in Supabase.
      The s3_key column is the actual S3 object key - use it as-is.

    key_formats:
      mastered:
        pattern: "mastered/{UUID}.mp3"
        location: "mastered/ folder"
        example: "mastered/7372F60B-5312-4985-B0A0-A97F92323F83.mp3"
        used_by: "ALL new audio generated by phase8-audio-v13 (January 2026+)"

      legacy_flat:
        pattern: "{UUID}.mp3"
        location: "bucket root"
        example: "7372F60B-5312-4985-B0A0-A97F92323F83.mp3"
        used_by: "Early v13 Spanish presentation audio (to be migrated)"
        note: "These files exist but were not mastered - will be regenerated"

    important: |
      BOTH formats exist in S3. The s3_key column tells you exactly where
      the file is. Do NOT try to normalize or strip paths.

      For Dashboard Agent:
        - ALL new audio: use mastered/{UUID}.mp3 format
        - Audio is normalized (-16 LUFS) before upload
        - The s3_key you store must match the actual S3 object key

      For Learning App:
        - Read s3_key from database
        - Construct URL: https://ssi-audio-stage.s3.eu-west-1.amazonaws.com/{s3_key}
        - Works for both formats automatically

    uuid_format: "UPPERCASE"
    rationale_uppercase: |
      UUIDs are stored in UPPERCASE for consistency:
      - All letters same height in URLs (neater)
      - Matches existing S3 records convention
      - Generated via uuidv4().toUpperCase()

    examples:
      mastered_format:
        s3_key: "mastered/7372F60B-5312-4985-B0A0-A97F92323F83.mp3"
        full_url: "https://ssi-audio-stage.s3.eu-west-1.amazonaws.com/mastered/7372F60B-5312-4985-B0A0-A97F92323F83.mp3"

      legacy_flat:
        s3_key: "7A30E5E0-3167-5FA2-946B-BA37B022D8FD.mp3"
        full_url: "https://ssi-audio-stage.s3.eu-west-1.amazonaws.com/7A30E5E0-3167-5FA2-946B-BA37B022D8FD.mp3"

  ## ==========================================================================
  ## AUDIO MASTERING PIPELINE
  ## ==========================================================================

  mastering:
    purpose: |
      All TTS-generated audio is mastered before upload to ensure consistent
      playback quality across all courses and devices.

    pipeline: |
      1. TTS Generation (Azure/ElevenLabs)
         ↓ raw audio buffer
      2. Normalization (ffmpeg loudnorm)
         - Target: -16 LUFS (broadcast standard)
         - LRA: 11 (loudness range)
         - True peak: -1.5 dBFS
         ↓ normalized audio
      3. Duration Extraction (ffprobe)
         - Extract duration in milliseconds
         - Store in course_audio.duration_ms
         ↓ mastered audio + duration
      4. S3 Upload
         - Key: mastered/{UUID}.mp3
         - ContentType: audio/mpeg

    requirements:
      - ffmpeg: Required for normalization
      - ffprobe: Required for duration extraction
      - Temp directory for processing (cleaned up automatically)

    implementation:
      file: "services/phases/phase8-audio-v13.cjs"
      function: "masterAudio(audioBuffer)"
      returns: "{ buffer: Buffer, durationMs: number }"

  deprecated_buckets:
    - bucket: "popty-bach-lfs"
      note: "DO NOT USE - legacy bucket, deleted"

  ## ==========================================================================
  ## SCHEMA DEFINITION
  ## ==========================================================================

  schema:
    version: "13.5.0"
    database: "supabase"
    compiler_target: "postgresql"

    ## ------------------------------------------------------------------------
    ## COURSES TABLE - Course metadata with voice configuration
    ## ------------------------------------------------------------------------

    table courses:
      description: "All courses with their voice assignments"

      columns:
        code:
          type: "TEXT"
          primary_key: true
          description: "Course identifier (e.g., 'spa_for_eng', 'cym_north_for_eng')"

        display_name:
          type: "TEXT"
          nullable: false
          description: "Human-readable name"

        known_lang:
          type: "TEXT"
          nullable: false
          description: "ISO 639-3 code for known language (e.g., 'eng')"

        target_lang:
          type: "TEXT"
          nullable: false
          description: "ISO 639-3 code for target language (e.g., 'spa')"

        voice_config:
          type: "JSONB"
          nullable: false
          default: "{}"
          description: |
            Voice assignments per role. Structure:
            {
              "known": "azure_en-GB-SoniaNeural",
              "target1": "azure_es-ES-ElviraNeural",
              "target2": "azure_es-ES-AlvaroNeural",
              "presentation": "human_aran"
            }

        course_type:
          type: "TEXT"
          nullable: false
          default: "'official'"
          check: "course_type IN ('official', 'community')"

        status:
          type: "TEXT"
          nullable: false
          default: "'draft'"
          check: "status IN ('draft', 'beta', 'released')"

        seed_count:
          type: "INTEGER"
          nullable: true
          description: "Target number of seeds (10=test, 250=beta, 668=full)"

        creator_email:
          type: "TEXT"
          nullable: true
          description: "For community courses - attribution"

        created_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

        updated_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

        translation_analysis:
          type: "JSONB"
          nullable: true
          description: |
            Two-pass workflow analysis data discovered during Pass 1 (translation).
            Structure:
            {
              "generated_at": "ISO timestamp",
              "seeds_analyzed": 260,
              "register": {"choice": "casual-polite", "markers": ["です", "ます"]},
              "problem_verbs": [
                {"english": "remember", "target_forms": [...], "disambiguation_rule": "..."}
              ],
              "golden_keys": [
                {"pattern": "want to V", "target_form": "V-stem + たい", "frequency": 58}
              ],
              "zut_concerns": [
                {"seed": 45, "original_english": "...", "suggested_reword": "..."}
              ]
            }
            Survives context compaction via /api/resume response.

        quality_rules:
          type: "JSONB"
          nullable: true
          description: |
            Language-pair specific methodology guidance discovered after Pass 1.
            Populated by /course-methodology-analysis skill.
            Structure:
            {
              "course_code": "ara_for_eng",
              "known_language": "eng",
              "target_language": "ara",
              "analysis_date": "2026-01-29",
              "known_language_guidance": {
                "quality_bar": "Natural, idiomatic - learner knows this language",
                "avoid_patterns": [{"pattern": "...", "use_instead": "...", "reason": "..."}],
                "trust_test": "Would a native speaker say this naturally?"
              },
              "target_language_guidance": {
                "quality_bar": "Correct, can have learning structure",
                "structural_notes": ["..."],
                "common_patterns": [{"english_pattern": "...", "target_form": "...", "frequency_rank": 1}]
              },
              "zut_direction": "eng → ara",
              "zut_note": "Same known must always produce same target",
              "early_seed_guidance": {
                "applies_to_seeds": [1, 20],
                "phrase_tips": ["..."]
              },
              "methodology_insights": ["BUILD phrases must be speakable in isolation", "..."],
              "opus_polish_guidance": ["Priority: fix unnatural known language", "..."]
            }
            Survives context compaction via /api/resume response.

    ## ------------------------------------------------------------------------
    ## COURSE_AUDIO TABLE - Audio owned by a specific course
    ## ------------------------------------------------------------------------

    table course_audio:
      description: "All audio files belonging to a course"

      columns:
        id:
          type: "UUID"
          primary_key: true
          default: "gen_random_uuid()"

        course_code:
          type: "TEXT"
          nullable: false
          references: "courses(code)"
          on_delete: "CASCADE"

        text:
          type: "TEXT"
          nullable: false
          description: "The spoken text (original case)"

        text_normalized:
          type: "TEXT"
          nullable: false
          description: "Lowercased, trimmed for matching (auto-populated by trigger)"

        language:
          type: "TEXT"
          nullable: false
          description: "ISO 639-3 language code"

        role:
          type: "TEXT"
          nullable: false
          check: "role IN ('known', 'target1', 'target2', 'presentation', 'encouragement', 'instruction')"
          description: |
            Audio role in the learning cycle:
            - known: Prompt in learner's known language
            - target1: First target language voice
            - target2: Second target language voice
            - presentation: LEGO introduction narration (course-specific)
            - encouragement: Motivational messages (from shared_audio)
            - instruction: Meta-learning content (from shared_audio)

        voice_id:
          type: "TEXT"
          nullable: false
          description: "Voice identifier (e.g., 'azure_es-ES-ElviraNeural', 'human_aran')"

        origin:
          type: "TEXT"
          nullable: false
          check: "origin IN ('tts', 'human')"
          description: |
            How the audio was created:
            - tts: Generated via TTS API (regenerable)
            - human: Recorded by human (precious, not regenerable)

        s3_key:
          type: "TEXT"
          nullable: false
          description: |
            S3 object key. New audio uses mastered/ prefix:
            - New (mastered): 'mastered/7372F60B-5312-4985-B0A0-A97F92323F83.mp3'
            - Legacy (flat): '7372F60B-5312-4985-B0A0-A97F92323F83.mp3'
            Use as-is to construct S3 URL - do not normalize or modify.

        duration_ms:
          type: "INTEGER"
          nullable: true
          description: |
            Audio duration in milliseconds.
            Automatically extracted during mastering for TTS audio.
            Used by learning app for timing and progress tracking.

        lego_id:
          type: "TEXT"
          nullable: true
          description: |
            For presentation audio: the LEGO this introduces.
            Stored directly to avoid regex parsing of presentation text.
            NULL for non-presentation roles (known, target1, target2, etc.)
            Example: 'S0001L01'

        file_size_bytes:
          type: "INTEGER"
          nullable: true

        created_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

      constraints:
        unique_course_audio:
          type: "UNIQUE"
          columns: ["course_code", "text_normalized", "language", "role"]
          description: "One audio per course+text+language+role combination"

      indexes:
        idx_course_audio_course:
          columns: ["course_code"]
        idx_course_audio_lookup:
          columns: ["course_code", "text_normalized", "language", "role"]
        idx_course_audio_lego:
          columns: ["course_code", "lego_id"]
          where: "lego_id IS NOT NULL"
          description: "Fast lookup of presentation audio by LEGO"

      triggers:
        normalize_text:
          timing: "BEFORE INSERT OR UPDATE"
          action: "SET text_normalized = LOWER(TRIM(text))"

    ## ------------------------------------------------------------------------
    ## SHARED_AUDIO TABLE - Audio shared across courses
    ## ------------------------------------------------------------------------

    table shared_audio:
      description: "Audio reused across courses (encouragements, instructions, paywall)"
      purpose: |
        Only for genuinely shared content:
        - Encouragements ("Da iawn!", "Excellent!")
        - Instructions ("Listen and repeat", "Now try saying...")
        - Paywall messages (subscription prompts, trial limits)

        NOT for course content (phrases, LEGOs) - those go in course_audio.

      columns:
        id:
          type: "UUID"
          primary_key: true
          default: "gen_random_uuid()"

        text:
          type: "TEXT"
          nullable: false

        text_normalized:
          type: "TEXT"
          nullable: false

        language:
          type: "TEXT"
          nullable: false
          description: "The known language this is spoken in"

        audio_type:
          type: "TEXT"
          nullable: false
          check: "audio_type IN ('encouragement', 'instruction', 'paywall')"

        voice_id:
          type: "TEXT"
          nullable: false

        origin:
          type: "TEXT"
          nullable: false
          check: "origin IN ('tts', 'human')"

        s3_key:
          type: "TEXT"
          nullable: false
          description: "S3 object key - just the UUID in UPPERCASE (e.g., 'A1B2C3D4-...mp3')"

        duration_ms:
          type: "INTEGER"
          nullable: true

        created_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

      constraints:
        unique_shared_audio:
          type: "UNIQUE"
          columns: ["text_normalized", "language", "audio_type"]

      indexes:
        idx_shared_audio_lookup:
          columns: ["text_normalized", "language", "audio_type"]

      triggers:
        normalize_text:
          timing: "BEFORE INSERT OR UPDATE"
          action: "SET text_normalized = LOWER(TRIM(text))"

    ## ------------------------------------------------------------------------
    ## COURSE_GENDER_EXPANSIONS TABLE - Gender-appropriate TTS variants
    ## ------------------------------------------------------------------------

    table course_gender_expansions:
      description: "Pre-computed gender-appropriate text variants for TTS generation"

      purpose: |
        Romance languages and Arabic require gender agreement with the speaker.
        Example: Spanish "Estoy cansado" (male) → "Estoy cansada" (female)

        This table stores Haiku-analyzed variants for target1 (female) and
        target2 (male) voices, enabling TTS to generate grammatically correct audio.

        Replaces regex-based gender-analyzer which failed for French avoir verbs
        and irregular forms.

      gendered_languages:
        - spa: "Spanish"
        - ita: "Italian"
        - por: "Portuguese"
        - fra: "French"
        - ara: "Arabic"

      workflow: |
        1. Run gender-prep-coordinator before TTS generation:
           node services/gender-prep-coordinator.cjs <course_code>

        2. Coordinator spawns Claude Haiku batches to analyze all unique texts
        3. Stores only texts that need gender variants (not all texts)
        4. TTS generation queries this table before generating audio
        5. If no variant found, uses original text (no gender change needed)

      coordinator_features:
        spawning: "Uses osascript/iTerm2 pattern (same as agent-spawner.cjs)"
        concurrency: "Default 5 concurrent Haiku batches"
        batch_size: "Default 200 texts per batch"
        performance: "2-7 seconds per batch via stdin pipe (not command-line args)"
        filtering: "Removes punctuation, single chars, metadata artifacts"
        idempotency: "Clears existing rows before reprocessing"

      columns:
        id:
          type: "UUID"
          primary_key: true
          default: "gen_random_uuid()"

        course_code:
          type: "TEXT"
          nullable: false
          references: "courses(code)"
          on_delete: "CASCADE"

        original_text:
          type: "TEXT"
          nullable: false
          description: "The original text (usually masculine default)"

        language:
          type: "TEXT"
          nullable: false
          description: "ISO 639-3 language code"

        expanded_f:
          type: "TEXT"
          nullable: true
          description: |
            Feminine variant for target1 voice (female speaker).
            NULL if no gender change needed.
            Example: "Estoy cansada" (Spanish), "Je suis fatiguée" (French)

        expanded_m:
          type: "TEXT"
          nullable: true
          description: |
            Masculine variant for target2 voice (male speaker).
            Usually same as original, but stored for symmetry.
            NULL if no gender change needed.

        created_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

      constraints:
        unique_course_text:
          type: "UNIQUE"
          columns: ["course_code", "original_text"]
          description: "One expansion per course+text (enables idempotent upserts)"

      indexes:
        idx_gender_expansions_course_lookup:
          columns: ["course_code", "language"]
          description: "Fast lookup by course for TTS generation"

      usage_pattern: |
        TTS generation (phase8-audio-v13):

        1. Query for text variant:
           SELECT expanded_f, expanded_m
           FROM course_gender_expansions
           WHERE course_code = $1 AND original_text = $2

        2. If row exists:
           - Use expanded_f for target1 (female voice)
           - Use expanded_m for target2 (male voice)

        3. If no row exists:
           - Use original text (no gender change needed)

      example_variants:
        spanish:
          original: "Estoy cansado"
          expanded_f: "Estoy cansada"
          expanded_m: "Estoy cansado"

        french:
          original: "Je suis fatigué"
          expanded_f: "Je suis fatiguée"
          expanded_m: "Je suis fatigué"

        arabic:
          original: "أنا سعيد"
          expanded_f: "أنا سعيدة"
          expanded_m: "أنا سعيد"

      cost: |
        ~$0.03 per 300-seed course (Claude Haiku batch analysis)
        Latency: 5-10 minutes pre-processing before TTS generation

      migration: |
        Added: 2026-02-15
        Migration: database/migrations/20260215_add_gender_expansions_constraint.sql

    ## ------------------------------------------------------------------------
    ## LEGO_INTRODUCTIONS TABLE - Links LEGOs to their presentation audio
    ## ------------------------------------------------------------------------

    table lego_introductions:
      description: "Links LEGOs to their presentation audio for introduction sequences"

      purpose: |
        An INTRODUCTION is a modified LEGO cycle that teaches a new LEGO:

        ┌─────────────────────────────────────────────────────────────────┐
        │  NORMAL CYCLE              vs    INTRODUCTION CYCLE            │
        │  ─────────────                   ──────────────────            │
        │  1. prompt (known audio)         1. presentation audio         │
        │  2. pause (learner thinks)          "The Spanish for 'X' is:"  │
        │  3. target1                      2. target1                    │
        │  4. target2                      3. target2                    │
        └─────────────────────────────────────────────────────────────────┘

        The introduction is a "reveal" cycle - no prompt/pause because
        the learner doesn't know it yet. Presentation teaches, then
        target1/target2 demonstrate the pronunciation.

        This table only stores presentation_audio_id because target1/target2
        can be derived from course_audio using the LEGO's target_text.

      columns:
        id:
          type: "UUID"
          primary_key: true
          default: "gen_random_uuid()"

        course_code:
          type: "TEXT"
          nullable: false
          references: "courses(code)"
          on_delete: "CASCADE"

        lego_id:
          type: "TEXT"
          nullable: false
          description: "LEGO identifier (e.g., 'S0001L01')"

        presentation_audio_id:
          type: "UUID"
          nullable: true
          references: "course_audio(id)"
          description: |
            The introduction narration audio.
            Format: "The {language} for '{known}', as in '{seed}', is:"
            Example: "The Spanish for 'I want', as in 'I want to speak Spanish', is:"

        audio_uuid:
          type: "UUID"
          nullable: true
          description: "Legacy field - use presentation_audio_id instead"

        duration_ms:
          type: "INTEGER"
          nullable: true
          description: "Duration of presentation audio in milliseconds"

        version:
          type: "INTEGER"
          default: 1

        updated_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

      constraints:
        unique_lego_intro:
          type: "UNIQUE"
          columns: ["lego_id"]
          description: "One introduction record per LEGO"

      indexes:
        idx_lego_intro_course:
          columns: ["course_code"]
        idx_lego_intro_lego:
          columns: ["lego_id"]

      audio_lookup: |
        To play an introduction, the player needs 3 audio files:

        1. PRESENTATION AUDIO (from this table):
           SELECT presentation_audio_id
           FROM lego_introductions
           WHERE lego_id = 'S0001L01'

        2. TARGET1 & TARGET2 (derived from course_audio):
           -- First get the LEGO's target_text from course_legos or script
           -- Then lookup by exact text match:
           SELECT id, role, s3_key
           FROM course_audio
           WHERE course_code = 'spa_for_eng'
           AND text_normalized = 'quiero'  -- the LEGO's target_text
           AND role IN ('target1', 'target2')

        This avoids storing redundant target1_audio_id/target2_audio_id
        columns since the LEGO already knows its target_text.

    ## ------------------------------------------------------------------------
    ## BUILD_JOBS TABLE - Multi-pass Course Builder coordination
    ## ------------------------------------------------------------------------

    table build_jobs:
      description: "Coordinates course builds between Dashboard and Course-Builder"
      purpose: |
        Database is the contract between Dashboard (Vercel) and Course-Builder (local).
        No direct API calls between them - all coordination via this table.

        Two-pass workflow:
        - Pass 1: Translate 668 canonical seeds + generate analysis doc
        - Pass 2: Decompose seeds -> LEGOs -> phrases (course_size configurable)

      columns:
        id:
          type: "UUID"
          primary_key: true
          default: "gen_random_uuid()"

        course_code:
          type: "TEXT"
          nullable: false
          references: "courses(course_code)"
          description: "Course being built"

        pass:
          type: "TEXT"
          nullable: false
          check: "pass IN ('pass_1', 'pass_2')"
          description: |
            Job type:
            - pass_1: Translate 668 seeds + analysis
            - pass_2: Decompose to LEGOs/phrases

        status:
          type: "TEXT"
          nullable: false
          default: "'pending'"
          check: "status IN ('pending', 'running', 'stalled', 'stopped', 'complete', 'failed')"
          description: "pending -> running -> complete/stopped/stalled/failed"

        current_seed:
          type: "INTEGER"
          nullable: true
          description: "Where agent is now"

        seeds_completed:
          type: "INTEGER"
          default: 0
          description: "How many seeds done"

        total_seeds:
          type: "INTEGER"
          nullable: false
          description: "668 for pass_1, course_size for pass_2"

        analysis_complete:
          type: "BOOLEAN"
          default: false
          description: "Pass 1 only: set true when language analysis doc generated"

        created_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

        started_at:
          type: "TIMESTAMPTZ"
          nullable: true
          description: "When agent claimed job"

        last_heartbeat:
          type: "TIMESTAMPTZ"
          nullable: true
          description: "Last sign of life from agent"

        last_progress_at:
          type: "TIMESTAMPTZ"
          nullable: true
          description: |
            When last seed was successfully submitted. Used for stuck detection:
            - last_heartbeat fresh + last_progress_at stale = agent stuck waiting for input
            - Triggers auto-respawn after 5 minutes without progress

        completed_at:
          type: "TIMESTAMPTZ"
          nullable: true
          description: "When finished"

        requested_by:
          type: "TEXT"
          nullable: true
          description: "'dashboard', 'cli', or email"

        stop_requested:
          type: "BOOLEAN"
          default: false
          description: "Dashboard sets true to signal agent to stop gracefully"

        error_message:
          type: "TEXT"
          nullable: true
          description: "Error details if failed"

        machine_name:
          type: "TEXT"
          nullable: true
          description: |
            Hostname of machine currently running this job.
            Updated on job creation, resume, and each heartbeat/progress update,
            so it always reflects the CURRENT machine running the job.

        build_mode:
          type: "TEXT"
          nullable: true
          default: "'parallel'"
          description: |
            Build strategy:
            - parallel: Coordinator + sub-agents via course_seed_drafts staging table
            Parallel builds submit drafts independently; finalize endpoint
            processes them in order (dedup, collision detection).

        resume_from_seed:
          type: "INTEGER"
          nullable: true
          description: "When resuming a stopped/stalled job, start from this seed"

      constraints:
        pass_1_always_668:
          type: "CHECK"
          expression: "pass != 'pass_1' OR total_seeds = 668"
          description: "Pass 1 must always process all 668 canonical seeds"

      indexes:
        idx_build_jobs_one_active:
          type: "UNIQUE"
          columns: ["course_code", "pass"]
          where: "status IN ('pending', 'running')"
          description: "Only one active job per course per pass"

        idx_build_jobs_status:
          columns: ["status"]

        idx_build_jobs_course_pass:
          columns: ["course_code", "pass"]

        idx_build_jobs_stall_check:
          columns: ["last_heartbeat"]
          where: "status = 'running'"
          description: "For detecting stalled agents"

      triggers:
        enforce_pass_order:
          timing: "BEFORE INSERT"
          description: "Prevents pass_2 from starting if pass_1 isn't complete"
          function: "check_pass_1_complete()"
          logic: |
            IF NEW.pass = 'pass_2' AND NEW.status = 'pending' THEN
              IF NOT EXISTS (
                SELECT 1 FROM build_jobs
                WHERE course_code = NEW.course_code
                  AND pass = 'pass_1'
                  AND status = 'complete'
              ) THEN
                RAISE EXCEPTION 'Cannot start pass_2: pass_1 not complete for course %', NEW.course_code;
              END IF;
            END IF;

      rls_policies:
        authenticated_read:
          operation: "SELECT"
          role: "authenticated"
          using: "true"
          description: "Dashboard (authenticated users) can read all jobs"

        authenticated_insert:
          operation: "INSERT"
          role: "authenticated"
          with_check: "true"
          description: "Dashboard can create new jobs"

        authenticated_update:
          operation: "UPDATE"
          role: "authenticated"
          using: "true"
          with_check: "true"
          description: "Dashboard can update jobs (stop_requested, etc.)"

        service_role_full:
          operation: "ALL"
          role: "service_role"
          using: "true"
          with_check: "true"
          description: "Course-Builder (service role) has full access"

    ## ------------------------------------------------------------------------
    ## COURSE_SEED_DRAFTS TABLE - Parallel build staging
    ## ------------------------------------------------------------------------

    table course_seed_drafts:
      description: "Staging table for parallel seed decomposition"
      purpose: |
        Parallel build workflow: multiple agents submit drafts independently.
        The finalize endpoint processes them in order (dedup, collision detection)
        before promoting to the live course_seeds/course_legos/course_practice_phrases tables.

        One draft per seed per course (upsert replaces on resubmission).

      columns:
        id:
          type: "UUID"
          primary_key: true
          default: "gen_random_uuid()"

        course_code:
          type: "TEXT"
          nullable: false
          references: "courses(course_code)"

        seed_number:
          type: "INTEGER"
          nullable: false

        known_text:
          type: "TEXT"
          nullable: false

        target_text:
          type: "TEXT"
          nullable: false

        submission_data:
          type: "JSONB"
          nullable: false
          description: "Full parsed legos array (with build/use phrases)"

        validation_status:
          type: "TEXT"
          default: "'valid'"
          check: "validation_status IN ('valid', 'collision', 'rework')"
          description: |
            Draft validation state:
            - valid: Ready for finalization
            - collision: LEGO conflict detected with another draft
            - rework: Agent needs to resubmit with fixes

        validation_notes:
          type: "JSONB"
          nullable: true
          description: "Details about collisions or rework reasons"

        created_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

        updated_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

      constraints:
        unique_draft_per_seed:
          type: "UNIQUE"
          columns: ["course_code", "seed_number"]
          description: "One draft per seed, upsert replaces"

      indexes:
        idx_course_seed_drafts_course:
          columns: ["course_code"]
        idx_course_seed_drafts_status:
          columns: ["course_code", "validation_status"]

      rls_policies:
        service_role_full:
          operation: "ALL"
          role: "service_role"
          using: "true"
          with_check: "true"
          description: "API server (service role) has full access"

        authenticated_read:
          operation: "SELECT"
          role: "authenticated"
          using: "true"
          description: "Dashboard can read drafts for monitoring"

    ## ------------------------------------------------------------------------
    ## COURSE_QA_FLAGS TABLE - QA monitoring infrastructure
    ## ------------------------------------------------------------------------

    table course_qa_flags:
      description: "QA issues flagged by monitor agent for human review"
      purpose: |
        Async phrase quality monitoring. Monitor agent flags issues here;
        human reviews at checkpoints.

        Also adds qa_checked TIMESTAMPTZ column to course_practice_phrases
        to track when each phrase was last checked by the monitor.

      columns:
        id:
          type: "UUID"
          primary_key: true
          default: "gen_random_uuid()"

        course_code:
          type: "TEXT"
          nullable: false
          references: "courses(course_code)"

        phrase_id:
          type: "UUID"
          nullable: true
          references: "course_practice_phrases(id)"
          description: "NULL for cross-seed issues like frequency/variety"

        seed_number:
          type: "INTEGER"
          nullable: true

        lego_id:
          type: "TEXT"
          nullable: true

        check_type:
          type: "TEXT"
          nullable: false
          check: "check_type IN ('grammar', 'semantic', 'naturalness', 'lego_frequency', 'lego_spread', 'variety', 'vocabulary')"
          description: |
            Type of check that found the issue:
            - grammar: Grammar errors (either language)
            - semantic: Translation meaning issues
            - naturalness: Unnatural phrasing
            - lego_frequency: LEGO phrase count issues (per-LEGO)
            - lego_spread: LEGO usage distribution across course
            - variety: Pattern repetition issues
            - vocabulary: Uses words not yet introduced

        severity:
          type: "TEXT"
          nullable: false
          default: "'warning'"
          check: "severity IN ('error', 'warning', 'info')"
          description: "error = must fix, warning = should review, info = pattern noticed"

        issue:
          type: "TEXT"
          nullable: false
          description: "Brief description of the problem"

        details:
          type: "JSONB"
          default: "'{}'"
          description: "Additional context (examples, counts, patterns)"

        status:
          type: "TEXT"
          nullable: false
          default: "'open'"
          check: "status IN ('open', 'resolved', 'ignored', 'false_positive')"

        resolved_at:
          type: "TIMESTAMPTZ"
          nullable: true

        resolved_by:
          type: "TEXT"
          nullable: true

        resolution_notes:
          type: "TEXT"
          nullable: true

        flagged_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

      constraints:
        unique_phrase_flag:
          type: "UNIQUE"
          columns: ["phrase_id", "check_type"]
          deferrable: "DEFERRABLE INITIALLY DEFERRED"
          description: "Prevent duplicate flags per phrase/check_type combo"

      indexes:
        idx_qa_flags_course:
          columns: ["course_code"]
        idx_qa_flags_status:
          columns: ["status"]
        idx_qa_flags_severity:
          columns: ["severity"]
        idx_qa_flags_type:
          columns: ["check_type"]
        idx_qa_flags_seed:
          columns: ["seed_number"]
        idx_qa_flags_open:
          columns: ["course_code", "severity"]
          where: "status = 'open'"

      rls_policies:
        authenticated_read:
          operation: "SELECT"
          role: "authenticated"
          using: "true"
          description: "Dashboard can read all flags"

        authenticated_insert:
          operation: "INSERT"
          role: "authenticated"
          with_check: "true"
          description: "Dashboard can insert flags (manual flagging)"

        authenticated_update:
          operation: "UPDATE"
          role: "authenticated"
          using: "true"
          with_check: "true"
          description: "Dashboard can update flags (resolve, ignore, etc.)"

        service_role_full:
          operation: "ALL"
          role: "service_role"
          using: "true"
          with_check: "true"
          description: "Monitor agent (service role) has full access"

      helper_functions:
        get_qa_summary:
          params: ["p_course_code TEXT"]
          returns: "TABLE (total_flags, error_count, warning_count, info_count, open_count, resolved_count)"
          description: "Get QA summary counts for a course"

        get_qa_flags_by_type:
          params: ["p_course_code TEXT"]
          returns: "TABLE (check_type, flag_count, open_count)"
          description: "Get flag counts grouped by check type for a course"

    ## ------------------------------------------------------------------------
    ## COURSE_EXPORT_STATES TABLE - 4-step export workflow state
    ## ------------------------------------------------------------------------

    table course_export_states:
      description: "Tracks export workflow state for each course"
      purpose: |
        4-step export workflow:
        1. Generate manifest (from database)
        2. Verify S3 audio files exist
        3. Publish manifest to course-configs
        4. Deploy audio to production S3

        Manifest is NOT stored in database (too much space over time).
        Only stats/hash stored - regenerate on demand.

      columns:
        id:
          type: "UUID"
          primary_key: true
          default: "gen_random_uuid()"

        course_code:
          type: "TEXT"
          nullable: false
          unique: true
          references: "courses(course_code)"
          on_delete: "CASCADE"
          description: "Course this state belongs to"

        # Step completion flags
        manifest_generated:
          type: "BOOLEAN"
          default: false
          description: "Step 1 complete"

        s3_verified:
          type: "BOOLEAN"
          default: false
          description: "Step 2 complete"

        manifest_published:
          type: "BOOLEAN"
          default: false
          description: "Step 3 complete"

        audio_deployed:
          type: "BOOLEAN"
          default: false
          description: "Step 4 complete"

        # Timestamps for each step
        manifest_generated_at:
          type: "TIMESTAMPTZ"
          nullable: true

        s3_verified_at:
          type: "TIMESTAMPTZ"
          nullable: true

        manifest_published_at:
          type: "TIMESTAMPTZ"
          nullable: true

        audio_deployed_at:
          type: "TIMESTAMPTZ"
          nullable: true

        # Manifest metadata (NOT stored - regenerated on demand)
        manifest_version:
          type: "TEXT"
          nullable: true

        manifest_hash:
          type: "TEXT"
          nullable: true
          description: "SHA256 hash (first 16 chars) for change detection"

        manifest_status:
          type: "TEXT"
          nullable: true
          check: "manifest_status IN ('alpha', 'beta', 'release')"

        manifest_seed_count:
          type: "INTEGER"
          nullable: true
          description: "Number of seeds in manifest at generation time"

        manifest_lego_count:
          type: "INTEGER"
          nullable: true
          description: "Number of unique LEGOs in manifest at generation time"

        manifest_audio_count:
          type: "INTEGER"
          nullable: true
          description: "Number of unique audio UUIDs in manifest at generation time"

        # Pending manifest location (stored locally on generating machine)
        pending_manifest_path:
          type: "TEXT"
          nullable: true
          description: "Relative path in course-configs repo: temp/pending/{id}.json"

        generated_on_machine:
          type: "TEXT"
          nullable: true
          description: "Human-readable machine name where manifest was generated"

        # S3 verification results
        s3_verification:
          type: "JSONB"
          nullable: true
          description: |
            JSON structure:
            {
              "total": 1234,
              "existing": 1230,
              "missing": 4,
              "missingUuids": ["uuid1", "uuid2", ...],
              "durationFixes": 10
            }

        # Publish results
        publish_course_configs_path:
          type: "TEXT"
          nullable: true

        publish_apidev_filename:
          type: "TEXT"
          nullable: true

        # Deploy results
        deploy_plan:
          type: "JSONB"
          nullable: true
          description: |
            JSON structure:
            {
              "total": 1234,
              "newFiles": 100,
              "overwrites": 5,
              "overwriteUuids": ["uuid1", ...]
            }

        deploy_executed_at:
          type: "TIMESTAMPTZ"
          nullable: true

        created_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

        updated_at:
          type: "TIMESTAMPTZ"
          default: "NOW()"

      indexes:
        idx_export_states_course:
          columns: ["course_code"]

      triggers:
        update_timestamp:
          timing: "BEFORE UPDATE"
          action: "SET updated_at = NOW()"

  ## ==========================================================================
  ## ROLES EXPLAINED
  ## ==========================================================================

  roles:
    known:
      description: "Prompt audio in the learner's known language"
      language: "Same as course.known_lang"
      used_in: "PROMPT phase of learning cycle"
      example: "I want to learn" (for English speaker learning Spanish)

    target1:
      description: "First target language voice"
      language: "Same as course.target_lang"
      used_in: "VOICE_1 phase of learning cycle"
      example: "Quiero aprender" (female Spanish voice)

    target2:
      description: "Second target language voice"
      language: "Same as course.target_lang"
      used_in: "VOICE_2 phase of learning cycle"
      example: "Quiero aprender" (male Spanish voice)

    presentation:
      description: "LEGO introduction narration"
      language: "Same as course.known_lang"
      used_in: "When introducing a new LEGO"
      example: "In this lesson you'll learn to say 'I want'"
      notes: |
        For Welsh courses: Often human-recorded, precious
        For TTS courses: Can be generated

    encouragement:
      description: "Motivational messages"
      language: "Same as course.known_lang"
      used_in: "Randomly during learning sessions"
      example: "Your brain is the most complex object in the universe"
      notes: |
        Copied from shared_audio at course import time.
        Shared across all courses with same known language.

    instruction:
      description: "Meta-learning content"
      language: "Same as course.known_lang"
      used_in: "Played in sequence during course"
      example: "Your brain has 100 billion neurons..."
      notes: |
        Copied from shared_audio at course import time.
        Longer instructional content about learning strategies.

  ## ==========================================================================
  ## ORIGIN (TTS vs HUMAN)
  ## ==========================================================================

  origin:
    tts:
      description: "Generated via TTS API"
      regenerable: true
      examples:
        - "azure_en-GB-SoniaNeural"
        - "elevenlabs_rachel"
      workflow: "Can be regenerated if quality issues"

    human:
      description: "Recorded by a human speaker"
      regenerable: false
      precious: true
      examples:
        - "human_aran" (Aran from Welsh courses)
        - "human_catrin" (Catrin from Welsh courses)
      workflow: "Preserve at all costs, never overwrite"

  ## ==========================================================================
  ## SHARED AUDIO WORKFLOW
  ## ==========================================================================

  shared_audio_workflow:
    purpose: |
      shared_audio is a TEMPLATE table. Its records get COPIED to course_audio
      when a course is imported. This keeps the learning app simple - it only
      queries course_audio, never shared_audio.

    terminology_mapping:
      legacy_orderedEncouragements: "instruction"   # Played in sequence
      legacy_pooledEncouragements: "encouragement"  # Randomly selected

    how_it_works: |
      ┌─────────────────────────────────────────────────────────────────────┐
      │                    SHARED AUDIO WORKFLOW                            │
      │                                                                     │
      │  1. IMPORT SHARED AUDIO (once per known language)                   │
      │     └─► shared_audio table (template)                               │
      │         • 48 instructions (orderedEncouragements)                   │
      │         • 26 encouragements (pooledEncouragements)                  │
      │         • Each row has s3_key pointing to audio file                │
      │                                                                     │
      │  2. COPY TO COURSE (on course import)                               │
      │     └─► course_audio table (per-course)                             │
      │         • Same s3_key copied (not the file!)                        │
      │         • Course now "owns" its copy of the reference               │
      │                                                                     │
      │  3. LEARNING APP QUERIES                                            │
      │     └─► Only queries course_audio                                   │
      │         • Simple: one table, no joins                               │
      │         • All audio for a course in one place                       │
      │                                                                     │
      └─────────────────────────────────────────────────────────────────────┘

    s3_sharing: |
      Multiple course_audio rows can point to the SAME S3 file.
      The s3_key is duplicated in the database, but there's only one MP3 in S3.

      Example:
        shared_audio (eng, instruction)     →  s3_key: "7372F60B-5312-4985-B0A0-A97F92323F83.mp3"
        course_audio (cym_s_for_eng)        →  s3_key: "7372F60B-5312-4985-B0A0-A97F92323F83.mp3"  (copied)
        course_audio (spa_for_eng)          →  s3_key: "7372F60B-5312-4985-B0A0-A97F92323F83.mp3"  (copied)
        course_audio (ita_for_eng)          →  s3_key: "7372F60B-5312-4985-B0A0-A97F92323F83.mp3"  (copied)
                                                        ↓
                                               S3: ONE FILE (7372F60B-5312-4985-B0A0-A97F92323F83.mp3)

    import_scripts:
      import_shared_audio: |
        node database/import-shared-audio.cjs <manifest.json>
        - Reads orderedEncouragements → shared_audio (audio_type: instruction)
        - Reads pooledEncouragements → shared_audio (audio_type: encouragement)
        - One-time per known language (e.g., run once for 'eng')

      copy_shared_to_course: |
        node database/copy-shared-to-course.cjs <course_code>
        - Copies shared_audio rows to course_audio for a specific course
        - Maps audio_type → role (encouragement → encouragement, instruction → instruction)
        - Skips if already exists (idempotent)

    why_copy_not_join: |
      We copy references instead of joining at query time because:
      1. Learning app stays simple (one table)
      2. Course can override shared audio if needed (course-specific version)
      3. No runtime dependency on shared_audio table
      4. Easier to reason about what audio a course has

  ## ==========================================================================
  ## VIEWS (for convenience)
  ## ==========================================================================

  views:
    course_audio_inventory:
      description: "Summary of audio per course/role"
      sql: |
        SELECT course_code, role, origin,
               COUNT(*) as count,
               COUNT(DISTINCT voice_id) as voice_count
        FROM course_audio
        GROUP BY course_code, role, origin

    course_voice_breakdown:
      description: "Voice usage per course/role"
      sql: |
        SELECT course_code, role, voice_id, origin, COUNT(*) as count
        FROM course_audio
        GROUP BY course_code, role, voice_id, origin

  ## ==========================================================================
  ## HELPER FUNCTIONS
  ## ==========================================================================

  functions:
    get_missing_audio:
      description: "Find phrases that need audio generation"
      params:
        - "p_course_code TEXT"
        - "p_needed JSONB"  # Array of {text, language, role}
      returns: "TABLE (text, language, role)"
      logic: |
        Compare needed list against course_audio.
        Return items where no matching audio exists.

    get_course_audio_summary:
      description: "Get audio inventory for a course"
      params:
        - "p_course_code TEXT"
      returns: "TABLE (role, origin, count, voice_count)"

  ## ==========================================================================
  ## AUDIO-NULLING TRIGGERS (Content Tables)
  ## ==========================================================================

  audio_nulling_triggers:
    purpose: |
      When text changes on course_practice_phrases or course_legos, the
      corresponding audio UUID columns are automatically set to NULL.
      Phase 8 "Start Generation" then picks up NULLs and regenerates audio.

      This ensures audio always matches the current text without manual
      intervention. Changed text = stale audio, so NULL it and regenerate.

    trigger course_practice_phrases:
      name: "trg_null_phrase_audio_on_text_change"
      timing: "BEFORE UPDATE"
      for_each: "ROW"
      function: "null_phrase_audio_on_text_change()"
      logic: |
        IF NEW.known_text IS DISTINCT FROM OLD.known_text THEN
          NEW.known_audio_id := NULL;
        END IF;
        IF NEW.target_text IS DISTINCT FROM OLD.target_text THEN
          NEW.target1_audio_id := NULL;
          NEW.target2_audio_id := NULL;
        END IF;

    trigger course_legos:
      name: "trg_null_lego_audio_on_text_change"
      timing: "BEFORE UPDATE"
      for_each: "ROW"
      function: "null_lego_audio_on_text_change()"
      logic: |
        IF NEW.known_text IS DISTINCT FROM OLD.known_text THEN
          NEW.known_audio_id := NULL;
          NEW.presentation_audio_id := NULL;
        END IF;
        IF NEW.target_text IS DISTINCT FROM OLD.target_text THEN
          NEW.target1_audio_id := NULL;
          NEW.target2_audio_id := NULL;
        END IF;

    related_columns: |
      These triggers act on the audio ID columns added by migration
      20260130_add_audio_ids_to_content.sql:

      course_legos:
        - known_audio_id UUID REFERENCES course_audio(id)
        - target1_audio_id UUID REFERENCES course_audio(id)
        - target2_audio_id UUID REFERENCES course_audio(id)
        - presentation_audio_id (existing column)

      course_practice_phrases:
        - known_audio_id UUID REFERENCES course_audio(id)
        - target1_audio_id UUID REFERENCES course_audio(id)
        - target2_audio_id UUID REFERENCES course_audio(id)

      These columns enable "cycle locking" - storing audio IDs directly
      instead of text matching at runtime. The nulling triggers ensure
      stale audio references are cleared when text is edited.

  ## ==========================================================================
  ## MIGRATION FROM v12
  ## ==========================================================================

  migration:
    from_v12:
      strategy: |
        v12 had: texts → audio_files → course_audio
        v13 has: course_audio (flat), shared_audio

        Migration:
        1. For each course_audio row in v12:
           - Join to get text content from texts table
           - Insert directly into v13 course_audio
        2. Identify genuinely shared audio (encouragements)
           - Insert into shared_audio
        3. Drop old tables: texts, audio_files, old course_audio

      notes: |
        The Welsh courses have human audio that must be preserved.
        Run import scripts before dropping old tables.

  ## ==========================================================================
  ## WHAT'S NOT IN THIS SPEC (YAGNI)
  ## ==========================================================================

  excluded:
    voices_table: "Course voice_config JSONB is sufficient"
    texts_table: "No need for separate text identity"
    audio_files_table: "No indirection layer needed"
    sample_flags: "QA workflow is separate concern - see sample-flags.apml"
    recording_provenance: "Nice-to-have, add later if needed"

## ============================================================================
