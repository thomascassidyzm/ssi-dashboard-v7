# OVERVIEW
# This document tracks all changes made during the migration from OLD phase numbering
# to APML v9.0 structure. If context is lost, a new model should read this document first.

---

# PHASE MAPPING REFERENCE

phase_mapping:
  phase_1:
    old: "Phase 1"
    new: "Phase 1"
    purpose: "Translation (seed_pairs.json)"

  phase_3_lego:
    old: "Phase 3"
    new: "Phase 1"
    purpose: "LEGO Extraction - NOW MERGED into Phase 1"

  phase_5:
    old: "Phase 5"
    new: "Phase 3"
    purpose: "Basket Generation (lego_baskets.json)"

  phase_5_5:
    old: "Phase 5.5"
    new: "REMOVED"
    purpose: "Grammar Validation - DEPRECATED"

  phase_6:
    old: "Phase 6"
    new: "Integrated"
    purpose: "Introductions - merged into Phase 1"

  phase_7:
    old: "Phase 7"
    new: "Manifest"
    purpose: "Course Compilation (no phase number)"

  phase_8:
    old: "Phase 8"
    new: "Audio"
    purpose: "TTS Generation (no phase number)"

# Key principle: "A phase triggers agents. Scripts run instantly."

