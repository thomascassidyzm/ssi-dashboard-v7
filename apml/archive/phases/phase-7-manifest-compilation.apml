# APML: Manifest Compilation Script
# Version: 10.0.0 (2025-12-03)
# Status: Production
# Type: SCRIPT (not a phase - no agent involvement)

script ManifestCompilation:
  name: "Manifest Compilation"
  purpose: "Transform SSoT files into app-ready course manifest"
  version: "10.0.0"
  type: "deterministic_script"

  ## ==========================================================================
  ## OVERVIEW
  ## ==========================================================================

  description: |
    This SCRIPT (not a phase) compiles SSoT files into the app-ready
    manifest format that the SSi mobile app expects.

    KEY PRINCIPLE: This is a deterministic transformation with no agent
    intelligence required. Same inputs always produce same outputs.

    Input Files (SSoT):
    - lego_pairs.json (LEGOs with types and components)
    - lego_baskets.json (practice phrases)
    - seed_pairs.json (optional fallback for seed sentences)
    - welcomes.json (course welcome messages)
    - eng_encouragements.json (encouragement messages)

    Output File:
    - course_manifest.json (app-ready manifest)
    - {CourseTitle}_COURSE_{timestamp}.json (timestamped backup)

  ## ==========================================================================
  ## INPUT SPECIFICATION
  ## ==========================================================================

  input:
    lego_pairs:
      location: "vfs/courses/{course_code}/lego_pairs.json"
      required: true
      provides:
        - Seed sentences with translations
        - LEGOs with types (A/M) and components
        - Seed → LEGO relationships

    lego_baskets:
      location: "vfs/courses/{course_code}/lego_baskets.json"
      required: true
      provides:
        - Practice phrases for each LEGO

    seed_pairs:
      location: "vfs/courses/{course_code}/seed_pairs.json"
      required: false
      provides:
        - Fallback seed sentences if not in lego_pairs

    welcomes:
      location: "vfs/canonical/welcomes.json"
      required: true
      provides:
        - Course-specific welcome messages

    eng_encouragements:
      location: "vfs/canonical/eng_encouragements.json"
      required: true
      provides:
        - Pooled and ordered encouragement messages

  ## ==========================================================================
  ## OUTPUT SPECIFICATION: APP MANIFEST
  ## ==========================================================================

  output:
    manifest:
      location: "vfs/courses/{course_code}/course_manifest.json"
      backup: "vfs/courses/{course_code}/{CourseTitle}_COURSE_{timestamp}.json"

      top_level_schema:
        id: string                 # "en-spa" (en + 3-letter target code)
        known: string              # "en" (always 2-letter for English)
        target: string             # "spa" (3-letter target language code)
        version: string            # "8.2.0"
        status: string             # "alpha" | "beta" | "production"
        introduction: AudioRef     # Course intro audio reference
        slices: Array<Slice>       # Single slice containing all content

  ## ==========================================================================
  ## STRUCTURE: SLICE
  ## ==========================================================================

  slice_schema:
    id: UUID                       # Deterministic UUID
    version: string                # Same as manifest version
    seeds: Array<Seed>             # All seeds in the course
    pooledEncouragements: Array<EncouragementRef>
    orderedEncouragements: Array<EncouragementRef>
    samples: Record<string, Array<SampleEntry>>  # Text → audio entries

  ## ==========================================================================
  ## STRUCTURE: SEED
  ## ==========================================================================

  seed_schema:
    id: UUID
    seed_sentence:
      canonical: string            # English seed sentence
    node:                          # The seed as a node
      id: UUID
      known:
        text: string               # English sentence
        tokens: Array<string>      # Empty (reserved)
        lemmas: Array<string>      # Empty (reserved)
      target:
        text: string               # Target language sentence
        tokens: Array<string>
        lemmas: Array<string>
    introduction_items: Array<IntroductionItem>  # LEGOs for this seed

  ## ==========================================================================
  ## STRUCTURE: INTRODUCTION_ITEM (LEGO)
  ## ==========================================================================

  introduction_item_schema:
    id: UUID
    node:                          # The LEGO itself
      id: UUID
      known:
        text: string               # English LEGO (e.g., "I want to")
        tokens: Array<string>
        lemmas: Array<string>
      target:
        text: string               # Target LEGO (e.g., "quiero")
        tokens: Array<string>
        lemmas: Array<string>
    nodes: Array<Node>             # Practice nodes (see NODES ARRAY below)
    presentation: string           # The presentation text for TTS

  ## ==========================================================================
  ## CRITICAL: NODES ARRAY STRUCTURE (Practice Phrase Ordering)
  ## ==========================================================================

  nodes_array:
    purpose: |
      The `nodes` array contains all practice content for a LEGO.
      The ordering follows pedagogical principles for optimal learning.

    ordering:
      1_components: "For M-type LEGOs only - component building blocks first"
      2_lego_debut: "The LEGO itself (always present)"
      3_practice_phrases: "Remaining phrases sorted by length (shortest first)"

    for_atomic_legos:
      description: "A-type LEGOs have no components"
      example:
        lego: "with you = contigo"
        nodes:
          - { known: "with you", target: "contigo" }                     # LEGO debut
          - { known: "I want to speak with you", target: "Quiero hablar contigo" }
          - { known: "to speak Spanish with you", target: "hablar español contigo" }

    for_molecular_legos:
      description: "M-type LEGOs have component drills FIRST"
      example:
        lego: "I'm trying = estoy intentando"
        nodes:
          - { known: "I'm", target: "estoy" }                            # Component 1
          - { known: "trying", target: "intentando" }                    # Component 2
          - { known: "I'm trying", target: "estoy intentando" }          # LEGO debut
          - { known: "I'm trying to speak", target: "Estoy intentando hablar" }
          - { known: "I'm trying to speak Spanish", target: "Estoy intentando hablar español" }

    pedagogical_rationale: |
      Component drills come BEFORE the LEGO debut so learners
      ACTIVELY PRACTICE the building blocks before combining them.

  ## ==========================================================================
  ## STRUCTURE: SAMPLES DICTIONARY
  ## ==========================================================================

  samples_dictionary:
    purpose: |
      The samples dictionary maps text content to audio file references.
      The app looks up audio by TEXT CONTENT, not by LEGO ID.
      This enables deduplication - same text = same audio file.

    structure:
      key: "The exact text content (string)"
      value: "Array of SampleEntry objects"

    critical_rule: |
      Each target language text MUST have TWO entries:
      - One with role: "target1" (female voice)
      - One with role: "target2" (male voice)

      Each known/English text has ONE entry with role: "source"

    example: |
      "samples": {
        "I want to speak Spanish with you now.": [
          { "duration": 0, "id": "UUID1", "cadence": "natural", "role": "source" }
        ],
        "Quiero hablar español contigo ahora.": [
          { "duration": 0, "id": "UUID2", "cadence": "natural", "role": "target1" },
          { "duration": 0, "id": "UUID3", "cadence": "natural", "role": "target2" }
        ],
        "The Spanish for 'i want', is: ... 'quiero' ... 'quiero'": [
          { "duration": 0, "id": "UUID4", "cadence": "natural", "role": "presentation" }
        ],
        "And remember that your brain has got...": [
          { "duration": 0, "id": "UUID5", "cadence": "natural", "role": "presentation_encouragement" }
        ]
      }

  ## ==========================================================================
  ## AUDIO ROLES (CRITICAL - Only These 5 Roles Are Valid)
  ## ==========================================================================

  audio_roles:
    source:
      description: "English/known language text (single entry per text)"
      voice: "English voice (Aran clone via ElevenLabs)"
      examples:
        - "I want to speak Spanish with you now."
        - "I want"
        - "to speak"

    target1:
      description: "Target language text - female voice"
      voice: "Female target language voice (Azure TTS)"
      examples:
        - "Quiero hablar español contigo ahora."
        - "quiero"

    target2:
      description: "Target language text - male voice"
      voice: "Male target language voice (Azure TTS)"
      note: "Same texts as target1, different voice"

    presentation:
      description: "LEGO introduction/presentation audio"
      voice: "English voice (Aran clone via ElevenLabs)"
      format: "The {Language} for '{known}', is: ... '{target}' ... '{target}'"
      examples:
        - "The Spanish for 'i want', is: ... 'quiero' ... 'quiero'"
        - Course welcome message

    presentation_encouragement:
      description: "Encouragement messages between practice"
      voice: "English voice (Aran clone via ElevenLabs)"
      examples:
        - "And remember that your brain has got as many neurons..."
        - "You're doing excellently..."

  ## ==========================================================================
  ## SAMPLE ENTRY STRUCTURE
  ## ==========================================================================

  sample_entry_schema:
    duration: number               # 0 until audio generated (populated by MAR)
    id: UUID                       # Deterministic UUID
    cadence: "natural"             # Always "natural" for initial compilation
    role: string                   # One of the 5 valid roles above

  ## ==========================================================================
  ## UUID GENERATION
  ## ==========================================================================

  uuid_generation:
    method: "MD5 hash formatted as UUID"
    format: "UPPERCASE with hyphens (8-4-4-4-12)"

    formula: |
      hash = MD5(`sample:${role}:${idSuffix}`)
      uuid = hash[0:8]-hash[8:12]-hash[12:16]-hash[16:20]-hash[20:32]

    determinism: |
      Same inputs ALWAYS produce same UUID.
      This enables:
      - Audio file caching (don't regenerate existing files)
      - MAR lookup for existing audio
      - Manifest regeneration without breaking audio links

  ## ==========================================================================
  ## COMPILATION WORKFLOW
  ## ==========================================================================

  workflow:
    STEP_1_LOAD_FILES:
      description: "Load all input files"
      files:
        - lego_pairs.json
        - lego_baskets.json
        - seed_pairs.json (optional)
        - welcomes.json
        - eng_encouragements.json

    STEP_2_INITIALIZE:
      description: "Initialize manifest structure and samples Map"
      actions:
        - Create manifest header (id, known, target, version, status)
        - Create introduction with welcome reference
        - Initialize empty samples Map
        - Add welcome text to samples (role: presentation)
        - Add encouragements to samples (role: presentation_encouragement)

    STEP_3_PROCESS_SEEDS:
      description: "Process each seed and its LEGOs"
      for_each_seed:
        - Get seed sentence (from lego_pairs or seed_pairs fallback)
        - Create seed node
        - Add seed known text to samples (role: source)
        - Add seed target text to samples (role: target1 + target2)
        - Process each LEGO in seed

    STEP_4_PROCESS_LEGOS:
      description: "Process each LEGO"
      for_each_lego:
        - Skip review LEGOs (new=false) without baskets
        - Generate presentation text dynamically
        - Create introduction_item with node
        - Add LEGO known to samples (role: source)
        - Add LEGO target to samples (role: target1 + target2)
        - Add presentation to samples (role: presentation)
        - Build nodes array with correct ordering

    STEP_5_BUILD_NODES:
      description: "Build nodes array for each LEGO"
      ordering:
        - If M-type: Add components first (source + target1 + target2 for each)
        - Add LEGO debut (already in samples)
        - Add practice phrases sorted by length (source + target1 + target2 for each)

    STEP_6_FINALIZE:
      description: "Assemble and write manifest"
      actions:
        - Convert samples Map to object
        - Assemble final manifest structure
        - Write timestamped JSON file
        - Copy to course_manifest.json

  ## ==========================================================================
  ## PRESENTATION TEXT GENERATION
  ## ==========================================================================

  presentation_format:
    template: "The {TargetLanguage} for '{known}', is: ... '{target}' ... '{target}'"
    example: "The Spanish for 'i want', is: ... 'quiero' ... 'quiero'"
    note: "Known text is lowercased in the template"

  ## ==========================================================================
  ## SCRIPT LOCATION
  ## ==========================================================================

  script:
    location: "scripts/phase7-compile-manifest-v3.cjs"
    usage: "node scripts/phase7-compile-manifest-v3.cjs {course_code}"
    example: "node scripts/phase7-compile-manifest-v3.cjs spa_for_eng"

    dependencies:
      - lego_pairs.json
      - lego_baskets.json
      - seed_pairs.json (optional)
      - welcomes.json (canonical)
      - eng_encouragements.json (canonical)

  ## ==========================================================================
  ## COMPARISON TOOL
  ## ==========================================================================

  comparison_script:
    location: "scripts/compare-manifests.cjs"
    usage: "node scripts/compare-manifests.cjs <new_manifest> [reference_manifest]"
    purpose: "Compare manifest structure against Italian reference"

  ## ==========================================================================
  ## STATISTICS (spa_for_eng)
  ## ==========================================================================

  statistics:
    seeds: 630
    introduction_items: 1912
    practice_nodes: 18820
    unique_sample_texts: 30118
    total_sample_entries: 43979
    role_breakdown:
      source: 14358
      target1: 13841
      target2: 13841
      presentation: 1913
      presentation_encouragement: 26
    file_size: ~14.5MB

## ============================================================================
## GENERATED: 2025-12-03
