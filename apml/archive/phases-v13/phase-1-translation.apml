# APML Phase 1: Translation + LEGO Extraction
# Version: 11.0.0 (2026-01-12)
# Status: Production-ready
# Server Port: 3457
#
# Source prompts:
#   - tools/generators/phase1-3-unified-prompt-v3.md
#   - public/docs/phase_intelligence/phase_1_seed_pairs.md
#   - public/docs/phase_intelligence/phase_1_orchestrator.md
#
# DB Schema Reference:
#   - database/migrations/002_registry_schema.sql
#
# CIK Principles Reference:
#   - apml/core/cik-lego-principles-v1.apml

phase Phase1TranslationLEGO:
  name: "Phase 1: Translation + LEGO Extraction"
  purpose: "Translate canonical seeds AND extract LEGOs with DB-first output"
  version: "11.0.0"
  server_port: 3457

  ## ==========================================================================
  ## OVERVIEW
  ## ==========================================================================

  description: |
    Coordinate parallel translation of ~668 seeds using orchestrator pattern.
    3 orchestrator agents x 10 sub-agents = 30 concurrent translation agents.
    Each seed becomes a [target, known] pedagogical pair with extracted LEGOs.

    DB-FIRST ARCHITECTURE (v11):
    - All outputs write directly to Supabase tables
    - No intermediate JSON chunk files
    - course_seeds and course_legos tables are the SSoT

  orchestration_pattern: "hierarchical"
    levels:
      - name: "orchestrator"
        count: 3
        responsibility: "Coordinate 10 sub-agents, validate chunk, write to Supabase"
        seeds_per_orchestrator: 223

      - name: "sub-agent"
        count: 10 per orchestrator
        responsibility: "Translate ~22-23 seeds following translation skill + CIK principles"
        seeds_per_agent: 23

  total_concurrent_agents: 30
  total_orchestrators: 3

  ## ==========================================================================
  ## INPUT SPECIFICATION
  ## ==========================================================================

  input:
    orchestrator_batch_file:
      location: "vfs/courses/{course_code}/orchestrator_batches/phase1/orchestrator_batch_{NN}.json"
      schema:
        orchestrator_id: string         # "phase1_orch_01"
        chunk_number: integer           # 1-3
        course_code: string             # e.g. "spa_for_eng"
        seed_range:
          start: integer                # e.g. 1
          end: integer                  # e.g. 223
          total: integer                # e.g. 223
        api:
          seeds_endpoint: string        # ngrok tunnel URL
          fetch_params: string          # "?start=1&end=223"
        config:
          agents_to_spawn: integer      # 10
          seeds_per_agent: integer      # 23

    canonical_seeds:
      source: "API endpoint specified in batch file"
      format: "Array of {id, canonical_text}"
      fetch_method: "WebFetch or curl"

  ## ==========================================================================
  ## OUTPUT SPECIFICATION (DB-FIRST)
  ## ==========================================================================

  output:
    description: |
      All outputs write directly to Supabase tables with status='draft'.
      No JSON chunk files are generated.

    supabase_tables:

      course_seeds:
        description: "Seed sentences - translated pairs"
        schema_reference: "database/migrations/002_registry_schema.sql"
        columns:
          - id: "UUID (auto-generated)"
          - course_code: "TEXT NOT NULL (FK to courses)"
          - seed_number: "INTEGER NOT NULL (1-668+)"
          - seed_id: "TEXT GENERATED (e.g., S0001)"
          - known_text: "TEXT NOT NULL (English translation)"
          - target_text: "TEXT NOT NULL (Spanish translation)"
          - status: "content_status DEFAULT 'draft'"
          - release_batch: "INTEGER (null for draft)"
          - version: "INTEGER DEFAULT 1"
          - updated_at: "TIMESTAMPTZ (auto-updated)"
          - created_at: "TIMESTAMPTZ"
        unique_constraint: "(course_code, seed_number)"
        on_conflict: "UPDATE known_text, target_text, updated_at"

      course_legos:
        description: "LEGO building blocks extracted from seeds"
        schema_reference: "database/migrations/002_registry_schema.sql"
        columns:
          - id: "UUID (auto-generated)"
          - course_code: "TEXT NOT NULL (FK to courses)"
          - seed_number: "INTEGER NOT NULL (parent seed)"
          - lego_index: "INTEGER NOT NULL (1-99, position within seed)"
          - lego_id: "TEXT GENERATED (e.g., S0001L01)"
          - type: "lego_type ENUM ('A', 'M')"
          - is_new: "BOOLEAN NOT NULL (first appearance = true)"
          - known_text: "TEXT NOT NULL"
          - target_text: "TEXT NOT NULL"
          - components: "JSONB (for M-type only)"
          - status: "content_status DEFAULT 'draft'"
          - release_batch: "INTEGER (null for draft)"
          - version: "INTEGER DEFAULT 1"
          - updated_at: "TIMESTAMPTZ (auto-updated)"
          - created_at: "TIMESTAMPTZ"
        unique_constraint: "(course_code, seed_number, lego_index)"
        on_conflict: "UPDATE type, is_new, known_text, target_text, components, updated_at"

        components_format: |
          For M-type LEGOs, components is a JSONB array of build-up scaffolding:
          [
            {"known": "time", "target": "tiempo"},
            {"known": "a short time", "target": "poco tiempo"},
            {"known": "in a short time", "target": "en poco tiempo"}
          ]

          CIK Principles (see apml/core/cik-lego-principles-v1.apml):
          - Components are pedagogical scaffolding, NOT parse trees
          - Single words that fail ZUT are absorbed, not listed
          - Build from simple -> complex, ending with full LEGO
          - Articles/prepositions/conjunctions NEVER standalone

  ## ==========================================================================
  ## WORKFLOW
  ## ==========================================================================

  workflow:
    STEP_1_READ_BATCH:
      description: "Read orchestrator batch file"
      actions:
        - Read batch file from VFS
        - Extract seed range (start, end)
        - Note API endpoint for fetching seeds
        - Identify course_code for Supabase writes

    STEP_2_FETCH_SEEDS:
      description: "Fetch canonical seeds from API"
      method: "WebFetch or curl to seeds_endpoint + fetch_params"
      example: "curl https://xxx.ngrok-free.dev/api/seeds?start=1&end=223"

    STEP_3_DIVIDE_WORK:
      description: "Split seeds into 10 equal portions"
      algorithm: |
        total_seeds = end - start + 1
        seeds_per_agent = ceil(total_seeds / 10)

        Agent 1: seeds[0:23]
        Agent 2: seeds[23:46]
        ...
        Agent 10: seeds[207:total_seeds]

    STEP_4_SPAWN_AGENTS:
      description: "Spawn 10 sub-agents in PARALLEL"
      critical: "ALL 10 agents must be spawned in a SINGLE message using Task tool"
      reason: "Parallel execution is 10x faster than sequential"

      agent_prompt_template: |
        Translate seeds S{start_id}-S{end_id} using the translation-skill.

        SKILL LOCATION: /Users/tomcassidy/SSi/ssi-dashboard-v7-clean/skills/translation-skill

        REQUIRED READING (in order):
        1. rules/TWO_ABSOLUTE_RULES.md - NEVER violate these [ABSOLUTE]
        2. rules/ZERO_VARIATION.md - First-come-first-served principle
        3. rules/COGNATE_PREFERENCE.md - Check cognates FIRST (seeds 1-100)
        4. workflow/EXTENDED_THINKING.md - Use for EVERY seed [MANDATORY]
        5. apml/core/cik-lego-principles-v1.apml - CIK LEGO extraction principles

        INPUT:
        - Seed list with IDs and canonical text
        - Target language: {target_code}
        - Known language: {known_code}
        - Course code: {course_code}

        OUTPUT FORMAT (for Supabase insertion):
        Return structured data ready for database insertion:
        {
          "seeds": [
            {
              "seed_number": 1,
              "known_text": "the car",
              "target_text": "el coche"
            }
          ],
          "legos": [
            {
              "seed_number": 1,
              "lego_index": 1,
              "type": "M",
              "is_new": true,
              "known_text": "the car",
              "target_text": "el coche",
              "components": [
                {"known": "car", "target": "coche"},
                {"known": "the car", "target": "el coche"}
              ]
            }
          ]
        }

        CRITICAL:
        - Extended thinking for EVERY seed
        - TWO ABSOLUTE RULES never violated
        - Cognate preference mandatory (seeds 1-100)
        - Maintain vocabulary registry for consistency
        - Follow CIK principles: M-type is the NORM, A-type is the EXCEPTION
        - Articles/prepositions/conjunctions NEVER standalone A-types

    STEP_5_RECEIVE_OUTPUTS:
      description: "Wait for all 10 sub-agents to complete"
      expected_outputs: 10
      format: "Each agent returns structured data with seeds and legos arrays"

    STEP_6_VALIDATE:
      description: "Validate all translations within chunk"

      validation_checks:
        grammar:
          - "Target language grammatically correct?"
          - "Known language grammatically correct?"
          - "Meaning preserved from canonical?"

        cognate_preference:
          applies_to: "Seeds 1-100 only"
          checks:
            - "Did agent check for cognate synonyms?"
            - "Is cognate used when available?"

        consistency_within_chunk:
          - "Same English word -> same Spanish translation?"
          - "Zero variation enforced (seeds 1-100)?"

        cik_compliance:
          reference: "apml/core/cik-lego-principles-v1.apml"
          checks:
            - "M-type LEGOs have components array?"
            - "A-type LEGOs are truly unambiguous (adverbs, proper nouns)?"
            - "No articles/prepositions/conjunctions as standalone A-types?"
            - "Components show build-up scaffolding, not parse trees?"
            - "Target 3-4 LEGOs per seed?"

        lego_structure:
          - "Every M-type has valid components JSONB array?"
          - "Components array ends with the full LEGO?"
          - "lego_index values are sequential (1, 2, 3...)?"
          - "is_new flag correctly set for overlapping LEGOs?"

      error_handling:
        minor_issues:
          threshold: "<5 seeds"
          action: "Fix manually"

        systematic_issues:
          threshold: ">5 seeds or misunderstood rules"
          action: "Re-spawn specific agent with clarification"

    STEP_7_MERGE:
      description: "Combine all 10 agent outputs"
      output_format:
        seeds: "Array of all seed records"
        legos: "Array of all LEGO records"
        metadata:
          orchestrator_id: string
          chunk_number: integer
          total_seeds: integer
          agents_used: integer
          validation_passed: boolean
          issues_found: integer
          manual_fixes: integer (optional)

    STEP_8_WRITE_TO_SUPABASE:
      description: "Write validated data to Supabase tables"

      write_operations:
        course_seeds:
          method: "UPSERT"
          conflict_target: "(course_code, seed_number)"
          on_conflict: "UPDATE SET known_text, target_text, updated_at = now()"
          status: "'draft'"

        course_legos:
          method: "UPSERT"
          conflict_target: "(course_code, seed_number, lego_index)"
          on_conflict: "UPDATE SET type, is_new, known_text, target_text, components, updated_at = now()"
          status: "'draft'"

      example_sql:
        seeds: |
          INSERT INTO course_seeds (course_code, seed_number, known_text, target_text, status)
          VALUES ('spa_for_eng', 1, 'the car', 'el coche', 'draft')
          ON CONFLICT (course_code, seed_number)
          DO UPDATE SET
            known_text = EXCLUDED.known_text,
            target_text = EXCLUDED.target_text,
            updated_at = now();

        legos: |
          INSERT INTO course_legos (course_code, seed_number, lego_index, type, is_new, known_text, target_text, components, status)
          VALUES ('spa_for_eng', 1, 1, 'M', true, 'the car', 'el coche',
                  '[{"known": "car", "target": "coche"}, {"known": "the car", "target": "el coche"}]'::jsonb,
                  'draft')
          ON CONFLICT (course_code, seed_number, lego_index)
          DO UPDATE SET
            type = EXCLUDED.type,
            is_new = EXCLUDED.is_new,
            known_text = EXCLUDED.known_text,
            target_text = EXCLUDED.target_text,
            components = EXCLUDED.components,
            updated_at = now();

    STEP_9_REPORT:
      description: "Output completion summary"
      format: |
        Phase 1 Orchestrator {NN} Complete

        Seeds translated: ~223
        Agents spawned: 10
        Database writes:
          - course_seeds: {seed_count} rows
          - course_legos: {lego_count} rows
        Validation: PASSED
        Issues: {count}
        CIK Compliance: VERIFIED

        Ready for Phase 2 (Conflict Resolution).

    STEP_10_CLEANUP:
      description: "Kill iTerm2 windows for sub-agents"
      critical: "30 agents x iTerm2 windows = significant memory usage"
      command: |
        osascript -e 'tell application "iTerm2" to close (every window whose name contains "Phase 1")'

  ## ==========================================================================
  ## CRITICAL RULES
  ## ==========================================================================

  rules:
    RULE_1_PARALLEL_SPAWNING:
      requirement: "Spawn all 10 agents in a SINGLE message"
      correct_approach: |
        I'll spawn 10 agents now.
        [Task tool x 10 in this single message]

      incorrect_approach: |
        I'll spawn agent 1... [waits] ...now agent 2... [waits] ...

      reason: "Parallel spawning is 10x faster than sequential"

    RULE_2_CHUNK_SCOPE:
      responsibility: "Validate consistency WITHIN chunk only"
      not_responsible_for: "Cross-chunk consistency (Phase 2 handles this)"

      example:
        orchestrator_checks: "Does seed 50 use same translation as seed 100 in MY chunk?"
        phase2_checks: "Does chunk 1's translation match chunk 3's translation?"

    RULE_3_INTELLIGENT_RETRY:
      when_one_agent_fails:
        action: "Re-spawn JUST that agent with specific corrections"
        dont: "Re-run all 10 agents"

      when_multiple_agents_fail:
        check: "Were Task prompts clear enough?"
        action: "Re-spawn problem agents with better instructions"

    RULE_4_MANUAL_FIXES:
      threshold: "<5 small errors"
      action: "Fix manually (faster than re-spawn)"
      tracking: "Note in metadata: 'manual_fixes': 2"

      re_spawn_threshold: ">5 errors, systematic issues, or misunderstood rules"

    RULE_5_DB_FIRST:
      requirement: "All output goes to Supabase tables, not JSON files"
      tables:
        - "course_seeds (seed_number, known_text, target_text, status='draft')"
        - "course_legos (seed_number, lego_index, type, known_text, target_text, is_new, components JSONB, status='draft')"
      reason: "Database is the Single Source of Truth (SSoT)"

    RULE_6_CIK_COMPLIANCE:
      reference: "apml/core/cik-lego-principles-v1.apml"
      core_principle: "Context is King - meaning emerges from context"
      requirements:
        - "M-type (Molecular) LEGOs are the PRIMARY teaching unit"
        - "A-type (Atomic) LEGOs are the EXCEPTION, not the rule"
        - "Articles, prepositions, conjunctions NEVER pass ZUT alone"
        - "Components are pedagogical scaffolding, not parse trees"
        - "Target 3-4 LEGOs per seed"

  ## ==========================================================================
  ## VALIDATION CHECKLIST
  ## ==========================================================================

  validation_checklist:
    translation_quality:
      - "All seeds translated (no missing IDs)"
      - "Grammar correct in BOTH languages"
      - "Cognates used when available (seeds 1-100)"
      - "Same English word -> same translation (within chunk)"
      - "Zero variation (seeds 1-100, within chunk)"
      - "Meaning preserved from canonical"

    lego_structure:
      - "Every seed has 3-4 LEGOs (2 acceptable for short, 5+ for complex)"
      - "M-type LEGOs have valid components JSONB array"
      - "A-type LEGOs are truly atomic (adverbs, proper nouns, unambiguous infinitives)"
      - "No articles/prepositions/conjunctions as standalone A-types"
      - "lego_index values sequential within each seed"
      - "is_new flag correct for overlapping LEGOs (embedded = false)"

    cik_compliance:
      - "Components show build-up from simple -> complex"
      - "Components end with full LEGO"
      - "ZUT-failing single words absorbed, not listed"
      - "Overlapping LEGOs provide richness"

    database_writes:
      - "course_code matches batch file"
      - "All records have status='draft'"
      - "UPSERT handles re-runs correctly"

  ## ==========================================================================
  ## EFFICIENCY METRICS
  ## ==========================================================================

  performance:
    total_time_per_orchestrator: "15-20 minutes for 223 seeds"
    parallel_speedup: "10x faster than sequential"
    resource_usage: "30 concurrent agents maximum (system-safe)"

  efficiency_tips:
    spawn_fast:
      - "Read batch file"
      - "Divide seeds (simple math)"
      - "Spawn 10 agents immediately (one message)"
      - "Don't overthink division - just split evenly"

    validate_efficiently:
      - "Scan for obvious errors first (missing fields, broken JSON)"
      - "Then check grammar/cognates"
      - "Verify CIK compliance (M-type has components, A-type truly atomic)"
      - "Only deep-dive if you spot patterns"

    write_efficiently:
      - "Batch Supabase inserts (not one-by-one)"
      - "Use UPSERT to handle re-runs"
      - "Verify row counts match expected"

  ## ==========================================================================
  ## SUCCESS CRITERIA
  ## ==========================================================================

  success_criteria:
    - "All ~223 seeds translated"
    - "10 agents spawned in parallel (not sequential)"
    - "Validation passed (grammar, cognates, consistency, CIK compliance)"
    - "course_seeds table populated with draft records"
    - "course_legos table populated with draft records"
    - "All M-type LEGOs have valid components JSONB"
    - "Summary reported"
    - "iTerm2 windows cleaned up"

  ## ==========================================================================
  ## VERSION HISTORY
  ## ==========================================================================

  version_history:
    v11_0_0:
      date: "2026-01-12"
      changes:
        - "DB-FIRST ARCHITECTURE: Output writes to Supabase tables instead of JSON files"
        - "Removed all JSON chunk file references (draft_lego_pairs.json, chunk files)"
        - "Output tables: course_seeds (seed_number, known_text, target_text, status='draft')"
        - "Output tables: course_legos (seed_number, lego_index, type, known_text, target_text, is_new, components JSONB, status='draft')"
        - "Added CIK principles reference (apml/core/cik-lego-principles-v1.apml)"
        - "Added CIK compliance validation checks"
        - "Added RULE_5_DB_FIRST and RULE_6_CIK_COMPLIANCE"
        - "Updated agent prompt template for structured DB output"
        - "Added example SQL for UPSERT operations"
        - "Schema reference: database/migrations/002_registry_schema.sql"

    v10_1_0:
      date: "2025-12-03"
      changes:
        - "Updated for production deployment"
        - "Refined validation checks"

    v1_1:
      date: "2025-10-30"
      changes:
        - "Reduced concurrency: 3 orchestrators x 10 agents = 30 concurrent agents"
        - "Increased seeds per orchestrator: ~223 seeds (was ~134)"
        - "Added cleanup step: STEP 9 kills iTerm2 windows"
        - "Updated for skills directory: Orchestrator points to modular translation-skill"
        - "Eliminated data duplication: Batch files contain ranges only, fetch from API"

    v1_0:
      date: "2025-10-29"
      changes:
        - "Initial orchestrator intelligence"
        - "5 orchestrators x 10 agents = 50 concurrent agents"
        - "Focus: Speed + quality within chunk"
        - "Validator handles cross-chunk consistency"
