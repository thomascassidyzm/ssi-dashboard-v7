# APML Phase 3: Practice Basket Generation
# Version: 11.1.0 (2026-01-12)
# Status: Production-ready (DB-first)
# Server Port: 3459

phase Phase3BasketGeneration:
  name: "Phase 3: Practice Basket Generation"
  purpose: "Generate high-quality practice phrase baskets using linguistic reasoning"
  version: "11.1.0"
  server_port: 3459

  ## ==========================================================================
  ## OVERVIEW
  ## ==========================================================================

  description: |
    Generate 10 practice phrases per LEGO using ONLY linguistic intelligence.
    Reads LEGOs from database, generates practice phrases, writes to database.
    Agent fills practice_phrases arrays using extended thinking for each LEGO.

  pipeline_architecture: "DB-First Pipeline"
    input_source: "course_legos table (WHERE is_new=true AND status='released')"
    output_target: "course_practice_phrases table"

    stage_1: "Mechanical preparation (done before agent)"
      - "Query course_legos for released new LEGOs"
      - "Build whitelist (3-category rule) from cumulative LEGOs"
      - "Prepare LEGO batch with metadata"

    stage_2: "Linguistic generation (agent task)"
      - "Fill practice_phrases arrays"
      - "Use extended thinking per LEGO"
      - "Ensure GATE compliance"

    stage_3: "Database persistence"
      - "Write to course_practice_phrases table"
      - "Set status='draft' initially"
      - "Include word_count and lego_count metadata"

  core_principle: "This is a LINGUISTIC task, not a CODING task"

  ## ==========================================================================
  ## DATABASE SCHEMA REFERENCE
  ## ==========================================================================

  database_schema:
    description: "Reference: database/migrations/002_registry_schema.sql"

    input_table: "course_legos"
      columns:
        - "id: UUID PRIMARY KEY"
        - "course_code: TEXT NOT NULL"
        - "seed_number: INTEGER NOT NULL"
        - "lego_index: INTEGER NOT NULL"
        - "lego_id: TEXT (generated as S{seed_number}L{lego_index})"
        - "type: lego_type ENUM ('A', 'M')"
        - "is_new: BOOLEAN NOT NULL"
        - "known_text: TEXT NOT NULL"
        - "target_text: TEXT NOT NULL"
        - "components: JSONB (for M-type only)"
        - "status: content_status ENUM ('draft', 'released', 'deprecated')"

      query_filter: "WHERE is_new = true AND status = 'released'"

    output_table: "course_practice_phrases"
      columns:
        - "id: UUID PRIMARY KEY (auto-generated)"
        - "course_code: TEXT NOT NULL"
        - "seed_number: INTEGER NOT NULL"
        - "lego_index: INTEGER NOT NULL"
        - "position: INTEGER NOT NULL (0=component, 1=lego, 2-7=debut, 8+=eternal)"
        - "known_text: TEXT NOT NULL"
        - "target_text: TEXT NOT NULL"
        - "word_count: INTEGER NOT NULL"
        - "target_syllable_count: INTEGER NOT NULL (cognitive load metric, max 25)"
        - "lego_count: INTEGER NOT NULL"
        - "status: content_status DEFAULT 'draft'"

      unique_constraint: "(course_code, seed_number, lego_index, position)"

    phrase_type_classification:
      description: "phrase_type is NOT stored - computed at runtime"
      view: "course_practice_phrases_with_type"
      rules:
        - "position = 0 -> 'component'"
        - "position = 1 -> 'lego'"
        - "position BETWEEN 2 AND 7 -> 'debut'"
        - "position >= 8 -> 'eternal'"

  ## ==========================================================================
  ## CRITICAL: PROHIBITED APPROACHES
  ## ==========================================================================

  prohibited:
    description: "Agent MAY NOT use automation or templates"

    forbidden_methods:
      - "Write Python/JavaScript/any scripts to generate phrases"
      - "Use template-based generation (f-strings, string interpolation)"
      - "Mechanically substitute LEGO text into fixed patterns"
      - "Automate phrase creation through loops or functions"

    rationale: |
      Automated generation cannot understand:
      - Word class (verb vs noun vs adjective)
      - Semantic appropriateness
      - Natural usage patterns
      - Contextual fit

  ## ==========================================================================
  ## REQUIRED APPROACH
  ## ==========================================================================

  required_approach:
    description: "Agent MUST use linguistic intelligence for every phrase"

    mandatory_methods:
      - "Think through each phrase individually"
      - "Use extended thinking (<thinking> tags) for every LEGO"
      - "Understand the LEGO's grammatical role"
      - "Create natural, conversational usage"
      - "Validate semantic correctness"

    quality_standard: "Top dollar content quality (slower but higher quality)"

  ## ==========================================================================
  ## INPUT: DATABASE QUERY
  ## ==========================================================================

  input_query:
    description: "Query course_legos for LEGOs requiring basket generation"

    sql_example: |
      SELECT
        cl.id,
        cl.course_code,
        cl.seed_number,
        cl.lego_index,
        cl.lego_id,
        cl.type,
        cl.is_new,
        cl.known_text,
        cl.target_text,
        cl.components,
        cs.known_text AS seed_known,
        cs.target_text AS seed_target
      FROM course_legos cl
      JOIN course_seeds cs ON cs.course_code = cl.course_code
                          AND cs.seed_number = cl.seed_number
      WHERE cl.course_code = $1
        AND cl.is_new = true
        AND cl.status = 'released'
      ORDER BY cl.seed_number, cl.lego_index;

    whitelist_query: |
      -- Build whitelist from all LEGOs up to current seed
      SELECT DISTINCT
        cl.target_text,
        cl.known_text,
        cl.type,
        cl.components
      FROM course_legos cl
      WHERE cl.course_code = $1
        AND cl.seed_number <= $2
        AND cl.status = 'released'
      ORDER BY cl.seed_number, cl.lego_index;

    what_is_available:
      - "LEGO content (known_text, target_text)"
      - "LEGO type (A or M)"
      - "Components for M-type LEGOs"
      - "Seed context (seed_known, seed_target)"
      - "Cumulative whitelist from all previous LEGOs"

    what_agent_must_do:
      - "Generate practice_phrases for each LEGO"
      - "Ensure GATE compliance against whitelist"
      - "Calculate word_count for each phrase"
      - "Set appropriate position values"

  ## ==========================================================================
  ## WHITELIST: THE 3-CATEGORY RULE
  ## ==========================================================================

  whitelist_logic:
    description: "Whitelist built mechanically using 'learned already' philosophy"
    philosophy: "Learner can use any vocabulary they've already encountered"

    three_sources:
      category_1_atomic_legos:
        description: "Single words from A-type LEGOs"
        example:
          lego:
            type: "A"
            target_text: "quiero"
            known_text: "I want"
          whitelist_entry: "quiero"
          learner_knows: "quiero = I want"

      category_2_molecular_legos_complete:
        description: "All words from M-type LEGOs (split into words)"
        example:
          lego:
            type: "M"
            target_text: "estoy intentando"
            known_text: "I'm trying"
          whitelist_entries: ["estoy", "intentando"]
          learner_knows: "estoy intentando = I'm trying (as phrase)"

      category_3_component_words:
        description: "Component words from M-type LEGOs (literal translations)"
        example:
          lego:
            type: "M"
            target_text: "estoy intentando"
            known_text: "I'm trying"
            components:
              - {"known": "I am", "target": "estoy"}
              - {"known": "trying", "target": "intentando"}
          whitelist_entries: ["estoy", "intentando"]
          learner_knows:
            - "estoy = I am (literal)"
            - "intentando = trying (literal)"

    pedagogical_benefit: |
      Component words let learners RECONSTRUCT and RECOMBINE.
      They see grammar without explanation!

      Example:
        LEGO: "lo mas posible" = "as much as possible" (M-type)
        Components:
          - "lo mas" = "the most" (literal)
          - "posible" = "possible" (literal)

        Learner can now use:
          lo mas posible (the whole phrase)
          lo mas alone (knows it means "the most")
          posible alone (knows it means "possible")

  ## ==========================================================================
  ## BASKET CYCLE SEQUENCE (v10.1)
  ## ==========================================================================

  basket_cycle_sequence:
    description: |
      For M-type (molecular) LEGOs, the basket includes a "LEGO Debut" cycle
      immediately after components and before practice sentences.
      This ensures learners combine the components before using the LEGO in full sentences.

    sequence_for_M_type:
      1_components:
        description: "Individual component words (position: 0, is_component: true)"
        purpose: "Learner hears and understands the building blocks"
        database_position: 0
        example:
          - {known_text: "I", target_text: "yo", position: 0, word_count: 1, lego_count: 1}
          - {known_text: "want", target_text: "quiero", position: 0, word_count: 1, lego_count: 1}

      2_lego_debut:
        description: "The LEGO itself (position: 1, is_debut: true)"
        purpose: "Learner combines components into the complete LEGO"
        database_position: 1
        example:
          - {known_text: "I want to", target_text: "quiero", position: 1, word_count: 1, lego_count: 1}

      3_practice_sentences:
        description: "Practice phrases using the LEGO (position: 2+)"
        purpose: "Learner uses LEGO in natural sentences"
        database_position: "2-11 (for 10 phrases)"
        example:
          - {known_text: "I want to go", target_text: "quiero ir", position: 2, word_count: 2, lego_count: 2}
          - {known_text: "I want to eat", target_text: "quiero comer", position: 3, word_count: 2, lego_count: 2}

    sequence_for_A_type:
      description: "A-type (atomic) LEGOs skip components and debut"
      note: "A-type LEGOs are single words, no decomposition needed"
      sequence:
        - "Practice sentences only (10 phrases, positions 2-11)"

    example_M_type_output:
      lego: {known_text: "I want to", target_text: "quiero"}
      type: "M"
      database_rows:
        - {position: 0, known_text: "I", target_text: "yo", word_count: 1, lego_count: 1}
        - {position: 0, known_text: "want", target_text: "quiero", word_count: 1, lego_count: 1}
        - {position: 1, known_text: "I want to", target_text: "quiero", word_count: 1, lego_count: 1}
        - {position: 2, known_text: "I want to go", target_text: "quiero ir", word_count: 2, lego_count: 2}
        - {position: 3, known_text: "I want to eat", target_text: "quiero comer", word_count: 2, lego_count: 2}
        # ... more practice phrases

  ## ==========================================================================
  ## PHRASE GENERATION PROCESS
  ## ==========================================================================

  generation_workflow:
    STEP_1_UNDERSTAND_LEGO:
      description: "Use extended thinking to analyze the LEGO"

      analysis_questions:
        - "What is it? (Verb? Noun? Adjective? Adverb? Phrase?)"
        - "How is it naturally used?"
        - "What contexts make sense?"
        - "What are typical sentence patterns?"
        - "Would a native speaker say this?"
        - "What is the seed theme?"

      example_thinking:
        lego: "quiero / I want"
        thinking: |
          <thinking>
          LEGO: "quiero" / "I want"
          - Type: Verb (first person singular, present)
          - Natural usage: Followed by infinitive or noun
          - Seed theme: "I want to speak Spanish with you now"

          Phrase ideas:
          1. Start bare: "I want" (show the LEGO)
          2. Add object: "I want coffee"
          3. Add infinitive: "I want to speak"
          4. Build complexity: "I want to speak Spanish"
          5. Toward seed: "I want to speak Spanish with you now"
          </thinking>

    STEP_2_WORD_CLASS_RECOGNITION:
      description: "CRITICAL: Identify LEGO's grammatical class before generating"

      verb_legos:
        examples: ["wants", "said", "met", "to show"]
        correct_usage:
          - "She wants coffee"
          - "He said something important"
          - "I met someone yesterday"
          - "I want to show you something"
        incorrect_usage:
          - "I think that wants is good"
          - "This is said"
          - "I know met"
          - "Do you have to show?"

      noun_legos:
        examples: ["coffee", "something", "woman"]
        correct_usage:
          - "Coffee is good (subject)"
          - "I want coffee (object)"
          - "The woman arrived (subject)"
          - "I met the woman (object)"

      adjective_legos:
        examples: ["new", "important", "young"]
        correct_usage:
          - "something new"
          - "an important fact"
          - "a young woman"
          - "This is important"

      phrase_legos:
        examples: ["to show you", "from home", "I'm trying"]
        correct_usage:
          - "I want to show you something"
          - "I work from home"
          - "I'm trying to learn Spanish"

    STEP_3_GENERATE_10_PHRASES:
      description: "Create exactly 10 phrases per LEGO"

      mandatory_distribution:
        really_short_1_2_words: 2       # Fragments OK, show bare LEGO
        quite_short_3_words: 2          # Complete thoughts
        longer_4_5_words: 2             # Complete thoughts
        long_6_plus_words: 4            # Conversational gold

      output_format:
        description: "Each phrase becomes a row in course_practice_phrases"
        fields:
          - "course_code: from input LEGO"
          - "seed_number: from input LEGO"
          - "lego_index: from input LEGO"
          - "position: 2-11 for practice phrases"
          - "known_text: English phrase"
          - "target_text: Spanish phrase"
          - "word_count: count of target language words"
          - "target_syllable_count: syllable count of target phrase (for cognitive load)"
          - "lego_count: count of LEGOs used in phrase"
          - "status: 'draft'"

      requirements_for_all_phrases:
        - "GATE Compliance: Every Spanish word must be in whitelist"
        - "Natural Language: Would a native speaker say this?"
        - "Semantic Correctness: Does it make logical sense?"
        - "Progressive Complexity: Build from simple to complex"
        - "Thematic Coherence: Relate to seed sentence theme"

    STEP_4_SPECIAL_RULES:
      final_lego_rule:
        condition: "Last LEGO in seed (highest lego_index)"
        requirement: "Phrase #10 MUST be the complete seed sentence"
        example:
          position: 11
          known_text: "I want to speak Spanish with you now."
          target_text: "Quiero hablar espanol contigo ahora."
          word_count: 5
          lego_count: 5

      recency_priority:
        principle: "Prioritize vocabulary from 5 previous seeds"
        benefit: "Makes content feel fresh and reinforces recent learning"

      conjunction_usage:
        condition: "Only if conjunctions (si, y, pero, porque, cuando) are in whitelist"
        usage_rate: "20-40% of phrases (2-4 out of 10)"

  ## ==========================================================================
  ## GATE COMPLIANCE (Zero Tolerance)
  ## ==========================================================================

  gate_compliance:
    principle: "Every Spanish word must be in the whitelist"
    tolerance: "ZERO violations allowed"

    validation_process:
      STEP_1_EXTRACT:
        description: "Extract words from Spanish phrase"
        method: "Split on spaces and punctuation, lowercase all"
        example:
          phrase: "Quiero hablar espanol."
          extracted: ["quiero", "hablar", "espanol"]

      STEP_2_CHECK:
        description: "Check each word against whitelist"
        checks:
          - "Is 'quiero' in whitelist?"
          - "Is 'hablar' in whitelist?"
          - "Is 'espanol' in whitelist?"

      STEP_3_SYLLABLE_CHECK:
        description: "Check syllable count for cognitive load"
        max_syllables: 25
        method: "Count syllables in target phrase (vowel cluster estimation)"
        rationale: "Phrases over 25 syllables create excessive cognitive load for learners"
        example:
          phrase: "Quiero hablar espanol contigo ahora mismo"
          syllables: 14
          status: "PASS (under 25)"

      STEP_4_REJECT:
        condition: "If ANY word is missing OR syllable count exceeds 25"
        action: "REJECT phrase, generate replacement"

    validation_error_types:
      - "missing_lego: Phrase doesn't contain the complete LEGO"
      - "gate_target: Target text contains unknown vocabulary"
      - "gate_known: Known text contains unknown vocabulary"
      - "syllable_overload: Phrase exceeds 25 syllables (cognitive load limit)"

    common_mistakes:
      mistake_1:
        whitelist_has: "quiero (I want)"
        wrong: "Quiere hablar espanol (quiere not in whitelist)"
        correct: "Quiero hablar espanol (quiero is in whitelist)"

      mistake_2:
        whitelist_has: "estoy (I am)"
        wrong: "Ella esta aqui (esta not in whitelist)"
        correct: "Estoy aqui (estoy is in whitelist)"

    critical_rule: "NO conjugations, NO variations - exact forms only"

  ## ==========================================================================
  ## OUTPUT: DATABASE INSERT
  ## ==========================================================================

  output:
    description: "Insert practice phrases into course_practice_phrases table"

    insert_statement: |
      INSERT INTO course_practice_phrases (
        course_code,
        seed_number,
        lego_index,
        position,
        known_text,
        target_text,
        word_count,
        target_syllable_count,
        lego_count,
        status
      ) VALUES ($1, $2, $3, $4, $5, $6, $7, $8, $9, 'draft')
      ON CONFLICT (course_code, seed_number, lego_index, position)
      DO UPDATE SET
        known_text = EXCLUDED.known_text,
        target_text = EXCLUDED.target_text,
        word_count = EXCLUDED.word_count,
        target_syllable_count = EXCLUDED.target_syllable_count,
        lego_count = EXCLUDED.lego_count,
        status = 'draft',
        updated_at = now();

    position_mapping:
      - "0: Component phrases (M-type only)"
      - "1: LEGO debut phrase"
      - "2-11: Practice phrases (10 total)"

    example_output:
      seed_number: 1
      lego_index: 1
      lego: {known_text: "I want", target_text: "quiero"}
      type: "A"
      inserted_rows:
        - {position: 2, known_text: "I want", target_text: "quiero", word_count: 1, lego_count: 1}
        - {position: 3, known_text: "I want coffee", target_text: "quiero cafe", word_count: 2, lego_count: 2}
        - {position: 4, known_text: "I want to speak", target_text: "quiero hablar", word_count: 2, lego_count: 2}
        - {position: 5, known_text: "I want to learn Spanish", target_text: "quiero aprender espanol", word_count: 3, lego_count: 3}
        - {position: 6, known_text: "I want to speak Spanish now", target_text: "quiero hablar espanol ahora", word_count: 4, lego_count: 4}
        - {position: 7, known_text: "I want to speak Spanish with you", target_text: "quiero hablar espanol contigo", word_count: 4, lego_count: 4}
        - {position: 8, known_text: "I want to speak with you now", target_text: "quiero hablar contigo ahora", word_count: 4, lego_count: 4}
        - {position: 9, known_text: "I want to learn Spanish with you", target_text: "quiero aprender espanol contigo", word_count: 4, lego_count: 4}
        - {position: 10, known_text: "I want to speak Spanish with someone", target_text: "quiero hablar espanol con alguien", word_count: 5, lego_count: 5}
        - {position: 11, known_text: "I want to speak Spanish with you now", target_text: "quiero hablar espanol contigo ahora", word_count: 5, lego_count: 5}

  ## ==========================================================================
  ## QUALITY CHECKLIST (Per LEGO)
  ## ==========================================================================

  quality_checklist:
    description: "Verify before moving to next LEGO"

    checks:
      - "10 phrases generated (exactly 10)"
      - "Distribution: 2-2-2-4 (short-quite short-longer-long)"
      - "ALL Spanish words in whitelist (zero violations)"
      - "All phrases under 25 syllables (cognitive load limit)"
      - "All phrases sound natural in BOTH languages"
      - "Word class used correctly (verb as verb, noun as noun)"
      - "Progressive complexity (simple -> complex)"
      - "Thematic coherence (relates to seed theme)"
      - "If final LEGO: phrase 10 is complete seed sentence"
      - "No template patterns detected"
      - "Extended thinking used for challenging LEGOs"
      - "word_count accurately calculated for each phrase"
      - "target_syllable_count accurately calculated for each phrase"
      - "lego_count accurately calculated for each phrase"

  ## ==========================================================================
  ## MULTI-MASTER ORCHESTRATION (v10.2)
  ## ==========================================================================

  multi_master_orchestration:
    description: |
      Phase 3 uses a multi-master architecture for parallel basket generation.
      Seeds are divided into groups (e.g., 5 seeds per master) and each master
      spawns workers to process individual LEGOs.

    spawn_endpoint: "POST /launch-15-masters"
    status_endpoint: "GET /status/{courseCode}"

    master_lifecycle:
      states: [pending, spawning, running, complete, failed, stalled]

      pending:
        description: "Master defined but not yet spawned"
        duration: "Until spawn loop reaches this master"

      spawning:
        description: "Browser launch in progress"
        duration: "5 seconds (inter-spawn delay)"

      running:
        description: "Workers active, processing LEGOs"
        transition_to_complete: "When legosReceived == legosExpected"
        transition_to_failed: "If spawn fails or no activity for extended period"

      complete:
        description: "All expected LEGOs received from workers"
        indicator: "Green checkmark in Agent Swimlane"

      failed:
        description: "Spawn error or critical failure"
        requires: "Manual retry via intelligent resume"

      stalled:
        description: "Running but no activity for >10 minutes"
        action: "Flag for attention, may need intervention"

    worker_tracking:
      description: "Workers tracked by database inserts, not browser sessions"

      worker_status:
        pending: "No inserts received yet"
        running: "At least one insert received"
        complete: "All assigned LEGOs processed"

      completion_detection: |
        When practice phrases are inserted via database,
        the server queries course_practice_phrases to track progress
        and updates worker status accordingly.

    data_model:
      job:
        courseCode: string
        status: enum [pending, running, complete, failed]
        masters: array of Master
        startedAt: timestamp
        completedAt: timestamp optional

      master:
        masterNum: integer
        seedRange: string              # "S0001-S0005"
        seeds: array of string         # ["S0001", "S0002", ...]
        legosExpected: integer
        legosReceived: integer
        status: enum [pending, spawning, running, complete, failed, stalled]
        spawnedAt: timestamp optional
        lastActivityAt: timestamp optional
        workers: array of Worker

      worker:
        workerNum: integer
        legoCount: integer
        legoIds: array of string       # ["S0001L01", "S0001L02", ...]
        status: enum [pending, running, complete]
        legosUploaded: integer default 0
        lastUpload: timestamp optional

    api_integration:
      get_status:
        endpoint: "GET /status/{courseCode}"
        returns:
          courseCode: string
          status: string
          masters: array of master objects (when available)

      progress_tracking:
        method: "Query course_practice_phrases table"
        query: |
          SELECT seed_number, lego_index, COUNT(*) as phrase_count
          FROM course_practice_phrases
          WHERE course_code = $1 AND status = 'draft'
          GROUP BY seed_number, lego_index;

    monitoring:
      component: "AgentSwimlane.vue"
      route: "/monitor/{courseCode}"
      poll_interval: "3 seconds"
      features:
        - "Master cards with status badges"
        - "Expandable workers panel"
        - "Progress rings showing LEGOs received/expected"
        - "Time since spawn, time since last activity"
        - "Live activity feed"

  ## ==========================================================================
  ## INTELLIGENT RESUME (Recovery)
  ## ==========================================================================

  intelligent_resume:
    description: |
      When Phase 3 fails partially (some masters complete, some fail),
      the system supports intelligent resume to continue from where it left off.

    mechanism:
      - "Query course_practice_phrases for existing phrases"
      - "Compare against expected LEGOs from course_legos (is_new=true, status='released')"
      - "Calculate missing LEGOs (those without practice phrases)"
      - "Launch new job targeting only missing LEGOs"

    missing_legos_query: |
      SELECT cl.* FROM course_legos cl
      LEFT JOIN (
        SELECT DISTINCT course_code, seed_number, lego_index
        FROM course_practice_phrases
        WHERE position >= 2  -- Has practice phrases
      ) cpp ON cpp.course_code = cl.course_code
           AND cpp.seed_number = cl.seed_number
           AND cpp.lego_index = cl.lego_index
      WHERE cl.course_code = $1
        AND cl.is_new = true
        AND cl.status = 'released'
        AND cpp.course_code IS NULL;

    trigger: "Re-launch /launch-15-masters with same courseCode"
    behavior: "System detects existing progress and resumes"

    no_automatic_retry:
      description: |
        Phase 3 does NOT automatically retry failed masters.
        Recovery requires manual triggering of a new launch.
        This is intentional to allow investigation of failures.

  ## ==========================================================================
  ## VERSION HISTORY
  ## ==========================================================================

  version_history:
    v11_1:
      date: "2026-01-12"
      status: "Production Ready"
      title: "Syllable Count Validation"
      changes:
        - "Added syllable_overload GATE check (max 25 syllables per phrase)"
        - "Added target_syllable_count field to database output"
        - "Updated validation_error_types to include syllable_overload"
        - "Updated quality checklist with syllable count requirements"
        - "Aligned APML spec with server.cjs implementation"

    v11_0:
      date: "2026-01-12"
      status: "Deprecated"
      title: "DB-First Architecture"
      changes:
        - "BREAKING: Remove all JSON file references (lego_pairs.json, lego_baskets.json, scaffolds)"
        - "Input: Read from course_legos table WHERE is_new=true AND status='released'"
        - "Output: Write to course_practice_phrases table"
        - "Added database schema reference section"
        - "Updated output format with position, word_count, lego_count fields"
