# APML Phase 2: Conflict Resolution (Upchunking)
# Version: 10.1.0 (2025-12-03)
# Status: Production-ready
# Server Port: 3458
#
# Source prompts:
#   - public/docs/phase_intelligence/phase_2_conflict_resolution.md

phase Phase2ConflictResolution:
  name: "Phase 2: Conflict Resolution"
  purpose: "Resolve LEGO conflicts through upchunking"
  version: "10.1.0"
  server_port: 3458

  ## ==========================================================================
  ## OVERVIEW
  ## ==========================================================================

  description: |
    Phase 2 resolves KNOWN→TARGET conflicts from Phase 1's draft_lego_pairs.json
    through **upchunking** - creating M-type LEGOs that teach conflicting patterns
    explicitly with disambiguating context.

  input:
    file: "draft_lego_pairs.json"
    location: "S3: s3://popty-bach-lfs/courses/{course_code}/draft_lego_pairs.json"
    description: "LEGOs from Phase 1 that may have conflicts"

  output:
    file: "lego_pairs.json"
    location: "S3: s3://popty-bach-lfs/courses/{course_code}/lego_pairs.json"
    description: "Conflict-free LEGOs (SINGLE SOURCE OF TRUTH)"

  ## ==========================================================================
  ## CONFLICT TYPES
  ## ==========================================================================

  conflict_types:
    known_to_target:
      description: "Same KNOWN word maps to multiple TARGET translations"
      example:
        conflict: "'tarde' → 'afternoon' vs 'tarde' → 'late'"
        resolution: "Create M-type LEGO 'por la tarde' → 'in the afternoon'"

  ## ==========================================================================
  ## UPCHUNKING ALGORITHM
  ## ==========================================================================

  upchunking_algorithm:
    description: "Create M-type LEGOs with disambiguating context"

    steps:
      1: "Identify all seeds where conflict occurs"
      2: "Analyze context words around conflicting KNOWN word"
      3: "Create M-type LEGO with:"
         - "KNOWN: conflicting word + context (2+ words)"
         - "TARGET: full translation (2+ words)"
         - "Type: 'M' (Molecular)"
      4: "Record resolution in upchunk_resolutions.json"

    example:
      conflict:
        word: "tarde"
        meanings:
          - { target: "afternoon", context: "por la tarde" }
          - { target: "late", context: "llegó tarde" }

      resolution:
        - { id: "UPCHUNK001", type: "M", known: "in the afternoon", target: "por la tarde" }
        - { id: "UPCHUNK002", type: "M", known: "arrived late", target: "llegó tarde" }

  ## ==========================================================================
  ## OUTPUT FORMAT
  ## ==========================================================================

  output_format:
    description: "lego_pairs.json (APML v10.1 format)"

    schema:
      version: "10.1"
      seeds:
        - seed_id: "S0001"
          seed_pair:
            known: "I want"
            target: "Dw i eisiau"
          legos:
            - id: "S0001L01"
              type: "A"
              lego:
                known: "I"
                target: "Dw i"
            - id: "S0001L02"
              type: "A"
              lego:
                known: "want"
                target: "eisiau"

  ## ==========================================================================
  ## LEGO REUSE TRACKING
  ## ==========================================================================

  lego_reuse_tracking:
    description: |
      Phase 2 marks LEGO reuse across the course. Two types of reuse:

    exact_duplicates:
      description: "Same LEGO appearing again later in course"
      detection: "Global check against all previously seen LEGOs"
      marking:
        new: false
        ref: "original seed ID"

    embedded_legos:
      description: "LEGO that appeared as substring within a recent larger LEGO"
      detection: "10-LEGO sliding window, character-level substring match"
      marking:
        new: false
        ref: null  # No ref for embedded matches
      example:
        container: { known: "to remember a word", target: "recordar una palabra" }
        embedded: { known: "a word", target: "una palabra" }
        reason: "Learner already heard 'una palabra' within the larger phrase"

    window_size: 10
    rationale: |
      10 LEGOs catches the "just heard it" annoyance. Beyond 10 LEGOs,
      re-introducing as "new" is pedagogically appropriate.

    character_matching: |
      Uses character-level substring matching (not word boundaries).
      Works for all languages including Chinese: "说" matches inside "说中文"

  ## ==========================================================================
  ## AGENT REQUIREMENTS
  ## ==========================================================================

  agent_requirements:
    linguistic_judgment: |
      Agent must understand context to determine which meaning applies
      and create appropriate upchunked LEGOs.

    zero_ambiguity_rule: |
      After upchunking, every LEGO must have ZERO ambiguity:
      When learner hears KNOWN, there is exactly ONE TARGET they should produce.

  ## ==========================================================================
  ## SCRIPTS
  ## ==========================================================================

  scripts:
    standalone: "scripts/phase2_lego_reuse_tracking.cjs"
    server: "services/phases/phase1-lego-extraction/server.cjs (port 3458)"

  ## ==========================================================================
  ## VERSION HISTORY
  ## ==========================================================================

  version_history:
    v10_1_1:
      date: "2025-12-03"
      status: "Production Ready"
      changes:
        - "Added embedded LEGO detection (10-LEGO sliding window)"
        - "Character-level substring matching for all languages"
        - "Baskets for new:false LEGOs are removed from lego_baskets.json"

    v10_1_0:
      date: "2025-12-03"
      status: "Production Ready"
      changes:
        - "Extracted as separate phase from old Phase 3"
        - "Added server_port 3458"
        - "Updated to v10.1 phase numbering"
