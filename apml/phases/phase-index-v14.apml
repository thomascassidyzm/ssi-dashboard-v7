    - name: "phase9-manifest"
      port: 3466
      script: "services/phases/phase9-manifest-compiler.cjs"

    - name: "course-builder"
      port: 3471
      script: "services/course-builder-api.cjs"

  deprecated:
    - name: "phase1-translation"
      reason: "Replaced by Course Builder"
    - name: "phase2-conflict"
      reason: "Replaced by Course Builder"
    - name: "phase3-basket"
      reason: "Replaced by Course Builder"

## ============================================================================
## WORKFLOW COMPARISON
## ============================================================================

WORKFLOW_COMPARISON:
  v13_workflow:
    description: "Multi-phase orchestration"
    steps:
      1: "Generate language brief (Phase 0)"
      2: "Spawn Phase 1 agent for translation + LEGO extraction"
      3: "Spawn Phase 2 agent for conflict resolution"
      4: "Spawn Phase 3 masters/workers for basket generation"
      5: "Monitor via Agent Swimlane dashboard"
      6: "Collect outputs, resolve conflicts"
      7: "Generate audio (Phase 8)"
      8: "Compile manifest (Phase 9)"

  v14_workflow:
    description: "Direct agent submission"
    steps:
      1: "Agent reads course-builder brief (methodology examples)"
      2: "Agent calls POST /api/seed/complete for each seed"
      3: "API validates atomically, inserts to Supabase"
      4: "Repeat for all seeds"
      5: "Generate audio (Phase 8)"
      6: "Compile manifest (Phase 9)"

    benefits:
      - "No orchestration overhead"
      - "Agent retains context for entire seed"
      - "Atomic validation catches errors immediately"
      - "Simple recovery (check /api/stats, continue from next seed)"

## ============================================================================
## SUMMARY
## ============================================================================

SUMMARY:
  version: "14.0.0"
  date: "2026-01-15"

  major_change: |
    Phases 0-3 consolidated into Course Builder API.
    Agent learns methodology from examples, submits directly via curl.

  active_services:
    - "Orchestrator (3456)"
    - "Course Builder API (3471)"
    - "Phase 8 Audio (3465)"
    - "Phase 9 Manifest (3466)"
    - "Production API (3470)"

  archived:
    - "Phase 0-3 servers"
    - "Agent Swimlane monitor"
    - "Master/Worker orchestration"

  methodology:
    location:
      - ".claude/commands/ssi-learner-pattern.md"
      - ".claude/commands/ssi-decompose-seed.md"
      - ".claude/commands/ssi-build-phrases.md"
    principle: "Learn by example, not by rules"

